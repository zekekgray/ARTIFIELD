let index = 0;
let formData = { businessType: "", painPoint: "", scale: "", action: "" };

const q = document.getElementById("question"), sub = document.getElementById("sub"), body = document.getElementById("body");
const next = document.getElementById("next"), back = document.getElementById("back"), bar = document.getElementById("bar"), progressText = document.getElementById("progressText");
const actionsBar = document.getElementById("actionsBar");
const stepsUI = [...document.querySelectorAll(".step")];

function syncActionsVisibility(){
  if(steps[index].action){
    actionsBar.classList.remove("visible");
    return;
  }
  actionsBar.classList.toggle("visible", !next.disabled || !back.disabled);
}

function render(){
  const s = steps[index];
  q.textContent = s.q;
  sub.textContent = s.sub;
  body.innerHTML = "";
  next.disabled = true;

  stepsUI.forEach((el, i) => el.classList.toggle("active", i === index));
  bar.style.width = ((index + 1) / steps.length * 100) + "%";
  progressText.textContent = (index + 1) + " / " + steps.length;
  back.disabled = index === 0;

  if(s.opts){
    const wrap = document.createElement("div");
    wrap.className = "options";
    s.opts.forEach((o) => {
      const card = document.createElement("div");
      card.className = "option";
      if(formData[s.key] === o.title) card.classList.add("selected");

      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "option-toggle";
      btn.innerHTML = '<span class="option-icon">' + o.icon + '</span>' +
        '<span class="option-head"><b>' + o.title + '</b><span>' + o.sub + '</span></span>' +
        '<span class="option-chevron">›</span>';

      const detail = document.createElement("div");
      detail.className = "option-detail";
      detail.innerHTML = '<p>' + o.detail + '</p>';

      function selectOption(){
        wrap.querySelectorAll(".option.selected").forEach(x => x.classList.remove("selected"));
        card.classList.add("selected");
        formData[s.key] = o.title;
        next.disabled = false;
        syncActionsVisibility();
      }
      function openOption(){
        wrap.querySelectorAll(".option.open").forEach(other => {
          if(other !== card){ other.classList.remove("open"); other.querySelector(".option-detail").style.maxHeight = null; }
        });
        card.classList.add("open");
        detail.style.maxHeight = detail.scrollHeight + "px";
      }
      function closeOption(){
        card.classList.remove("open");
        detail.style.maxHeight = null;
      }

      if(supportsHover){
        card.addEventListener("mouseenter", openOption);
        card.addEventListener("mouseleave", closeOption);
        btn.addEventListener("focus", openOption);
        btn.addEventListener("blur", closeOption);
        btn.addEventListener("click", selectOption);
      } else {
        btn.addEventListener("click", () => {
          const wasOpen = card.classList.contains("open");
          selectOption();
          if(!wasOpen) openOption();
        });
      }

      card.appendChild(btn);
      card.appendChild(detail);
      wrap.appendChild(card);
    });
    body.appendChild(wrap);
    if(formData[s.key]) next.disabled = false;
  }

  if(s.input){
    const inp = document.createElement("input");
    inp.className = "input";
    inp.placeholder = "e.g. 6";
    inp.inputMode = "numeric";
    inp.value = formData.scale || "";
    inp.addEventListener("input", () => {
      const val = inp.value.trim();
      formData.scale = val;
      next.disabled = !(val && /\d/.test(val));
      syncActionsVisibility();
    });
    body.appendChild(inp);
    if(inp.value) next.disabled = false;
  }

  if(s.result){
    const fit = FIT_MAP[formData.painPoint] || DEFAULT_FIT;
    body.innerHTML =
      '<div class="result result-step4"><small>YOUR FIT</small>' +
      '<div class="headline">' + fit.headline + '</div>' +
      '<div class="body">' + fit.body + '</div>' +
      '<div class="result-grid">' +
        '<div class="metric"><small>PROJECT TYPE</small><b>' + (formData.businessType || "—") + '</b></div>' +
        '<div class="metric"><small>APPROX. BUILDINGS/PHASES</small><b>' + (formData.scale || "—") + '</b></div>' +
        '<div class="metric"><small>STARTS WITH</small><b>' + fit.modules[0] + '</b></div>' +
      '</div></div>';
    next.disabled = false;
  }

  if(s.action){
    const buttonsHtml = config.actions
      .map((label, i) => '<button class="btn ' + (i === 0 ? 'btn-light' : 'btn-secondary') + '" id="actionBtn' + i + '">' + label + ' →</button>')
      .join('');
    body.innerHTML =
      '<div class="result" id="actionResult"><small>NEXT STEP</small>' +
      '<div class="headline">Let\'s get you a demo on your own project.</div>' +
      '<div class="body">Share your details and someone from the ArtiField team will follow up to schedule a 20-minute walkthrough using your actual schedule and cost data.</div>' +
      '<span class="result-form-label">Your details</span>' +
      '<div class="result-form" id="leadForm">' +
        '<div class="result-field" id="fieldName"><label>Full name</label><input type="text" id="leadName" placeholder="Juan Dela Cruz"></div>' +
        '<div class="result-row">' +
          '<div class="result-field" id="fieldEmail"><label>Work email</label><input type="email" id="leadEmail" placeholder="you@company.com"></div>' +
          '<div class="result-field" id="fieldCompany"><label>Company / project name</label><input type="text" id="leadCompany" placeholder="Your project"></div>' +
        '</div>' +
        '<div class="result-field"><label>Phone (optional)</label><input type="tel" id="leadPhone" placeholder="09XX XXX XXXX"></div>' +
      '</div>' +
      '<div class="action-buttons" id="actionButtons">' + buttonsHtml + '</div></div>';
    config.actions.forEach((label, i) => {
      document.getElementById("actionBtn" + i).onclick = (e) => submitLead(label, e.currentTarget);
    });
    next.disabled = true;
  }

  syncActionsVisibility();
}

