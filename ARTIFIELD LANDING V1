        wrap.style.removeProperty("--vex-tx");
        wrap.style.removeProperty("--vex-ty");
        wrap.innerHTML = "";
        document.body.classList.add("app-ready");
        window.dispatchEvent(new Event("appReady"));
        if(navLabel){
          requestAnimationFrame(() => navLabel.classList.add("show"));
        }
      }, 620);
    }, holdMs);
  }
};
