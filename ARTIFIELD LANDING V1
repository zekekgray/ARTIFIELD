  getHistory(){
    try{
      const raw = localStorage.getItem(this.storageKey);
      return raw ? JSON.parse(raw) : { lastGreeting:"", recent:[], lastShownAt:0, visits:0 };
    }catch(e){
      return { lastGreeting:"", recent:[], lastShownAt:0, visits:0 };
    }
  },
  saveHistory(h){
    try{ localStorage.setItem(this.storageKey, JSON.stringify(h)); }catch(e){}
  },

  getHoliday(date){
    const m = date.getMonth() + 1, d = date.getDate();
    if(m === 1 && d === 1) return "newYear";
    if(m === 12 && (d === 24 || d === 25)) return "christmas";
    if(m === 2 && d === 14) return "valentines";
    return null;
  },

  pickFrom(list, history){
    const options = list.filter(g => !history.recent.includes(g));
    const pool = options.length ? options : list;
    return pool[Math.floor(Math.random() * pool.length)];
  },

  buildGreeting(){
    const history = this.getHistory();
    const now = Date.now();
    const date = new Date();
    const hour = date.getHours();
    const day = date.getDay();
    const isWeekend = (day === 0 || day === 6);
    const holidayKey = this.getHoliday(date);
    const isFirstVisit = history.visits === 0;

    let pool;
    if(holidayKey && this.greetings.holiday[holidayKey]){
      pool = this.greetings.holiday[holidayKey];
    } else if(isFirstVisit){
      pool = this.greetings.firstVisit;
    } else if(isWeekend && hour >= 5 && hour < 12){
      pool = this.greetings.weekendMorning;
    } else if(isWeekend){
      pool = this.greetings.weekend;
    } else if(hour >= 5 && hour < 8){
      pool = this.greetings.morningEarly;
    } else if(hour >= 8 && hour < 12){
      pool = this.greetings.morning;
    } else if(hour >= 12 && hour < 17){
      pool = this.greetings.afternoon;
    } else if(hour >= 17 && hour < 21){
      pool = this.greetings.evening;
    } else {
      pool = this.greetings.night;
    }

    const text = this.pickFrom(pool, history);

    history.recent.push(text);
    if(history.recent.length > 5) history.recent.shift();
    history.lastGreeting = text;
    history.lastShownAt = now;
    history.visits = (history.visits || 0) + 1;
    this.saveHistory(history);

    return text;
  },

  makeTypingIndicator(){
    const el = document.createElement("div");
    el.className = "vex-typing";
    el.innerHTML = '<span class="vex-typing-dot"></span><span class="vex-typing-dot"></span><span class="vex-typing-dot"></span>';
    return el;
  },

  typeText(el, text, charsPerSecond, onDone){
    const textEl = document.createElement("span");
    const caret = document.createElement("span");
    caret.className = "vex-caret";
    el.appendChild(textEl);
    el.appendChild(caret);

    let start = null;
    let shown = 0;
    const total = text.length;

    function step(ts){
      if(start === null) start = ts;
      const elapsed = (ts - start) / 1000;
      const targetChars = Math.min(total, Math.floor(elapsed * charsPerSecond));
      if(targetChars > shown){
        shown = targetChars;
        textEl.textContent = text.slice(0, shown);
      }
      if(shown < total){
        requestAnimationFrame(step);
      } else {
        caret.remove();
        if(onDone) onDone();
      }
    }
    requestAnimationFrame(step);
  },

  showBubbleWithDelay(wrap, className, tagHtml, text, humanDelayMs, charsPerSecond){
    return new Promise((resolve) => {
      const typing = this.makeTypingIndicator();
      wrap.appendChild(typing);
      requestAnimationFrame(() => typing.classList.add("show"));

      setTimeout(() => {
        typing.classList.remove("show");
        typing.classList.add("hide");
        setTimeout(() => {
          typing.remove();
          const bubble = document.createElement("div");
          bubble.className = "vex-bubble" + (className ? " " + className : "");
          if(tagHtml) bubble.innerHTML = tagHtml;
          const textWrap = document.createElement("div");
          textWrap.className = "vex-bubble-text";
          bubble.appendChild(textWrap);
          wrap.appendChild(bubble);
          requestAnimationFrame(() => bubble.classList.add("show"));

          this.typeText(textWrap, text, charsPerSecond, () => resolve(bubble));
        }, 250);
      }, humanDelayMs);
    });
  },

  async render(){
    const fullText = this.buildGreeting();
    if(!fullText){ document.body.classList.add("app-ready"); window.dispatchEvent(new Event("appReady")); return; }
    const overlay = document.getElementById("vexOverlay");
