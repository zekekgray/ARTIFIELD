      const fourthDelay = 300 + Math.random() * 300;
      await this.showBubbleWithDelay(wrap, "vex-bubble-sub", "", discSub, fourthDelay, 40);
    }

    const holdMs = 2200;
    setTimeout(() => {
      if(navLabel){
        const wrapRect = wrap.getBoundingClientRect();
        const navRect = navLabel.getBoundingClientRect();
        const tx = (navRect.left + navRect.width / 2) - (wrapRect.left + wrapRect.width / 2);
        const ty = (navRect.top + navRect.height / 2) - (wrapRect.top + wrapRect.height / 2);
        wrap.style.setProperty("--vex-tx", tx + "px");
