(function(){
  if(!artiwheelConfig.enabled) return;

  const overlay = document.getElementById("awOverlay");
  const wheel = document.getElementById("awWheel");
  const spinBtn = document.getElementById("awSpinBtn");
  const step1 = document.getElementById("awStep1");
  const step2 = document.getElementById("awStep2");
  const step3 = document.getElementById("awStep3");
  const prizeText = document.getElementById("awPrizeText");
  const claimBtn = document.getElementById("awClaimBtn");
  let currentPrize = null;
  let rotation = 0;

  const TOTAL_SLOTS = artiwheelConfig.tiers.reduce((s,t) => s + t.count, 0);

  function buildWheelOrder(tiers, total){
    const order = new Array(total).fill(null);
    tiers.forEach((t, ti) => {
      for(let k = 0; k < t.count; k++){
        let pos = Math.round((k + 0.5) / t.count * total) % total;
        while(order[pos] !== null) pos = (pos + 1) % total;
        order[pos] = ti;
      }
    });
    return order;
  }

  const slotOrder = buildWheelOrder(artiwheelConfig.tiers, TOTAL_SLOTS);
  const segAngles = slotOrder.map((tierIndex, i) => {
    const t = artiwheelConfig.tiers[tierIndex];
    const start = i / TOTAL_SLOTS * 360;
    const end = (i + 1) / TOTAL_SLOTS * 360;
    return { label: t.label, symbol: t.symbol, color: t.color, start, end };
  });

  wheel.style.background = "conic-gradient(" + segAngles.map(s => s.color + " " + s.start + "deg " + s.end + "deg").join(",") + ")";

  spinBtn.addEventListener("click", () => {
    spinBtn.disabled = true;
    const slot = Math.floor(Math.random() * TOTAL_SLOTS);
    currentPrize = segAngles[slot];
    const mid = (currentPrize.start + currentPrize.end) / 2;

    const totalDuration = 8 + Math.random() * 2;
    const recoilDuration = 1.7;
    const mainDuration = totalDuration - recoilDuration;

    const fullTurns = 6 + Math.floor(Math.random() * 3);
    const overshootDeg = 1.5 + Math.random() * 0.5;

    const targetRotation = rotation + fullTurns * 360 + (360 - mid);
    const overshootRotation = targetRotation + overshootDeg;

    wheel.style.transition = "transform " + mainDuration.toFixed(2) + "s cubic-bezier(0.15,0.9,0.2,1.02)";
    wheel.style.transform = "rotate(" + overshootRotation + "deg)";

    setTimeout(() => {
      wheel.style.transition = "transform " + recoilDuration.toFixed(2) + "s cubic-bezier(0.34,1.15,0.64,1)";
      wheel.style.transform = "rotate(" + targetRotation + "deg)";
    }, mainDuration * 1000);

    rotation = targetRotation;

    setTimeout(() => {
      step1.classList.remove("show");
      step2.classList.add("show");
      prizeText.textContent = currentPrize.symbol + " " + currentPrize.label;
      spinBtn.disabled = false;
    }, totalDuration * 1000 + 150);
  });

  claimBtn.addEventListener("click", () => {
    const name = document.getElementById("awName").value.trim();
    const contact = document.getElementById("awContact").value.trim();
    if(name.length < 2 || contact.length < 5){
      toast("Please enter your name and email or number", true);
      return;
    }
    const payload = { source: "ArtiWheel", prize: currentPrize.label, name, contact, ts: new Date().toISOString() };
    claimBtn.disabled = true;
    claimBtn.textContent = "Sending…";
    if(config.webhookUrl){
      fetch(config.webhookUrl, {
        method: "POST", mode: "no-cors",
        headers: {"Content-Type": "text/plain;charset=utf-8"},
        body: JSON.stringify(payload)
      }).then(() => {
        step2.classList.remove("show");
        step3.classList.add("show");
      }).catch(() => {
        toast("Could not send — try again", true);
        claimBtn.disabled = false;
        claimBtn.textContent = "Claim Prize";
      });
    } else {
      console.log("ArtiWheel claim (local test mode):", payload);
      step2.classList.remove("show");
      step3.classList.add("show");
    }
  });

  function openArtiwheel(){
    overlay.classList.add("open");
    document.body.classList.add("aw-open");
  }
  function closeArtiwheel(){
    overlay.classList.remove("open");
    document.body.classList.remove("aw-open");
  }
  document.getElementById("awClose").addEventListener("click", closeArtiwheel);
  overlay.addEventListener("click", (e) => { if(e.target === overlay) closeArtiwheel(); });

  window.addEventListener("load", () => setTimeout(openArtiwheel, 3000));
})();
/* === END: ARTIWHEEL CONFIG + LOGIC (54-SECTION / 7-TIER) === */

/* === OPEN APP HINT PILL TIMING === */
(function(){
  const hint = document.getElementById("oaHint");
  const openAppBtn = document.getElementById("openApp");
  if(!hint || !openAppBtn) return;

  function dismissHint(){
    if(!hint.classList.contains("show")) return;
    hint.classList.remove("show");
    hint.classList.add("hide");
    setTimeout(() => { hint.style.display = "none"; }, 450);
  }

  window.addEventListener("dxNoticeClosed", () => {
    setTimeout(() => {
      hint.classList.add("show");
      setTimeout(dismissHint, 4000);
    }, 1200);
  }, { once: true });

  openAppBtn.addEventListener("click", dismissHint);
})();

/* === DESKTOP-ONLY NOTICE TIMING === */
(function(){
  const overlay = document.getElementById("dxOverlay");
  const btn = document.getElementById("dxContinue");
  if(!overlay || !btn) return;
  const key = "artifieldDesktopNoticeSeen";
  const readTimeMs = 6000; // human reading phase before auto-close
  let seen = false;
  try{ seen = sessionStorage.getItem(key) === "1"; }catch(e){}

  let autoCloseTimer = null;
  let closed = false;

  function closeDx(){
    if(closed) return;
    closed = true;
    clearTimeout(autoCloseTimer);
    overlay.classList.remove("open");
    document.body.style.overflow = "";
    try{ sessionStorage.setItem(key, "1"); }catch(e){}
    window.dispatchEvent(new Event("dxNoticeClosed"));
  }

  function startDxNotice(){
    if(!seen){
      setTimeout(() => {
        overlay.classList.add("open");
        document.body.style.overflow = "hidden";
        autoCloseTimer = setTimeout(closeDx, readTimeMs);
      }, 300);
    } else {
      window.dispatchEvent(new Event("dxNoticeClosed"));
    }
  }

  window.addEventListener("appReady", startDxNotice, { once:true });

  btn.addEventListener("click", closeDx);
})();

render();
</script>
