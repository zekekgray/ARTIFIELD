<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<title>ArtiField — Know your schedule. Know your real cost. Every day on site.</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;850&family=JetBrains+Mono:wght@500&display=optional');
:root{
  --bg:#f4f5f2; --surface:#ffffff; --soft:#edf0ec; --line:#dfe3df; --line-strong:#c7cdc7;
  --ink:#111513; --muted:#6c746f; --faint:#9aa39c;
  --accent:#171b18; --accent-hover:#2a2f2b; --accent-soft:#eceeec;
  --radius:20px;
  --font:'Inter',ui-sans-serif,system-ui,sans-serif; --mono:'JetBrains Mono',monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;overflow-x:hidden;scrollbar-width:thin;scrollbar-color:rgba(17,21,19,.25) transparent}
html::-webkit-scrollbar{width:8px}
html::-webkit-scrollbar-track{background:transparent}
html::-webkit-scrollbar-thumb{background-color:rgba(17,21,19,.22);border-radius:999px;border:2px solid transparent;background-clip:padding-box}
html::-webkit-scrollbar-thumb:hover{background-color:rgba(17,21,19,.38)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font);-webkit-font-smoothing:antialiased;overflow-x:hidden;width:100%}
header,main{opacity:0;transform:translateY(16px);transition:opacity .8s cubic-bezier(.22,1,.36,1),transform .8s cubic-bezier(.22,1,.36,1);pointer-events:none}
body.app-ready header,body.app-ready main{opacity:1;transform:translateY(0);pointer-events:auto}
button,input{font:inherit}
button{cursor:pointer}
.shell{max-width:100%;margin:auto;padding:0 clamp(16px,2vw,40px);width:100%}
.nav{position:relative;height:74px;display:flex;align-items:center;justify-content:space-between}
.nav-left{display:flex;align-items:center;gap:20px}
.brand{display:flex;align-items:center;gap:9px;font-weight:800;letter-spacing:-.03em;font-size:19px}
.brand .dot{width:9px;height:9px;border-radius:3px;background:var(--accent)}
.nav-right{display:flex;gap:10px;align-items:center}
.pill{display:inline-flex;align-items:center;justify-content:center;gap:6px;border:1px solid rgba(255,255,255,.6);background:rgba(255,255,255,.55);backdrop-filter:blur(14px) saturate(180%);-webkit-backdrop-filter:blur(14px) saturate(180%);border-radius:999px;padding:8px 16px;font-size:12.5px;font-weight:650;letter-spacing:.01em;line-height:1;color:var(--ink);box-shadow:0 8px 20px rgba(17,21,19,.1);white-space:nowrap;flex-shrink:0;align-self:center}
.pill::before{content:"✓";display:inline-flex;align-items:center;justify-content:center;width:14px;height:14px;border-radius:50%;background:var(--ink);color:#fff;font-size:9px;font-weight:800;flex-shrink:0}
.btn-nav{border:0;background:var(--ink);color:var(--bg);border-radius:10px;padding:10px 16px;font-size:13px;font-weight:650}
.btn-nav-ghost{border:1px solid var(--line-strong);background:transparent;color:var(--ink);border-radius:10px;padding:9px 15px;font-size:13px;font-weight:600;text-decoration:none;display:inline-flex;align-items:center}
.btn-nav-ghost:hover{background:var(--soft)}

.hero{padding:5%;min-height:calc(100vh - 74px);display:grid;grid-template-columns:1.15fr .85fr;gap:48px;align-items:center;box-sizing:border-box}
.nav-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);pointer-events:none}
.vex-nav-label{font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--faint);opacity:0;transition:opacity .6s ease;background:none;border:0;padding:0;font-family:inherit;pointer-events:auto;cursor:pointer}
.vex-nav-label:hover{color:var(--ink)}
.vex-nav-label.show{opacity:1}@media(max-width:640px){.nav-center{display:none}}
.eyebrow{font-size:12.5px;color:var(--accent);font-weight:700;letter-spacing:.01em}
h1{font-size:clamp(38px,5vw,58px);line-height:1.04;letter-spacing:-.03em;margin:14px 0 20px;max-width:640px}
.lead{font-size:17px;line-height:1.6;color:var(--muted);max-width:520px}
.hero-stats{display:flex;gap:26px;margin-top:26px}
.hero-stat b{display:block;font-size:22px;letter-spacing:-.02em}
.hero-stat span{font-size:12px;color:var(--faint)}

.hero-edge-nav{display:flex;align-items:center;gap:8px;list-style:none;margin:0;padding:0}
.edge-item{position:relative;display:flex;align-items:center;justify-content:center;width:36px;height:36px;background:none;border:0;padding:0;transition:transform .25s cubic-bezier(.34,1.56,.64,1)}
.edge-item svg{width:17px;height:17px;stroke:var(--muted);flex-shrink:0;transition:stroke .2s}
.edge-item:hover,.edge-item.open{background:none;transform:translateY(-2px)}
.edge-item:hover svg,.edge-item.open svg{stroke:var(--ink)}
.edge-tip{position:absolute;left:50%;top:calc(100% + 11px);transform:translateX(-50%) translateY(-6px);white-space:nowrap;background:var(--ink);color:#fff;font-size:12px;font-weight:650;padding:7px 12px;border-radius:9px;box-shadow:0 10px 24px rgba(17,21,19,.18);opacity:0;pointer-events:none;transition:opacity .22s cubic-bezier(.22,1,.36,1),transform .22s cubic-bezier(.22,1,.36,1);z-index:30}
.edge-tip::after{content:"";position:absolute;left:50%;bottom:100%;transform:translateX(-50%) rotate(45deg);width:8px;height:8px;background:var(--ink)}
.edge-item:hover .edge-tip,.edge-item.open .edge-tip{opacity:1;transform:translateX(-50%) translateY(0)}

.edge-modal-head{display:flex;align-items:center;gap:14px;margin-bottom:2px}
.edge-modal-icon{flex-shrink:0;width:44px;height:44px;border-radius:13px;background:var(--soft);display:grid;place-items:center;color:var(--ink)}
.edge-modal-icon svg{width:22px;height:22px}
.edge-modal-tagline{font-size:19px;font-weight:700;letter-spacing:-.02em;line-height:1.3;margin:14px 0 10px}
.edge-features{display:flex;flex-direction:column;margin-top:4px}
.edge-feature{display:flex;gap:12px;padding:14px 0;border-top:1px solid var(--line)}
.edge-feature:first-child{border-top:0}
.edge-feature-num{font-family:var(--mono);font-size:11px;color:var(--faint);flex-shrink:0;margin-top:2px}
.edge-feature-body b{display:block;font-size:14px;margin-bottom:2px}
.edge-feature-body>span{font-size:12.5px;color:var(--muted);line-height:1.5}
.edge-feature-body ul{margin:8px 0 0;padding-left:16px;font-size:12px;color:var(--muted);line-height:1.7}
.edge-extra{margin-top:6px;border-top:1px solid var(--line);padding-top:16px}
.edge-extra-label{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--faint);font-weight:650;margin-bottom:8px}
.edge-flow-block{margin-top:20px;border-top:1px solid var(--line);padding-top:16px}
.edge-flow-block+.edge-flow-block{margin-top:14px;border-top:0;padding-top:0}
.edge-flow-label{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--faint);font-weight:650;margin-bottom:9px}
.edge-flow{display:flex;flex-wrap:wrap;align-items:center;gap:6px;font-size:12.5px;font-weight:650}
.edge-flow span:not(.edge-flow-arrow){background:var(--soft);border-radius:999px;padding:5px 11px}
.edge-flow-arrow{color:var(--faint);font-weight:400}
.edge-result{margin-top:18px;background:linear-gradient(155deg,#171b18,#2e3430);color:#f4f5f2;border-radius:16px;padding:18px 20px}
.edge-result-label{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#aeb7b1;margin-bottom:6px}
.edge-result-text{font-size:15.5px;font-weight:650;line-height:1.4}
.edge-modal-cta{margin-top:18px;width:100%;text-align:center}

.hero-card{background:linear-gradient(155deg,#171b18,#2e3430);color:#f4f5f2;border-radius:24px;padding:30px;min-height:280px;display:flex;flex-direction:column;gap:18px;border:1px solid rgba(255,255,255,.08);box-shadow:0 24px 60px rgba(17,21,19,.35)}
.hero-card .mini{display:flex;align-items:center;gap:7px;color:#8f978f;font-size:11px;font-weight:650;text-transform:uppercase;letter-spacing:.1em}
.hero-card strong{display:block;font-size:22px;line-height:1.32;letter-spacing:-.02em;font-weight:700;margin-top:2px}
.hero-card .flow{display:flex;flex-wrap:wrap;align-items:center;gap:5px;font-size:11.5px;color:#c9cec8;margin-top:4px}
.hero-card .flow span:not(.flow-arrow){background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.06);border-radius:999px;padding:6px 12px;font-weight:600;letter-spacing:.01em}
.hero-card .flow .flow-arrow{color:#5c655f;font-size:12px;padding:0 1px}
.sim-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.08);color:#f4f5f2;border-radius:11px;padding:12px 16px;font-size:13px;font-weight:650;letter-spacing:.01em;transition:background-color .2s,border-color .2s,transform .2s;width:100%}
.sim-btn:hover{background:rgba(255,255,255,.16);border-color:rgba(255,255,255,.34);transform:translateY(-1px)}
.sim-cta{display:inline-flex;align-items:center;gap:5px;margin-top:2px;color:#c9cec8;font-size:12.5px;font-weight:650;text-decoration:none;width:max-content;transition:color .2s,gap .2s}
.sim-cta:hover{color:#f4f5f2;gap:8px}
.sim-cta-arrow{display:inline-block;transition:transform .25s cubic-bezier(.34,1.56,.64,1)}
.sim-cta:hover .sim-cta-arrow{transform:translateX(4px)}
.hero-sub{margin:0;font-size:12.5px;color:#8f978f;line-height:1.55}
.wf-panel{margin-top:16px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:14px}
.wf-panel-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.wf-panel-title{font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:#aeb7b1;font-weight:650}
.wf-badge{font-size:10px;letter-spacing:.06em;text-transform:uppercase;background:rgba(255,255,255,.12);color:#f4f5f2;padding:3px 8px;border-radius:999px;font-weight:650}
.wf-stage{display:flex;gap:10px;align-items:flex-start;width:100%;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.03);border-radius:12px;padding:11px 12px;text-align:left;transition:opacity .35s cubic-bezier(.22,1,.36,1),border-color .35s cubic-bezier(.22,1,.36,1),background-color .35s cubic-bezier(.22,1,.36,1);opacity:.55;color:inherit}
.wf-stage:hover{opacity:.8;border-color:rgba(255,255,255,.18)}
.wf-stage.active{opacity:1;border-color:rgba(255,255,255,.4);background:rgba(255,255,255,.08)}
.wf-stage.done{opacity:1;border-color:rgba(255,255,255,.16)}
.wf-stage-num{flex-shrink:0;font-family:var(--mono);font-size:11px;color:#aeb7b1;margin-top:2px}
.wf-stage.active .wf-stage-num,.wf-stage.done .wf-stage-num{color:#f4f5f2}
.wf-stage-body{display:flex;flex-direction:column;gap:2px}
.wf-stage-body b{font-size:13px;color:#f4f5f2;font-weight:650}
.wf-stage-body>span:not(.wf-stage-data){font-size:11.5px;color:#aeb7b1;line-height:1.4}
.wf-stage-data{margin-top:4px;font-family:var(--mono);font-size:12.5px;color:#f4f5f2;min-height:16px;opacity:0;transform:translateY(4px);transition:opacity .45s cubic-bezier(.22,1,.36,1),transform .45s cubic-bezier(.22,1,.36,1)}
.wf-stage-data.show{opacity:1;transform:translateY(0)}
.wf-arrow{text-align:center;color:#565f5a;font-size:11px;padding:2px 0}
.wf-play{margin-top:14px;width:100%;text-align:center}
.wf-play:disabled{opacity:.5;cursor:not-allowed}
.wf-launch{margin-top:16px;width:100%;text-align:center}
.wf-overlay{position:fixed;inset:0;background:rgba(17,21,19,.6);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;z-index:999;padding:24px;opacity:0;visibility:hidden;transition:opacity .32s cubic-bezier(.22,1,.36,1),visibility 0s linear .32s}
.wf-overlay.open{opacity:1;visibility:visible;transition:opacity .32s cubic-bezier(.22,1,.36,1)}
.wf-modal{background:#171b18;color:#f4f5f2;border-radius:22px;max-width:460px;width:100%;max-height:88vh;overflow-y:auto;padding:26px;position:relative;box-shadow:0 30px 80px rgba(0,0,0,.5);transform:scale(.96) translateY(6px);transition:transform .38s cubic-bezier(.22,1,.36,1);scrollbar-width:none;-ms-overflow-style:none}
.wf-modal::-webkit-scrollbar{display:none}
.wf-overlay.open .wf-modal{transform:scale(1) translateY(0)}
.wf-modal-title{display:block;font-size:20px;font-weight:700;letter-spacing:-.02em;line-height:1.25;margin:10px 0 2px}
.wf-modal-close{position:absolute;top:16px;right:16px;width:30px;height:30px;border-radius:50%;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.06);color:#f4f5f2;font-size:14px;line-height:1;display:flex;align-items:center;justify-content:center}
.wf-modal-close:hover{background:rgba(255,255,255,.14)}
.progress-wrap{margin:18px 0 0}
.progress-top{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:7px}
.progress{height:5px;background:var(--soft);border-radius:999px;overflow:hidden}
.progress i{display:block;height:100%;background:var(--accent);width:20%;transition:.35s}

.experience{padding:26px 5% 88px;background:#a5a7a5}
.experience-grid{display:grid;grid-template-columns:250px 1fr;gap:20px}
.side{background:rgba(255,255,255,.55);backdrop-filter:blur(18px) saturate(180%);-webkit-backdrop-filter:blur(18px) saturate(180%);border:1px solid rgba(255,255,255,.6);border-radius:var(--radius);padding:20px;height:max-content;position:sticky;top:20px;box-shadow:0 12px 34px rgba(17,21,19,.08)}
.side h3{font-size:12.5px;margin:0 0 15px;color:var(--muted);font-weight:650}
.step{display:flex;gap:10px;align-items:center;padding:9px 0;color:var(--faint);font-size:13px}
.dot2{width:24px;height:24px;border:1px solid var(--line-strong);border-radius:50%;display:grid;place-items:center;font-size:11px;background:var(--surface);flex-shrink:0}
.step.active{color:var(--ink);font-weight:650}.step.active .dot2{background:var(--accent);color:#fff;border-color:var(--accent)}

.workspace{background:rgba(255,255,255,.55);backdrop-filter:blur(18px) saturate(180%);-webkit-backdrop-filter:blur(18px) saturate(180%);border:1px solid rgba(255,255,255,.6);border-radius:26px;min-height:600px;padding:clamp(22px,4vw,48px);display:flex;flex-direction:column;box-shadow:0 14px 40px rgba(17,21,19,.09)}
.workspace-head{display:flex;justify-content:space-between;gap:20px;align-items:center;flex-wrap:wrap}
.kicker{font-size:12px;color:var(--faint)}
.workspace h2{font-size:clamp(26px,3.2vw,38px);letter-spacing:-.03em;line-height:1.08;margin:11px 0 12px;max-width:600px}
.workspace p{color:var(--muted);line-height:1.55;max-width:600px;font-size:14.5px}

.options{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:26px 0}
.option{border:1px solid rgba(255,255,255,.6);background:rgba(255,255,255,.6);backdrop-filter:blur(16px) saturate(180%);-webkit-backdrop-filter:blur(16px) saturate(180%);border-radius:16px;overflow:hidden;box-shadow:0 10px 30px rgba(17,21,19,.08);transition:border-color .25s cubic-bezier(.22,1,.36,1),transform .3s cubic-bezier(.22,1,.36,1),box-shadow .3s cubic-bezier(.22,1,.36,1),background-color .25s}
.option:hover{border-color:var(--line-strong);transform:translateY(-3px);box-shadow:0 14px 32px rgba(17,21,19,.08)}
.option.open{transform:translateY(-3px);box-shadow:0 14px 32px rgba(17,21,19,.08)}
.option.selected{border-color:var(--accent);background:var(--accent-soft)}
.option-toggle{display:flex;align-items:center;gap:13px;width:100%;padding:18px;background:none;border:0;text-align:left;color:inherit}
.option-icon{flex-shrink:0;width:34px;height:34px;border-radius:10px;background:var(--soft);display:grid;place-items:center;color:var(--ink);transition:background-color .3s cubic-bezier(.22,1,.36,1),color .3s cubic-bezier(.22,1,.36,1),transform .3s cubic-bezier(.22,1,.36,1)}
.option-icon svg{width:18px;height:18px}
.option:hover .option-icon,.option.open .option-icon,.option.selected .option-icon{background:var(--ink);color:#fff;transform:scale(1.08) rotate(-4deg)}
.option-head{flex:1;display:flex;flex-direction:column;gap:2px}
.option-head b{font-size:14.5px}
.option-head span{font-size:12.5px;color:var(--muted);line-height:1.4;transition:color .25s}
.option:hover .option-head span,.option.open .option-head span{color:var(--ink)}
.option-chevron{flex-shrink:0;font-size:15px;color:var(--faint);transition:transform .3s cubic-bezier(.22,1,.36,1),color .25s}
.option:hover .option-chevron,.option.open .option-chevron{transform:rotate(90deg);color:var(--ink)}
.option-detail{max-height:0;overflow:hidden;transition:max-height .35s cubic-bezier(.22,1,.36,1)}
.option-detail p{margin:0;padding:0 18px 16px 65px;color:var(--muted);font-size:12.5px;line-height:1.5}

.actions{margin-top:auto;display:flex;justify-content:space-between;gap:10px;padding-top:28px;opacity:0;transform:translateY(8px);pointer-events:none;transition:opacity .35s cubic-bezier(.22,1,.36,1),transform .35s cubic-bezier(.22,1,.36,1)}
.actions.visible{opacity:1;transform:translateY(0);pointer-events:auto}
.btn{border:0;border-radius:12px;padding:12px 18px;font-weight:650;font-size:14px}
.btn-dark{background:var(--ink);color:#fff}.btn-light{background:var(--soft);color:var(--ink)}
.btn-dark:hover{background:#463832}
.btn:disabled{opacity:.35;cursor:not-allowed}
.input{width:100%;padding:15px;border:1px solid var(--line-strong);border-radius:13px;outline:none;margin-top:16px;background:var(--surface)}
.input:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}

.result-form{margin-top:20px;display:flex;flex-direction:column;gap:10px}
.result-field label{display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:#aeb7b1;margin-bottom:5px}
.result-field input{width:100%;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);color:#f4f5f2;border-radius:9px;padding:10px 12px;font-size:13.5px;outline:none;transition:border-color .2s}
.result-field input:focus{border-color:rgba(255,255,255,.4)}
.result-field.invalid input{border-color:#c1554f}
.result-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.action-buttons{display:flex;gap:18px;flex-wrap:wrap;align-items:center;margin-top:18px}
.btn-secondary{background:transparent;color:#aeb7b1;border:0;padding:9px 0;font-size:13px;font-weight:600;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.28)}
.btn-secondary:hover{color:#f4f5f2;border-color:#f4f5f2}
.result-back-btn{display:inline-block;margin-top:18px}
.result-form-label{font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:#aeb7b1;font-weight:650;margin-top:20px;display:block}

.result{margin-top:22px;background:linear-gradient(155deg,#171b18,#2e3430);color:#f4f5f2;border-radius:20px;padding:24px}
.result small{color:#aeb7b1;text-transform:uppercase;letter-spacing:.08em;font-size:11px}
.result .headline{font-size:24px;font-weight:700;letter-spacing:-.02em;margin:9px 0 8px;line-height:1.3}
.result .body{color:#aeb7b1;font-size:13.5px;line-height:1.6}
.result-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}
.metric{background:rgba(255,255,255,.07);border-radius:13px;padding:14px;transition:transform .25s cubic-bezier(.22,1,.36,1),background-color .25s cubic-bezier(.22,1,.36,1);cursor:default}.metric:hover{transform:scale(1.05);background:rgba(255,255,255,.13)}.metric small{display:block;margin-bottom:5px;color:#aeb7b1}.metric b{font-size:14px}

.result-step4{background:linear-gradient(155deg,#171b18,#2e3430)}

.section{padding:70px 5%}
.section h2{font-size:clamp(28px,3.6vw,44px);letter-spacing:-.03em;line-height:1.06;margin:8px 0 14px}
.section-intro{color:var(--muted);max-width:600px;line-height:1.6;font-size:15px}

.patterns{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:28px}
.pattern{background:rgba(255,255,255,.6);backdrop-filter:blur(16px) saturate(180%);-webkit-backdrop-filter:blur(16px) saturate(180%);border:1px solid rgba(255,255,255,.6);border-radius:18px;overflow:hidden;box-shadow:0 10px 30px rgba(17,21,19,.08);transition:border-color .25s cubic-bezier(.22,1,.36,1),transform .3s cubic-bezier(.22,1,.36,1),box-shadow .3s cubic-bezier(.22,1,.36,1)}
.pattern:hover{border-color:var(--line-strong);transform:translateY(-3px);box-shadow:0 14px 32px rgba(17,21,19,.08)}
.pattern.open{border-color:var(--accent);transform:translateY(-3px);box-shadow:0 14px 32px rgba(17,21,19,.1)}
.pattern-toggle{display:flex;align-items:center;gap:13px;width:100%;padding:20px 22px;background:none;border:0;text-align:left;color:inherit;cursor:default}
