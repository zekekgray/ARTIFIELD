function validateArtilinePitchForm(){
  const nameEl = document.getElementById("apName");
  const emailEl = document.getElementById("apEmail");
  const companyEl = document.getElementById("apCompany");
  const checks = [
    { wrap: document.getElementById("apFieldName"), valid: nameEl.value.trim().length > 1 },
    { wrap: document.getElementById("apFieldEmail"), valid: /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailEl.value.trim()) },
    { wrap: document.getElementById("apFieldCompany"), valid: companyEl.value.trim().length > 1 }
  ];
  let ok = true;
  checks.forEach(c => {
    c.wrap.classList.toggle("invalid", !c.valid);
    if(!c.valid) ok = false;
  });
  return ok;
}

function submitArtilinePitch(btnEl){
  if(!validateArtilinePitchForm()){
    toast("Please fill in your name, email, and business name", true);
    return;
  }
  const payload = {
    source: "ARTILINE Pitch",
    name: document.getElementById("apName").value.trim(),
    email: document.getElementById("apEmail").value.trim(),
    company: document.getElementById("apCompany").value.trim(),
    phone: document.getElementById("apPhone").value.trim(),
    ts: new Date().toISOString()
  };
  const originalLabel = btnEl.textContent;
  btnEl.disabled = true;
  btnEl.innerHTML = '<span class="btn-spinner"></span>Sending…';

  function showSuccess(){
    document.getElementById("artilineLeadForm").style.display = "none";
    btnEl.style.display = "none";
    document.getElementById("artilinePitchResult").innerHTML =
      '<div class="edge-result" style="margin-top:4px"><div class="edge-result-label">REQUEST SENT</div>' +
      '<div class="edge-result-text">Thanks, ' + payload.name.split(" ")[0] + ' — we got it. Someone from ArtiByte will reach out to talk about building ARTILINE for ' + payload.company + '.</div></div>';
  }

  if(config.webhookUrl){
    fetch(config.webhookUrl, {
      method: "POST", mode: "no-cors",
      headers: {"Content-Type": "text/plain;charset=utf-8"},
      body: JSON.stringify(payload)
    }).then(() => {
      toast("✓ Sent");
      showSuccess();
    }).catch(() => {
      toast("Could not send — try again", true);
      btnEl.disabled = false;
      btnEl.textContent = originalLabel;
    });
  } else {
    console.log("ARTILINE pitch lead (local test mode):", payload);
    toast("Local test — captured lead");
    showSuccess();
  }
}

