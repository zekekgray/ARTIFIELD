const wfStages = [1, 2, 3, 4].map(n => ({
  el: document.getElementById("wfStage" + n),
  data: document.getElementById("wfData" + n),
  value: wfDataText[n]
}));

function resetWorkflow(fromIndex){
  wfStages.forEach((s, i) => {
    if(i >= fromIndex){
      s.el.classList.remove("active", "done");
      s.data.classList.remove("show");
      s.data.textContent = "—";
    }
  });
}

function playWorkflow(fromIndex){
  const playBtn = document.getElementById("wfPlay");
  playBtn.disabled = true;
  resetWorkflow(fromIndex);

  let i = fromIndex;
  function step(){
    if(i > 0) wfStages[i - 1].el.classList.replace("active", "done");
    if(i >= wfStages.length){ playBtn.disabled = false; return; }
    const s = wfStages[i];
    s.el.classList.add("active");
    if(i === 0){
      setTimeout(() => s.el.scrollIntoView({ behavior: "smooth", block: "start" }), 260);
    }
    setTimeout(() => {
      s.data.textContent = s.value;
      requestAnimationFrame(() => s.data.classList.add("show"));
    }, 220);
    i++;
    setTimeout(step, 750);
  }
  step();
}

const wfOverlay = document.getElementById("wfOverlay");

function openWorkflowModal(){
  wfOverlay.classList.add("open");
  document.body.style.overflow = "hidden";
  playWorkflow(0);
}

function closeWorkflowModal(){
  wfOverlay.classList.remove("open");
  document.body.style.overflow = "";
  resetWorkflow(0);
}

