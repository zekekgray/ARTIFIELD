}

const AD_HEADINGS = [
  "Your website shouldn't just be seen.",
  "Six stages. One guided experience.",
  "Rules decide. AI explains.",
  "A note from the founder.",
  "Let's build yours."
];
const AD_TOTAL = AD_HEADINGS.length;
let adCurrent = 0;
let adBuilt = [false,false,false,false,false];
let adOpen = false;

function adBuildChars(el, text){
  el.classList.remove("shown");
  el.innerHTML = "";
  let i = 0;
  text.split(" ").forEach((word, wi, arr) => {
    const wordWrap = document.createElement("span");
    wordWrap.style.display = "inline-block";
    word.split("").forEach(ch => {
      const s = document.createElement("span");
      s.className = "adc";
      s.style.transitionDelay = (i*18) + "ms";
      s.textContent = ch;
      wordWrap.appendChild(s);
      i++;
    });
    el.appendChild(wordWrap);
    if(wi < arr.length - 1){
      const space = document.createElement("span");
      space.className = "adc";
      space.style.transitionDelay = (i*18) + "ms";
      space.textContent = "\u00A0";
      el.appendChild(space);
      i++;
    }
  });
  void el.offsetWidth;
  requestAnimationFrame(() => el.classList.add("shown"));
}

let adHintTimer = null;
function adShowHint(){
  clearTimeout(adHintTimer);
  const hint = document.getElementById("adHint");
  if(!hint) return;
  hint.classList.remove("show");
  void hint.offsetWidth;
  setTimeout(() => hint.classList.add("show"), 500);
  adHintTimer = setTimeout(() => hint.classList.remove("show"), 3200);
}

function adGoTo(i, opts){
  opts = opts || {};
  i = Math.max(0, Math.min(AD_TOTAL - 1, i));
  const changed = i !== adCurrent;
  adCurrent = i;
  const track = document.getElementById("adTrack");
  const h = document.getElementById("adStage").clientHeight;
  track.style.transform = "translateY(-" + (i*h) + "px)";
  document.getElementById("adTopFill").style.width = (((i+1)/AD_TOTAL)*100) + "%";
  document.querySelectorAll("#adTrack .ad-slide").forEach((s,idx) => s.classList.toggle("ad-active", idx === i));
  document.querySelectorAll("#adDots .ad-dot").forEach((d,idx) => d.classList.toggle("active", idx === i));
  if(!adBuilt[i]){
    adBuilt[i] = true;
    adBuildChars(document.getElementById("adH" + i), AD_HEADINGS[i]);
  }
  document.getElementById("adNext").style.display = (i === AD_TOTAL - 1) ? "none" : "flex";
  if(!opts.silent) adHaptic(changed ? "medium" : "light");
  if(i < AD_TOTAL - 1) adShowHint();
  else clearTimeout(adHintTimer);
}
function adNext(){ adGoTo(adCurrent + 1); }
function adPrev(){ adGoTo(adCurrent - 1); }

function openArtilineDeck(){
  const overlay = document.getElementById("adOverlay");
  adBuilt = [false,false,false,false,false];
  adCurrent = 0;
  document.getElementById("adForm").style.display = "";
