# 2. PUBLIC ENTRY POINT

All frontend W16 requests should eventually enter through:

```javascript
/**
 * Main public W16 Gateway entry point.
 *
 * Frontend should call:
 *
 * w16Gateway({
 *   module: 'SCHEDULE',
 *   operation: 'READ',
 *   intent: 'GET_CURRENT_SCHEDULE',
 *   payload: {},
 *   clientId: '...',
 *   projectId: '...',
 *   locale: 'en',
 *   source: 'ARTIFIELD_UI'
 * });
 */
function w16Gateway(rawRequest) {

  const startedAt = new Date();

  let requestId = null;

  try {

    // --------------------------------------------------------
    // 1. RECEIVE
    // --------------------------------------------------------

    requestId = w16GenerateRequestId();

    // --------------------------------------------------------
    // 2. NORMALIZE
    // --------------------------------------------------------

    const request = w16NormalizeRequest(
      rawRequest,
      requestId
    );

    // --------------------------------------------------------
    // 3. BASIC VALIDATION
    // --------------------------------------------------------

    w16ValidateRequest(request);

    // --------------------------------------------------------
    // 4. ESTABLISH EXECUTION CONTEXT
    // --------------------------------------------------------

    const context = w16BuildExecutionContext(request);

    // --------------------------------------------------------
    // 5. AUTHORIZATION
    // --------------------------------------------------------

    w16AuthorizeRequest(request, context);

    // --------------------------------------------------------
    // 6. REQUEST LIMITS
    // --------------------------------------------------------

    w16EnforceRequestLimits(request, context);

    // --------------------------------------------------------
    // 7. ATTACH FINAL CONTEXT
    // --------------------------------------------------------

    request.execution = {
      gatewayVersion: W16_GATEWAY_VERSION,
      startedAt: startedAt.toISOString(),
      receivedAt: new Date().toISOString(),
      contextId: context.contextId
    };

    // --------------------------------------------------------
    // 8. ROUTE
    // --------------------------------------------------------

    return w16DispatchRequest(request, context);

  } catch (error) {

    return w16GatewayError(
      error,
      requestId,
      startedAt
    );
  }
}
```

