# 27. STANDARD ERROR OBJECT

```javascript
function w16CreateError(
  category,
  safeMessage,
  internalMessage,
  retryable
) {

  const error =
    new Error(internalMessage || safeMessage);

  error.w16 = {

    category:
      category || 'UNKNOWN_ERROR',

    safeMessage:
      safeMessage || 'An unexpected error occurred.',

    internalMessage:
      internalMessage || safeMessage,

    retryable:
      retryable === true,

    errorId:
      'ERR-' +
      Utilities.getUuid()
        .replace(/-/g, '')
        .substring(0, 16)
        .toUpperCase()

  };

  return error;
}
```

