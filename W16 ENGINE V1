# 20. REQUEST LIMIT ENGINE

```javascript
function w16EnforceRequestLimits(
  request,
  context
) {

  const limit =
    w16GetRequestLimit(request);

  if (!limit) {
    return true;
  }

  const allowed =
    w16CheckRateLimit(
      request,
      context,
      limit
    );

  if (!allowed) {

    throw w16CreateError(
      'RATE_LIMIT_ERROR',
      'Request limit reached. Please try again later.',
      'W16 rate limit exceeded.',
      true
    );
  }

  return true;
}
```

---

# 21. LIMIT CLASSIFICATION

```javascript
function w16GetRequestLimit(request) {

  const operation =
    request.operation;

  if (
    operation === 'EXTRACT' ||
    operation === 'IMPORT'
  ) {
    return W16_GATEWAY_CONFIG
      .RATE_LIMITS
      .IMPORT;
  }

  if (
    operation === 'ANALYZE' ||
    operation === 'FORECAST' ||
    operation === 'RECOMMEND' ||
    operation === 'CHAT'
  ) {
    return W16_GATEWAY_CONFIG
      .RATE_LIMITS
      .AI;
  }

  if (
    operation === 'EXPORT' ||
    operation === 'REPORT'
  ) {
    return W16_GATEWAY_CONFIG
      .RATE_LIMITS
      .EXPORT;
  }

  if (
    operation === 'ADMIN'
  ) {
    return W16_GATEWAY_CONFIG
      .RATE_LIMITS
      .ADMIN;
  }

  return W16_GATEWAY_CONFIG
    .RATE_LIMITS
    .DEFAULT;
}
```

