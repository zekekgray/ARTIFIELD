# 3. REQUEST ID GENERATOR

Every request gets a unique ID.

```javascript
function w16GenerateRequestId() {

  const timestamp = Date.now().toString(36).toUpperCase();

  const random = Utilities
    .getUuid()
    .replace(/-/g, '')
    .substring(0, 12)
    .toUpperCase();

  return [
    W16_GATEWAY_CONFIG.REQUEST_ID_PREFIX,
    timestamp,
    random
  ].join('-');
}
```

Example:

```text
W16-MF8A91K2-7D2C91A0B3F4
```








# 4. CORRELATION ID

A correlation ID allows multiple related operations to be traced together.

```javascript
function w16NormalizeCorrelationId(value) {

  if (!value) {
    return Utilities.getUuid();
  }

  const id = String(value).trim();

  if (!/^[A-Za-z0-9._:-]{1,128}$/.test(id)) {
    return Utilities.getUuid();
  }

  return id;
}
```










---

# 5. REQUEST NORMALIZATION

The Gateway converts raw input into the canonical W16Request structure.

```javascript
function w16NormalizeRequest(rawRequest, requestId) {

  if (!rawRequest || typeof rawRequest !== 'object') {

    throw w16CreateError(
      'VALIDATION_ERROR',
      'Malformed request.',
      'Request must be an object.',
      false
    );
  }

  const now = new Date();

  const request = {

    requestId: requestId,

    correlationId: w16NormalizeCorrelationId(
      rawRequest.correlationId
    ),

    timestamp: now.toISOString(),

    actor: w16NormalizeActor(
      rawRequest.actor
    ),

    clientId: w16NormalizeIdentifier(
      rawRequest.clientId,
      'clientId'
    ),

    projectId: w16NormalizeIdentifier(
      rawRequest.projectId,
      'projectId'
    ),

    module: w16NormalizeEnum(
      rawRequest.module,
      'module'
    ),

    operation: w16NormalizeEnum(
      rawRequest.operation,
      'operation'
    ),

    intent: w16NormalizeIntent(
      rawRequest.intent
    ),

    payload: w16NormalizePayload(
      rawRequest.payload
    ),

    dataVersion: w16NormalizeDataVersion(
      rawRequest.dataVersion
    ),

    locale: w16NormalizeLocale(
      rawRequest.locale
    ),

    source: w16NormalizeSource(
      rawRequest.source
    ),

    metadata: w16NormalizeMetadata(
      rawRequest.metadata
    )

  };

  return request;
}
```

---

# 6. IDENTIFIER NORMALIZATION

Client/project IDs must be normalized and size-limited.

```javascript
function w16NormalizeIdentifier(value, fieldName) {

  if (value === undefined || value === null) {
    return null;
  }

  const valueString = String(value).trim();

  if (!valueString) {
    return null;
  }

  if (valueString.length > 256) {

    throw w16CreateError(
      'VALIDATION_ERROR',
      'Invalid ' + fieldName + '.',
      fieldName + ' exceeds maximum length.',
      false
    );
  }

  return valueString;
}
```

---

# 7. ENUM NORMALIZATION

```javascript
function w16NormalizeEnum(value, fieldName) {

  if (value === undefined || value === null) {
    return null;
  }

  return String(value)
    .trim()
    .toUpperCase()
    .replace(/[^A-Z0-9_.:-]/g, '');
}
```

---

# 8. INTENT NORMALIZATION

Intent can remain human-readable but must be bounded.

```javascript
function w16NormalizeIntent(value) {

  if (
    value === undefined ||
    value === null
  ) {
    return null;
  }

  const intent = String(value).trim();

  if (
    intent.length === 0 ||
    intent.length > 500
  ) {

    throw w16CreateError(
      'VALIDATION_ERROR',
      'Invalid request intent.',
      'Intent length is outside the allowed range.',
      false
    );
  }

  return intent;
}
```

---

# 9. PAYLOAD NORMALIZATION

Payload is treated as untrusted data.

```javascript
function w16NormalizePayload(payload) {

  if (
    payload === undefined ||
    payload === null
  ) {
    return {};
  }

  if (
    typeof payload !== 'object' ||
    Array.isArray(payload)
  ) {

    throw w16CreateError(
      'VALIDATION_ERROR',
      'Invalid payload.',
      'Payload must be an object.',
      false
    );
  }

  const serialized = JSON.stringify(payload);

  const byteLength = Utilities
    .newBlob(serialized)
    .getBytes()
    .length;

  if (
    byteLength >
    W16_GATEWAY_CONFIG.MAX_PAYLOAD_BYTES
  ) {

    throw w16CreateError(
      'VALIDATION_ERROR',
      'Payload is too large.',
      'Payload exceeds Gateway size limit.',
      false
    );
  }

  return payload;
}
```

---

# 10. DATA VERSION NORMALIZATION

```javascript
function w16NormalizeDataVersion(value) {

  if (
    value === undefined ||
    value === null ||
    value === ''
  ) {
    return null;
  }

  const version = String(value).trim();

  if (!/^[A-Za-z0-9._:-]{1,128}$/.test(version)) {

    throw w16CreateError(
      'VALIDATION_ERROR',
      'Invalid data version.',
      'Data version format is invalid.',
      false
    );
  }

  return version;
}
```

---

# 11. LOCALE NORMALIZATION

```javascript
function w16NormalizeLocale(value) {

  if (!value) {
    return W16_GATEWAY_CONFIG.DEFAULT_LOCALE;
  }

  const locale = String(value)
    .trim()
    .replace('_', '-');

  if (!/^[A-Za-z]{2,3}(-[A-Za-z]{2,4})?$/.test(locale)) {
    return W16_GATEWAY_CONFIG.DEFAULT_LOCALE;
  }

  return locale;
}
```

---

# 12. SOURCE NORMALIZATION

```javascript
function w16NormalizeSource(value) {

  if (!value) {
    return 'ARTIFIELD_UI';
  }

  const source = String(value)
    .trim()
    .toUpperCase();

  if (
    W16_GATEWAY_CONFIG.ALLOWED_SOURCES
      .indexOf(source) === -1
  ) {

    throw w16CreateError(
      'VALIDATION_ERROR',
      'Invalid request source.',
      'Source is not recognized.',
      false
    );
  }

  return source;
}
```

---

# 13. ACTOR NORMALIZATION

The actor must never be treated as proof of identity.

```javascript
function w16NormalizeActor(actor) {

  if (
    !actor ||
    typeof actor !== 'object'
  ) {
    return {
      type: 'UNKNOWN',
      id: null
    };
  }

  return {

    type: actor.type
      ? String(actor.type).trim().toUpperCase()
      : 'USER',

    id: actor.id
      ? String(actor.id).trim()
      : null

  };
}
```

Important:

```text
actor.id supplied by frontend
≠
authenticated identity
```

The authoritative identity should eventually come from the server/session/authentication layer.

---

# 14. METADATA NORMALIZATION

```javascript
function w16NormalizeMetadata(metadata) {

  if (
    metadata === undefined ||
    metadata === null
  ) {
    return {};
  }

  if (
    typeof metadata !== 'object' ||
    Array.isArray(metadata)
  ) {

    throw w16CreateError(
      'VALIDATION_ERROR',
      'Invalid metadata.',
      'Metadata must be an object.',
      false
    );
  }

  const keys = Object.keys(metadata);

  if (
    keys.length >
    W16_GATEWAY_CONFIG.MAX_METADATA_KEYS
  ) {

    throw w16CreateError(
      'VALIDATION_ERROR',
      'Too much metadata.',
      'Metadata contains too many keys.',
      false
    );
  }

  const result = {};

  keys.forEach(function(key) {

    const safeKey = String(key)
      .substring(0, 100);

    let value = metadata[key];

    if (
      typeof value === 'string' &&
      value.length >
      W16_GATEWAY_CONFIG.MAX_STRING_LENGTH
    ) {
      value = value.substring(
        0,
        W16_GATEWAY_CONFIG.MAX_STRING_LENGTH
      );
    }

    result[safeKey] = value;

  });

  return result;
}
```

