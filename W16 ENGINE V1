# 28. SAFE GATEWAY ERROR

Never expose raw internal errors.

```javascript
function w16GatewayError(
  error,
  requestId,
  startedAt
) {

  const w16Error =
    error && error.w16
      ? error.w16
      : null;

  const category =
    w16Error
      ? w16Error.category
      : 'SYSTEM_ERROR';

  const safeMessage =
    w16Error
      ? w16Error.safeMessage
      : 'W16 could not complete the request.';

  const retryable =
    w16Error
      ? w16Error.retryable === true
      : false;

  /*
   * IMPORTANT:
   *
   * Internal error logging should eventually be
   * handled by W16_Audit / W16_Observability.
   */

  console.error(
    JSON.stringify({

      requestId: requestId,

      category: category,

      internalError:
        error &&
        error.stack
          ? error.stack
          : String(error),

      timestamp:
        new Date().toISOString()

    })
  );

  return {

    success: false,

    requestId:
      requestId || null,

    correlationId: null,

    status: 'FAILED',

    error: {

      errorId:
        w16Error
          ? w16Error.errorId
          : null,

      category: category,

      message: safeMessage,

      retryable: retryable

    },

    data: null,

    warnings: [],

    errors: [
      safeMessage
    ],

    w16Version:
      W16_GATEWAY_VERSION,

    timestamp:
      new Date().toISOString(),

    durationMs:
      startedAt
        ? Date.now() -
          startedAt.getTime()
        : null

  };
}
```

