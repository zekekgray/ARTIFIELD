# 26. STANDARD RESPONSE

```javascript
function w16CreateResponse(options) {

  return {

    success:
      options.success === true,

    requestId:
      options.requestId || null,

    correlationId:
      options.correlationId || null,

    module:
      options.module || null,

    operation:
      options.operation || null,

    status:
      options.status || (
        options.success
          ? 'SUCCESS'
          : 'FAILED'
      ),

    data:
      options.data === undefined
        ? null
        : options.data,

    warnings:
      Array.isArray(options.warnings)
        ? options.warnings
        : [],

    errors:
      Array.isArray(options.errors)
        ? options.errors
        : [],

    w16Version:
      W16_GATEWAY_VERSION,

    timestamp:
      new Date().toISOString()

  };
}
```

