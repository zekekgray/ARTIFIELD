# 23. REQUEST DISPATCHER

The Gateway should not contain every business function.

It routes to registered modules.

```javascript
function w16DispatchRequest(
  request,
  context
) {

  const module =
    String(request.module)
      .trim()
      .toUpperCase();

  switch (module) {

    case 'VEX':
      return w16DispatchVex(
        request,
        context
      );

    case 'ASSISTANT':
      return w16DispatchAssistant(
        request,
        context
      );

    case 'SCHEDULE':
      return w16DispatchSchedule(
        request,
        context
      );

    case 'COST':
      return w16DispatchCost(
        request,
        context
      );

    case 'MATERIALS':
      return w16DispatchMaterials(
        request,
        context
      );

    case 'REPORTS':
      return w16DispatchReports(
        request,
        context
      );

    case 'PROJECTS':
      return w16DispatchProjects(
        request,
        context
      );

    case 'SYSTEM':
      return w16DispatchSystem(
        request,
        context
      );

    default:

      throw w16CreateError(
        'VALIDATION_ERROR',
        'Unsupported W16 module.',
        'Module "' + module + '" is not registered.',
        false
      );
  }
}
```

