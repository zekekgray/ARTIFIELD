# 15. REQUEST VALIDATION

```javascript
function w16ValidateRequest(request) {

  if (!request.requestId) {
    throw w16CreateError(
      'VALIDATION_ERROR',
      'Request ID missing.',
      'Gateway could not establish request identity.',
      false
    );
  }

  if (!request.module) {

    throw w16CreateError(
      'VALIDATION_ERROR',
      'Module is required.',
      'Every W16 request must specify a module.',
      false
    );
  }

  if (!request.operation) {

    throw w16CreateError(
      'VALIDATION_ERROR',
      'Operation is required.',
      'Every W16 request must specify an operation.',
      false
    );
  }

  if (
    W16_GATEWAY_CONFIG.ALLOWED_OPERATIONS
      .indexOf(request.operation) === -1
  ) {

    throw w16CreateError(
      'VALIDATION_ERROR',
      'Unsupported operation.',
      'Operation is not registered with W16.',
      false
    );
  }

  if (
    !request.clientId &&
    request.source !== 'SYSTEM'
  ) {

    throw w16CreateError(
      'AUTH_ERROR',
      'Client context is required.',
      'Client context could not be established.',
      false
    );
  }

  return true;
}
```

