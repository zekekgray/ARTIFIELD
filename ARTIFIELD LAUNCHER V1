/**
 * Called by the frontend via google.script.run.getVersionInfo().
 *
 * Reads from Script Properties:
 *   LATEST_VERSION
 *   LATEST_VERSION_URL
 *
 *   VERSION_1_NAME / VERSION_1_URL / VERSION_1_STATUS
 *   VERSION_2_NAME / VERSION_2_URL / VERSION_2_STATUS
 *   ... (numbered sequentially, stops at first gap)
 *
 * Returns:
 *   {
 *     latestVersion: string,
 *     latestUrl: string,
 *     versions: [{ name: string, url: string, status: string }]
 *   }
 *
 * Throws an Error if LATEST_VERSION or LATEST_VERSION_URL is missing,
 * which the frontend's withFailureHandler() will catch.
 */
function getVersionInfo() {

  const props = PropertiesService.getScriptProperties();

  const latestVersion = props.getProperty('LATEST_VERSION');
  const latestUrl = props.getProperty('LATEST_VERSION_URL');

  if (!latestVersion || !latestUrl) {
    throw new Error(
      'Missing required Script Properties: LATEST_VERSION and/or LATEST_VERSION_URL.'
    );
  }

  const versions = [];
  let i = 1;

  while (true) {

    const name = props.getProperty('VERSION_' + i + '_NAME');
    const url = props.getProperty('VERSION_' + i + '_URL');

    if (!name || !url) {
      break;
    }

    const status = props.getProperty('VERSION_' + i + '_STATUS') || '';

    versions.push({
      name: name,
      url: url,
      status: status
    });

    i++;

  }

  return {
    latestVersion: latestVersion,
    latestUrl: latestUrl,
    versions: versions
  };

}







