<body>

  <div class="container">

    <div class="version-card">

      <div class="label">
        Latest Software Version
      </div>

      <div class="version" id="latestVersion">
        Loading...
      </div>

      <div class="error-text" id="errorText">
        Unable to load version info. Please refresh the page.
      </div>

      <a
        id="openButton"
        class="open-button"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        aria-disabled="true"
        onclick="return openButtonClick(event);">
        Open ARTIFIELD
      </a>

      <div
        class="versions-link"
        onclick="toggleVersions()">
        Check other versions
      </div>

      <div
        id="versions"
        class="versions">
      </div>

    </div>

    <div class="footer">
      ARTIFIELD • Software Access
    </div>

  </div>

  <script>

    /*
      Script Properties expected:

      LATEST_VERSION
      LATEST_VERSION_URL

      Optional:

      VERSION_1_NAME
      VERSION_1_URL
      VERSION_1_STATUS

      VERSION_2_NAME
      VERSION_2_URL
      VERSION_2_STATUS

      etc.
    */

    window.addEventListener("DOMContentLoaded", function() {

      google.script.run
        .withSuccessHandler(renderVersions)
        .withFailureHandler(handleLoadError)
        .getVersionInfo();

    });


    function renderVersions(data) {

      document.getElementById("latestVersion").textContent =
        data.latestVersion;

      const openButton =
        document.getElementById("openButton");

      openButton.href = data.latestUrl;
      openButton.removeAttribute("aria-disabled");

      const container =
        document.getElementById("versions");

      container.innerHTML = "";

      if (!data.versions || data.versions.length === 0) {
        return;
      }

      data.versions.forEach(function(version) {

        const item =
          document.createElement("div");

        item.className = "version-item";

        item.innerHTML = `
          <span>${version.name}</span>
          <a
            href="${version.url}"
            target="_blank"
            rel="noopener noreferrer">
            Open
          </a>
        `;

        container.appendChild(item);

      });

    }


    function handleLoadError(error) {

      document.getElementById("latestVersion").textContent =
        "Unavailable";

      document.getElementById("errorText").style.display =
        "block";

      console.error("getVersionInfo failed:", error);

    }


    function openButtonClick(event) {

      const openButton =
        document.getElementById("openButton");

      if (openButton.getAttribute("aria-disabled") === "true") {
        event.preventDefault();
        return false;
      }

      return true;

    }


    function toggleVersions() {

      const element =
        document.getElementById("versions");

      if (element.style.display === "block") {

        element.style.display = "none";

      } else {

        element.style.display = "block";

      }

    }

  </script>

</body>
