   — pagsasama-sama lang ng existing totoong numero sa bagong layout. */
function computeCostControlData(){
  const buildings = buildingList();
  const totals = buildings.reduce((acc,b)=>{
    const s = costSummaryForBuilding(b);
    acc.budget += s.budget||0; acc.actual += s.actual||0; acc.committed += s.committed||0;
    acc.eac += s.eac||0; acc.ev += s.ev||0;
    return acc;
  }, {budget:0, actual:0, committed:0, eac:0, ev:0});
  const cpi = totals.actual>0 ? totals.ev/totals.actual : null;
  const vac = totals.budget - totals.eac;
  const remaining = totals.budget - totals.actual - totals.committed;

  const byCategory = {};
  state.costEntries.filter(e=>e.type!=='budget').forEach(e=>{
    const cat = e.category || 'Uncategorized';
    byCategory[cat] = (byCategory[cat]||0) + (Number(e.amount)||0);
  });
  const categoryRows = Object.entries(byCategory).sort((a,b)=>b[1]-a[1]);

  const warnings = computeCostWarnings();
  return {buildings, totals, cpi, vac, remaining, categoryRows, warnings};
}

