  <div class="chart-card" style="padding:0;overflow:auto;max-height:68vh;">
    <table class="data"><thead><tr>
      <th>P6 ID</th><th>Building</th><th>Trade</th><th>Category</th><th>Task</th><th>Floor</th>
      <th>Planned Start</th><th>Planned Finish</th><th>Revised Finish</th><th>WT%</th><th>Actual %</th><th>Confidence</th><th>Status</th><th></th>
