/* === ANALYTICS — INTELLIGENCE & TRENDS MODAL: START ===
   Sagot sa "Ano ang trend, variance, at pattern ng project?" — hindi
   basta dashboard ulit. Ginagamit ang existing computeSpiDrivers() (parehong
   engine ng SPI Explainer) para sa top negative variances, totoong
   state.snapshots history para sa progress trend (walang gawa-gawang
   multi-period na cost trend dahil isang beses lang kinukuha ang cost
   snapshot sa app na ito — status na lang ang isinasabi para sa cost,
   hindi "declining N periods" na walang historical basis). */
function computeProgressTrend(){
  // Kunin ang huling ilang snapshot, kunin ang weighted actual % sa bawat
  // isa, tapos tignan kung tumataas o bumababa ang bilis ng progress
  // (velocity) sa pagitan ng mga snapshot — totoong pattern mula sa data,
  // hindi estimate.
  if(state.snapshots.length<3) return null;
  const recent = state.snapshots.slice(-4);
  const values = recent.map(s=>weightedPctFromSnapshot(state.tasks, s));
  const velocities = [];
  for(let i=1;i<values.length;i++){
    if(values[i]==null || values[i-1]==null) continue;
    velocities.push(values[i]-values[i-1]);
  }
  if(velocities.length<2) return null;
  const declining = velocities.every((v,i)=> i===0 || v <= velocities[i-1]+0.01);
  const improving = velocities.every((v,i)=> i===0 || v >= velocities[i-1]-0.01);
  return { velocities, declining, improving, lastVelocity: velocities[velocities.length-1] };
}

function computeAnalyticsData(){
  const {spi, pv, ev, bac} = computeSPI(state.tasks);
  const buildings = buildingList();
  const totals = buildings.reduce((acc,b)=>{
    const s = costSummaryForBuilding(b);
    acc.budget += s.budget||0; acc.actual += s.actual||0; acc.eac += s.eac||0;
    return acc;
  }, {budget:0, actual:0, eac:0});
  const overallCpi = totals.actual>0 ? (totals.budget*weightedActualPct(state.tasks)/100)/totals.actual : null;
  const vac = totals.budget - totals.eac;
  const drivers = computeSpiDrivers();
  const trend = computeProgressTrend();
  const materialWarnings = computeMaterialWarnings();
  return {spi, pv, ev, bac, totals, overallCpi, vac, drivers, trend, materialWarnings};
}

