function setTab(tab){
  /* === GANTT FULLSCREEN VIEW: leaving Gantt always exits fullscreen —
     kung hindi, mananatiling nakatago ang sidebar/topbar sa ibang tabs
     (hal. Clash & Sequence Log / Data Quality Issues) na walang sariling
     exit control, kaya parang "stuck/frozen" ang UI. === */
  if(state.ganttFullscreen && tab!=='gantt'){
    state.ganttFullscreen = false;
    document.body.classList.remove('gantt-fullscreen');
    const exitBtn = document.getElementById('ganttFsExitBtn');
    if(exitBtn) exitBtn.classList.add('hidden');
  }
  /* === GANTT FILTER/FOCUS AUTO-RESET: START ===
     Dating nananatili ang filters (Building/Trade/Level/etc.) at Focus mode
     (Current Week/Critical/Delayed) kahit lumipat ka ng tab — kaya pag
     bumalik ka sa Gantt, konti na lang ang makikita mo (naka-filter/focus
     pa rin pala) at parang "nagbago" o "may bug" — hindi mo namamalayang
     naka-set mo pa rin dati. I-reset tuwing PAPASOK papunta sa Gantt mula
     sa ibang tab, para laging malinis at kumpleto ang simula. */
  if(tab==='gantt' && state.tab!=='gantt'){
    state.ganttFilters = { building:'', trade:'', level:'', status:'', criticality:'', delay:'', dateStart:null, dateEnd:null };
    state.ganttFocus = { type:'', taskId:'' };
  }
  /* === GANTT FILTER/FOCUS AUTO-RESET: END === */
  state.tab = tab;
  closeGanttDrawer();
  buildNav();
  renderTopNavPills();
  document.querySelectorAll('nav.tabs button').forEach(b=>b.classList.toggle('active', b.dataset.tab===tab));
  document.getElementById('topTitle').textContent = tabTitle(tab);
  const evBtn = document.getElementById('btnExportCurrentView');
  if(evBtn) evBtn.title = t('export_scoped_to')+tabTitle(tab);
  render();
}

