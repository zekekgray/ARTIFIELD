window.openComparePointModal = openComparePointModal;

function renderComparePanel(){
  const mode = state.compare.mode;
  const options = compareOptionsList();
  const allIds = state.compare.selected;

  const chips = options.map(id=>{
    const isSel = allIds.includes(id);
    const color = isSel ? compareColorFor(id, allIds) : null;
    const label = mode==='trade' ? id : 'Building '+id;
    const styleAttr = color ? ` style="--chip-color:${color}"` : '';
    return `<button class="compare-chip ${isSel?'selected':''}"${styleAttr} onclick="toggleCompareSelection('${escOnclickArg(id)}')">
      <span class="swatch"></span>${esc(label)}
    </button>`;
  }).join('');

  const noDataIds = allIds.filter(id=>{
    const cnt = mode==='trade'
      ? state.tasks.filter(t=>t.trade===id && hasValidDates(t)).length
      : state.tasks.filter(t=>t.building===id && hasValidDates(t)).length;
    return cnt===0;
  });

  return `
  <div class="compare-panel">
    <h4>Compare buildings or trades</h4>
    <div class="sub">Overlay 2+ ${mode==='trade'?'trades':'buildings'} on one chart to directly compare pace</div>
    <div class="compare-controls">
      <div class="compare-row">
        <span class="compare-label">Compare by</span>
        <div class="compare-mode-toggle">
          <button class="${mode==='building'?'active':''}" onclick="setCompareMode('building')">Buildings</button>
          <button class="${mode==='trade'?'active':''}" onclick="setCompareMode('trade')">Trades</button>
        </div>
        <button class="compare-toolbtn" onclick="setCompareAll()">Select all</button>
        <button class="compare-toolbtn" onclick="clearCompareSelection()">Clear</button>
        <label class="compare-check" style="margin-left:auto;">
          <input type="checkbox" ${state.compare.showPlanned?'checked':''} onchange="toggleComparePlanned()"> Show planned baselines
        </label>
      </div>
      <div class="compare-row">${options.length ? chips : `<span class="help">No ${mode==='trade'?'trades':'buildings'} in the database yet.</span>`}</div>
      ${allIds.length>COMPARE_PALETTE.length ? `<div class="compare-warn">Beyond ${COMPARE_PALETTE.length} selections, colors start repeating — trim your selection for full legibility.</div>` : ''}
      ${noDataIds.length ? `<div class="compare-warn">${esc(noDataIds.join(', '))} — no dated tasks yet, won't appear on the chart.</div>` : ''}
    </div>
    <div id="compareChartMount"></div>
  </div>`;
}

function mountComparePanel(){
  const mount = document.getElementById('compareChartMount');
