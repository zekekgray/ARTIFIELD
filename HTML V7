async function restoreBackendVersion(analysisId, version){
  if(!confirm(`Restore version ${version}? This replaces your current in-progress data with this saved version. A new version will be saved on top once you make further changes.`)) return;
  try{
    const res = await gsRun('getAnalysisJsonById', analysisId);
    if(res && res.success){
      applyFullState(res.json_result);
      toast(`Restored version ${version}.`, 'ok');
      render();
    } else {
      toast('Could not find that version on the server.', 'err');
    }
  }catch(e){
    toast('Restore failed: '+e.message, 'err');
  }
}
