   linkedActivityId field (kung nailagay sa import) o fallback sa
   building-level na tasks kung walang specific link — walang gawa-gawang
   schedule-impact number, ang "potential impact" ay simpleng pagbabawas ng
   days-supply sa lead-time (parehong logic na ginagamit na ng atRisk flag). */
function computeMaterialsControlData(){
  const buildings = buildingList();
  const allMaterials = [];
  buildings.forEach(b=>{ materialsForBuilding(b).forEach(m=>allMaterials.push(m)); });
  const critical = allMaterials.filter(m=>m.severity==='High');
  const warning = allMaterials.filter(m=>m.severity==='Medium'||m.severity==='Low');
  const atRiskCount = allMaterials.filter(m=>m.atRisk).length;
  const shortageCount = allMaterials.filter(m=>m.daysSupply!=null && m.daysSupply<=0).length;
  return {total: allMaterials.length, atRiskCount, criticalCount: critical.length, shortageCount, critical, warning, allMaterials};
}

function materialAffectedActivities(m){
  if(m.linkedActivityId){
    const t = state.tasks.find(x=>x.p6ActivityId===m.linkedActivityId);
    if(t) return [t];
  }
  // Fallback: mga tasks sa parehong building na may pangalang tumutugma sa item name
  const itemWords = (m.item||'').toLowerCase().split(/\s+/).filter(w=>w.length>3);
  return state.tasks.filter(t=>t.building===m.building && itemWords.some(w=>t.name.toLowerCase().includes(w))).slice(0,5);
}

