/* === ISSUES — ISSUE/RISK CONTROL MODAL: START ===
   Sagot sa "Ano ang problema, gaano ito kaseryoso, at ano ang epekto?" —
   pinagsama ang tatlong totoong pinagmulan ng "problema": Vex-imported
   violations/NCR (state.violations), schedule sequence violations, at
   space/time clashes. Ang "Impact Chain" ay gumagamit ng totoong
   computeDownstreamTasks() engine (parehong function na nagpapakita ng
   "affected activities" sa Gantt task drawer) — hindi gawa-gawang chain. */
function computeIssuesControlData(){
  const violations = state.violations||[];
  const openViolations = violations.filter(v=>v.status==='open');
  const criticalViolations = openViolations.filter(v=>v.severity==='critical');
  const overdueViolations = openViolations.filter(v=>{
    if(!v.dateRaised) return false;
    return daysBetween(v.dateRaised, new Date().toISOString()) > 14; // walang due-date field sa schema, kaya 14 days na open ang proxy para sa "overdue"
  });
  const resolvedCount = violations.filter(v=>v.status==='closed').length;
  const seqV = computeSequenceViolations();
  const clashV = computeSpaceTimeClashes();
  const totalOpen = openViolations.length + seqV.length + clashV.length;
  const totalCritical = criticalViolations.length + seqV.filter(v=>v.severity==='High').length + clashV.filter(v=>v.severity==='High').length;
  return {violations, openViolations, criticalViolations, overdueViolations, resolvedCount, seqV, clashV, totalOpen, totalCritical};
}

