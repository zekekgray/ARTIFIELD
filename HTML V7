   Kinukuha mula sa totoong state: source files ng tasks/cost/materials,
   Vex processing status, at ang confidence tally (parehong function —
   tallyConfidence — na ginagamit din sa Extraction Review screen, kaya
   consistent ang numbers kahit saan pinanggalingan).
   =========================================================================== */
function computeDataProvenance(){
  const sourceFiles = new Set();
  state.tasks.forEach(t=>{ if(t.sourceFile) sourceFiles.add(t.sourceFile); });
  state.costEntries.forEach(e=>{ if(e.sourceFile) sourceFiles.add(e.sourceFile); });
  state.materialEntries.forEach(m=>{ if(m.sourceFile) sourceFiles.add(m.sourceFile); });
  const conf = tallyConfidence(state.tasks);
  const unresolvedIssues = state.tasks.filter(t=>t.dataIssues && t.dataIssues.length).length + (state.lockedImportConflicts||[]).length;
  return {
    asOf: state.asOfDate,
    sources: [...sourceFiles],
    processedBy: state.vexMeta.length ? 'Vex Document Standardization' : 'Manual / Direct Import',
    records: state.tasks.length,
    high: conf.high, medium: conf.medium, low: conf.low,
    unresolvedIssues,
  };
}
