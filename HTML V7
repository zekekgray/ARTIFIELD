/* === CHANGES — CHANGE CONTROL MODAL: START ===
   Sagot sa "Ano ang nagbago at ano ang epekto nito sa project?" — hindi
   duplicate ng Issues (Issues = problema, Changes = modification sa
   approved scope). Ginagamit ang totoong state.variationOrders at
   state.rfis mula sa Vex schema. Cost impact ay direktang mula sa
   amountDelta field — walang schedule-impact-in-days na kinakalkula dahil
   walang ganyang field sa VO schema; kung meron mang gustong idagdag na
   schedule-impact tracking sa VO, kailangan munang idagdag sa Vex prompt/
   schema bago ito maipakita rito nang totoo. */
function computeChangesControlData(){
  const vos = state.variationOrders||[];
  const rfis = state.rfis||[];
  const pending = vos.filter(v=>v.status==='under_review'||v.status==='submitted');
  const approved = vos.filter(v=>v.status==='approved'||v.status==='implemented'||v.status==='billed');
  const rejected = vos.filter(v=>v.status==='rejected');
  const openRfis = rfis.filter(r=>r.status==='open');
  const totalCostImpact = vos.reduce((s,v)=>s + (Number(v.amountDelta)||0), 0);
  const scheduleImpactingRfis = rfis.filter(r=>r.impactsScheduleOrCost===true);
  return {vos, rfis, pending, approved, rejected, openRfis, totalCostImpact, scheduleImpactingRfis};
}

