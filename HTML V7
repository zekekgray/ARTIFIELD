function tallyConfidence(items){
  const t = {high:0, medium:0, low:0};
  items.forEach(x=>{
    const c = (x && x.confidence) || 'medium';
    if(c==='high') t.high++; else if(c==='low') t.low++; else t.medium++;
  });
  return t;
}
function goToExtractionReview(summary){
  const session = recordExtractionSession(summary);
