/* === OVERVIEW — PROJECT CONTROL CENTER MODAL: START ===
   Sagot sa "Ano ang tunay na kalagayan ng project ngayon?" — hero health
   status, per-domain status dots, KPI cards, "Attention Required" list na
   direktang bumubukas sa kaukulang tab, at recent activity mula sa totoong
   extraction sessions / snapshots. Walang gawa-gawang numero — lahat mula
   sa existing engines (computeSPI, costSummaryForBuilding, computeCostWarnings,
   computeMaterialWarnings, computeSequenceViolations/computeSpaceTimeClashes). */
function computeOverviewHealth(){
  const {spi} = computeSPI(state.tasks);
  const overallActual = weightedActualPct(state.tasks);
  const overallPlanned = weightedPlannedPct(state.tasks, state.asOfDate);
  const seq = computeSequenceViolations(), clash = computeSpaceTimeClashes();
  const costWarnings = computeCostWarnings();
  const materialWarnings = computeMaterialWarnings();
  const buildings = buildingList();
  const totals = buildings.reduce((acc,b)=>{
    const s = costSummaryForBuilding(b);
    if(s.budget!=null) acc.budget += s.budget;
    if(s.actual!=null) acc.actual += s.actual;
    if(s.eac!=null) acc.eac += s.eac;
    return acc;
  }, {budget:0, actual:0, eac:0});
  const openIssues = seq.length + clash.length + (state.violations||[]).filter(v=>v.status==='open').length;
  const criticalIssues = (state.violations||[]).filter(v=>v.status==='open' && v.severity==='critical').length + costWarnings.length;

  const domainStatus = (bad, warn) => bad ? 'red' : warn ? 'amber' : 'green';
  const scheduleStatus = domainStatus(spi!=null && spi<0.85, spi!=null && spi<1);
  const costStatus = domainStatus(costWarnings.length>1, costWarnings.length>0);
  const materialsStatus = domainStatus(materialWarnings.some(m=>m.severity==='High'), materialWarnings.length>0);
  const issuesStatus = domainStatus(criticalIssues>0, openIssues>0);
  const changesStatus = domainStatus(false, (state.rfis||[]).filter(r=>r.status==='open').length>3);
  const dataQualityConf = tallyConfidence(state.tasks);
  const dataQualityStatus = domainStatus(dataQualityConf.low > dataQualityConf.high, dataQualityConf.low>0);

  const statuses = [scheduleStatus, costStatus, materialsStatus, issuesStatus, changesStatus, dataQualityStatus];
  const overallStatus = statuses.includes('red') ? 'CRITICAL' : statuses.includes('amber') ? 'AT RISK' : 'ON TRACK';
  const overallColor = overallStatus==='CRITICAL' ? 'var(--red)' : overallStatus==='AT RISK' ? 'var(--amber)' : 'var(--green)';

  return {
    spi, overallActual, overallPlanned, totals, openIssues, criticalIssues,
    scheduleStatus, costStatus, materialsStatus, issuesStatus, changesStatus, dataQualityStatus,
    overallStatus, overallColor, seq, clash, costWarnings, materialWarnings,
  };
}

function overviewAttentionItems(h){
  const items = [];
  if(h.criticalIssues>0){
    items.push({sev:'red', title:`${h.criticalIssues} Critical Issue(s)`, detail:`${h.costWarnings.length} budget overrun warning(s), ${(state.violations||[]).filter(v=>v.status==='open'&&v.severity==='critical').length} critical NCR(s)`, tab:'clashes'});
  }
  if(h.spi!=null && h.spi<1){
    const delayedCount = state.tasks.filter(t=>t.status==='Shifted' && t.shiftDays>0).length;
    items.push({sev: h.spi<0.85?'red':'amber', title:'Schedule Behind Plan', detail:`SPI ${h.spi.toFixed(2)} — ${delayedCount} activit${delayedCount===1?'y':'ies'} delayed`, tab:'gantt'});
  }
