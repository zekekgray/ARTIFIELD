/* ===========================================================================
   METRIC EXPLAINER — pinipilit ang parser na i-explain ang sarili.
   Sa halip na basta ipakita ang SPI formula/number, itinuturo nito kung ANO
   sa raw na na-extract na data ang pinagmulan ng number na iyon: aling
   building/trade ang pinaka-nag-aambag sa pagkalag, ilang task ang naantala,
   ilang sequence/clash conflict ang kasabay, at gaano ka-confident ang
   extraction ng datos na ginamit dito.
   =========================================================================== */
function computeSpiDrivers(){
  const now = state.asOfDate;
  const scoped = state.tasks.filter(hasValidDates).filter(t=>t.weightPct!=null);
  const groups = {};
  scoped.forEach(t=>{
    const key = t.building+'||'+t.trade;
    const [s,f] = activeRange(t);
    const dur = Math.max(1,(f-s)/DAY);
    const elapsed = clamp((now-s)/DAY, 0, dur);
    const timeFrac = elapsed/dur;
    const pv = t.weightPct*timeFrac;
    const ev = t.weightPct*((t.accToDatePct||0)/100);
    if(!groups[key]) groups[key] = {building:t.building, trade:t.trade, pv:0, ev:0};
    groups[key].pv += pv;
    groups[key].ev += ev;
  });
  const drivers = Object.values(groups)
    .map(g=>Object.assign(g,{gap: g.pv-g.ev}))
    .filter(g=>g.gap>0.05);
  drivers.sort((a,b)=>b.gap-a.gap);
  return drivers.slice(0,5);
}

