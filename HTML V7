   caller confirms persistence, then fades out on its own. Purely visual —
   never touches data/state. */
let _saveIndicatorTimers = {};
function showSaveIndicator(elId, phase){
  const el = document.getElementById(elId);
  if(!el) return;
  clearTimeout(_saveIndicatorTimers[elId]);
  el.classList.remove('saving','saved');
  const textEl = el.querySelector('.si-text');
  if(phase==='saving'){
    el.classList.add('show','saving');
    if(textEl) textEl.textContent = t('status_saving');
  } else if(phase==='saved'){
    el.classList.add('show','saved');
    if(textEl) textEl.textContent = t('status_saved');
    _saveIndicatorTimers[elId] = setTimeout(()=>{ el.classList.remove('show'); }, 1800);
  }
}
