function t(key){
  const lang = (typeof state!=='undefined' && state.uiLang) || 'en';
  const runtime = (window._i18nRuntime && window._i18nRuntime[lang]) || null;
  if(runtime && runtime[key]!=null) return runtime[key];
  return (I18N[lang] && I18N[lang][key]) || (I18N.en && I18N.en[key]) || key;
}

function applyI18n(root){
  const scope = root || document;
  scope.querySelectorAll('[data-i18n]').forEach(el=>{ el.textContent = t(el.getAttribute('data-i18n')); });
  scope.querySelectorAll('[data-i18n-placeholder]').forEach(el=>{ el.placeholder = t(el.getAttribute('data-i18n-placeholder')); });
  scope.querySelectorAll('[data-i18n-title]').forEach(el=>{ el.title = t(el.getAttribute('data-i18n-title')); });
}

/* === I18N BACKEND SYNC ======================================================
   The client-side I18N object is only a FALLBACK — used for the instant
   before a server round-trip finishes, or if the server call fails. The
   REAL dictionary lives in Code.gs (getUiTranslations) — that's the only
   place anyone needs to edit or add strings/languages going forward. Every
   call here just fills window._i18nRuntime[lang], which t() reads before
   falling back to the local bundle. No data, IDs, or logic pass through
   this — text only.
   =========================================================================== */
window._i18nRuntime = window._i18nRuntime || {};
function fetchLanguageFromBackend(lang, onDone){
  if(typeof google==='undefined' || !google.script || !google.script.run){
    if(onDone) onDone(false);
    return;
  }
  google.script.run
    .withSuccessHandler(res=>{
      if(res && res.strings){
        window._i18nRuntime[res.lang || lang] = res.strings;
        if(state.uiLang === (res.lang || lang)){
          applyI18n(document);
          if(document.getElementById('sidebar')){ buildNav(); renderSidebarProfile(); }
          if(document.getElementById('content') && document.getElementById('content').innerHTML.trim()){ render(); }
        }
      }
      if(onDone) onDone(true);
    })
    .withFailureHandler(()=>{ if(onDone) onDone(false); })
    .getUiTranslations(lang);
}

/** Rebuilds the language <select> options from Code.gs's
 * getSupportedLanguages() — adding a language server-side (e.g. French,
 * Arabic) shows up in the picker automatically, no HTML/JS redeploy. */
function loadSupportedLanguagesIntoSelectors(){
  if(typeof google==='undefined' || !google.script || !google.script.run) return;
  google.script.run
    .withSuccessHandler(list=>{
      if(!Array.isArray(list) || !list.length) return;
      document.querySelectorAll('#welcomeLangSelect, #sidebarLangSelect').forEach(sel=>{
        const current = sel.value;
        sel.innerHTML = list.map(l=>`<option value="${l.code}">${l.label}</option>`).join('');
        sel.value = list.some(l=>l.code===current) ? current : ((list[0] && list[0].code) || 'en');
      });
    })
    .withFailureHandler(()=>{})
    .getSupportedLanguages();
}

function setLanguage(lang){
  // Any language code is accepted here — the backend dictionary
  // (getUiTranslations) is authoritative and may support languages beyond
  // the client-side fallback bundle.
  state.uiLang = lang;
  saveUiLang();
  document.querySelectorAll('#welcomeLangSelect, #sidebarLangSelect').forEach(sel=>{ sel.value = lang; });
  // Paint instantly with whatever's cached/fallback so switching feels
  // immediate, then ask GS for the authoritative strings and re-render
  // once they arrive.
  applyI18n(document);
  if(document.getElementById('sidebar')){ buildNav(); renderSidebarProfile(); }
  if(document.getElementById('content') && document.getElementById('content').innerHTML.trim()){ render(); }
  fetchLanguageFromBackend(lang);
}
window.setLanguage = setLanguage;

