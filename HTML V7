/* === ARTIFIELD LICENSE PIN GATE: START ===
   Server-side verification via google.script.run → verifyArtifieldPin() sa
   Code.gs (PropertiesService, fail-closed). Ang PIN mismo ay HINDI kailanman
   dumadaan o naka-hardcode sa client-side JS — pinapadala lang bilang
   parameter papunta sa server, tapos boolean result lang ang bumabalik. */
(function setupArtifieldLicenseGate(){
  const input = document.getElementById('licenseKeyInput');
  const errorEl = document.getElementById('pinError');
  const submitBtn = document.getElementById('btnEnterApp');
  const originalBtnHTML = submitBtn.innerHTML;

  function clearErrorState(){
    errorEl.textContent = '';
    input.classList.remove('error');
  }
  function showError(msg){
    errorEl.textContent = msg;
    input.classList.add('error');
  }
  function setBusy(isBusy){
    submitBtn.disabled = isBusy;
    input.disabled = isBusy;
    submitBtn.innerHTML = isBusy ? 'Verifying…' : originalBtnHTML;
  }

  /* === ESCALATING LOCKOUT COUNTDOWN: START === */
  let lockCountdownInterval = null;

  function formatDuration(ms){
    const totalSec = Math.max(0, Math.ceil(ms/1000));
    if(totalSec < 60) return totalSec+' second'+(totalSec===1?'':'s');
    const totalMin = Math.ceil(totalSec/60);
    if(totalMin < 60) return totalMin+' minute'+(totalMin===1?'':'s');
    const totalHr = Math.ceil(totalMin/60);
    if(totalHr < 24) return totalHr+' hour'+(totalHr===1?'':'s');
    const totalDay = Math.ceil(totalHr/24);
    return totalDay+' day'+(totalDay===1?'':'s');
  }

  function showLockError(remainingMs, showTip){
    const tipHtml = showTip
      ? '<br><span style="display:block;margin-top:6px;color:var(--text-faint);font-size:11px;">Tip: check your internet connection, or contact support if this keeps happening.</span>'
      : '';
    errorEl.innerHTML = 'Too many attempts. Try again in '+formatDuration(remainingMs)+'.'+tipHtml;
    input.classList.add('error');
  }

  function startLockCountdown(retryAfterMs, showTip){
    clearInterval(lockCountdownInterval);
    let remaining = retryAfterMs;
    input.value = ''; input.disabled = true;
    submitBtn.disabled = true;
    showLockError(remaining, showTip);
    lockCountdownInterval = setInterval(()=>{
      remaining -= 1000;
      if(remaining <= 0){
        clearInterval(lockCountdownInterval);
        input.disabled = false;
        submitBtn.disabled = false;
        clearErrorState();
        input.focus();
      } else {
        showLockError(remaining, showTip);
      }
    }, 1000);
  }
  /* === ESCALATING LOCKOUT COUNTDOWN: END === */

  input.addEventListener('input', clearErrorState);
  input.addEventListener('keydown', e=>{ if(e.key==='Enter') attemptActivate(); });
  submitBtn.addEventListener('click', attemptActivate);

  function attemptActivate(){
    const key = input.value.trim();
    if(!key){ showError('Enter your license key.'); return; }
    clearErrorState();
    setBusy(true);
    google.script.run
      .withSuccessHandler(res=>{
        setBusy(false);
        if(res && res.ok){
          showLicenseSuccessScreen(res);
        } else {
          handleDenied(res);
        }
      })
      .withFailureHandler(()=>{
        // FAIL-CLOSED: error sa server call mismo — huwag payagang makapasok.
        setBusy(false);
        showError('Could not verify license right now. Please try again.');
      })
      .verifyLicenseKey(key);
  }

  let _pendingLicenseResult = null;
  function showLicenseSuccessScreen(res){
    _pendingLicenseResult = res;
    state.clientId = res.client_id;
    state.licenseInfo = {
      client_name: res.client_name || res.client_id,
      client_email: res.client_email || '',
      project_name: res.project_name || '',
      plan: res.plan || 'Standard',
      expires_at: res.expires_at || '',
      license_key: res.license_key || '',
      license_status: res.license_status || '',
      max_users: res.max_users || '',
      device_limit: res.device_limit || '',
    };
    document.getElementById('licenseFormWrap').classList.add('hidden');
    const titleEl = document.getElementById('welcomeTitle');
    if(titleEl) titleEl.classList.add('hidden');
    const langWrap = document.getElementById('welcomeLangSelectWrap');
    if(langWrap) langWrap.classList.add('hidden');

    document.getElementById('licenseSuccessWrap').classList.remove('hidden');
    setTimeout(proceedIntoArtifieldFromLicense, 3000);
  }

  function proceedIntoArtifieldFromLicense(){
    const res = _pendingLicenseResult;
    if(!res) return;
    _pendingLicenseResult = null;
    const w = document.getElementById('welcome');
    w.classList.add('fade-out');
    setTimeout(()=>{ w.style.display = 'none'; }, 380);
    setTimeout(()=>{
      if(res.project_id){
        // License is bound to a specific project — skip the picker entirely.
        finalizeProjectSelection(res.client_id, res.project_id);
      } else {
        // Client-wide license — let them pick which of their projects to open.
        showProjectStep(res.client_id, res.client_name);
      }
    }, 450);
  }

  function handleDenied(res){
    if(!res){ showError('Could not verify license. Please try again.'); return; }
    /* === ESCALATING LOCKOUT COUNTDOWN: START === */
    if(res.reason==='locked'){
      startLockCountdown(res.retryAfterMs || 10000, !!res.showTip);
      return;
    }
    /* === ESCALATING LOCKOUT COUNTDOWN: END === */
    if(res.reason==='expired'){
      showError('This license expired on '+fmtDate(res.expiredAt)+'. Please renew to continue.');
    } else if(res.reason==='inactive'){
      showError('This license is not active. Contact support for help.');
    } else if(res.reason==='empty'){
      showError('Enter your license key.');
    } else {
      const remaining = res.attemptsRemaining!=null ? ` (${res.attemptsRemaining} attempt(s) left)` : '';
      showError('License key not found.'+remaining);
    }
  }

  document.getElementById('btnGetLicense').addEventListener('click', openGetLicenseModal);
  document.getElementById('btnContactSupport').addEventListener('click', ()=>{
    // Palitan mo ito ng totoong support contact (email, form, o chat link).
    window.open('mailto:support@yourcompany.com', '_blank');
  });

  /* === ADMIN OVERRIDE — ROTATION UI HOOK: START ===
     Deliberately not a visible button — 5 quick clicks on the pin-hint
     label opens a browser prompt flow to rotate the override key. Kept
     minimal (window.prompt) on purpose: this is an admin-only maintenance
     action, not part of the normal unlock flow, so it doesn't need its
     own modal markup. */
  (function setupOverrideRotationHook(){
    const hintEl = document.getElementById('pinHintTrigger');
    if(!hintEl) return;
    let clickCount = 0, clickTimer = null;
    hintEl.addEventListener('click', ()=>{
      clickCount++;
      clearTimeout(clickTimer);
      clickTimer = setTimeout(()=>{ clickCount = 0; }, 1200);
      if(clickCount>=5){
        clickCount = 0;
        promptRotateOverrideKey();
      }
    });
  })();

  function promptRotateOverrideKey(){
    const current = window.prompt('Admin override — enter CURRENT override key (leave blank if none set yet):');
    if(current===null) return; // cancelled
    const next = window.prompt('Enter NEW override key (min 6 characters):');
    if(next===null) return;
    google.script.run
      .withSuccessHandler(res=>{
        if(res && res.ok){
          alert('Override key updated.');
        } else if(res && res.reason==='incorrect_current'){
          alert('Current override key is incorrect — no change made.');
        } else if(res && res.reason==='invalid_new'){
          alert('New key must be at least 6 characters.');
        } else if(res && res.reason==='same_as_user_pin'){
          alert('Override key cannot match the regular license PIN.');
        } else {
          alert('Could not update override key.');
        }
      })
      .withFailureHandler(()=>alert('Could not reach the server to update the override key.'))
      .changeArtifieldAdminOverrideKey(current, next);
  }
  /* === ADMIN OVERRIDE — ROTATION UI HOOK: END === */

  input.focus();
})();
/* === ARTIFIELD LICENSE PIN GATE: END === */

