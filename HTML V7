/* === WHAT CHANGED SINCE LAST IMPORT: START ===
   Categorizes tasks touched by the most recent import batch (importedAt
   === state.lastImport) using fields mergeIntoDB already sets — status
   ('New'/'Shifted') and shiftDays — rather than a separate change-tracking
   system. "Removed" records aren't tracked because mergeIntoDB never
   deletes tasks on import, only adds/updates, so there is nothing to
   detect there yet. */
function computeChangeSummarySinceLastImport(){
  if(!state.lastImport) return null;
  const touched = state.tasks.filter(t=>t.importedAt===state.lastImport);
  const isNew = touched.filter(t=>t.status==='New');
  const shifted = touched.filter(t=>t.status==='Shifted');
  const delayed = shifted.filter(t=>t.shiftDays>0);
  const advanced = shifted.filter(t=>t.shiftDays<0);
  const completed = touched.filter(t=>t.accToDatePct!=null && t.accToDatePct>=99.5);
  return { touched, isNew, shifted, delayed, advanced, completed };
}

