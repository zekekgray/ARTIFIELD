  if(id) setGanttFocusTask(id);
}
window.ganttFocusTaskInputChange = ganttFocusTaskInputChange;

/* Inaaplay PAGKATAPOS ng applyGanttFilters — kaya "Delayed · Building B"
   ay hindi magkasalungat: una munang sinala ng Building/Trade pill filters,
   tapos yung Focus preset (week/critical/delayed) ang huling nagpipino.
   Ang 'task' focus ay eksepsiyon: kinukuha ito mula sa BUONG state.tasks
   (hindi sa naka-scope na listahan) para laging kumpleto ang kapitbahay
   (predecessor + successor) ng napiling task, kahit magkaiba ang building/
   trade nila sa kasalukuyang pill selection. */
function applyGanttFocus(tasks, controlStatus, flaggedIds){
  const focus = state.ganttFocus || {type:'', taskId:''};
  if(!focus.type) return tasks;
  if(focus.type==='week'){
    const wkStart = new Date(state.asOfDate); wkStart.setHours(0,0,0,0);
    wkStart.setDate(wkStart.getDate()-wkStart.getDay());
    const wkEnd = new Date(wkStart); wkEnd.setDate(wkEnd.getDate()+7);
    return tasks.filter(t=>{
      if(!hasValidDates(t)) return false;
      const [s,f] = activeRange(t);
      return s<wkEnd && f>=wkStart;
    });
  }
  if(focus.type==='critical'){
    return tasks.filter(t=> (controlStatus[t.id]||{}).status==='critical' || flaggedIds.has(t.id));
  }
  if(focus.type==='delayed'){
    return tasks.filter(t=> ['delayed','critical'].includes((controlStatus[t.id]||{}).status));
  }
  if(focus.type==='atrisk'){
    return tasks.filter(t=> (controlStatus[t.id]||{}).status==='atrisk');
  }
  if(focus.type==='task' && focus.taskId){
    const t = state.tasks.find(x=>x.id===focus.taskId);
    if(!t) return tasks;
    const up = computeUpstreamTasks(t, state.tasks).map(i=>i.task.id);
    const down = computeDownstreamTasks(t, state.tasks).map(i=>i.task.id);
    const keep = new Set([t.id, ...up, ...down]);
    return state.tasks.filter(x=>keep.has(x.id));
  }
  return tasks;
}

function renderGanttFocusBar(scopedBeforeFocusTasks){
  const focus = state.ganttFocus || {type:'', taskId:''};
  const f = state.ganttFilters;
  window._ganttTaskSearchMap = {};
  const searchPool = scopedBeforeFocusTasks.filter(hasValidDates).slice(0,400);
  searchPool.forEach(t=>{ window._ganttTaskSearchMap[ganttTaskSearchLabel(t)] = t.id; });
  const selectedTask = (focus.type==='task' && focus.taskId) ? state.tasks.find(x=>x.id===focus.taskId) : null;

  const parts = [];
  if(focus.type==='week') parts.push('Current Week');
  if(focus.type==='critical') parts.push('Critical Path');
 if(focus.type==='delayed') parts.push('Delayed Activities');
  if(focus.type==='atrisk') parts.push('At-Risk Activities');
  if(focus.type==='task') parts.push(selectedTask ? `"${selectedTask.name}" + connected tasks` : 'Selected task (not found)');
  if(f.building) parts.push('Building '+f.building);
  if(f.trade) parts.push(f.trade);
  const focusLabel = parts.length ? parts.join(' · ') : 'All Activities';

  /* === GANTT DEPENDENCY CHAIN: START ===
     Dependency lines are hidden by default across the whole Gantt (no
     spaghetti). Only when a task is focused do we show its immediate
     predecessor(s)/successor(s) as a simple vertical chain — clicking any
     node re-centers the chain on that task. */
  let chainHtml = '';
  if(focus.type==='task' && selectedTask){
    const up = computeUpstreamTasks(selectedTask, state.tasks);
    const down = computeDownstreamTasks(selectedTask, state.tasks);
    const chainNode = (label, t, isSelected) => `
      <div class="gantt-chain-node ${isSelected?'selected':''}" ${t?`onclick="setGanttFocusTask('${escOnclickArg(t.id)}')"`:''}>
        <span class="gantt-chain-role">${label}</span>
        <span class="gantt-chain-name">${esc(t?t.name:selectedTask.name)}</span>
      </div>`;
    const upNodes = up.slice(0,2).map(imp=>chainNode('PREDECESSOR', imp.task, false));
    const downNodes = down.slice(0,2).map(imp=>chainNode('SUCCESSOR', imp.task, false));
    chainHtml = `<div class="gantt-chain">
      ${upNodes.join('<div class="gantt-chain-arrow">↓</div>')}
      ${up.length ? '<div class="gantt-chain-arrow">↓</div>' : ''}
      ${chainNode('SELECTED', null, true)}
      ${down.length ? '<div class="gantt-chain-arrow">↓</div>' : ''}
      ${downNodes.join('<div class="gantt-chain-arrow">↓</div>')}
    </div>`;
  }
  /* === GANTT DEPENDENCY CHAIN: END === */

  return `
  <div class="chart-card" style="margin-bottom:14px;background:linear-gradient(150deg,#0D141C,#12181F);border-color:${focus.type?'var(--blue-dim)':'var(--line-soft)'};">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;flex-wrap:wrap;gap:8px;">
      <div style="font-family:var(--mono);font-size:12px;color:var(--blue);">${ICO.target} Focus: <b style="color:var(--text);">${esc(focusLabel)}</b></div>
      ${focus.type ? `<button class="btn" onclick="clearGanttFocus()">Clear focus</button>` : ''}
    </div>
    <div class="compare-row">
      <button class="pill-btn ${focus.type==='week'?'active':''}" onclick="setGanttFocus('week')">${ICO.calendar} Current Week</button>
      <button class="pill-btn ${focus.type==='critical'?'active':''}" style="--pill-color:var(--red);" onclick="setGanttFocus('critical')"><span style="color:var(--red)">${ICO.dot}</span> Critical Path</button>
       <button class="pill-btn ${focus.type==='delayed'?'active':''}" style="--pill-color:var(--amber);" onclick="setGanttFocus('delayed')"><span style="color:var(--amber)">${ICO.dot}</span> Delayed</button>
      <button class="pill-btn ${focus.type==='atrisk'?'active':''}" style="--pill-color:var(--amber);" onclick="setGanttFocus('atrisk')"><span style="color:var(--amber)">${ICO.dot}</span> At Risk</button>
      <input type="text" list="ganttTaskSearchList" placeholder="Focus on a task…" style="width:240px;" value="${selectedTask?esc(ganttTaskSearchLabel(selectedTask)):''}" onchange="ganttFocusTaskInputChange(this.value)">
      <datalist id="ganttTaskSearchList">${searchPool.map(t=>`<option value="${esc(ganttTaskSearchLabel(t))}">`).join('')}</datalist>
    </div>
    <div class="help" style="margin-top:6px;">Combine with the Building/Trade filters below for a tighter view — e.g. "Delayed Activities · Building B". Task focus shows that task plus its immediate predecessors and successors.</div>
    ${chainHtml}
  </div>`;
}
/* === FOCUS MODE: END === */

function ganttScopeLabel(){
  const f = state.ganttFilters;
  const parts = [
    f.building ? 'Building '+f.building : 'All Buildings',
    f.trade ? f.trade : 'All Trades',
    f.level ? f.level : 'All Levels',
    f.status ? f.status : 'All Statuses',
    f.criticality ? f.criticality : 'Critical & Non-critical',
    f.delay ? f.delay : 'Delayed & On-track',
  ];
  return parts.join(' · ') + ' · As of ' + fmtDate(state.asOfDate);
}

function applyGanttFilters(tasks, flaggedIds){
  const f = state.ganttFilters;
  return tasks.filter(t=>{
    if(f.building && t.building!==f.building) return false;
    if(f.trade && t.trade!==f.trade) return false;
    if(f.level && (t.level||'—')!==f.level) return false;
    if(f.status && (t.status||'—')!==f.status) return false;
    if(f.criticality==='Critical' && !flaggedIds.has(t.id)) return false;
    if(f.criticality==='Non-critical' && flaggedIds.has(t.id)) return false;
    const isDelayed = t.status==='Shifted' && t.shiftDays>0;
    if(f.delay==='Delayed' && !isDelayed) return false;
    if(f.delay==='On-track' && isDelayed) return false;
    if(f.dateStart || f.dateEnd){
      const [s,fin] = activeRange(t);
      if(f.dateStart && fin < new Date(f.dateStart)) return false;
      if(f.dateEnd && s > new Date(f.dateEnd)) return false;
    }
    return true;
  });
}

function renderGanttFilterBar(allTasks, flaggedIds){
  const f = state.ganttFilters;
  const baselineOptions = state.baselines.slice().reverse();
  const buildings = [...new Set(allTasks.map(t=>t.building))].sort();
  const trades = [...new Set(allTasks.map(t=>t.trade))].sort();
  const levels = [...new Set(allTasks.map(t=>t.level).filter(Boolean))].sort();
  const statuses = [...new Set(allTasks.map(t=>t.status).filter(Boolean))].sort();
  const toInputDate = iso => iso ? new Date(iso).toISOString().slice(0,10) : '';
  const hasActiveFilters = f.building||f.trade||f.level||f.status||f.criticality||f.delay||f.dateStart||f.dateEnd;

  const pillGroup = (label, kind, options, selected) => `
    <div class="compare-row" style="margin-bottom:6px;">
      <span class="compare-label">${esc(label)}</span>
      <button class="pill-btn ${selected===''?'active':''}" onclick="setGanttFilter('${kind}','')">All</button>
      ${options.map(o=>`<button class="pill-btn ${selected===o?'active':''}" onclick="setGanttFilter('${kind}','${escOnclickArg(o)}')">${esc(o)}</button>`).join('')}
    </div>`;

  return `
  <div class="chart-card" style="margin-bottom:14px;">
    <div style="font-family:var(--mono);font-size:11.5px;letter-spacing:.03em;color:var(--blue);margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid var(--line-soft);">
      ${esc(ganttScopeLabel())}
    </div>
    ${pillGroup('Building','building',buildings,f.building)}
    ${pillGroup('Trade','trade',trades,f.trade)}
    ${levels.length ? pillGroup('Level','level',levels,f.level) : ''}
    ${statuses.length ? pillGroup('Status','status',statuses,f.status) : ''}
    ${pillGroup('Criticality','criticality',['Critical','Non-critical'],f.criticality)}
    ${pillGroup('Progress','delay',['Delayed','On-track'],f.delay)}
    <div class="compare-row">
      <span class="compare-label">Baseline</span>
      <select onchange="setGanttBaselineCompare(this.value)">
        <option value="">None</option>
        ${baselineOptions.map(b=>`<option value="${esc(b.id)}" ${state.ganttBaselineCompare===b.id?'selected':''}>${esc(b.name)}</option>`).join('')}
      </select>
      ${!baselineOptions.length ? `<span class="help">No named baselines yet — save one from the Named Baselines tab.</span>` : ''}
    </div>
    <div class="compare-row">
      <span class="compare-label">Date range</span>
      <input type="date" id="ganttRangeStart" value="${toInputDate(f.dateStart)}">
      <span class="count-pill">to</span>
      <input type="date" id="ganttRangeEnd" value="${toInputDate(f.dateEnd)}">
      <button class="btn" onclick="setGanttDateRange()">Apply</button>
      ${hasActiveFilters ? `<button class="btn" onclick="resetGanttFilters()">Reset all filters</button>` : ''}
    </div>
  </div>`;
}
/* === CONSOLIDATED GANTT — SCOPE FILTERS: END === */

function renderGantt(c){
  const seqV = computeSequenceViolations();
  const clashV = computeSpaceTimeClashes();
const flaggedIds = new Set();
  [...seqV, ...clashV].forEach(v=>{ flaggedIds.add(v.taskA.id); flaggedIds.add(v.taskB.id); });
  const controlStatus = computeGanttControlStatus(state.tasks, flaggedIds);
  window._ganttControlStatus = controlStatus;
  /* === DELAY IMPACT CASCADE: START ===
     controlStatus[t.id].impacts ay computed na (via computeDownstreamTasks)
     para sa lahat ng critical/delayed/atrisk tasks — dito lang binabaligtad
     ang direksyon: mula "sino ang maaapektuhan ng task na ito" papunta sa
     "sino ang nag-aapekto sa task na ito" — para sa affected/downstream
     task mismo, may makikitang chain-glyph sa row nito na nagsasabing
     "may kasalukuyang paparating na delay na tatama dito". */
  const ganttAffectedByMap = {};
  state.tasks.forEach(src=>{
    const cs0 = controlStatus[src.id];
    if(cs0 && cs0.impacts && cs0.impacts.length){
      cs0.impacts.forEach(imp=>{
        (ganttAffectedByMap[imp.task.id] = ganttAffectedByMap[imp.task.id] || []).push({source:src, note:imp.note});
      });
    }
  });

  /* === CONTROL TOWER HEADER: START ===
     Project-wide status + attention alerts, computed against the FULL
     state.tasks (not the filtered/focused scope below) — this is the
     "zoom all the way out" summary that sits above the Gantt regardless
     of whatever Building/Trade/Focus the user has drilled into. */
  const ctOverallActual = weightedActualPct(state.tasks);
  const ctOverallPlanned = weightedPlannedPct(state.tasks, state.asOfDate);
  const ctVariance = ctOverallActual - ctOverallPlanned;
  const ctDelayedTasks = state.tasks.filter(t=>['critical','delayed'].includes((controlStatus[t.id]||{}).status));
  const ctAtRiskTasks = state.tasks.filter(t=>(controlStatus[t.id]||{}).status==='atrisk');
  const ctConflictsCount = seqV.length + clashV.length;
  const ctLowConfCount = state.tasks.filter(t=>t.confidence==='low').length;
  const ctDelayDaysList = ctDelayedTasks.map(t=>t.shiftDays).filter(d=>d>0);
  const ctAvgDelayDays = ctDelayDaysList.length ? Math.round(ctDelayDaysList.reduce((a,b)=>a+b,0)/ctDelayDaysList.length) : 0;

  const controlTowerHtml = `
  <div class="chart-card" style="margin-bottom:14px;">
    <div style="font-family:var(--mono);font-size:11px;letter-spacing:.1em;color:var(--blue);margin-bottom:12px;">CONSOLIDATED SCHEDULE</div>
    <div class="grid cards3" style="margin-bottom:14px;">
      <div class="card kpi ${ctOverallActual<ctOverallPlanned-3?'warn':'good'}"><div class="label">Actual</div><div class="value">${ctOverallActual.toFixed(0)}%</div></div>
      <div class="card kpi"><div class="label">Planned</div><div class="value">${ctOverallPlanned.toFixed(0)}%</div></div>
      <div class="card kpi ${ctVariance<0?'bad':'good'}"><div class="label">Variance</div><div class="value">${ctVariance>=0?'+':''}${ctVariance.toFixed(0)}%${ctAvgDelayDays?' · '+ctAvgDelayDays+'d behind':''}</div></div>
    </div>
    <div style="font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;color:var(--text-faint);margin-bottom:8px;">ATTENTION</div>
    <div class="grid cards4">
      <div class="card kpi ${ctDelayedTasks.length?'bad':'good'}" style="cursor:pointer;" onclick="setGanttFocus('delayed')" title="Focus the Gantt on delayed/critical activities"><div class="label"><span style="color:var(--red)">${ICO.dot}</span> Delayed / Critical</div><div class="value">${ctDelayedTasks.length}</div>${Object.keys(ganttAffectedByMap).length?`<div class="delta">→ cascades to ${Object.keys(ganttAffectedByMap).length} downstream task(s)</div>`:''}</div>
      <div class="card kpi ${ctAtRiskTasks.length?'warn':'good'}" style="cursor:pointer;" onclick="setGanttFocus('atrisk')" title="Focus the Gantt on at-risk activities"><div class="label"><span style="color:var(--amber)">${ICO.dot}</span> At Risk</div><div class="value">${ctAtRiskTasks.length}</div></div>
      <div class="card kpi ${ctConflictsCount?'bad':'good'}" style="cursor:pointer;" onclick="setTab('clashes')" title="Open Clash & Sequence Log"><div class="label"><span style="color:var(--blue)">${ICO.dot}</span> Dependency Conflicts</div><div class="value">${ctConflictsCount}</div></div>
      <div class="card kpi ${ctLowConfCount?'warn':'good'}" style="cursor:pointer;" onclick="setTab('clashes')" title="Open Clash & Sequence Log — Data Quality Issues"><div class="label">${ICO.warn} Low Confidence</div><div class="value">${ctLowConfCount}</div></div>
    </div>
  </div>`;
  /* === CONTROL TOWER HEADER: END === */

  const compareActive = !!state.ganttBaselineCompare;
  const changeSummary = computeChangeSummarySinceLastImport();

  /* === CONSOLIDATED GANTT — SCOPE FILTERS: START === */
  const filterBarHtml = renderGanttFilterBar(state.tasks.filter(hasValidDates), flaggedIds);
  let scopedTasks = applyGanttFilters(state.tasks, flaggedIds);
  /* === FOCUS MODE: START === */
  const focusBarHtml = renderGanttFocusBar(scopedTasks);
  scopedTasks = applyGanttFocus(scopedTasks, controlStatus, flaggedIds);
  /* === FOCUS MODE: END === */
  /* === CONSOLIDATED GANTT — SCOPE FILTERS: END === */

  const buildings = [...new Set(scopedTasks.map(t=>t.building))].sort();
  const withDates = scopedTasks.filter(hasValidDates);
  const skippedCount = scopedTasks.length - withDates.length;
  let minD = new Date(Math.min(...withDates.map(t=>+new Date(t.plannedStart))));
  let maxD = new Date(Math.max(...withDates.map(t=>+new Date(t.revisedFinish||t.plannedFinish))));
  /* === HORIZON FIX: START === (see buildValueScurveSVG for full rationale) */
  maxD = new Date(+maxD + 14*DAY);
  /* === HORIZON FIX: END === */
  /* === CONSOLIDATED GANTT — SCOPE FILTERS: START === */
  if(withDates.length===0){
    c.innerHTML = `<div id="ganttFullscreenWrap">` + (state.ganttFullscreen ? `
  <div class="gantt-fs-bar">
    <span class="gantt-fs-title">${ICO.ruler} Consolidated Gantt — Fullscreen</span>
    <button class="btn primary" onclick="toggleGanttFullscreen()">Exit Fullscreen ✕</button>
  </div>` : '') + controlTowerHtml + focusBarHtml + filterBarHtml + `<div class="empty"><h3>No tasks match this focus/filter combination</h3><p>Try widening your Building, Trade, Level, Status, Criticality, or date range selection above, or clear the active Focus.</p><div class="btn-row" style="justify-content:center;"><button class="btn primary" onclick="resetGanttFilters()">Reset all filters</button>${state.ganttFocus&&state.ganttFocus.type?`<button class="btn" onclick="clearGanttFocus()">Clear focus</button>`:''}</div></div></div>`;
    return;
  }
  /* === CONSOLIDATED GANTT — SCOPE FILTERS: END === */
  const totalDays = Math.max(1,(maxD-minD)/DAY);
  /* === GANTT ZOOM LEVEL: START === */
  const zoomLevel = state.ganttZoom.level;
  const pxPerDay = GANTT_ZOOM_PXPERDAY[zoomLevel] || Math.max(0.8, 1100/totalDays);
  const trackWidth = totalDays*pxPerDay;
  const ganttCenterDate = state.ganttZoom.centerDate ? new Date(state.ganttZoom.centerDate) : state.asOfDate;
  const centerLeftForScroll = clamp(((ganttCenterDate-minD)/DAY)*pxPerDay, 0, trackWidth);
  /* === GANTT ZOOM LEVEL: END === */  /* === GANTT AESTHETICS EDIT: START === */
  const LABEL_W = 260;
  const totalRowWidth = LABEL_W + trackWidth;
  /* === GANTT AESTHETICS EDIT: END === */
  const tradeColors = {};
  /* === STATUS AS SHAPE, NOT COLOR: START ===
     Desaturated/muted na palette — trade differentiation pa rin, pero
     hindi na nangungunang visual signal. Status (glyph) at delay
     (position/badge) na ang unang babasahin ng mata, hindi ang trade hue. */
  const palette = ['#EDF1F5','#C7CDD4','#9AA3AC','#7A828B','#5A626B','#3E4650','#2C333B','#8FA0B3'];
  /* === STATUS AS SHAPE, NOT COLOR: END === */
  [...new Set(scopedTasks.map(t=>t.trade))].forEach((tr,i)=>tradeColors[tr]=palette[i%palette.length]);

  /* === CONSOLIDATED GANTT — HIERARCHY: START === */
  const byBuildingGantt = {};
  withDates.forEach(t=>{ (byBuildingGantt[t.building]=byBuildingGantt[t.building]||[]).push(t); });

  // Default: LAHAT ng buildings at trades naka-expand paglabas — para
  // makita agad ng user ang kumpletong listahan ng tasks, hindi lang isang
  // building. Dati isang building lang ang naka-expand bilang default,
  // kaya mukhang "konti lang" ang lumalabas kahit kumpleto naman ang data
  // — nakalilito dahil parang nagbabago ang bilang ng rows sa bawat bisita.
  if(state.ganttExpanded==null){
    state.ganttExpanded = {};
    buildings.forEach(b=>{
      state.ganttExpanded['B|'+b] = true;
      const trTasks = byBuildingGantt[b] || [];
      [...new Set(trTasks.map(t=>t.trade))].forEach(tr=>{
        state.ganttExpanded['T|'+b+'|'+tr] = true;
      });
    });
  }

  let rows = '';
  buildings.forEach(b=>{
    const bTasks = byBuildingGantt[b] || [];
    const bExpanded = !!state.ganttExpanded['B|'+b];
    const bPct = weightedActualPct(bTasks);
    const bFlagged = bTasks.some(t=>flaggedIds.has(t.id));
    const bChevron = bExpanded ? '▾' : '▸';

    if(!bExpanded){
      // Collapsed building: isang aggregate/rollup bar lang, buong span nito.
      const [s,f] = aggregateRangeFor(bTasks);
      const left = ((s-minD)/DAY)*pxPerDay;
      const width = Math.max(3, ((f-s)/DAY)*pxPerDay);
      rows += `<div class="gantt-row gantt-group-row" onclick="toggleGanttBuilding('${escOnclickArg(b)}')">
        <div class="gantt-label" style="cursor:pointer;font-weight:600;">
          <span class="gantt-chevron">${bChevron}</span> ${ICO.building} BUILDING ${esc(b)}${bFlagged?' '+ICO.warn:''}
          <span class="gantt-rollup-pct">${bPct.toFixed(0)}%</span>
        </div>
        <div class="gantt-track" style="width:${trackWidth}px">
          <div class="gantt-agg-bar" style="left:${left}px;width:${width}px;background:#4FC3F7;">
            <div class="gantt-agg-bar-fill" style="width:${clamp(bPct,0,100)}%;"></div>
          </div>
        </div>
      </div>`;
      return;
    }

    rows += `<div class="gantt-bldg-head" style="width:${totalRowWidth}px;cursor:pointer;" onclick="toggleGanttBuilding('${escOnclickArg(b)}')">
      <div class="gantt-bldg-head-inner"><span class="gantt-chevron">${bChevron}</span> ${ICO.building} BUILDING ${esc(b)} <span class="gantt-bldg-count">· ${bTasks.length} task(s) · ${bPct.toFixed(0)}% complete</span></div>
    </div>`;

    const byTrade = {};
    bTasks.forEach(t=>{ (byTrade[t.trade]=byTrade[t.trade]||[]).push(t); });
    const trades = Object.keys(byTrade).sort();

    trades.forEach(tr=>{
      const trTasks = byTrade[tr];
      const trExpanded = !!state.ganttExpanded['T|'+b+'|'+tr];
      const trPct = weightedActualPct(trTasks);
      const trFlagged = trTasks.some(t=>flaggedIds.has(t.id));
      const trChevron = trExpanded ? '▾' : '▸';
      const color = tradeColors[tr];

      if(!trExpanded){
        // Collapsed trade: rollup bar lang, walang individual task rows.
        const [s,f] = aggregateRangeFor(trTasks);
        const left = ((s-minD)/DAY)*pxPerDay;
        const width = Math.max(3, ((f-s)/DAY)*pxPerDay);
        rows += `<div class="gantt-row gantt-group-row" onclick="toggleGanttTrade('${escOnclickArg(b)}','${escOnclickArg(tr)}')">
          <div class="gantt-label" style="cursor:pointer;padding-left:28px;">
            <span class="gantt-chevron">${trChevron}</span> ${esc(tr)}${trFlagged?' ⚠':''}
            <span class="gantt-rollup-pct">${trPct.toFixed(0)}%</span>
          </div>
          <div class="gantt-track" style="width:${trackWidth}px">
            <div class="gantt-agg-bar" style="left:${left}px;width:${width}px;background:${color};">
              <div class="gantt-agg-bar-fill" style="width:${clamp(trPct,0,100)}%;"></div>
            </div>
          </div>
        </div>`;
        return;
      }

      // Expanded trade: header + totoong individual task bars.
      rows += `<div class="gantt-trade-head" style="width:${totalRowWidth}px;cursor:pointer;" onclick="toggleGanttTrade('${escOnclickArg(b)}','${escOnclickArg(tr)}')">
        <div class="gantt-trade-head-inner"><span class="gantt-chevron">${trChevron}</span> ${esc(tr)} <span class="gantt-bldg-count">· ${trTasks.length} task(s) · ${trPct.toFixed(0)}% complete</span></div>
      </div>`;

      const list = trTasks.slice().sort((a,b2)=>new Date(a.plannedStart)-new Date(b2.plannedStart));
      list.forEach(t=>{
        const [as_, af] = activeRange(t);
        const [ps, pf] = ganttPlannedRange(t);
        const actualLeft = ((as_-minD)/DAY)*pxPerDay;
        const flagged = flaggedIds.has(t.id);
        const cs = controlStatus[t.id] || {status:'ontrack', reasons:[], impacts:[], forecastShiftDays:0};
        const statusColor = GANTT_STATUS_COLORS[cs.status];
        const variance = ganttVarianceDays(t);
        const varLabel = variance!==0 ? `${variance>0?'+':''}${variance}d` : '';
        const tip = `${t.p6ActivityId?esc(t.p6ActivityId)+' · ':''}${esc(t.trade)} · Planned ${fmtDate(ps)}–${fmtDate(pf)} · Actual ${fmtDate(as_)}–${fmtDate(af)}${t.accToDatePct!=null?' · '+t.accToDatePct.toFixed(0)+'% complete':''} · ${GANTT_STATUS_LABELS[cs.status]}${variance!==0?' · '+varLabel+(variance>0?' behind plan':' ahead of plan'):''}`;
        /* === GANTT BASELINE COMPARE: START === */
        let baselineHtml = '';
        if(compareActive){
          const be = baselineTaskEntry(state.ganttBaselineCompare, t.id);
          if(be){
            const bStart = new Date(be.revisedStart || be.plannedStart);
            const bFinish = new Date(be.revisedFinish || be.plannedFinish);
            if(!isNaN(bStart) && !isNaN(bFinish)){
              const bLeft = ((bStart-minD)/DAY)*pxPerDay;
              const bWidth = Math.max(3, ((bFinish-bStart)/DAY)*pxPerDay);
              const bVariance = daysBetween(bFinish.toISOString(), af.toISOString());
              baselineHtml = `<div class="gantt-bar-baseline" style="left:${bLeft}px;width:${bWidth}px;" title="Baseline: ${fmtDate(bStart)} – ${fmtDate(bFinish)}"></div>`;
              if(bVariance){
                baselineHtml += `<div class="gantt-baseline-variance" style="left:${bLeft+bWidth+4}px;">${bVariance>0?'+':''}${bVariance}d</div>`;
              }
            }
          }
        }
        /* === GANTT BASELINE COMPARE: END === */
  let barHtml;
        if(t.isMilestone){
          barHtml = `<div class="gantt-milestone ${flagged?'violation':''}" style="left:${actualLeft}px;background:${color};box-shadow:0 1px 3px rgba(0,0,0,.4);cursor:pointer;" title="${tip}" onclick="event.stopPropagation();openGanttTaskDrawer('${escOnclickArg(t.id)}')"></div>`;
          /* === STATUS AS SHAPE, NOT COLOR: START === */
          if(cs.status!=='ontrack') barHtml += `<span class="gantt-status-glyph" style="left:${actualLeft+9}px;color:${statusColor};" title="${GANTT_STATUS_LABELS[cs.status]}">${GANTT_STATUS_GLYPH[cs.status]||''}</span>`;
          /* === STATUS AS SHAPE, NOT COLOR: END === */
          if(varLabel) barHtml += `<div class="gantt-variance-badge" style="left:${actualLeft+14}px;color:${variance>0?'var(--red)':'var(--green)'};">${varLabel}</div>`;
        } else {
          const plannedLeft = ((ps-minD)/DAY)*pxPerDay;
          const plannedWidth = Math.max(3, ((pf-ps)/DAY)*pxPerDay);
          const actualWidth = Math.max(3, ((af-as_)/DAY)*pxPerDay);
          const pct = t.accToDatePct!=null ? clamp(t.accToDatePct,0,100) : null;
          const fillHtml = pct!=null ? `<div class="gantt-bar-fill" style="width:${pct}%;"></div>` : '';
          barHtml = `<div class="gantt-bar-planned" style="left:${plannedLeft}px;width:${plannedWidth}px;border-color:${color};" title="Planned: ${fmtDate(ps)}–${fmtDate(pf)}"></div>` +
            /* === STATUS AS SHAPE, NOT COLOR: START ===
               Ang bar fill ay subtle na trade tint na lang (color-mix,
               ~42% lang, laban sa madilim na base) — hindi na saturated
               na pangunahing signal. Status ay hiwalay na glyph overlay
               sa ibaba, hindi na "background swap" ng buong bar. */
            `<div class="gantt-bar gantt-bar-actual ${flagged?'violation':''}" style="left:${actualLeft}px;width:${actualWidth}px;background:color-mix(in srgb, ${color} 42%, #1A222C);cursor:pointer;" title="${tip}" onclick="event.stopPropagation();openGanttTaskDrawer('${escOnclickArg(t.id)}')">${fillHtml}</div>`;
          if(cs.status!=='ontrack'){
            barHtml += `<span class="gantt-status-glyph" style="left:${actualLeft-1}px;color:${statusColor};" title="${GANTT_STATUS_LABELS[cs.status]}">${GANTT_STATUS_GLYPH[cs.status]||''}</span>`;
          }
          /* === STATUS AS SHAPE, NOT COLOR: END === */
          if(varLabel){
            const badgeLeft = Math.max(plannedLeft+plannedWidth, actualLeft+actualWidth) + 6;
            barHtml += `<div class="gantt-variance-badge" style="left:${badgeLeft}px;color:${variance>0?'var(--red)':'var(--green)'};">${varLabel}</div>`;
          }
        }
        barHtml += baselineHtml;
        const confColor = ganttConfidenceColor(t.confidence);
        const confLabel = ganttConfidenceLabel(t.confidence);
        const confBadge = `<button class="gantt-conf-badge" style="--conf-color:${confColor};color:${confColor};" onclick="event.stopPropagation();openConfidenceExplainer('${escOnclickArg(t.id)}')" title="Data confidence: ${confLabel} — click to see why"><span class="dot"></span>${confLabel}${t.confidence==='low'?' '+ICO.warn:''}</button>`;
const affectedBy = ganttAffectedByMap[t.id];
        const chainGlyphHtml = affectedBy ? `<span class="gantt-chain-glyph" title="Affected by delay in: ${esc(affectedBy.slice(0,3).map(a=>a.source.name).join(' · '))}${affectedBy.length>3?' …':''}">${ICO.chain}</span>` : '';
        /* === DELAY IMPACT CASCADE: END === */
        rows += `<div class="gantt-row">
          <div class="gantt-label" style="padding-left:44px;" title="${esc(t.name)}">
            <span style="display:inline-block;min-width:10px;text-align:center;color:${statusColor};font-size:10px;font-weight:700;margin-right:6px;flex:none;" title="${GANTT_STATUS_LABELS[cs.status]}">${GANTT_STATUS_GLYPH[cs.status] || '•'}</span>
            ${chainGlyphHtml}
            <span style="overflow:hidden;text-overflow:ellipsis;">${flagged?ICO.warn+' ':''}${esc(t.name)}</span>
            ${confBadge}
          </div>
          <div class="gantt-track" style="width:${trackWidth}px;${compareActive?'height:38px;':''}">${barHtml}</div>
        </div>`;
      });
    });
  });

   const todayLeft = ((state.asOfDate-minD)/DAY)*pxPerDay;
  /* === TODAY HORIZON INTELLIGENCE: START === */
  const day7Left = todayLeft + 7*pxPerDay;
  const day30Left = todayLeft + 30*pxPerDay;
  const band7Width = clamp(Math.min(7*pxPerDay, trackWidth-todayLeft), 0, trackWidth);
  const band30Width = clamp(Math.min(23*pxPerDay, trackWidth-day7Left), 0, trackWidth);
  const upcoming7 = withDates.filter(t=>{ const [s]=activeRange(t); const days=(s-state.asOfDate)/DAY; return days>=0 && days<=7; }).length;
  const upcoming30 = withDates.filter(t=>{ const [s]=activeRange(t); const days=(s-state.asOfDate)/DAY; return days>7 && days<=30; }).length;
  /* === TODAY HORIZON INTELLIGENCE: END === */
  let yearMarks='';
  for(let yr=minD.getFullYear(); yr<=maxD.getFullYear(); yr++){
    const gx = ((new Date(yr,0,1)-minD)/DAY)*pxPerDay;
    if(gx<0||gx>trackWidth) continue;
    yearMarks += `<div class="gantt-gridline-year" style="left:${gx+LABEL_W}px;"></div><div style="position:absolute;left:${gx+LABEL_W+4}px;top:6px;font-family:var(--mono);font-size:10px;color:#546274;z-index:2;">${yr}</div>`;
  }
  /* === GANTT AESTHETICS EDIT: START ===
     Month gridlines fill in the empty stretches between year marks (Jan is
     skipped since the year line already covers it). Weekend shading is capped
     to ~2-year horizons so very long multi-year projects don't render
     hundreds of extra divs for no visual benefit at that zoom level. */
  let monthMarks='';
  {
    let cursor = new Date(minD.getFullYear(), minD.getMonth(), 1);
    while(cursor<=maxD){
      const gx = ((cursor-minD)/DAY)*pxPerDay;
      if(gx>=0 && gx<=trackWidth && cursor.getMonth()!==0){
        monthMarks += `<div class="gantt-gridline-month" style="left:${gx+LABEL_W}px;"></div>`;
      }
      /* === GANTT ZOOM LEVEL: START ===
         Sa 1M/3M zoom, kailangan ng month LABEL sa itaas (hindi lang year
         label) dahil posibleng wala nang year boundary sa loob ng
         visible window sa ganitong zoom level. */
      if((zoomLevel==='1M'||zoomLevel==='3M') && gx>=0 && gx<=trackWidth){
        monthMarks += `<div style="position:absolute;left:${gx+LABEL_W+4}px;top:20px;font-family:var(--mono);font-size:9.5px;color:#546274;z-index:2;">${cursor.toLocaleDateString('en-US',{month:'short'})}</div>`;
      }
      /* === GANTT ZOOM LEVEL: END === */
      cursor.setMonth(cursor.getMonth()+1);
    }
  }
  /* === GANTT ZOOM LEVEL: START — week gridlines kapag 1M === */
  let weekMarks='';
  if(zoomLevel==='1M'){
    let wc = new Date(minD); wc.setHours(0,0,0,0);
    wc.setDate(wc.getDate() - wc.getDay());
    while(wc<=maxD){
      const gx = ((wc-minD)/DAY)*pxPerDay;
      if(gx>=0 && gx<=trackWidth){
        weekMarks += `<div class="gantt-gridline-month" style="left:${gx+LABEL_W}px;opacity:.5;"></div>`;
      }
      wc.setDate(wc.getDate()+7);
    }
  }
  /* === GANTT ZOOM LEVEL: END === */
  let weekendMarks='';
  if(totalDays<=730){
    let cursor = new Date(minD); cursor.setHours(0,0,0,0);
    for(let i=0;i<totalDays;i++){
      const dow = cursor.getDay();
      if(dow===0||dow===6){
        const gx = ((cursor-minD)/DAY)*pxPerDay;
        weekendMarks += `<div class="gantt-weekend" style="left:${gx+LABEL_W}px;width:${pxPerDay}px;"></div>`;
      }
      cursor.setDate(cursor.getDate()+1);
    }
  }
  /* === GANTT AESTHETICS EDIT: END === */

  const ganttStatusCounts = {critical:0,delayed:0,atrisk:0,ontrack:0,completed:0};
  withDates.forEach(t=>{ const cs=controlStatus[t.id]; if(cs) ganttStatusCounts[cs.status]=(ganttStatusCounts[cs.status]||0)+1; });

  const baselineBannerHtml = compareActive ? (function(){
    const b = state.baselines.find(x=>x.id===state.ganttBaselineCompare);
    const moved = computeBaselineMovedTasks(state.ganttBaselineCompare);
    return `<div class="chart-card" style="margin-bottom:14px;border-color:var(--violet-dim);cursor:pointer;" onclick="openBaselineMovedModal('${escOnclickArg(state.ganttBaselineCompare)}')">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
        <div style="font-family:var(--mono);font-size:12px;color:var(--violet);">${ICO.ruler} Comparing against baseline: <b style="color:var(--text);">${esc(b?b.name:'—')}</b></div>
        <span class="tag violet">${moved.length} activit${moved.length===1?'y':'ies'} moved</span>
      </div>
      <div class="help" style="margin-top:6px;">Click to see exactly which activities shifted since this baseline.</div>
    </div>`;
  })() : '';

  const changeBannerHtml = (changeSummary && changeSummary.touched.length>0) ? `
    <div class="chart-card" style="margin-bottom:14px;border-color:var(--blue-dim);cursor:pointer;" onclick="openChangeReviewModal()">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
        <div style="font-family:var(--mono);font-size:12px;color:var(--blue);">${ICO.refresh} Schedule changed since last upload (${fmtDate(state.lastImport)})</div>
        <span class="tag blue">${changeSummary.touched.length} activities changed</span>
      </div>
      <div class="legend" style="margin-top:8px;font-size:11.5px;">
        ${changeSummary.shifted.length?`<span>${changeSummary.shifted.length} dates moved</span>`:''}
        ${changeSummary.completed.length?`<span>${changeSummary.completed.length} marked complete</span>`:''}
        ${changeSummary.delayed.length?`<span>${changeSummary.delayed.length} delayed</span>`:''}
        ${changeSummary.isNew.length?`<span>${changeSummary.isNew.length} new</span>`:''}
      </div>
      <div class="help" style="margin-top:6px;">Click to review exactly which activities changed.</div>
    </div>` : '';

  c.innerHTML = `<div id="ganttFullscreenWrap">` + (state.ganttFullscreen ? `
  <div class="gantt-fs-bar">
    <span class="gantt-fs-title">${ICO.ruler} Consolidated Gantt — Fullscreen</span>
    <button class="btn primary" onclick="toggleGanttFullscreen()">Exit Fullscreen ✕</button>
  </div>` : '') + controlTowerHtml + baselineBannerHtml + changeBannerHtml + focusBarHtml + filterBarHtml + `
  <div class="toolbar">
    <span class="count-pill" style="padding-left:0;">Zoom</span>
    <button class="btn ${state.ganttFullscreen?'primary':''}" onclick="toggleGanttFullscreen()" title="${state.ganttFullscreen?'Exit fullscreen':'Expand Gantt to full screen'}">${state.ganttFullscreen?ICO.collapse+' Exit Fullscreen':ICO.expand+' Fullscreen'}</button>
    <button class="pill-btn ${zoomLevel==='1M'?'active':''}" onclick="setGanttZoomLevel('1M')">1M</button>
    <button class="pill-btn ${zoomLevel==='3M'?'active':''}" onclick="setGanttZoomLevel('3M')">3M</button>
    <button class="pill-btn ${zoomLevel==='6M'?'active':''}" onclick="setGanttZoomLevel('6M')">6M</button>
    <button class="pill-btn ${zoomLevel==='1Y'?'active':''}" onclick="setGanttZoomLevel('1Y')">1Y</button>
    <button class="pill-btn ${zoomLevel==='ALL'?'active':''}" onclick="ganttFitProject()">ALL</button>
    <button class="btn" onclick="ganttZoomOut()" title="Zoom out">−</button>
    <button class="btn" onclick="ganttZoomIn()" title="Zoom in">+</button>
    <button class="btn" onclick="ganttGoToToday()">Today</button>
    <button class="btn" onclick="ganttFitProject()">Fit Project</button>
    <button class="btn primary" onclick="openGanttExportModal()">${ICO.exportIco} Export Gantt</button>
  </div>
  <div class="toolbar">
    <span class="count-pill">${withDates.length} tasks plotted · ${buildings.length} buildings · horizon to ${maxD.getFullYear()}${skippedCount?` · ${skippedCount} excluded (data quality)`:''}${zoomLevel!=='ALL'?` · zoomed: ${zoomLevel}`:''}</span>
    <button class="btn" onclick="expandAllGantt()">Expand all</button>
    <button class="btn" onclick="collapseAllGantt()">Collapse all</button>
    <div class="spacer"></div>
    <div class="legend">${Object.entries(tradeColors).map(([tr,col])=>`<span><i style="background:${col}"></i>${esc(tr)}</span>`).join('')}</div>
  </div>
  <div class="toolbar" style="margin-top:-4px;">
    <span class="count-pill" style="padding-left:0;">Project control status</span>
    <div class="legend">${Object.keys(GANTT_STATUS_COLORS).map(k=>`<span><i style="background:${GANTT_STATUS_COLORS[k]}"></i>${GANTT_STATUS_GLYPH[k]?GANTT_STATUS_GLYPH[k]+' ':''}${GANTT_STATUS_LABELS[k]} (${ganttStatusCounts[k]||0})</span>`).join('')}</div>
  </div>
  <div class="toolbar" style="margin-top:-4px;">
    <span class="count-pill" style="padding-left:0;">${ICO.pin} Upcoming</span>
    <span class="tag amber">${upcoming7} task(s) start in next 7 days</span>
    <span class="tag gray">${upcoming30} task(s) start in 8–30 days</span>
    <span class="help" style="margin-left:auto;">Shaded band on the chart marks the next 7/30-day window</span>
  </div>
 <div class="gantt-wrap" id="ganttScrollWrap" style="position:relative;max-height:70vh;overflow:auto;">
    <div style="position:relative;">
      ${weekendMarks}
      ${monthMarks}
      ${weekMarks}
      ${yearMarks}
      <div id="ganttCenterMarker" style="position:absolute;left:${centerLeftForScroll+LABEL_W}px;top:0;width:1px;height:1px;"></div>
      ${band7Width>0 ? `<div class="gantt-horizon-band" style="left:${todayLeft+LABEL_W}px;width:${band7Width}px;background:rgba(255,176,32,.11);"></div>` : ''}
      ${band30Width>0 ? `<div class="gantt-horizon-band" style="left:${day7Left+LABEL_W}px;width:${band30Width}px;background:rgba(255,176,32,.045);"></div>` : ''}
      ${(day7Left>=0 && day7Left<=trackWidth) ? `<div class="gantt-horizon-marker" style="left:${day7Left+LABEL_W}px;"></div><div class="gantt-horizon-label" style="left:${day7Left+LABEL_W}px;">+7D</div>` : ''}
      ${(day30Left>=0 && day30Left<=trackWidth) ? `<div class="gantt-horizon-marker" style="left:${day30Left+LABEL_W}px;border-left-color:rgba(84,98,116,.7);"></div><div class="gantt-horizon-label" style="left:${day30Left+LABEL_W}px;color:var(--text-faint);">+30D</div>` : ''}
      <div style="position:absolute;left:${todayLeft+LABEL_W}px;top:0;bottom:0;width:2px;background:#FFB020;z-index:5;box-shadow:0 0 6px rgba(255,176,32,.7);"></div>
      <div class="gantt-today-label" style="left:${todayLeft+LABEL_W}px;">TODAY</div>
      ${rows}
    </div>
  </div>
  <div class="help" style="margin-top:10px;">Bar color = trade (subtle) · ${ICO.triangleFlag} critical · ${ICO.dot} delayed · ${ICO.diamondFlag} at risk · ${ICO.check} complete (no icon = on track) · <span style="border-bottom:1.5px dashed var(--text-dim);">dashed outline</span> = planned · filled portion = accomplishment to-date · <span style="color:var(--red)">+Nd</span>/<span style="color:var(--green)">−Nd</span> = variance vs plan (position/badge) · small badge below name = data confidence · amber line = today · shaded zones = next 7/30 days${compareActive?' · <span style="color:var(--violet)">▬</span> violet bar = selected baseline':''}.</div>
  </div>`;
  /* === GANTT ZOOM LEVEL: START === */
  if(zoomLevel!=='ALL') requestAnimationFrame(scrollGanttToCenter);
  /* === GANTT ZOOM LEVEL: END === */
}

/* ---------- CLASH & SEQUENCE LOG ---------- */
let modalClashList = [];

function renderClashTable(items){
  modalClashList = items;
  return `<div class="chart-card" style="padding:0;overflow:hidden;">
  <table class="data"><thead><tr>
    <th>Type</th><th>Severity</th><th>Building</th><th>Floor</th><th>Task A</th><th>Task B</th><th>Overlap</th><th></th>
  </tr></thead><tbody>
  ${items.map((v,idx)=>`<tr class="clash-row" style="cursor:pointer;" onclick="openClashModal(${idx})">
    <td><span class="tag ${v.type==='space-time'?'red':'amber'}">${v.type==='space-time'?'Space/Time':'Sequence'}</span></td>
    <td><span class="tag ${v.severity==='High'?'red':v.severity==='Medium'?'amber':'gray'}">${v.severity}</span></td>
    <td>${esc(v.taskA.building)}</td>
    <td class="mono">${esc(v.taskA.level||'—')}</td>
    <td>${esc(v.taskA.name)} <span class="mono">(${esc(v.taskA.trade)})</span></td>
    <td>${esc(v.taskB.name)} <span class="mono">(${esc(v.taskB.trade)})</span></td>
    <td class="mono">${v.overlapDays}d</td>
    <td onclick="event.stopPropagation()">${v.type==='space-time' ? `<button class="small-btn" onclick="markCompatible('${escOnclickArg(v.taskA.trade)}','${escOnclickArg(v.taskB.trade)}')">Mark compatible</button>` : ''}</td>
  </tr>`).join('')}
  </tbody></table></div>`;
}

function markCompatible(a,b){
  state.compatiblePairs[pairKey(a,b)] = true;
  saveRules();
  toast(`${a} + ${b} marked compatible — future overlaps in the same floor won't flag.`, 'ok');
  render();
}
window.markCompatible = markCompatible;

function openClashModal(idx){
  const v = modalClashList[idx];
  if(!v) return;
  const bg = document.createElement('div');
  bg.className = 'modal-bg';
  bg.addEventListener('click', e=>{ if(e.target===bg) bg.remove(); });
  bg.innerHTML = `<div class="modal">
    <h3>${v.type==='space-time' ? 'Space/Time Clash' : 'Sequence Violation'}
      <span class="tag ${v.severity==='High'?'red':v.severity==='Medium'?'amber':'gray'}" style="margin-left:8px;vertical-align:middle;">${v.severity}</span>
    </h3>
    <div class="desc">${esc(v.note)}</div>
    <div class="field"><label>Building / Floor</label><div class="mono">${esc(v.taskA.building)} · ${esc(v.taskA.level||'—')}</div></div>
    <div class="field">
      <label>Task A${v.taskA.p6ActivityId?' · '+esc(v.taskA.p6ActivityId):''}</label>
      <div>${esc(v.taskA.name)} <span class="mono">(${esc(v.taskA.trade)})</span></div>
      <div class="det">${fmtDate(v.taskA.plannedStart)} – ${fmtDate(v.taskA.plannedFinish)}</div>
    </div>
    <div class="field">
      <label>Task B${v.taskB.p6ActivityId?' · '+esc(v.taskB.p6ActivityId):''}</label>
      <div>${esc(v.taskB.name)} <span class="mono">(${esc(v.taskB.trade)})</span></div>
      <div class="det">${fmtDate(v.taskB.plannedStart)} – ${fmtDate(v.taskB.plannedFinish)}</div>
    </div>
    <div class="field"><label>Overlap</label><div class="mono">${v.overlapDays} day(s)</div></div>
    <div class="btn-row" style="margin-top:10px;">
      ${v.type==='space-time' ? `<button class="btn primary" onclick="markCompatible('${escOnclickArg(v.taskA.trade)}','${escOnclickArg(v.taskB.trade)}');this.closest('.modal-bg').remove();">Mark compatible</button>` : ''}
      <button class="btn" onclick="this.closest('.modal-bg').remove();">Close</button>
    </div>
  </div>`;
  document.body.appendChild(bg);
}
window.openClashModal = openClashModal;

function renderClashes(c){
  const seq = computeSequenceViolations();
  const clash = computeSpaceTimeClashes();
  const shifted = computeShiftedTasks();
  const lockedConflicts = state.lockedImportConflicts||[];
  const badData = state.tasks.filter(t=>t.dataIssues && t.dataIssues.length);
  const flaggedUpdates = computeFlaggedFieldUpdates();
  /* === UNLEVELED TASK VISIBILITY: START === */
  const unleveled = computeUnleveledTasks();
  /* === UNLEVELED TASK VISIBILITY: END === */

  c.innerHTML = `
  ${badData.length ? `
  <div class="section-title">Data Quality Issues <span class="hint">${badData.length} task(s) excluded from charts</span></div>
  <div class="chart-card" style="padding:0;overflow:hidden;">
    <table class="data"><thead><tr><th>Building</th><th>Trade</th><th>Task</th><th>Issue</th><th>Source</th></tr></thead><tbody>
    ${badData.map(t=>`<tr>
      <td>${esc(t.building)}</td><td class="mono">${esc(t.trade)}</td><td>${esc(t.name)}</td>
      <td><span class="tag amber">${esc(t.dataIssues[0])}</span></td>
      <td class="mono">${esc(t.sourceFile)} / ${esc(t.sourceSheet)}</td>
    </tr>`).join('')}
    </tbody></table></div>` : ''}

  ${unleveled.length ? `
  <div class="section-title" style="margin-top:${badData.length?'26px':'0'};">Floor Not Detected <span class="hint">${unleveled.length} task(s) excluded from Space/Time Clash detection</span></div>
  <div class="warning-banner">${ICO.building} <div>These tasks have valid dates but their floor/level could not be parsed from the description — they are <b>silently skipped</b> by the clash engine. Add a recognizable floor label to the source description (e.g. "Ground Floor", "3rd Floor", "Podium"), then re-import.</div></div>
  <div class="chart-card" style="padding:0;overflow:hidden;max-height:280px;overflow-y:auto;">
    <table class="data"><thead><tr><th>Building</th><th>Trade</th><th>Task</th><th>Category</th><th>Source</th></tr></thead><tbody>
    ${unleveled.map(t=>`<tr>
      <td>${esc(t.building)}</td><td class="mono">${esc(t.trade)}</td><td>${esc(t.name)}</td>
      <td>${esc(t.category||'—')}</td>
      <td class="mono">${esc(t.sourceFile)} / ${esc(t.sourceSheet)}</td>
    </tr>`).join('')}
    </tbody></table></div>` : ''}

  <div class="section-title" style="margin-top:${(badData.length||unleveled.length)?'26px':'0'};">Space/Time Clashes <span class="hint">${clash.length} open${unleveled.length?` · ${unleveled.length} not checked (no floor detected)`:''}</span></div>
  ${clash.length ? renderClashTable(clash) : `<div class="help">None detected — no two trades are booked in the same building &amp; floor at overlapping times beyond tolerance.</div>`}

  <div class="section-title" style="margin-top:26px;">Sequence Violations <span class="hint">${seq.length} open</span></div>
  ${seq.length ? renderClashTable(seq) : `<div class="help">None detected — predecessor/successor order looks consistent within each trade schedule.</div>`}

  <div class="section-title" style="margin-top:26px;">Smart Validation Flags <span class="hint">${flaggedUpdates.length} field update(s) flagged</span></div>
  ${flaggedUpdates.length ? `<div class="chart-card" style="padding:0;overflow:hidden;">
    <table class="data"><thead><tr><th>Date</th><th>Task</th><th>Building</th><th>Prev%</th><th>New%</th><th>Flags</th><th>Logged By</th></tr></thead><tbody>
    ${flaggedUpdates.slice(0,100).map(u=>{
      const t = state.tasks.find(x=>x.id===u.taskId);
      return `<tr>
