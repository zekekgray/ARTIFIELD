/* === MANUAL TASK EDIT: START ===
   Dati view-only ang Database tab — kailangan pa ng buong re-import para
   iayos ang isang maling date/weight/category. Dito, may modal na
   nagpapa-edit ng key fields nang direkta. Kung nagbago ang dates, naka-log
   pa rin sa revisionHistory (may `manualEdit: true` marker) para malinaw sa
   audit trail kung galing sa re-import o sa manual override ang pagbabago. */
function openEditTaskModal(id){
  const t = state.tasks.find(x=>x.id===id);
  if(!t) return;
  if(t.locked){ openLockedTaskNotice(t); return; }
  const toInputDate = iso => iso ? new Date(iso).toISOString().slice(0,10) : '';
  const bg = document.createElement('div');
  bg.className = 'modal-bg';
  bg.addEventListener('click', e=>{ if(e.target===bg) bg.remove(); });
  bg.innerHTML = `<div class="modal">
    <h3>Edit Task</h3>
    <div class="desc">${esc(t.name)} <span class="mono">(${esc(t.building)} · ${esc(t.trade)}${t.p6ActivityId?' · '+esc(t.p6ActivityId):''})</span></div>
    <div class="field"><label>Category</label><input type="text" id="editCategory" value="${esc(t.category||'')}"></div>
    <div class="field"><label>Subcategory</label><input type="text" id="editSubcategory" value="${esc(t.subcategory||'')}"></div>
    <div class="field"><label>Floor / Level</label><input type="text" id="editLevel" value="${esc(t.level||'')}"></div>
    ${t.originalPlannedStart ? `<div class="help" style="margin-bottom:10px;">${ICO.lock} Original Day-1 baseline: <b>${fmtDate(t.originalPlannedStart)} – ${fmtDate(t.originalPlannedFinish)}</b> (frozen — never overwritten by re-import, regardless of edits below)</div>` : ''}
    <div class="field"><label>Planned Start</label><input type="date" id="editPlannedStart" value="${toInputDate(t.plannedStart)}"></div>
    <div class="field"><label>Planned Finish</label><input type="date" id="editPlannedFinish" value="${toInputDate(t.plannedFinish)}"></div>
    <div class="field"><label>Revised Start (optional)</label><input type="date" id="editRevisedStart" value="${toInputDate(t.revisedStart)}"></div>
    <div class="field"><label>Revised Finish (optional)</label><input type="date" id="editRevisedFinish" value="${toInputDate(t.revisedFinish)}"></div>
    <div class="field"><label>Weight %</label><input type="number" step="0.01" id="editWeightPct" value="${t.weightPct!=null?t.weightPct:''}"></div>
    <div class="field"><label>Accomplishment To-Date %</label><input type="number" step="0.1" id="editAccToDatePct" value="${t.accToDatePct!=null?t.accToDatePct:''}"></div>
    <div class="btn-row" style="margin-top:10px;">
      <button class="btn primary" id="editSaveBtn">Save changes</button>
      <button class="btn" onclick="this.closest('.modal-bg').remove();">Cancel</button>
    </div>
  </div>`;
  document.body.appendChild(bg);
  bg.querySelector('#editSaveBtn').addEventListener('click', ()=>saveTaskEdit(id, bg));
}
window.openEditTaskModal = openEditTaskModal;

function saveTaskEdit(id, modalEl){
  const t = state.tasks.find(x=>x.id===id);
  if(!t) return;
  if(t.locked){ toast('This task is locked — unlock it first.', 'err'); return; }
  const val = sel => document.getElementById(sel).value;
  const parseDateInput = s => {
    if(!s) return null;
    const d = new Date(s+'T00:00:00');
    return isNaN(d.getTime()) ? null : d.toISOString();
  };
  const newPlannedStart = parseDateInput(val('editPlannedStart'));
  const newPlannedFinish = parseDateInput(val('editPlannedFinish'));
  if(newPlannedStart==null || newPlannedFinish==null){
    toast('Planned Start and Planned Finish are required.', 'err');
    return;
  }
  const newRevisedStart = parseDateInput(val('editRevisedStart'));
  const newRevisedFinish = parseDateInput(val('editRevisedFinish'));
  const wRaw = val('editWeightPct');
  const newWeightPct = wRaw===''? null : Number(wRaw);
  const aRaw = val('editAccToDatePct');
  const newAccToDatePct = aRaw==='' ? null : Number(aRaw);

  const datesChanged = t.plannedStart!==newPlannedStart || t.plannedFinish!==newPlannedFinish ||
                        t.revisedStart!==newRevisedStart || t.revisedFinish!==newRevisedFinish;
  if(datesChanged){
    t.revisionHistory = t.revisionHistory || [];
    t.revisionHistory.push({
      at: t.importedAt || new Date().toISOString(),
      plannedStart: t.plannedStart, plannedFinish: t.plannedFinish,
      revisedStart: t.revisedStart, revisedFinish: t.revisedFinish,
      manualEdit: true,
    });
  }

  t.category = val('editCategory').trim();
  t.subcategory = val('editSubcategory').trim();
  t.level = val('editLevel').trim() || null;
  t.plannedStart = newPlannedStart;
  t.plannedFinish = newPlannedFinish;
  t.revisedStart = newRevisedStart;
  t.revisedFinish = newRevisedFinish;
  t.weightPct = newWeightPct;
  t.accToDatePct = newAccToDatePct;
  t.manuallyEdited = true;
  t.editedAt = new Date().toISOString();
  /* === DATE LOGIC VALIDATION: START === */
  const staleLogicMsgs = ['Revised Finish is earlier than Revised Start', 'Revised Finish is earlier than the original Planned Start'];
  t.dataIssues = (t.dataIssues||[]).filter(m=>!staleLogicMsgs.some(p=>m.startsWith(p)));
  const editLogicIssues = checkDateLogicIssues(t.plannedStart, t.plannedFinish, t.revisedStart, t.revisedFinish);
  if(editLogicIssues.length){
    t.dataIssues.push(...editLogicIssues);
    t.confidence = 'low';
    toast('Saved, but flagged: '+editLogicIssues[0], 'err');
  }
  /* === DATE LOGIC VALIDATION: END === */

  saveDB();
  /* === S-CURVE DATE SEQUENCING: START ===
     Dati, ang direktang pag-edit ng Accomplishment % dito sa Database tab
     ay hindi nagre-record ng snapshot — kaya hindi ito nare-reflect sa
     S-curve "actual" line hanggang sa susunod na import/field update.
     Kinukuha ngayon ang isang snapshot kaagad pagkatapos i-save. */
  recordSnapshot();
  /* === S-CURVE DATE SEQUENCING: END === */
  modalEl.remove();
  toast('Task updated.', 'ok');
  render();
}
window.saveTaskEdit = saveTaskEdit;
/* === MANUAL TASK EDIT: END === */

