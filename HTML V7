/* === TOP NAV TOOLTIP: FLOATING, ATTACHED TO <body> — immune to any ancestor
   overflow:auto/hidden clipping (the .top-nav-pills scroll container forces
   overflow-y to 'auto' per spec even when set to 'visible', which silently
   clipped the old span-based tooltip). Reads the native `title` attribute
   as the label, then removes it so the browser's own slow-appearing native
   tooltip doesn't show alongside this instant custom one. === */
let _topNavTooltipEl = null;
function ensureTopNavTooltipEl(){
  if(_topNavTooltipEl) return _topNavTooltipEl;
  const el = document.createElement('div');
  el.id = 'topNavTooltip';
  el.style.cssText = 'position:fixed;z-index:999;background:#0D1319;border:1px solid #212B38;border-radius:6px;padding:5px 10px;font-size:11px;color:#EDF1F5;white-space:nowrap;pointer-events:none;opacity:0;transition:opacity .12s;box-shadow:0 8px 20px rgba(0,0,0,.35);font-family:-apple-system,BlinkMacSystemFont,sans-serif;';
  document.body.appendChild(el);
  _topNavTooltipEl = el;
  return el;
}
function showTopNavTooltip(target, text){
  if(!text) return;
  const el = ensureTopNavTooltipEl();
  el.textContent = text;
  el.style.left = '-9999px'; el.style.top='-9999px'; el.style.opacity = '1';
  const rect = target.getBoundingClientRect();
  const tw = el.offsetWidth;
  let left = rect.left + rect.width/2 - tw/2;
  left = Math.max(4, Math.min(left, window.innerWidth - tw - 4));
  el.style.left = left+'px';
  el.style.top = (rect.bottom + 8)+'px';
}
function hideTopNavTooltip(){
  if(_topNavTooltipEl) _topNavTooltipEl.style.opacity = '0';
}
function attachTopNavTooltips(){
  document.querySelectorAll('.top-nav-pill[title], .top-nav-fab[title]').forEach(btn=>{
    if(btn._tnTooltipAttached) return;
    btn._tnTooltipAttached = true;
    const label = btn.getAttribute('title') || '';
    btn.removeAttribute('title');
    btn.addEventListener('mouseenter', ()=>showTopNavTooltip(btn, label));
    btn.addEventListener('mouseleave', hideTopNavTooltip);
  });
}
window.attachTopNavTooltips = attachTopNavTooltips;
