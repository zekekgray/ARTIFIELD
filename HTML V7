    // real connective field available.
    affectedTasks = state.tasks.filter(t=>t.building===v.building && (!v.level || t.level===v.level) && hasValidDates(t)).slice(0,1);
  } else {
    // seq/clash — taskA is the source, downstream from its finish
    const list = kind==='seq' ? state.tasks : state.tasks; // resolved via id below
  }
  const bg = document.createElement('div');
