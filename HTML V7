/* === MULTI-SERIES COMPARE OVERLAY: START === */
.compare-panel{background:var(--panel);border:1px solid var(--line-soft);border-radius:var(--radius);padding:18px;margin-bottom:18px;}
.compare-panel h4{margin:0 0 2px;font-size:13px;font-weight:650;}
.compare-panel .sub{font-size:11px;color:var(--text-faint);margin-bottom:14px;font-family:var(--mono);}
.compare-controls{display:flex;flex-direction:column;gap:12px;margin-bottom:16px;}
.compare-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
.compare-label{font-size:11px;color:var(--text-faint);min-width:64px;}
.compare-mode-toggle{display:flex;gap:2px;background:var(--panel-2);border:1px solid var(--line);border-radius:8px;padding:2px;}
.compare-mode-toggle button{all:unset;cursor:pointer;font-size:11.5px;padding:6px 12px;border-radius:6px;color:var(--text-dim);}
.compare-mode-toggle button.active{background:var(--blue);color:#04121A;font-weight:600;}
.compare-chip{
  all:unset;cursor:pointer;display:inline-flex;align-items:center;gap:7px;font-size:11.5px;
  padding:6px 12px 6px 8px;border-radius:20px;border:1px solid var(--line);color:var(--text-dim);
  transition:all .12s;background:var(--panel-2);
}
.compare-chip:hover{border-color:#3A4759;color:var(--text);}
.compare-chip .swatch{width:9px;height:9px;border-radius:50%;background:#3A4759;flex:none;transition:background .12s;}
.compare-chip.selected{color:var(--text);border-color:var(--chip-color, var(--blue));background:color-mix(in srgb, var(--chip-color, var(--blue)) 14%, transparent);}
.compare-chip.selected .swatch{background:var(--chip-color, var(--blue));}
.compare-toolbtn{all:unset;cursor:pointer;font-size:11px;padding:5px 10px;border-radius:6px;color:var(--text-faint);border:1px solid transparent;}
.compare-toolbtn:hover{color:var(--text-dim);background:var(--panel-2);}
.compare-check{display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--text-dim);cursor:pointer;user-select:none;}
.compare-check input{accent-color:var(--blue);width:14px;height:14px;}
.compare-empty{border:1px dashed #2A3644;border-radius:10px;padding:26px;text-align:center;color:var(--text-faint);font-size:12px;}
.compare-legend-list{display:flex;flex-wrap:wrap;gap:10px 18px;margin-top:10px;}
.compare-legend-item{
  all:unset;cursor:pointer;display:inline-flex;align-items:center;gap:7px;font-size:11.5px;color:var(--text-dim);
  padding:3px 4px;border-radius:6px;
}
.compare-legend-item i{width:16px;height:3px;border-radius:2px;display:inline-block;flex:none;}
.compare-legend-item.off{opacity:.35;text-decoration:line-through;}
.compare-legend-item .cli-val{font-family:var(--mono);color:var(--text-faint);margin-left:2px;}
.compare-tooltip{
  position:absolute;top:8px;left:8px;z-index:10;background:#0D1319;border:1px solid var(--line);
  border-radius:8px;padding:10px 12px;font-size:11.5px;line-height:1.55;pointer-events:none;opacity:0;
  transition:opacity .08s;box-shadow:0 8px 24px rgba(0,0,0,.35);min-width:180px;max-width:260px;
}
.compare-tooltip .ctt-date{font-family:var(--mono);color:var(--text-dim);font-size:10.5px;margin-bottom:5px;padding-bottom:5px;border-bottom:1px solid var(--line-soft);}
.compare-tooltip .ctt-row{display:flex;align-items:center;gap:10px;justify-content:space-between;}
.compare-tooltip .ctt-row .ctt-name{display:flex;align-items:center;gap:6px;color:var(--text-dim);}
.compare-tooltip .ctt-row i{width:8px;height:8px;border-radius:50%;display:inline-block;flex:none;}
.compare-tooltip .ctt-row b{color:var(--text);font-family:var(--mono);}
.compare-tooltip .ctt-hint{margin-top:5px;padding-top:5px;border-top:1px solid var(--line-soft);color:var(--text-faint);font-size:10px;}
.compare-warn{font-size:10.5px;color:var(--amber);margin-top:2px;}
/* === MULTI-SERIES COMPARE OVERLAY: END === */

.trade-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px;}

/* ---------- Executive rows ---------- */
.exec-row{display:grid;grid-template-columns:1.1fr .7fr .7fr .9fr 1fr .5fr;gap:14px;align-items:center;padding:14px 18px;border-bottom:1px solid var(--line-soft);}
.exec-row:last-child{border-bottom:none;}
.exec-row .bname{font-size:14px;font-weight:600;}
.exec-row .blabel{font-size:10.5px;color:var(--text-faint);margin-top:2px;}
.exec-metric .m-label{font-size:10.5px;color:var(--text-faint);}
.exec-metric .m-value{font-family:var(--mono);font-size:15px;margin-top:2px;font-weight:600;}
.status-dot{width:11px;height:11px;border-radius:50%;display:inline-block;}
.status-dot.red{background:var(--red);box-shadow:0 0 0 3px var(--red-dim);}
.status-dot.amber{background:var(--amber);box-shadow:0 0 0 3px var(--amber-dim);}
.status-dot.green{background:var(--green);box-shadow:0 0 0 3px var(--green-dim);}

.warning-banner{border:1px solid var(--red-dim);background:linear-gradient(180deg,#1A0E0E,#120A0A);border-radius:var(--radius);padding:13px 16px;margin-bottom:10px;font-size:12.5px;display:flex;gap:10px;align-items:flex-start;}
.warning-banner b{color:var(--red);}

/* ---------- Gantt ---------- */
.gantt-wrap{overflow-x:auto;border:1px solid var(--line-soft);border-radius:var(--radius);background:var(--panel);}
.gantt-row{display:flex;border-bottom:1px solid var(--line-soft);}
.gantt-row:nth-child(even){background:#0D131A;}
.gantt-row:nth-child(even) .gantt-label{background:#0D131A;}
.gantt-row:hover{background:#111823 !important;}
.gantt-row:hover .gantt-label{background:#111823 !important;}
.gantt-label{
  width:260px;flex:none;padding:7px 12px;font-size:11.5px;position:sticky;left:0;background:var(--panel);
  border-right:1px solid var(--line-soft);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  display:flex;align-items:center;gap:6px;z-index:4;transition:background .1s;
}
.gantt-track{position:relative;height:32px;flex:none;z-index:1;}
.gantt-bar{
  position:absolute;top:15px;height:13px;border-radius:5px;opacity:.95;overflow:hidden;
  box-shadow:0 1px 3px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.12);
}
.gantt-bar-fill{position:absolute;left:0;top:0;bottom:0;background:rgba(255,255,255,.28);}
.gantt-bar.violation{outline:1.5px solid var(--red);}
/* === STATUS AS SHAPE, NOT COLOR: START === */
.gantt-status-glyph{position:absolute;top:-11px;font-size:11px;font-weight:700;line-height:1;pointer-events:none;text-shadow:0 1px 2px rgba(0,0,0,.6);z-index:3;}
/* === STATUS AS SHAPE, NOT COLOR: END === *//* === PLANNED VS ACTUAL OVERLAY: START === */
.gantt-bar-planned{
  position:absolute;top:4px;height:8px;border-radius:4px;border:1.5px dashed;
  background:transparent;opacity:.75;pointer-events:none;
}
.gantt-variance-badge{
  position:absolute;top:8px;font-family:var(--mono);font-size:9.5px;font-weight:700;
  white-space:nowrap;pointer-events:none;text-shadow:0 1px 3px rgba(0,0,0,.7);z-index:3;
}
/* === PLANNED VS ACTUAL OVERLAY: END === */
/* === GANTT BASELINE COMPARE — BARS & BANNER: START === */
.gantt-bar-baseline{
  position:absolute;top:25px;height:4px;border-radius:2px;
  background:var(--violet);opacity:.6;pointer-events:none;
}
.gantt-baseline-variance{
  position:absolute;top:23px;font-family:var(--mono);font-size:9px;font-weight:700;
  color:var(--violet);white-space:nowrap;pointer-events:none;text-shadow:0 1px 3px rgba(0,0,0,.7);z-index:3;
}
/* === GANTT BASELINE COMPARE — BARS & BANNER: END === */
/* === GANTT DEPENDENCY CHAIN: START === */
.gantt-chain{margin-top:12px;padding-top:12px;border-top:1px solid var(--line-soft);display:flex;flex-direction:column;align-items:flex-start;gap:2px;}
.gantt-chain-node{display:flex;align-items:baseline;gap:8px;padding:5px 10px;border-radius:7px;cursor:pointer;transition:background .12s;}
.gantt-chain-node:hover{background:var(--panel-2);}
.gantt-chain-node.selected{background:color-mix(in srgb, var(--blue) 16%, transparent);cursor:default;}
.gantt-chain-role{font-family:var(--mono);font-size:9.5px;letter-spacing:.06em;color:var(--text-faint);min-width:82px;flex:none;}
.gantt-chain-node.selected .gantt-chain-role{color:var(--blue);}
.gantt-chain-name{font-size:12.5px;color:var(--text);}
.gantt-chain-arrow{padding-left:14px;color:var(--text-faint);font-family:var(--mono);font-size:12px;}
/* === GANTT DEPENDENCY CHAIN: END === */
.gantt-milestone{
  position:absolute;top:6px;width:14px;height:14px;transform:translateX(-50%) rotate(45deg);
  border-radius:3px;box-shadow:0 1px 3px rgba(0,0,0,.4);
}
/* === DELAY IMPACT CASCADE: START === */
.gantt-impact-badge{
  position:absolute;top:8px;font-family:var(--mono);font-size:9.5px;font-weight:700;
  white-space:nowrap;cursor:pointer;color:var(--blue);text-shadow:0 1px 3px rgba(0,0,0,.7);
  z-index:4;padding:0 4px;border-radius:3px;background:rgba(79,195,247,.14);
}
.gantt-impact-badge:hover{background:rgba(79,195,247,.28);}
.gantt-chain-glyph{color:var(--blue);font-size:10px;margin-right:3px;flex:none;cursor:help;}
/* === DELAY IMPACT CASCADE: END === */
/* === DATA CONFIDENCE INDICATORS: START === */
.gantt-conf-badge{
  all:unset;cursor:pointer;display:inline-flex;align-items:center;gap:3px;
  font-family:var(--mono);font-size:9.5px;font-weight:650;margin-left:6px;
  padding:1px 5px 1px 4px;border-radius:20px;flex:none;
  background:color-mix(in srgb, var(--conf-color, var(--text-faint)) 16%, transparent);
}
.gantt-conf-badge:hover{background:color-mix(in srgb, var(--conf-color, var(--text-faint)) 28%, transparent);}
.gantt-conf-badge .dot{width:6px;height:6px;border-radius:50%;background:var(--conf-color, var(--text-faint));flex:none;}
/* === DATA CONFIDENCE INDICATORS: END === */
.gantt-milestone.violation{outline:1.5px solid var(--red);}
.gantt-bldg-head{background:#0D141C;border-bottom:1px solid var(--line-soft);border-top:1px solid var(--line-soft);position:relative;}
.gantt-bldg-head:first-child{border-top:none;}
.gantt-bldg-head-inner{
  position:sticky;left:0;display:inline-flex;align-items:center;gap:8px;white-space:nowrap;
  padding:9px 12px;font-family:var(--mono);font-size:11px;color:var(--blue);letter-spacing:.05em;
}
.gantt-bldg-count{color:var(--text-faint);font-weight:400;letter-spacing:0;}
/* === CONSOLIDATED GANTT — HIERARCHY: START === */
.gantt-chevron{display:inline-block;width:10px;text-align:center;color:var(--text-faint);}
.gantt-group-row{cursor:pointer;}
.gantt-group-row:hover td, .gantt-group-row:hover{background:#111823;}
.gantt-trade-head{background:#0F161E;border-bottom:1px solid var(--line-soft);position:relative;}
.gantt-trade-head-inner{
  position:sticky;left:0;display:inline-flex;align-items:center;gap:8px;white-space:nowrap;
  padding:7px 12px 7px 28px;font-size:11.5px;color:var(--text-dim);
}
.gantt-rollup-pct{font-family:var(--mono);color:var(--text-dim);margin-left:auto;padding-right:10px;font-size:11px;}
.gantt-agg-bar{position:absolute;top:9px;height:14px;border-radius:5px;opacity:.5;box-shadow:inset 0 0 0 1px rgba(255,255,255,.15);}
.gantt-agg-bar-fill{position:absolute;left:0;top:0;bottom:0;background:rgba(255,255,255,.4);border-radius:5px 0 0 5px;}
/* === CONSOLIDATED GANTT — HIERARCHY: END === */
.gantt-gridline-year{position:absolute;top:0;bottom:0;width:1px;background:#28323F;}
.gantt-gridline-month{position:absolute;top:0;bottom:0;width:1px;background:#161D26;}
.gantt-weekend{position:absolute;top:0;bottom:0;background:rgba(255,255,255,.02);}
.gantt-today-label{
  position:absolute;top:-1px;transform:translateX(-50%);z-index:6;
  background:#FFB020;color:#04121A;font-family:var(--mono);font-size:9.5px;font-weight:700;
  padding:1px 6px;border-radius:4px;white-space:nowrap;
