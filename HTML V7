/* === ENGINE — DATA/EXTRACTION CONTROL MODAL (HONEST VERSION): START ===
   Sagot sa "Can I trust the data/engine?" gamit LAMANG totoong data na
   meron ang app: extraction sessions (state.extractionSessions), Vex
   extraction metadata (state.vexMeta — structuralFindings/blindSpots/
   overallConfidence), locked-task import conflicts (mga kailangan pa ng
   manual review), at ang data-confidence tally (tallyConfidence, parehong
   engine sa Extraction Review screen). SINADYANG WALANG AI Router (Gemini/
   Claude/OpenAI fallback), Job Queue, o Data Versioning (v42/v43) dito —
   walang ganyang backend architecture ang app na ito (Apps Script +
   Sheets lang), kaya ang pagpapakita ng ganyang numero ay magiging peke.
   Kapag nagkaroon na ng totoong backend para dito, dito rin idadagdag. */
function computeEngineData(){
  const sessions = state.extractionSessions||[];
  const lastSession = sessions.length ? sessions[sessions.length-1] : null;
  const vexMeta = state.vexMeta||[];
  const conf = tallyConfidence(state.tasks);
  const totalConf = conf.high+conf.medium+conf.low;
  const highPct = totalConf ? Math.round(conf.high/totalConf*100) : 0;
  const lockedConflicts = state.lockedImportConflicts||[];
  const dataIssueTasks = state.tasks.filter(t=>t.dataIssues && t.dataIssues.length);
  const sourceFiles = new Set();
  state.tasks.forEach(t=>{ if(t.sourceFile) sourceFiles.add(t.sourceFile); });
  state.costEntries.forEach(e=>{ if(e.sourceFile) sourceFiles.add(e.sourceFile); });
  state.materialEntries.forEach(m=>{ if(m.sourceFile) sourceFiles.add(m.sourceFile); });
  const findings = vexMeta.flatMap(m=>(m.structuralFindings||[]).map(f=>Object.assign({},f,{fileLabel:m.fileLabel})));
  const blindSpots = vexMeta.flatMap(m=>(m.blindSpots||[]).map(b=>({text:b, fileLabel:m.fileLabel})));

  let status = 'HEALTHY', statusColor = 'var(--green)';
  if(lockedConflicts.length>0 || highPct<50){ status='NEEDS REVIEW'; statusColor='var(--red)'; }
  else if(dataIssueTasks.length>0 || highPct<80){ status='CAUTION'; statusColor='var(--amber)'; }

  return {sessions, lastSession, vexMeta, conf, highPct, lockedConflicts, dataIssueTasks,
    sourceFiles: [...sourceFiles], findings, blindSpots, status, statusColor};
}

