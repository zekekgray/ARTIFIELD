  const issuesTotal = (summary.needsReview.discrepancies||0) + (summary.needsReview.unusual||0) + (summary.needsReview.skipped||0);
  const session = {
    id: hashKey(['session', Date.now(), Math.random()].join('|')),
    at: new Date().toISOString(),
    source: summary.source || 'Unspecified',
    filesAnalyzed: summary.filesAnalyzed || 0,
    sheetsProcessed: summary.sheetsProcessed || 0,
    batchExtracted: (summary.confidence.high||0)+(summary.confidence.medium||0)+(summary.confidence.low||0),
    totalTasksAfter: state.tasks.length,
    totalBuildingsAfter: buildingList().length,
    costRecords: summary.costRecords || 0,
    materialRecords: summary.materialRecords || 0,
    rfis: summary.rfis || 0,
    variationOrders: summary.variationOrders || 0,
    confidence: summary.confidence,
    needsReview: summary.needsReview,
    issuesTotal,
  };
  state.extractionSessions.push(session);
  saveExtractionSessions();
  return session;
}

function computeSnapshotDelta(){
  const s = state.extractionSessions;
  if(s.length<2) return null;
  const cur = s[s.length-1], prev = s[s.length-2];
  return {
    prevAt: prev.at, curAt: cur.at,
    taskDelta: cur.totalTasksAfter - prev.totalTasksAfter,
    buildingDelta: cur.totalBuildingsAfter - prev.totalBuildingsAfter,
    issuesDelta: cur.issuesTotal - prev.issuesTotal,
    costDelta: cur.costRecords - prev.costRecords,
    materialDelta: cur.materialRecords - prev.materialRecords,
  };
}
