function captureBaseline(name){
  const trimmed = (name||'').trim();
  if(!trimmed){ toast('Enter a name for this baseline.', 'err'); return; }
  const taskDates = {};
  state.tasks.forEach(t=>{
    taskDates[t.id] = {
      name: t.name, building: t.building, trade: t.trade,
      plannedStart: t.plannedStart, plannedFinish: t.plannedFinish,
      revisedStart: t.revisedStart, revisedFinish: t.revisedFinish,
      weightPct: t.weightPct, accToDatePct: t.accToDatePct,
    };
  });
  state.baselines.push({
    id: hashKey(['baseline', trimmed, Date.now()].join('|')),
    name: trimmed, createdAt: new Date().toISOString(), taskDates,
  });
  saveBaselines();
  toast(`Baseline "${trimmed}" saved (${state.tasks.length} tasks).`, 'ok');
  render();
}
