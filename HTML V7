/* === GANTT PNG EXPORT (html2canvas): START ===
   The Gantt chart is pure DOM (divs), not SVG, so the generic SVG-based
   exportChartPng() below can never find anything to capture on that tab.
   html2canvas renders the full (unscrolled) Gantt content — including
   sticky labels, which are temporarily un-stuck in the clone since a
   static export has no scrolling viewport to stick against — into a
   canvas, so the exported PNG shows the entire timeline width and full
   row list, not just whatever happened to be visible on screen. */
/* === GANTT PNG EXPORT — COLOR-MIX RESOLUTION: START ===
   html2canvas cannot parse the modern CSS color-mix() function used
   throughout the Gantt (bar tints, confidence badges, etc.) — it throws
   "attempting to parse an unsupported color function 'color-mix'".
   getComputedStyle() on the LIVE element always resolves color-mix() down
   to a concrete rgb()/rgba() value (the browser has to compute it to
   paint the pixel), so walking the original and cloned trees in lockstep
   and copying the resolved colors onto the clone's inline style sidesteps
   the parser entirely — html2canvas then only ever sees plain rgb/rgba. */
function resolveColorsForCapture(origEl, cloneEl){
  const cs = window.getComputedStyle(origEl);
  cloneEl.style.backgroundColor = cs.backgroundColor;
  cloneEl.style.color = cs.color;
  cloneEl.style.borderTopColor = cs.borderTopColor;
  cloneEl.style.borderRightColor = cs.borderRightColor;
  cloneEl.style.borderBottomColor = cs.borderBottomColor;
  cloneEl.style.borderLeftColor = cs.borderLeftColor;
  const origChildren = origEl.children;
  const cloneChildren = cloneEl.children;
  for(let i=0;i<origChildren.length;i++){
    if(cloneChildren[i]) resolveColorsForCapture(origChildren[i], cloneChildren[i]);
  }
}
/* === GANTT PNG EXPORT — COLOR-MIX RESOLUTION: END === */

function exportGanttPng(){
  const scrollWrap = document.getElementById('ganttScrollWrap');
  if(!scrollWrap){
    toast('Open the Gantt tab first, then try exporting again.', 'err');
    return;
  }
  if(typeof html2canvas === 'undefined'){
    toast('Chart export library failed to load — check your connection and try again.', 'err');
    return;
  }
  const inner = scrollWrap.firstElementChild;
  if(!inner){ toast('Nothing to export yet.', 'err'); return; }

  toast('Preparing Gantt image — this can take a few seconds for large schedules…', 'ok');

  const clone = inner.cloneNode(true);
  resolveColorsForCapture(inner, clone);
  clone.querySelectorAll('.gantt-label, .gantt-bldg-head-inner, .gantt-trade-head-inner').forEach(el=>{
    el.style.position = 'relative';
    el.style.left = '0';
  });

  const captureWrap = document.createElement('div');
  captureWrap.style.position = 'fixed';
  captureWrap.style.left = '-99999px';
  captureWrap.style.top = '0';
  captureWrap.style.background = '#0A0D12';
  captureWrap.appendChild(clone);
  document.body.appendChild(captureWrap);

  requestAnimationFrame(()=>{
    html2canvas(clone, {
      backgroundColor: '#0A0D12',
      scale: 2,
      useCORS: true,
      logging: false,
    }).then(canvas=>{
      captureWrap.remove();
      canvas.toBlob(blob=>{
        if(!blob){ toast('Could not generate the Gantt image.', 'err'); return; }
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = slugifyProjectName()+'-gantt.png';
        document.body.appendChild(a); a.click(); a.remove();
        toast('Exported Gantt chart as PNG.', 'ok');
        closeExportCenterModal();
      });
    }).catch(err=>{
      captureWrap.remove();
      toast('Could not export the Gantt chart: '+err.message, 'err');
    });
  });
}
window.exportGanttPng = exportGanttPng;
/* === GANTT PNG EXPORT (html2canvas): END === */

function exportChartPng(){
  /* === GANTT PNG EXPORT: route to the DOM-based exporter on the Gantt tab === */
  if(state.tab==='gantt'){ exportGanttPng(); return; }
  const svg = document.querySelector('#content svg');
  if(!svg){ toast('No chart on this tab yet — switch to S-Curve, Trades, or a Curves tab first, then try again.', 'err'); return; }
  const vb = (svg.getAttribute('viewBox')||'0 0 900 260').split(' ').map(Number);
  const w = vb[2]||900, h = vb[3]||260, scale = 2;
  const clone = svg.cloneNode(true);
  clone.setAttribute('width', w); clone.setAttribute('height', h);
  const xml = new XMLSerializer().serializeToString(clone);
  const url = URL.createObjectURL(new Blob([xml], {type:'image/svg+xml;charset=utf-8'}));
  const img = new Image();
  img.onload = ()=>{
    const canvas = document.createElement('canvas');
    canvas.width = w*scale; canvas.height = h*scale;
    const ctx = canvas.getContext('2d');
    ctx.fillStyle = '#0A0D12'; ctx.fillRect(0,0,canvas.width,canvas.height);
    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
    URL.revokeObjectURL(url);
    canvas.toBlob(blob=>{
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = slugifyProjectName()+'-chart.png';
      document.body.appendChild(a); a.click(); a.remove();
      toast('Exported chart as PNG.', 'ok');
      closeExportCenterModal();
    });
  };
  img.onerror = ()=>toast('Could not render this chart to PNG.', 'err');
  img.src = url;
}
window.exportChartPng = exportChartPng;

