function buildCompareSeriesDefs(){
  const ids = state.compare.selected;
  return ids.map(id=>{
    const tasks = state.compare.mode==='trade'
      ? state.tasks.filter(t=>t.trade===id)
      : state.tasks.filter(t=>t.building===id);
