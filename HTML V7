/* === SCHEDULE — SCHEDULE CONTROL MODAL: START ===
   Sagot sa "Nasaan na ang project schedule at saan ito pupunta?" — hindi
   basta Gantt ulit. Totoong laman lang: control-status engine na meron na
   (computeGanttControlStatus) para sa "critical path" (walang buong CPM
   float sa dataset natin, kaya ito ay based sa delayed+flagged tasks, hindi
   pormal na float calculation), at delay-by-trade sa halip na gawa-gawang
   delay-reason categories na wala namang structured field sa data. Activity
   drill-down ay direktang gumagamit ng existing openGanttTaskDrawer — isang
   detail panel na lang para sa buong app, consistent kahit saan pinasok. */
function computeScheduleHealth(){
  const seqV = computeSequenceViolations(), clashV = computeSpaceTimeClashes();
  const flaggedIds = new Set();
  [...seqV, ...clashV].forEach(v=>{ flaggedIds.add(v.taskA.id); flaggedIds.add(v.taskB.id); });
  const controlStatus = computeGanttControlStatus(state.tasks, flaggedIds);
  const dated = state.tasks.filter(hasValidDates);
  const total = state.tasks.length;
  const completed = state.tasks.filter(t=>t.accToDatePct!=null && t.accToDatePct>=99.5).length;
  const notStarted = state.tasks.filter(t=>t.accToDatePct==null || t.accToDatePct<=0).length;
  const inProgress = Math.max(0, total - completed - notStarted);

  const counts = {critical:0, delayed:0, atrisk:0, ontrack:0, completed:0};
  dated.forEach(t=>{ const s=(controlStatus[t.id]||{}).status||'ontrack'; counts[s]=(counts[s]||0)+1; });
  const datedTotal = dated.length || 1;
  const onTimePct = (counts.ontrack+counts.completed)/datedTotal*100;
  const delayedPct = counts.delayed/datedTotal*100;
  const criticalPct = counts.critical/datedTotal*100;
  const lowConfCount = state.tasks.filter(t=>t.confidence==='low').length;

  const criticalTasks = dated.filter(t=>(controlStatus[t.id]||{}).status==='critical')
    .sort((a,b)=>(b.shiftDays||0)-(a.shiftDays||0));
  const delayedTasks = dated.filter(t=>(controlStatus[t.id]||{}).status==='delayed')
    .sort((a,b)=>(b.shiftDays||0)-(a.shiftDays||0));
  const atriskTasks = dated.filter(t=>(controlStatus[t.id]||{}).status==='atrisk');

  const health = criticalTasks.length>0 ? 'CRITICAL' : (delayedTasks.length>0||atriskTasks.length>0) ? 'AT RISK' : 'ON TRACK';
  const healthColor = health==='CRITICAL'?'var(--red)':health==='AT RISK'?'var(--amber)':'var(--green)';

  const byTrade = {};
  delayedTasks.forEach(t=>{ byTrade[t.trade]=(byTrade[t.trade]||0)+1; });
  const delayByTrade = Object.entries(byTrade).sort((a,b)=>b[1]-a[1]).slice(0,6);

  return {total, completed, inProgress, notStarted, onTimePct, delayedPct, criticalPct, lowConfCount,
    criticalTasks, delayedTasks, atriskTasks, health, healthColor, delayByTrade};
}

