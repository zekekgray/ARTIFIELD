function serializeFullState(){
  return JSON.stringify({
    tasks: state.tasks, costEntries: state.costEntries, materialEntries: state.materialEntries,
    projectMeta: state.projectMeta, compatiblePairs: state.compatiblePairs, verifications: state.verifications,
    snapshots: state.snapshots, fieldUpdates: state.fieldUpdates, manpowerLogs: state.manpowerLogs,
    materialLogs: state.materialLogs, materialPlan: state.materialPlan, projectName: state.projectName,
    projectAddress: state.projectAddress, lastImport: state.lastImport, lockedImportConflicts: state.lockedImportConflicts,
    quantityTakedowns: state.quantityTakedowns, violations: state.violations, forecastNotes: state.forecastNotes,
    variationOrders: state.variationOrders, rfis: state.rfis, vexMeta: state.vexMeta,
    buildingAliases: state.buildingAliases, buildingSuggestionsDismissed: state.buildingSuggestionsDismissed,
    baselines: state.baselines, extractionSessions: state.extractionSessions,
  });
}

function applyFullState(json){
  const d = JSON.parse(json);
  Object.keys(d).forEach(k=>{ state[k] = d[k]; });
}

let _syncTimer = null;
function syncToBackend(){
  if(!state.projectId){ return; } // walang project selected — nothing to save to yet
  clearTimeout(_syncTimer);
  _syncTimer = setTimeout(()=>{
    google.script.run
      .withSuccessHandler(res=>{ if(!res || !res.success) toast('Could not save to server.', 'err'); })
      .withFailureHandler(err=>toast('Save failed: '+err.message, 'err'))
      .saveProjectState(state.projectId, serializeFullState(), '', 'ARTIFIELD', 'v1');
  }, 1200); // debounce — sabay-sabay na maraming save calls sa loob ng 1.2s ay isang call na lang
}

async function loadProjectFromBackend(projectId){
  return new Promise((resolve)=>{
    google.script.run
      .withSuccessHandler(res=>{
        if(res && res.success && res.found){ applyFullState(res.json_result); }
        resolve(res);
      })
      .withFailureHandler(err=>{ toast('Could not load project: '+err.message, 'err'); resolve(null); })
      .getProjectState(projectId);
  });
}
/* === BACKEND SYNC (Apps Script + Sheets): END === */

