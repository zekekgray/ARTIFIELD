  renderSidebarProfile();
  renderTopNavPills();
  attachTopNavTooltips();
  restoreSidebarCollapsedState();
  setupSidebarOutsideClickClose();
  // Note: loadDB()/loadProjectFromBackend() ay tinatawag na ng
