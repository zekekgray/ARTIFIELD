/* === FOCUS MODE: START ===
   Ito ay HIWALAY na layer sa itaas ng granular filter bar (Building/Trade/
   Level/Status/atbp). Ang filter bar ay para sa "narrow down by attribute";
   ang Focus Mode ay para sa "isang click, tama agad ang tanong" — Current
   Week, Critical Path, Delayed, o isang partikular na task + ang mga
   kaagad na predecessor/successor nito. Pareho itong gumagana kasabay ng
   Building/Trade pills, kaya posible ang "Focus: Delayed Activities ·
   Building B" na parang totoong control-room query. */
function setGanttFocus(type){
  if(!state.ganttFocus) state.ganttFocus = {type:'', taskId:''};
  state.ganttFocus.type = (state.ganttFocus.type===type) ? '' : type;
  if(state.ganttFocus.type!=='task') state.ganttFocus.taskId = '';
  render();
}
