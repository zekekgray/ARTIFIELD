function badgeForConfidence(conf){
  const cls = conf==='high' ? 'green' : conf==='low' ? 'red' : 'amber';
  return `<span class="tag ${cls}">${esc(conf||'—')}</span>`;
}
function badgeForCategory(cat){
  const map = {CONFIRMED_ERROR:'red', DISCREPANCY:'amber', SUSPICIOUS:'violet', UNUSUAL:'gray'};
  return `<span class="tag ${map[cat]||'gray'}">${esc(cat||'—')}</span>`;
}

