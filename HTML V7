/* === SIDEBAR CLICK-OUTSIDE-TO-CLOSE: START ===
   Kapag bukas ang sidebar (hindi naka-sidebar-collapsed ang body), ang
   click kahit saan sa labas ng #sidebar mismo — hindi lang yung X button —
   ay magsasara na rin nito. Ginagamit ang capture phase (true) para
   masilip ang click bago pa ma-block/ma-stop ng ibang handler sa loob ng
   sidebar, at si-check muna kung open nga ang sidebar bago mag-react para
   walang epekto ito habang naka-collapse na (default state). */
function setupSidebarOutsideClickClose(){
  document.addEventListener('click', e=>{
    const isOpen = !document.body.classList.contains('sidebar-collapsed');
    if(!isOpen) return;
    const sidebar = document.getElementById('sidebar');
    const hamburgerFab = document.getElementById('sidebarOpenFab');
    if(!sidebar) return;
    if(sidebar.contains(e.target)) return;
    if(hamburgerFab && hamburgerFab.contains(e.target)) return;
    document.body.classList.add('sidebar-collapsed');
    try{ window.storage.set(KEY_SIDEBAR_COLLAPSED, 'true', false); }catch(err){}
  }, true);
}
