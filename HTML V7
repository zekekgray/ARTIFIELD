function resolveGanttExportScope(scope, buildingSel){
  if(scope==='full') return state.tasks;
  if(scope==='building') return state.tasks.filter(t=>t.building===buildingSel);
  // 'current' — respects whatever filters/focus are active kung nasa Gantt tab ka
  const seqV = computeSequenceViolations(), clashV = computeSpaceTimeClashes();
  const flaggedIds = new Set();
  [...seqV, ...clashV].forEach(v=>{ flaggedIds.add(v.taskA.id); flaggedIds.add(v.taskB.id); });
  const controlStatus = computeGanttControlStatus(state.tasks, flaggedIds);
  let scoped = applyGanttFilters(state.tasks, flaggedIds);
  scoped = applyGanttFocus(scoped, controlStatus, flaggedIds);
  return scoped;
}

/* === GANTT SVG EXPORT — XML ESCAPING & VALIDATION: START === */
function escapeXmlText(value){
  return String(value==null?'':value).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function escapeXmlAttr(value){
  return String(value==null?'':value).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/'/g,'&apos;');
}
// Numeric attributes (x/y/width/height) must never carry NaN or exponential
// notation (e.g. "1.2e+21" on an extremely long horizon) — both are invalid
// or unpredictable as SVG coordinate values even though they're not an XML
// escaping issue per se.
function num(v){
  return (typeof v==='number' && isFinite(v)) ? v.toFixed(2) : '0';
}
// Final safety net: parse the generated string as XML and check for a
// parsererror node. Catches anything the escape helpers might have missed
// (e.g. a future edit that forgets to escape a new dynamic value) BEFORE
// the user ends up with a broken downloaded file.
function validateSvgString(svgString){
  try{
    const doc = new DOMParser().parseFromString(svgString, 'image/svg+xml');
    const errNode = doc.querySelector('parsererror');
    if(errNode) return { ok:false, message: errNode.textContent.slice(0,200) };
    return { ok:true };
  }catch(e){
    return { ok:false, message: e.message };
  }
}
/* === GANTT SVG EXPORT — XML ESCAPING & VALIDATION: END === */

function buildGanttExportSVG(tasks, opts){
  const withDates = tasks.filter(hasValidDates);
  if(!withDates.length) return null;

  const byBuilding = {};
  withDates.forEach(t=>{
    (byBuilding[t.building]=byBuilding[t.building]||{});
    (byBuilding[t.building][t.trade]=byBuilding[t.building][t.trade]||[]).push(t);
  });
  const buildings = Object.keys(byBuilding).sort();

  const rows = [];
  buildings.forEach(b=>{
    rows.push({type:'building', label:'BUILDING '+b});
    Object.keys(byBuilding[b]).sort().forEach(tr=>{
      rows.push({type:'trade', label:tr});
      byBuilding[b][tr].slice().sort((a,c)=>new Date(a.plannedStart)-new Date(c.plannedStart))
        .forEach(t=>rows.push({type:'task', task:t}));
    });
  });

  let minD = opts.dateStart ? new Date(opts.dateStart) : new Date(Math.min(...withDates.map(t=>+new Date(t.plannedStart))));
  let maxD = opts.dateEnd ? new Date(opts.dateEnd) : new Date(Math.max(...withDates.map(t=>+new Date(t.revisedFinish||t.plannedFinish))));
  if(!opts.dateEnd) maxD = new Date(+maxD + 14*DAY);
  if(maxD<=minD) maxD = new Date(+minD+DAY);
  const totalDays = Math.max(1,(maxD-minD)/DAY);

  const ROW_H=22, LABEL_W=260, HEADER_H=40, LEGEND_H=opts.includeLegend?30:0, FOOTER_H=opts.includeSource?40:0;
  const chartW=1400, trackW=chartW-LABEL_W, pxPerDay=trackW/totalDays;
  const chartH = HEADER_H + rows.length*ROW_H + LEGEND_H + FOOTER_H + 20;
  const x = d => LABEL_W + ((d-minD)/DAY)*pxPerDay;

  const tradePalette = ['#5B7A8C','#A68A5B','#7C6F94','#5B9179','#9C7566','#8C6572','#68708C','#5B8C82'];
  const tradeColors = {}; let colorIdx=0;
  let svgRows='', y=HEADER_H;

  rows.forEach(r=>{
    if(r.type==='building'){
      svgRows += `<rect x="0" y="${num(y)}" width="${num(chartW)}" height="${num(ROW_H)}" fill="#0D141C"/>`;
      svgRows += `<text x="8" y="${num(y+ROW_H/2+4)}" fill="#4FC3F7" font-family="monospace" font-size="11" font-weight="700">${escapeXmlText(r.label)}</text>`;
    } else if(r.type==='trade'){
      if(!tradeColors[r.label]) tradeColors[r.label]=tradePalette[(colorIdx++)%tradePalette.length];
      svgRows += `<rect x="0" y="${num(y)}" width="${num(chartW)}" height="${num(ROW_H)}" fill="#0F161E"/>`;
      svgRows += `<text x="24" y="${num(y+ROW_H/2+4)}" fill="#8FA0B3" font-family="sans-serif" font-size="11">${escapeXmlText(r.label)}</text>`;
    } else {
      const t = r.task, color = escapeXmlAttr(tradeColors[t.trade]||'#4FC3F7');
      svgRows += `<text x="40" y="${num(y+ROW_H/2+4)}" fill="#EDF1F5" font-family="sans-serif" font-size="10.5">${escapeXmlText(t.name.length>42 ? t.name.slice(0,42)+'…' : t.name)}</text>`;
      if(opts.includePlanned){
        const [ps,pf] = ganttPlannedRange(t);
        const pl=x(ps), pw=Math.max(2, x(pf)-x(ps));
        svgRows += `<rect x="${num(pl)}" y="${num(y+4)}" width="${num(pw)}" height="8" rx="2" fill="none" stroke="${color}" stroke-width="1.2" stroke-dasharray="3 2"/>`;
      }
      if(opts.includeActual){
        const [as_,af] = activeRange(t);
        const al=x(as_), aw=Math.max(2, x(af)-x(as_));
        svgRows += `<rect x="${num(al)}" y="${num(y+7)}" width="${num(aw)}" height="9" rx="2" fill="${color}" opacity="0.55"/>`;
        if(t.accToDatePct!=null){
          svgRows += `<rect x="${num(al)}" y="${num(y+7)}" width="${num(aw*clamp(t.accToDatePct,0,100)/100)}" height="9" rx="2" fill="${color}"/>`;
        }
      }
    }
    y += ROW_H;
  });

  let todayLine = '';
  if(opts.includeToday && state.asOfDate>=minD && state.asOfDate<=maxD){
    const tx = x(state.asOfDate);
    todayLine = `<line x1="${num(tx)}" y1="${num(HEADER_H)}" x2="${num(tx)}" y2="${num(HEADER_H+rows.length*ROW_H)}" stroke="#FFB020" stroke-width="1.5" stroke-dasharray="4 3"/>
      <text x="${num(tx+3)}" y="${num(HEADER_H-4)}" fill="#FFB020" font-family="monospace" font-size="9">TODAY</text>`;
  }

  let gridlines = '';
  for(let yr=minD.getFullYear(); yr<=maxD.getFullYear(); yr++){
    const gd = new Date(yr,0,1);
    if(gd<minD||gd>maxD) continue;
    const gx = x(gd);
    gridlines += `<line x1="${num(gx)}" y1="${num(HEADER_H)}" x2="${num(gx)}" y2="${num(HEADER_H+rows.length*ROW_H)}" stroke="#1A222C" stroke-width="1"/>`;
    gridlines += `<text x="${num(gx+3)}" y="${num(HEADER_H-4)}" fill="#546274" font-family="monospace" font-size="10">${yr}</text>`;
  }

  const legend = opts.includeLegend ? `<g transform="translate(${num(LABEL_W)}, ${num(HEADER_H+rows.length*ROW_H+14)})">
    ${Object.keys(tradeColors).map((tr,i)=>`
      <rect x="${num(i*150)}" y="0" width="10" height="10" fill="${escapeXmlAttr(tradeColors[tr])}"/>
      <text x="${num(i*150+14)}" y="9" fill="#8FA0B3" font-family="sans-serif" font-size="10">${escapeXmlText(tr)}</text>
    `).join('')}
  </g>` : '';

  const footer = opts.includeSource ? `<text x="8" y="${num(chartH-10)}" fill="#546274" font-family="monospace" font-size="9">Generated ${escapeXmlText(fmtDate(new Date()))} · As of ${escapeXmlText(fmtDate(state.asOfDate))} · ${escapeXmlText(state.projectName||'Project')}</text>` : '';

  return `<svg viewBox="0 0 ${num(chartW)} ${num(chartH)}" xmlns="http://www.w3.org/2000/svg" font-family="sans-serif">
    <rect x="0" y="0" width="${num(chartW)}" height="${num(chartH)}" fill="#0A0D12"/>
    ${gridlines}
    <rect x="0" y="0" width="${num(LABEL_W)}" height="${num(chartH)}" fill="#0A0D12"/>
    ${svgRows}${todayLine}${legend}${footer}
  </svg>`;
}

function downloadSVGFile(svgString, filename){
  const blob = new Blob([svgString], {type:'image/svg+xml;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href=url; a.download=filename;
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url);
}

function svgStringToPngBlob(svgString, scale, callback){
  const vb = svgString.match(/viewBox="0 0 ([\d.]+) ([\d.]+)"/);
  const w = vb?Number(vb[1]):1400, h = vb?Number(vb[2]):800;
  const url = URL.createObjectURL(new Blob([svgString], {type:'image/svg+xml;charset=utf-8'}));
  const img = new Image();
  img.onload = ()=>{
    const canvas = document.createElement('canvas');
    canvas.width=w*scale; canvas.height=h*scale;
    const ctx = canvas.getContext('2d');
    ctx.fillStyle='#0A0D12'; ctx.fillRect(0,0,canvas.width,canvas.height);
    ctx.drawImage(img,0,0,canvas.width,canvas.height);
    URL.revokeObjectURL(url);
    canvas.toBlob(callback);
  };
  img.onerror = ()=>{ URL.revokeObjectURL(url); callback(null); };
  img.src = url;
}

