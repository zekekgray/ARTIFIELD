function handleScheduleFiles(fileList){
  [...fileList].forEach(file=>{
    const ext = (file.name.split('.').pop()||'').toLowerCase();
    if(ext!=='xlsx' && ext!=='xls'){ toast(file.name+' is not an .xlsx/.xls file — use the Cost or Materials dropzone for JSON.', 'err'); return; }
    const reader = new FileReader();
    reader.onload = ev=>{
      try{
        const data = new Uint8Array(ev.target.result);
        const wb = XLSX.read(data, {type:'array', cellDates:false});
        const fileLabel = file.name.replace(/\.(xlsx|xls)$/i,'').replace(/_/g,' ').slice(0,60);
        const sheets = wb.SheetNames.map(name=>({
          name, checked: looksLikePrimarySheet(name),
          buildingOverride: guessBuildingFromSheetName(name) || '',
          tradeOverride: '',
        }));
        stagedWorkbooks.push({fileLabel, wb, sheets, fileName:file.name, size:file.size});
        renderStage();
      }catch(err){
        toast('Could not read '+file.name+': '+err.message, 'err');
      }
    };
    reader.readAsArrayBuffer(file);
  });
}

