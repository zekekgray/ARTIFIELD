      <div class="gantt-bldg-head-inner"><span class="gantt-chevron">${bChevron}</span> 🏗 BUILDING ${esc(b)} <span class="gantt-bldg-count">· ${bTasks.length} task(s) · ${bPct.toFixed(0)}% complete</span></div>
    </div>`;

