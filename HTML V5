#welcome{
  position:fixed;inset:0;z-index:500;background:radial-gradient(circle at 50% 30%, #101820 0%, #0A0D12 70%);
  display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;
  padding:24px;
}
#welcome .welcome-inner{
  max-width:460px;display:flex;flex-direction:column;align-items:center;
  opacity:0;transform:translateY(4px);
  transition:opacity .45s cubic-bezier(.16,1,.3,1), transform .45s cubic-bezier(.16,1,.3,1);
}
#welcome .welcome-inner.fonts-ready{ opacity:1; transform:translateY(0); }
#welcome .weyebrow{
  font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:.09em;color:var(--blue);
  display:flex;align-items:center;gap:9px;margin-bottom:18px;
}
#welcome .weyebrow .ln{ width:18px;height:1px;background:var(--blue-dim); }
#welcome h1{
  font-family:'Sora',var(--sans);font-size:clamp(15px,2.2vw,22px);margin:0;font-weight:800;letter-spacing:-.02em;line-height:1.14;
  color:#F7F3E9;
}
#welcome .wsub{font-size:13.5px;color:var(--text-dim);margin-top:14px;max-width:380px;line-height:1.6;}
#welcome .wbtn{
  all:unset;cursor:pointer;margin-top:30px;padding:14px 26px;border-radius:14px;
  background:#F7F3E9;color:#0A0D12;font-weight:700;font-size:13.5px;
  display:inline-flex;align-items:center;gap:8px;
  box-shadow:0 1px 2px rgba(0,0,0,.2), 0 8px 20px rgba(0,0,0,.28);
  transition:transform .2s cubic-bezier(.34,1.56,.64,1), box-shadow .25s;
}
#welcome .wbtn:hover{ transform:translateY(-2px); box-shadow:0 2px 4px rgba(0,0,0,.2), 0 14px 28px rgba(0,0,0,.32); }
#welcome .wbtn:active{ transform:translateY(0) scale(.96); }
#welcome .wbtn svg{ width:15px;height:15px; }
#welcome.fade-out{animation:welcomeOut .35s ease forwards;}
@keyframes welcomeOut{from{opacity:1;}to{opacity:0;visibility:hidden;}}
a.link{color:var(--blue);text-decoration:none;cursor:pointer;}
a.link:hover{text-decoration:underline;}
.help{font-size:11.5px;color:var(--text-faint);line-height:1.6;margin-top:4px;}

/* === ARTIFIELD LICENSE PIN GATE: START === */
#welcome .pin-row{display:flex;gap:10px;margin-top:28px;}
#welcome .pin-box{
  width:44px;height:54px;text-align:center;font-size:22px;font-family:var(--mono);
  background:#12181F;border:1.5px solid var(--line);border-radius:10px;color:var(--text);
  outline:none;transition:border-color .15s, box-shadow .15s;
}
#welcome .pin-box:focus{border-color:var(--blue);box-shadow:0 0 0 3px var(--blue-dim);}
#welcome .pin-box.error{border-color:var(--red);box-shadow:0 0 0 3px var(--red-dim);}
#welcome .pin-error{font-size:12px;color:var(--red);margin-top:14px;min-height:16px;}
#welcome .pin-hint{font-size:11px;color:var(--text-faint);margin-top:6px;}
/* === PIN INCOMPLETE RED FLASH: START === */
#welcome .wbtn.pin-submit{margin-top:22px;}
#welcome .wbtn.pin-flash-red{
  background:var(--red) !important;
  color:#fff !important;
  animation:pinFlashRed .28s ease;
}
@keyframes pinFlashRed{
  0%{transform:scale(1);}
  35%{transform:scale(1.05);}
  100%{transform:scale(1);}
}
/* === PIN INCOMPLETE RED FLASH: END === */
#welcome .wbtn:disabled{opacity:.5;cursor:not-allowed;transform:none !important;}
/* === ARTIFIELD LICENSE PIN GATE: END === */

/* === ARTIFIELD WELCOME SPLASH (post-unlock): START === */
.field-welcome-overlay{
  position:fixed; inset:0; z-index:600;
  background:linear-gradient(135deg, rgba(10,13,18,.92), rgba(10,13,18,.86));
  backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px);
  display:flex; align-items:center; justify-content:center;
  padding:24px;
  opacity:0; pointer-events:none;
  transition:opacity .35s ease;
}
.field-welcome-overlay.active{ opacity:1; pointer-events:auto; }
.field-welcome-card{
  width:100%; max-width:560px;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:14px;
  box-shadow:0 30px 80px rgba(0,0,0,.45);
  overflow:hidden;
  transform:translateY(14px) scale(.98);
  transition:transform .4s cubic-bezier(0.34,1.56,0.64,1);
  max-height:88vh;
  display:flex; flex-direction:column;
}
.field-welcome-overlay.active .field-welcome-card{ transform:none; }
.field-welcome-head{
  background:linear-gradient(150deg, #0D141C, #16202B);
  color:var(--text);
  padding:26px 28px 22px 28px;
  position:relative;
  border-bottom:1px solid var(--line-soft);
}
.field-welcome-head .fw-mark{
  font-family:var(--mono); font-size:10.5px; letter-spacing:.1em; color:var(--blue);
  margin-bottom:12px;
}
.field-welcome-head h2{
  margin:0; font-family:'Sora',var(--sans); font-size:20px; font-weight:800;
  letter-spacing:-.01em; line-height:1.3; color:#F7F3E9;
}
.field-welcome-head p{ margin:8px 0 0 0; font-size:12.5px; color:var(--text-dim); line-height:1.6; }
.field-welcome-close{ position:absolute; top:16px; right:16px; }
.field-welcome-body{ padding:22px 28px 6px 28px; overflow-y:auto; }
.field-welcome-body p{ font-size:12.5px; color:var(--text-dim); line-height:1.7; margin:0 0 13px 0; }
.field-welcome-body p strong{ color:var(--text); }
.field-welcome-tags{ display:flex; flex-wrap:wrap; gap:6px; margin:2px 0 14px 0; }
.field-welcome-tags span{
  font-size:10.5px; font-weight:650; padding:4px 10px; border-radius:100px;
  background:var(--blue-dim); color:var(--blue);
}
.field-welcome-foot{
  padding:16px 28px 22px 28px; display:flex; align-items:center; justify-content:space-between; gap:14px;
  border-top:1px solid var(--line-soft);
}
.field-welcome-sig{ font-size:11px; color:var(--text-faint); line-height:1.5; }
.field-welcome-sig strong{ color:var(--text-dim); display:block; font-weight:650; }
.field-welcome-progress{ position:relative; height:3px; width:110px; background:var(--line); border-radius:2px; overflow:hidden; flex-shrink:0; }
.field-welcome-progress-bar{
  position:absolute; left:0; top:0; bottom:0; width:100%;
  background:var(--blue); transform-origin:left; transform:scaleX(0);
}
.field-welcome-progress-bar.run{ transition:transform linear; transform:scaleX(1); }
@media (max-width:640px){
  .field-welcome-head{ padding:22px 20px 18px 20px; }
  .field-welcome-body{ padding:18px 20px 4px 20px; }
  .field-welcome-foot{ padding:14px 20px 18px 20px; flex-direction:column; align-items:flex-start; gap:10px; }
}
/* === ARTIFIELD WELCOME SPLASH (post-unlock): END === */

@media (max-width: 900px){
  #sidebar{position:fixed;left:-260px;top:0;bottom:0;z-index:50;transition:left .18s;box-shadow:0 0 40px rgba(0,0,0,.5);overflow-y:auto;-webkit-overflow-scrolling:touch;}
  #sidebar.open{left:0;}
  .content{padding:18px 16px 60px;}
  .cards4,.cards3,.cards2{grid-template-columns:1fr 1fr;}
  .exec-row{grid-template-columns:1fr;gap:8px;}
}
</style>
</head>
<body>
<div id="welcome">
  <div class="welcome-inner" id="welcomeInner">
    <h1>Every trade. Every floor.<br>One number you can trust.</h1>
    <div class="wsub">Schedule · Cost · Supply — one decision engine for the jobsite.</div>
    <div class="pin-row" id="pinRow">
      <input type="tel" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="pin-box" data-idx="0" autocomplete="off">
      <input type="tel" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="pin-box" data-idx="1" autocomplete="off">
      <input type="tel" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="pin-box" data-idx="2" autocomplete="off">
      <input type="tel" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="pin-box" data-idx="3" autocomplete="off">
      <input type="tel" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="pin-box" data-idx="4" autocomplete="off">
      <input type="tel" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="pin-box" data-idx="5" autocomplete="off">
    </div>
    <div class="pin-hint" id="pinHintTrigger">Enter your 6-digit license PIN</div>
    <div class="pin-error" id="pinError"></div>
    <button class="wbtn pin-submit" id="btnEnterApp">
      Unlock ARTIFIELD
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
    </button>
  </div>
</div>
<div id="app">
  <aside id="sidebar">
    <div class="brand">
      <h1>ARTIFIELD</h1>
      <div class="sub">Schedule · Cost · Supply — one decision engine</div>
    </div>
    <div class="nav-section-label">Schedule</div>
    <nav class="tabs" id="tabs-schedule"></nav>
    <div class="nav-section-label">S-Curves (Vol. &amp; $)</div>
    <nav class="tabs" id="tabs-curves"></nav>
    <div class="nav-section-label">Finance &amp; supply</div>
    <nav class="tabs" id="tabs-finance"></nav>
    <div class="nav-section-label">Field Data (Vex)</div>
    <nav class="tabs" id="tabs-fielddata"></nav>
    <div class="nav-section-label">Data</div>
    <nav class="tabs" id="tabs-data"></nav>
    <div class="side-foot">
      <div class="row clickable" onclick="setTab('database')" title="Go to Database"><span>Tasks</span><b id="footTasks">0</b></div>
      <div class="row clickable" onclick="setTab('database')" title="Go to Database"><span>Buildings</span><b id="footBldgs">0</b></div>
      <div class="row clickable" onclick="setTab('import')" title="Go to Import Data"><span>Last import</span><b id="footImport">—</b></div>
    </div>
  </aside>

  <main id="main">
    <div id="topbar">
      <div>
        <h2 id="topTitle">Dashboard</h2>
        <input type="text" class="mark-edit meta" id="topMetaInput" value="" placeholder="Project address" spellcheck="false" onchange="setProjectAddress(this.value)" oninput="this.style.width=((this.value.length||this.placeholder.length)+2)+'ch'">
      </div>
      <div class="btn-row">
        <div class="vexai-wrap" id="vexaiWrap">
          <button class="btn" id="btnVexAi">Vex AI ▾</button>
          <div class="vexai-menu hidden" id="vexaiMenu">
            <button type="button" data-provider="gemini">Gemini</button>
            <button type="button" data-provider="grok">Grok</button>
          </div>
        </div>
        <button class="btn" id="btnExport">Export master DB (.xlsx)</button>
        <button class="btn danger" id="btnReset">Reset database</button>
      </div>
    </div>
    <div class="content" id="content"></div>
  </main>
</div>

<div id="toast"></div>

<script>
/* =========================================================================
   ARTIFIELD — MASTER CONTROL TOWER
   Self-contained schedule + cost + supply intelligence app: xlsx/json import,
   normalization, clash/sequence/revision engines, cost EVM engine, materials
   shortage engine, S-curves, consolidated Gantt, executive dashboard.
   ========================================================================= */

const DAY = 86400000;
const state = {
  tasks: [],             // normalized schedule database
  costEntries: [],        // budget/actual cost line items
  materialEntries: [],    // materials on-hand / consumption
  projectMeta: {},        // building -> {contractValue}
  compatiblePairs: {},    // trade-pair overrides: "TradeA|TradeB" -> true (ignore clash)
  verifications: {},      // taskId -> {verifiedAt, note}
  /* === ACCOMPLISHMENT SNAPSHOT LOG: START === */
  snapshots: [],          // [{at: ISOString, values: {taskId: accToDatePct}}] — one per import day
  /* === ACCOMPLISHMENT SNAPSHOT LOG: END === */
  /* === FIELD UPDATE + SMART VALIDATION: START === */
  fieldUpdates: [],        // [{id, taskId, date, prevPct, newPct, note, flags:[], loggedBy, at}]
  /* === FIELD UPDATE + SMART VALIDATION: END === */
  /* === 7 S-CURVES: START === */
  manpowerLogs: [],        // [{id, building, trade, date, manHours, loggedBy}]
  materialLogs: [],        // [{id, building, item, date, qty, unit, loggedBy}]
  materialPlan: {},        // 'building|item' -> {plannedTotalQty, unit}
  curveBuilding: '',       // selected building for cost/manpower/banana/material curve tabs
  curveMaterialItem: '',   // selected item for material curve tab
  /* === 7 S-CURVES: END === */
  projectNameCustomized: false,
  projectAddress: '',
  projectAddressCustomized: false,
  lastImport: null,
  pendingImport: null,
  tab: 'dashboard',
  /* === TASK LOCKING: START ===
     Ang verifyTask() ay nag-se-set ng task.locked=true. Habang locked, hindi
     puwedeng baguhin ang task via Edit modal o Log Update modal, AT hindi
     ito ino-overwrite ng susunod na import — sa halip, ang import ay
     nagta-tala ng "pending conflict" na kailangang manual na i-review. */
  lockedImportConflicts: [],  // [{id, taskId, taskName, building, incoming:{...}, sourceRowRef, at}]
  /* === TASK LOCKING: END === */
  asOfDate: new Date(),
  dbFilters: { building: '', trade: '' },
  /* === CONSOLIDATED GANTT — HIERARCHY EXPAND STATE: START ===
     null = hindi pa na-initialize (unang render pa lang) — dito lang
     awtomatikong nag-e-expand ang unang building bilang default. Pagkatapos
     niyan, object na ('B|Building A': true, 'T|Building A|Civil': true, atbp)
     — ephemeral lang ito, hindi naka-persist sa storage, resets sa reload. */
  ganttExpanded: null,
  /* === CONSOLIDATED GANTT — HIERARCHY EXPAND STATE: END === */
  /* === CONSOLIDATED GANTT — SCOPE FILTERS: START === */
    ganttFilters: { building:'', trade:'', level:'', status:'', criticality:'', delay:'', dateStart:null, dateEnd:null },
  /* === CONSOLIDATED GANTT — SCOPE FILTERS: END === */
  /* === GANTT ZOOM LEVEL: START === */
  ganttZoom: { level:'fit', centerDate:null },
  /* === GANTT ZOOM LEVEL: END === */  /* === FOCUS MODE: START === */
  ganttFocus: { type:'', taskId:'' },  // '' | 'week' | 'critical' | 'delayed' | 'task'
  /* === FOCUS MODE: END === */
  /* === GANTT BASELINE COMPARE: START === */
  ganttBaselineCompare: '',  // '' | baseline.id from state.baselines
  /* === GANTT BASELINE COMPARE: END === */
   /* === MULTI-SERIES COMPARE OVERLAY: START === */
  compare: { mode: 'building', selected: [], showPlanned: true },
  /* === MULTI-SERIES COMPARE OVERLAY: END === */
  /* === SCURVE DATE-RANGE ZOOM: START ===
     Para sa mahahabang project (5-10 years), ang fixed 60-step sampling sa
     buong horizon ay nagiging masyadong "coarse" — bawat step ay tumatalon
     ng ilang linggo/buwan. Sa halip na drag/pinch zoom (mas komplikado at
     hindi gaanong pamilyar sa maraming user), isang simpleng "from-to" date
     range filter — kapag na-set, ang minD/maxD ng chart mismo ang
     nagbabago papuntang mas maikling range, kaya awtomatikong mas
     magaganda (mas siksik) ang mga sample points sa loob ng napiling
     window. null = walang filter (buong project range, default). */
  scurveRange: { start: null, end: null },
  /* === SCURVE DATE-RANGE ZOOM: END === */
  /* === VEX SCHEMA SYNC: START ===
     Bagong arrays para tumugma 100% sa Vex Document Standardization Mode
     JSON output schema (v1.2) — mga array na wala pang katumbas sa dating
     ARTIFIELD data model: quantityTakedowns, violations, forecastNotes,
     variationOrders, rfis. Isa pang array (vexMeta) ang nag-iimbak ng meta
     block (schemaVersion, documentType, structuralFindings, blindSpots,
     overallConfidence) ng BAWAT Vex JSON import nang hiwalay-hiwalay —
     hindi pinagsasama-sama, dahil dapat manatiling traceable pabalik sa
     partikular na source file ang bawat structural finding. */
  quantityTakedowns: [],
  violations: [],
  forecastNotes: [],
  variationOrders: [],
  rfis: [],
  vexMeta: [],
  /* === VEX SCHEMA SYNC: END === */
  /* === BUILDING NAME RESOLVER: START === */
  buildingAliases: {},              // normBuildingKey(raw) -> canonical name (user-confirmed)
  buildingSuggestionsDismissed: {},  // "keyA|keyB" -> true (user said "not the same")
  /* === BUILDING NAME RESOLVER: END === */
  /* === NAMED BASELINES: START ===
     Hiwalay sa revisionHistory[] (na per-task, walang pangalan) — ito ay
     isang GLOBAL snapshot ng lahat ng task dates+progress sa sandaling
     ito, may user-given na pangalan (hal. "Rev 2 — Aug submission").
     Nagbibigay-daan itong pumili ng dalawang named point in time at
     ikumpara sa isang table, sa halip na basahin ang raw history array
     nang manual per-task. */
  baselines: [],  // [{id, name, createdAt, taskDates: {taskId:{plannedStart,plannedFinish,revisedStart,revisedFinish,weightPct,accToDatePct}}}]
  /* === NAMED BASELINES: END === */
  /* === EXTRACTION SESSIONS: START ===
     Isang entry bawat import batch — hindi live-recomputed, kundi
     naka-freeze na "sa oras na ito, ganito ang state ng project data".
     Ito ang pinagmumulan ng "Data Snapshots" tab at ng "what changed
     since last upload" comparison. */
  extractionSessions: [],
  /* === EXTRACTION SESSIONS: END === */
};

const KEY_DB = 'turf-master-tasks-v1';
const KEY_RULES = 'turf-clash-rules-v1';
const KEY_LOCKED_CONFLICTS = 'turf-locked-import-conflicts-v1';
const KEY_COST = 'turf-cost-entries-v1';
const KEY_MATERIALS = 'turf-material-entries-v1';
 const KEY_PROJECTMETA = 'turf-project-meta-v1';
const KEY_PROJECTNAME = 'turf-project-name-v1';
const KEY_PROJECTADDRESS = 'turf-project-address-v1';
const KEY_PROJECTNAME_CUSTOMIZED = 'turf-project-name-customized-v1';
const KEY_PROJECTADDRESS_CUSTOMIZED = 'turf-project-address-customized-v1';
/* === ACCOMPLISHMENT SNAPSHOT LOG: START === */
const KEY_SNAPSHOTS = 'turf-accomplishment-snapshots-v1';
/* === ACCOMPLISHMENT SNAPSHOT LOG: END === */
/* === FIELD UPDATE + SMART VALIDATION: START === */
const KEY_FIELD_UPDATES = 'turf-field-updates-v1';
/* === FIELD UPDATE + SMART VALIDATION: END === */
/* === 7 S-CURVES: START === */
const KEY_MANPOWER_LOGS = 'turf-manpower-logs-v1';
const KEY_MATERIAL_LOGS = 'turf-material-logs-v1';
const KEY_MATERIAL_PLAN = 'turf-material-plan-v1';
/* === 7 S-CURVES: END === */
/* === VEX SCHEMA SYNC: START === */
const KEY_QTAKEDOWNS = 'turf-quantity-takedowns-v1';
const KEY_VIOLATIONS = 'turf-violations-v1';
const KEY_FORECASTNOTES = 'turf-forecast-notes-v1';
const KEY_VARIATIONORDERS = 'turf-variation-orders-v1';
const KEY_RFIS = 'turf-rfis-v1';
const KEY_VEXMETA = 'turf-vex-meta-v1';
/* === VEX SCHEMA SYNC: END === */
/* === BUILDING NAME RESOLVER: START === */
const KEY_BUILDING_ALIASES = 'turf-building-aliases-v1';
const KEY_BUILDING_DISMISSED = 'turf-building-dismissed-v1';
/* === BUILDING NAME RESOLVER: END === */
/* === NAMED BASELINES: START === */
const KEY_BASELINES = 'turf-named-baselines-v1';
const KEY_EXTRACTION_SESSIONS = 'turf-extraction-sessions-v1';
/* === NAMED BASELINES: END === */

/* === ARTIFIELD WELCOME SPLASH (post-unlock): START === */
const FIELD_WELCOME_MS = 60000; // auto-closes after 1 minute if not dismissed
function showFieldWelcomeSplash(){
  if(window.__fieldWelcomeShown) return;
  window.__fieldWelcomeShown = true;

  const overlay = document.createElement('div');
  overlay.className = 'field-welcome-overlay';
  overlay.id = 'field-welcome-overlay';
  overlay.innerHTML =
    '<div class="field-welcome-card">' +
      '<div class="field-welcome-head">' +
        '<button class="icon-btn field-welcome-close" id="field-welcome-close-btn" title="Close" style="all:unset;cursor:pointer;position:absolute;top:16px;right:16px;color:var(--text-dim);">' +
          '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>' +
        '</button>' +
        '<div class="fw-mark">CIST · ARTIFIELD</div>' +
        '<h2>Welcome to ARTIFIELD.</h2>' +
        '<p>A quick note before you get started.</p>' +
      '</div>' +
      '<div class="field-welcome-body">' +
        '<p>Hi, and thank you for using <strong>ARTIFIELD</strong> \u2014 your all-in-one schedule, cost, and materials supply decision engine for the jobsite.</p>' +
        '<p>In simple terms, ARTIFIELD helps you track everything happening across your project: your <strong>construction schedule</strong> and how it\u2019s tracking against plan, your <strong>project costs</strong> and profitability per building, and your <strong>materials supply</strong> so you never get caught short on site.</p>' +
        '<div class="field-welcome-tags"><span>Schedule</span><span>Cost (EVM)</span><span>Materials</span><span>Clash Detection</span><span>S-Curves</span></div>' +
        '<p>Import your building schedules, cost entries, and stock levels through the Import Data tab \u2014 ARTIFIELD reads them and automatically builds your S-curves, SPI/CPI performance, clash warnings, and shortage forecasts from there.</p>' +
        '<p>We built this to give you one number you can trust, across every trade and every floor. Thank you for trusting us with your project.</p>' +
      '</div>' +
      '<div class="field-welcome-foot">' +
        '<div class="field-welcome-sig"><strong>The CIST / ARTIFIELD Team</strong>Built for the jobsite.</div>' +
        '<div class="field-welcome-progress"><div class="field-welcome-progress-bar" id="field-welcome-progress-bar"></div></div>' +
      '</div>' +
    '</div>';
  document.body.appendChild(overlay);

  requestAnimationFrame(function(){
    overlay.classList.add('active');
    const bar = document.getElementById('field-welcome-progress-bar');
    if(bar){
      requestAnimationFrame(function(){
        bar.style.transitionDuration = FIELD_WELCOME_MS+'ms';
        bar.classList.add('run');
      });
    }
  });

  let dismissed = false;
  function dismiss(){
    if(dismissed) return;
    dismissed = true;
    overlay.classList.remove('active');
    setTimeout(function(){ overlay.remove(); }, 400);
  }
  const timer = setTimeout(dismiss, FIELD_WELCOME_MS);
  document.getElementById('field-welcome-close-btn').addEventListener('click', function(){ clearTimeout(timer); dismiss(); });
  overlay.addEventListener('click', function(e){ if(e.target===overlay){ clearTimeout(timer); dismiss(); } });
}
/* === ARTIFIELD WELCOME SPLASH (post-unlock): END === */

function toast(msg, type){
  const el = document.createElement('div');
  el.className = 'toastel' + (type ? ' '+type : '');
  el.textContent = msg;
  document.getElementById('toast').appendChild(el);
  setTimeout(()=>{ el.style.opacity='0'; el.style.transition='opacity .3s'; setTimeout(()=>el.remove(),300); }, 3600);
}

/* ---------------------------------------------------------------------
   PERSISTENCE
   --------------------------------------------------------------------- */
async function loadDB(){
