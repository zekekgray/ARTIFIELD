function renderExecRow(b){
  const spiObj = computeSPI(state.tasks.filter(t=>t.building===b));
  const cost = costSummaryForBuilding(b);
  const mats = materialsForBuilding(b);
  const matRisk = mats.filter(m=>m.atRisk).length;
  let status = 'green';
  if((spiObj.spi!=null && spiObj.spi<0.9) || (cost.vac!=null && cost.vac<0) || matRisk>1) status='red';
  else if((spiObj.spi!=null && spiObj.spi<1) || (cost.projectedProfit!=null && cost.projectedProfit < cost.budget*0.05) || matRisk>0) status='amber';
  /* === PROJECT HEALTH DRIVERS: START === */
  const drivers = [];
  if(spiObj.spi!=null && spiObj.spi<1) drivers.push(`SPI ${spiObj.spi.toFixed(2)} — behind planned pace`);
  if(cost.vac!=null && cost.vac<0) drivers.push(`Forecast (EAC) exceeds budget by ${peso(Math.abs(cost.vac))}`);
  if(matRisk>0) drivers.push(`${matRisk} material item(s) at shortage risk`);
  const driverText = drivers.length ? drivers.join(' · ') : 'On track — no material drivers flagged';
