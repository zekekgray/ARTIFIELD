/* Inaaplay PAGKATAPOS ng applyGanttFilters — kaya "Delayed · Building B"
   ay hindi magkasalungat: una munang sinala ng Building/Trade pill filters,
   tapos yung Focus preset (week/critical/delayed) ang huling nagpipino.
   Ang 'task' focus ay eksepsiyon: kinukuha ito mula sa BUONG state.tasks
   (hindi sa naka-scope na listahan) para laging kumpleto ang kapitbahay
   (predecessor + successor) ng napiling task, kahit magkaiba ang building/
   trade nila sa kasalukuyang pill selection. */
function applyGanttFocus(tasks, controlStatus, flaggedIds){
  const focus = state.ganttFocus || {type:'', taskId:''};
  if(!focus.type) return tasks;
  if(focus.type==='week'){
    const wkStart = new Date(state.asOfDate); wkStart.setHours(0,0,0,0);
    wkStart.setDate(wkStart.getDate()-wkStart.getDay());
    const wkEnd = new Date(wkStart); wkEnd.setDate(wkEnd.getDate()+7);
    return tasks.filter(t=>{
      if(!hasValidDates(t)) return false;
      const [s,f] = activeRange(t);
      return s<wkEnd && f>=wkStart;
    });
  }
  if(focus.type==='critical'){
    return tasks.filter(t=> (controlStatus[t.id]||{}).status==='critical' || flaggedIds.has(t.id));
  }
  if(focus.type==='delayed'){
    return tasks.filter(t=> ['delayed','critical'].includes((controlStatus[t.id]||{}).status));
  }
  if(focus.type==='atrisk'){
    return tasks.filter(t=> (controlStatus[t.id]||{}).status==='atrisk');
  }
  if(focus.type==='task' && focus.taskId){
    const t = state.tasks.find(x=>x.id===focus.taskId);
    if(!t) return tasks;
    const up = computeUpstreamTasks(t, state.tasks).map(i=>i.task.id);
    const down = computeDownstreamTasks(t, state.tasks).map(i=>i.task.id);
    const keep = new Set([t.id, ...up, ...down]);
    return state.tasks.filter(x=>keep.has(x.id));
  }
  return tasks;
}

function renderGanttFocusBar(scopedBeforeFocusTasks){
  const focus = state.ganttFocus || {type:'', taskId:''};
