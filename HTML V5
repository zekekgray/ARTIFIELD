    <div class="grid cards3" style="margin-bottom:14px;">
      <div class="card kpi ${ctOverallActual<ctOverallPlanned-3?'warn':'good'}"><div class="label">Actual</div><div class="value">${ctOverallActual.toFixed(0)}%</div></div>
      <div class="card kpi"><div class="label">Planned</div><div class="value">${ctOverallPlanned.toFixed(0)}%</div></div>
      <div class="card kpi ${ctVariance<0?'bad':'good'}"><div class="label">Variance</div><div class="value">${ctVariance>=0?'+':''}${ctVariance.toFixed(0)}%${ctAvgDelayDays?' · '+ctAvgDelayDays+'d behind':''}</div></div>
    </div>
    <div style="font-family:var(--mono);font-size:10.5px;letter-spacing:.08em;color:var(--text-faint);margin-bottom:8px;">ATTENTION</div>
    <div class="grid cards4">
      <div class="card kpi ${ctDelayedTasks.length?'bad':'good'}" style="cursor:pointer;" onclick="setGanttFocus('delayed')" title="Focus the Gantt on delayed/critical activities"><div class="label">🔴 Delayed / Critical</div><div class="value">${ctDelayedTasks.length}</div>${Object.keys(ganttAffectedByMap).length?`<div class="delta">→ cascades to ${Object.keys(ganttAffectedByMap).length} downstream task(s)</div>`:''}</div>
      <div class="card kpi ${ctAtRiskTasks.length?'warn':'good'}" style="cursor:pointer;" onclick="setGanttFocus('atrisk')" title="Focus the Gantt on at-risk activities"><div class="label">🟠 At Risk</div><div class="value">${ctAtRiskTasks.length}</div></div>
