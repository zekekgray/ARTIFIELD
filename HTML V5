function applyGanttFilters(tasks, flaggedIds){
  const f = state.ganttFilters;
  return tasks.filter(t=>{
    if(f.building && t.building!==f.building) return false;
    if(f.trade && t.trade!==f.trade) return false;
    if(f.level && (t.level||'—')!==f.level) return false;
    if(f.status && (t.status||'—')!==f.status) return false;
    if(f.criticality==='Critical' && !flaggedIds.has(t.id)) return false;
    if(f.criticality==='Non-critical' && flaggedIds.has(t.id)) return false;
    const isDelayed = t.status==='Shifted' && t.shiftDays>0;
    if(f.delay==='Delayed' && !isDelayed) return false;
    if(f.delay==='On-track' && isDelayed) return false;
    if(f.dateStart || f.dateEnd){
      const [s,fin] = activeRange(t);
      if(f.dateStart && fin < new Date(f.dateStart)) return false;
      if(f.dateEnd && s > new Date(f.dateEnd)) return false;
    }
    return true;
  });
}

