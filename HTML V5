        } else {
          const plannedLeft = ((ps-minD)/DAY)*pxPerDay;
          const plannedWidth = Math.max(3, ((pf-ps)/DAY)*pxPerDay);
          const actualWidth = Math.max(3, ((af-as_)/DAY)*pxPerDay);
          const pct = t.accToDatePct!=null ? clamp(t.accToDatePct,0,100) : null;
          const fillHtml = pct!=null ? `<div class="gantt-bar-fill" style="width:${pct}%;"></div>` : '';
          barHtml = `<div class="gantt-bar-planned" style="left:${plannedLeft}px;width:${plannedWidth}px;border-color:${color};" title="Planned: ${fmtDate(ps)}–${fmtDate(pf)}"></div>` +
            /* === STATUS AS SHAPE, NOT COLOR: START ===
               Ang bar fill ay subtle na trade tint na lang (color-mix,
               ~42% lang, laban sa madilim na base) — hindi na saturated
               na pangunahing signal. Status ay hiwalay na glyph overlay
               sa ibaba, hindi na "background swap" ng buong bar. */
            `<div class="gantt-bar gantt-bar-actual ${flagged?'violation':''}" style="left:${actualLeft}px;width:${actualWidth}px;background:color-mix(in srgb, ${color} 42%, #1A222C);cursor:pointer;" title="${tip}" onclick="event.stopPropagation();openGanttTaskDrawer('${escOnclickArg(t.id)}')">${fillHtml}</div>`;
          if(cs.status!=='ontrack'){
            barHtml += `<span class="gantt-status-glyph" style="left:${actualLeft-1}px;color:${statusColor};" title="${GANTT_STATUS_LABELS[cs.status]}">${GANTT_STATUS_GLYPH[cs.status]||''}</span>`;
          }
          /* === STATUS AS SHAPE, NOT COLOR: END === */
          if(varLabel){
            const badgeLeft = Math.max(plannedLeft+plannedWidth, actualLeft+actualWidth) + 6;
            barHtml += `<div class="gantt-variance-badge" style="left:${badgeLeft}px;color:${variance>0?'var(--red)':'var(--green)'};">${varLabel}</div>`;
