function updateIpdAdvancedPreview(){
  const ta = document.getElementById('vexPasteText');
  if(ta) ipdPasteText = ta.value;
  const rawEl = document.getElementById('ipdRawJson');
  const schemaEl = document.getElementById('ipdSchemaVersion');
  const validEl = document.getElementById('ipdValidation');
  const countsEl = document.getElementById('ipdCounts');
  if(!rawEl || !schemaEl || !validEl || !countsEl) return;

  rawEl.textContent = ipdPasteText || '(nothing pasted yet)';
  if(!ipdPasteText.trim()){
    schemaEl.innerHTML = '<span class="tag gray">—</span>';
    validEl.innerHTML = '<span class="tag gray">Waiting for JSON</span>';
    countsEl.innerHTML = '<span class="help">Paste or import JSON to see record counts.</span>';
    return;
  }
  let payload;
  try{ payload = JSON.parse(ipdPasteText); }
  catch(err){
    schemaEl.innerHTML = '<span class="tag gray">—</span>';
    validEl.innerHTML = `<span class="tag red">Invalid JSON — ${esc(err.message)}</span>`;
    countsEl.innerHTML = '<span class="help">Fix the JSON to see record counts.</span>';
    return;
  }
  const sv = payload.meta && payload.meta.schemaVersion;
  const supported = typeof VEX_SUPPORTED_SCHEMA_VERSIONS!=='undefined' && VEX_SUPPORTED_SCHEMA_VERSIONS.includes(sv);
  schemaEl.innerHTML = sv ? `<span class="tag ${supported?'green':'red'}">${esc(sv)}</span>` : '<span class="tag amber">not specified</span>';
  validEl.innerHTML = supported
    ? '<span class="tag green">Valid Vex extraction</span>'
    : `<span class="tag red">${sv?'Unsupported schema version':'Missing meta.schemaVersion'}</span>`;
  const counts = [
    ['Tasks', (payload.tasks||[]).length],
    ['Cost entries', (payload.costEntries||[]).length],
    ['Material entries', (payload.materialEntries||[]).length],
    ['Quantity takedowns', (payload.quantityTakedowns||[]).length],
    ['Violations', (payload.violations||[]).length],
    ['Forecast notes', (payload.forecastNotes||[]).length],
    ['Variation orders', (payload.variationOrders||[]).length],
    ['RFIs', (payload.rfis||[]).length],
  ].filter(([,n])=>n>0);
  countsEl.innerHTML = counts.length
    ? counts.map(([label,n])=>`<span class="tag blue" style="margin:2px 4px 2px 0;">${label}: ${n}</span>`).join('')
    : '<span class="help">No recognized arrays found in this JSON.</span>';
}
