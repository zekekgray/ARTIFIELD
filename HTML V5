/* === PLANNED VS ACTUAL VARIANCE HELPERS: START === */
function ganttPlannedRange(t){
  const ps = t.originalPlannedStart || t.plannedStart;
  const pf = t.originalPlannedFinish || t.plannedFinish;
  return [new Date(ps), new Date(pf)];
}
function ganttVarianceDays(t){
  const [,pf] = ganttPlannedRange(t);
  const [,af] = activeRange(t);
  return daysBetween(pf.toISOString(), af.toISOString());
}
