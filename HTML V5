      <span>Cost records: <b>${latestDelta.costDelta>0?'+':''}${latestDelta.costDelta}</b></span>
      <span>Material records: <b>${latestDelta.materialDelta>0?'+':''}${latestDelta.materialDelta}</b></span>
    </div>
  </div>` : ''}

