      <div class="card kpi ${ctLowConfCount?'warn':'good'}" style="cursor:pointer;" onclick="setTab('clashes')" title="Open Clash & Sequence Log — Data Quality Issues"><div class="label">⚠ Low Confidence</div><div class="value">${ctLowConfCount}</div></div>
