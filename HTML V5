  const upcoming7 = withDates.filter(t=>{ const [s]=activeRange(t); const days=(s-state.asOfDate)/DAY; return days>=0 && days<=7; }).length;
  const upcoming30 = withDates.filter(t=>{ const [s]=activeRange(t); const days=(s-state.asOfDate)/DAY; return days>7 && days<=30; }).length;
  /* === TODAY HORIZON INTELLIGENCE: END === */
  let yearMarks='';
  for(let yr=minD.getFullYear(); yr<=maxD.getFullYear(); yr++){
    const gx = ((new Date(yr,0,1)-minD)/DAY)*pxPerDay;
