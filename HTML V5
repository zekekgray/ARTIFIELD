function computeShiftedTasks(){
  return state.tasks.filter(t=>t.status==='Shifted' && !state.verifications[t.id]);
}

/* === FIELD UPDATE + SMART VALIDATION: START === */
function validateFieldUpdate(task, newPct, dateISO, prevUpdateForDay){
  const flags = [];
  const prevPct = task.accToDatePct;
  if(prevPct!=null && newPct < prevPct - 0.01){
    flags.push({level:'warn', message:`Progress decreased: ${prevPct.toFixed(1)}% → ${newPct.toFixed(1)}%. Confirm this isn't a typo or a rework/rejection.`});
  }
  if(newPct > 100){
    flags.push({level:'error', message:`Accomplishment cannot exceed 100% (entered ${newPct.toFixed(1)}%).`});
  }
  if(hasValidDates(task)){
    const [,f] = activeRange(task);
    const d = new Date(dateISO);
    if(d > f && newPct < 99.5){
      flags.push({level:'warn', message:`Update date (${fmtDate(d)}) is past the planned/revised finish (${fmtDate(f)}) but accomplishment is only ${newPct.toFixed(1)}% — finish date may need revision.`});
    }
  }
  if(prevUpdateForDay){
    flags.push({level:'warn', message:`Another update was already logged for this task on ${fmtDate(new Date(dateISO))} (${prevUpdateForDay.newPct.toFixed(1)}%) — this will overwrite/correct that entry, not add a duplicate day.`});
  }
  return flags;
}
function computeFlaggedFieldUpdates(){
  return state.fieldUpdates.filter(u=>u.flags && u.flags.length).sort((a,b)=>new Date(b.at)-new Date(a.at));
}
/* === FIELD UPDATE + SMART VALIDATION: END === */

/* === 7 S-CURVES: START ===
   Ang 7 kinikilalang S-Curve types sa construction planning practice (PSP/PMP/P6):
   Category A (Physical Progress %): (1) Master, (2) Per-Building/Zone,
   (3) Per-Trade — covered na ng buildScurveSVG (Dashboard/S-Curve/Trades tabs).
   Category B (Volume & Time-Based): (4) Cost/Cash Flow, (5) Manpower,
   (6) Banana Curve, (7) Material & Equipment — apat na dinagdag dito. */

function cumulativeLogValueAt(logs, valueField, date){
  const t = +date;
  let sum = 0;
  logs.forEach(l=>{ if(+new Date(l.date) <= t) sum += Number(l[valueField])||0; });
  return sum;
}

function buildValueScurveSVG(opts){
  // opts: {label, tasks, plannedTotal, actualLogs, valueField, unitLabel, formatValue}
  const withDates = opts.tasks.filter(hasValidDates);
  if(withDates.length===0 || !opts.plannedTotal){
    return `<div class="help">Not enough data yet — need dated schedule tasks and a planned total (set it above) to draw this curve.</div>`;
  }
  let minD = new Date(Math.min(...withDates.map(t=>+new Date(t.plannedStart))));
  let maxD = new Date(Math.max(...withDates.map(t=>+new Date(t.revisedFinish||t.plannedFinish))));
  /* === HORIZON FIX: START ===
     Dating naka-clamp ang maxD papuntang Dec 31, 2030 kahit matagal nang
     dapat matapos ang project — kaya artificially lumalaki ang buong date
     span, at ang bawat isa sa 60 sampling steps ng chart ay tumatalon ng
     mas malaking bilang ng araw kaysa dapat (hal. Aug 1 → Sep 9 → Oct 8
     sa halip na malinaw na pantay-pantay na agwat). Ngayon, ang aktwal na
     huling plannedFinish/revisedFinish sa dataset mismo ang dulo ng chart,
     may +14 days na maliit na padding lang para may espasyo ang huling
     datapoint. */
  maxD = new Date(+maxD + 14*DAY);
  /* === HORIZON FIX: END === */

  const W=900, H=260, padL=64, padR=18, padT=16, padB=30;
  const totalW = W-padL-padR, totalH = H-padT-padB;
  const totalDays = Math.max(1,(maxD-minD)/DAY);
  const steps = 60;
  const rawPts = [];
  for(let i=0;i<=steps;i++){
    const d = new Date(+minD + (totalDays*i/steps)*DAY);
    const planned = weightedPlannedPct(withDates, d)/100 * opts.plannedTotal;
    const actual = (d<=state.asOfDate) ? cumulativeLogValueAt(opts.actualLogs, opts.valueField, d) : null;
    rawPts.push({d, planned, actual});
  }
  const maxVal = Math.max(opts.plannedTotal, ...rawPts.filter(p=>p.actual!=null).map(p=>p.actual), 1) * 1.08;
  const x = d => padL + ((d-minD)/DAY)/totalDays*totalW;
  const y = v => padT + totalH - (clamp(v,0,maxVal)/maxVal)*totalH;

  const plannedPath = rawPts.map((p,i)=>`${i===0?'M':'L'}${x(p.d).toFixed(1)},${y(p.planned).toFixed(1)}`).join(' ');
  const actualPtsOnly = rawPts.filter(p=>p.actual!=null);
  const actualPath = actualPtsOnly.map((p,i)=>`${i===0?'M':'L'}${x(p.d).toFixed(1)},${y(p.actual).toFixed(1)}`).join(' ');
  const todayX = x(clamp(state.asOfDate, minD, maxD));

  let gridlines='', yearLabels='';
  for(let yr=minD.getFullYear(); yr<=maxD.getFullYear(); yr++){
    const gd = new Date(yr,0,1);
    if(gd<minD||gd>maxD) continue;
    const gx = x(gd);
    gridlines += `<line x1="${gx}" y1="${padT}" x2="${gx}" y2="${padT+totalH}" stroke="#1A222C" stroke-width="1"/>`;
    yearLabels += `<text x="${gx}" y="${H-8}" fill="#546274" font-size="10" font-family="var(--mono)">${yr}</text>`;
  }
  let hlines='';
  [0,0.25,0.5,0.75,1].forEach(f=>{
    const v = f*maxVal;
    hlines += `<line x1="${padL}" y1="${y(v)}" x2="${W-padR}" y2="${y(v)}" stroke="#161D26" stroke-width="1"/>`;
    hlines += `<text x="4" y="${y(v)+3}" fill="#546274" font-size="10" font-family="var(--mono)">${opts.formatValue(v)}</text>`;
  });

  const latestActual = [...actualPtsOnly].reverse()[0];
  const latestPlanned = rawPts.filter(p=>p.d<=state.asOfDate).slice(-1)[0];
  const variance = (latestActual && latestPlanned) ? latestActual.actual - latestPlanned.planned : null;

  return `
  <h4>${esc(opts.label)}</h4>
  <div class="sub">Horizon: ${fmtDate(minD)} → ${fmtDate(maxD)} · today = ${fmtDate(state.asOfDate)} · unit: ${esc(opts.unitLabel)}</div>
  <svg viewBox="0 0 ${W} ${H}" style="width:100%;height:auto;display:block;">
    ${hlines}${gridlines}
    <line x1="${todayX}" y1="${padT}" x2="${todayX}" y2="${padT+totalH}" stroke="#FFB020" stroke-width="1.3" stroke-dasharray="4 3"/>
    <path d="${plannedPath}" fill="none" stroke="#4FC3F7" stroke-width="2.4"/>
    <path d="${actualPath}" fill="none" stroke="#3DDC84" stroke-width="2.4"/>
    ${yearLabels}
  </svg>
  <div class="legend">
    <span><i style="background:#4FC3F7"></i> Planned (time-phased from schedule %)</span>
    <span><i style="background:#3DDC84"></i> Actual (from logged entries)</span>
  </div>
  <div class="legend" style="margin-top:4px;">
    <span>Planned to-date: <b>${latestPlanned?opts.formatValue(latestPlanned.planned):'—'}</b></span>
    <span>Actual to-date: <b>${latestActual?opts.formatValue(latestActual.actual):'—'}</b></span>
    <span>Variance: <b style="color:${variance==null?'var(--text-dim)':(variance<0?'var(--red)':'var(--green)')}">${variance==null?'—':opts.formatValue(variance)}</b></span>
  </div>`;
}

function buildBananaCurveSVG(tasks, label){
  const withDates = tasks.filter(hasValidDates);
  if(withDates.length===0) return `<div class="help">No dated tasks for ${esc(label)}.</div>`;
  let minD = new Date(Math.min(...withDates.map(t=>+new Date(t.plannedStart))));
  let maxD = new Date(Math.max(...withDates.map(t=>+new Date(t.revisedFinish||t.plannedFinish))));
  /* === HORIZON FIX: START === (see buildValueScurveSVG for full rationale) */
  maxD = new Date(+maxD + 14*DAY);
  /* === HORIZON FIX: END === */

  const W=900, H=280, padL=46, padR=18, padT=16, padB=30;
  const totalW = W-padL-padR, totalH = H-padT-padB;
  const totalDays = Math.max(1,(maxD-minD)/DAY);
  const steps = 60;
  const x = d => padL + ((d-minD)/DAY)/totalDays*totalW;
  const y = p => padT + totalH - (clamp(p,0,100)/100)*totalH;

  function plannedPctAtOriginal(date){
    let w=0, sum=0;
    withDates.forEach(t=>{
      if(t.weightPct==null) return;
      const s = new Date(t.plannedStart), f = new Date(t.plannedFinish);
      const dur = Math.max(1,(f-s)/DAY);
      const elapsed = clamp((date-s)/DAY,0,dur);
      w += t.weightPct;
      sum += t.weightPct*(elapsed/dur)*100;
    });
    return w>0 ? sum/w : 0;
  }

  const rawPts = [];
  for(let i=0;i<=steps;i++){
    const d = new Date(+minD + (totalDays*i/steps)*DAY);
    rawPts.push({
      d,
      early: plannedPctAtOriginal(d),
      late: weightedPlannedPct(withDates, d),
      actual: (d<=state.asOfDate) ? weightedActualPctAtDate(withDates, d) : null,
    });
  }

  const linePath = field => rawPts.map((p,i)=>`${i===0?'M':'L'}${x(p.d).toFixed(1)},${y(p[field]).toFixed(1)}`).join(' ');
  const earlyPath = linePath('early');
  const latePath = linePath('late');
  const bandPath = earlyPath + ' L' + [...rawPts].reverse().map(p=>`${x(p.d).toFixed(1)},${y(p.late).toFixed(1)}`).join(' L') + ' Z';
  const actualPtsOnly = rawPts.filter(p=>p.actual!=null);
  const actualPath = actualPtsOnly.map((p,i)=>`${i===0?'M':'L'}${x(p.d).toFixed(1)},${y(p.actual).toFixed(1)}`).join(' ');
  const todayX = x(clamp(state.asOfDate, minD, maxD));

  let gridlines='', yearLabels='';
  for(let yr=minD.getFullYear(); yr<=maxD.getFullYear(); yr++){
    const gd = new Date(yr,0,1);
    if(gd<minD||gd>maxD) continue;
    const gx = x(gd);
    gridlines += `<line x1="${gx}" y1="${padT}" x2="${gx}" y2="${padT+totalH}" stroke="#1A222C" stroke-width="1"/>`;
    yearLabels += `<text x="${gx}" y="${H-8}" fill="#546274" font-size="10" font-family="var(--mono)">${yr}</text>`;
  }
  let hlines='';
  [0,25,50,75,100].forEach(p=>{
    hlines += `<line x1="${padL}" y1="${y(p)}" x2="${W-padR}" y2="${y(p)}" stroke="#161D26" stroke-width="1"/>`;
    hlines += `<text x="4" y="${y(p)+3}" fill="#546274" font-size="10" font-family="var(--mono)">${p}%</text>`;
  });

  return `
  <h4>${esc(label)} — Banana Curve</h4>
  <div class="sub">Early = original baseline dates · Late = current/revised dates · band = allowable float zone · today = ${fmtDate(state.asOfDate)}</div>
  <svg viewBox="0 0 ${W} ${H}" style="width:100%;height:auto;display:block;">
    ${hlines}${gridlines}
    <path d="${bandPath}" fill="#4FC3F7" opacity="0.08" stroke="none"/>
    <line x1="${todayX}" y1="${padT}" x2="${todayX}" y2="${padT+totalH}" stroke="#FFB020" stroke-width="1.3" stroke-dasharray="4 3"/>
    <path d="${earlyPath}" fill="none" stroke="#4FC3F7" stroke-width="2" stroke-dasharray="5 3"/>
    <path d="${latePath}" fill="none" stroke="#A78BFA" stroke-width="2" stroke-dasharray="5 3"/>
    <path d="${actualPath}" fill="none" stroke="#3DDC84" stroke-width="2.6"/>
    ${yearLabels}
  </svg>
  <div class="legend">
    <span><i style="background:#4FC3F7"></i> Early / Original Baseline</span>
    <span><i style="background:#A78BFA"></i> Late / Current Program</span>
    <span><i style="background:#3DDC84"></i> Actual</span>
  </div>
  <div class="help" style="margin-top:6px;">Approximated from tracked Planned vs Revised dates (no full CPM logic-link network in this dataset) — the practical banana curve most contractors use without a fully linked P6 schedule.</div>`;
}
/* === 7 S-CURVES: END === */

 /* === SPI DENOMINATOR ALIGNMENT (Option A): START ===
   Dati, ang SPI ay gumagamit ng `pvTracked` — isang HIWALAY na denominator na
   restricted lang sa mga task na may naka-log na accToDatePct. Ibig sabihin
   magkaibang "population" ang ginagamit ng SPI number (Dashboard KPI) kumpara
   sa Planned/Actual lines mismo ng Master S-Curve (na gumagamit na ng buong
   population matapos ang Option A fix sa weightedActualPct/
   weightedPctFromSnapshot). Kaya posibleng magkaiba ang implied gap sa chart
   kumpara sa sinasabing SPI — nakalilito sa isang PM na titignan pareho.
   Ngayon, ang `pv` mismo (full-population time-phased planned value, kasama
   na ang lahat ng may weightPct) ang ginagamit bilang denominator — pareho na
   ito sa convention ng weightedPlannedPct(). Ang `ev` ay 0 pa rin ang
   kontribusyon kung walang accToDatePct (hindi tinatanggal sa dataset) —
   pareho sa convention ng weightedActualPct(). Kaya magkatugma na ngayon ang
   SPI at ang Planned/Actual lines ng Master S-Curve — parehong population,
   parehong "walang report = 0% progress" na pagpapalagay. */
function computeSPI(taskList){
  const now = state.asOfDate;
  let pv=0, bac=0, ev=0;
  taskList.filter(hasValidDates).forEach(t=>{
    if(t.weightPct==null) return;
    const [s,f] = activeRange(t);
    const dur = Math.max(1,(f-s)/DAY);
    const elapsed = clamp((now-s)/DAY, 0, dur);
    const timeFrac = elapsed/dur;
    bac += t.weightPct;
    pv += t.weightPct * timeFrac;
    if(t.accToDatePct!=null){
      ev += t.weightPct * (t.accToDatePct/100);
    }
  });
  const spi = pv>0 ? (ev/pv) : null;
  return {pv, ev, bac, spi};
}
/* === SPI DENOMINATOR ALIGNMENT (Option A): END === */

function plannedPctAt(t, date){
  const [s,f] = activeRange(t);
  const dur = Math.max(1,(f-s)/DAY);
  const elapsed = clamp((date-s)/DAY,0,dur);
  return elapsed/dur;
}
/* === ACTUAL-LINE DENOMINATOR FIX (Option A): START ===
   Dati, ang task na walang naka-log na accToDatePct ay basta tinatanggal sa
   DENOMINATOR (w) — kaya mas maliit ang population ng Actual kaysa sa
   Planned (na kumukuha ng buong weight ng lahat ng may weightPct). Ngayon,
   kasama sa denominator ang LAHAT ng may weightPct, pero ang task na walang
   accToDatePct ay itinuturing na 0% progress (standard EVM convention) sa
   halip na tanggalin — kaya magkapareho na ang population ng Planned at
   Actual lines. */
function weightedActualPct(tasks){
  let w=0, sum=0;
  tasks.filter(hasValidDates).forEach(t=>{
    if(t.weightPct==null) return;
    w+=t.weightPct;
    if(t.accToDatePct!=null) sum+=t.weightPct*t.accToDatePct;
  });
  return w>0 ? sum/w : 0;
}
/* === ACTUAL-LINE DENOMINATOR FIX (Option A): END === */
function weightedPlannedPct(tasks, date){
  let w=0, sum=0;
  tasks.filter(hasValidDates).forEach(t=>{ if(t.weightPct!=null){ w+=t.weightPct; sum += t.weightPct*plannedPctAt(t,date)*100; } });
  return w>0 ? sum/w : 0;
}

/* === ACCOMPLISHMENT SNAPSHOT LOG: START ===
   Isang snapshot ng accToDatePct per task, isang beses per araw (overwrite kung
   ilang import ang nangyari sa parehong araw). Dito hinuhugot ng S-curve ang
   totoong historical "actual" value sa halip na yung latest snapshot na lang. */
function findSnapshotAtOrBefore(date){
  const t = +date;
  let best = null;
  state.snapshots.forEach(s=>{
    const st = +new Date(s.at);
    if(st<=t && (!best || st>+new Date(best.at))) best = s;
  });
  return best;
}
/* === S-CURVE DATE SEQUENCING: START ===
   Dating step function ang actual line (naka-freeze sa huling snapshot
   hanggang sa susunod na import) — hindi tugma sa standard S-curve na dapat
   makinis at tuloy-tuloy araw-araw. Dito, hinahanap muna ang snapshot BAGO
   at PAGKATAPOS ng hiniling na petsa, tapos ginagawan ng linear
   interpolation ang weighted % sa pagitan ng dalawa — kaya kalendaryo-based
   at walang hagdan-hagdan kahit paisa-isang linggo/buwan lang ang aktwal
   na import. */
function findSurroundingSnapshots(date){
  const t = +date;
  let before = null, after = null;
  state.snapshots.forEach(s=>{
    const st = +new Date(s.at);
    if(st<=t && (!before || st>+new Date(before.at))) before = s;
    if(st>=t && (!after || st<+new Date(after.at))) after = s;
  });
  return {before, after};
}
function weightedPctFromSnapshot(tasks, snap){
  if(!snap) return null;
  let w=0, sum=0;
  /* === WEIGHT-FREEZE SNAPSHOT (read side): START ===
     Suportado pa rin ang lumang format ng snapshot (plain number, walang
     naka-freeze na weight) sa pamamagitan ng fallback sa CURRENT weight
     ng task. Para sa bagong format ({acc, weight}), ang naka-freeze na
     weight sa mismong petsang iyon ang laging gagamitin. */
  /* === ACTUAL-LINE DENOMINATOR FIX (Option A): START ===
     Dati, ang task na walang entry sa snap.values (raw==null — hindi pa
     na-track sa petsang iyon) ay basta sina-skip, kaya tinatanggal din sa
     DENOMINATOR — parehong isyu gaya ng weightedActualPct(). Ngayon, kasama
     pa rin sa denominator (w) ang buong weight nito (fallback sa
     kasalukuyang t.weightPct dahil wala pang na-freeze na historical weight
     para dito), pero 0 ang kontribusyon sa sum — itinuturing itong "0%
     progress noon" sa halip na "wala sa dataset". */
  tasks.forEach(t=>{
    if(t.weightPct==null) return;
    const raw = snap.values[t.id];
    let histAcc = null, histWeight = t.weightPct;
    if(raw!=null){
      if(typeof raw === 'number'){
        histAcc = raw;
        histWeight = t.weightPct;
      } else {
        histAcc = raw.acc;
        histWeight = raw.weight!=null ? raw.weight : t.weightPct;
      }
    }
    w += histWeight;
    if(histAcc!=null) sum += histWeight*histAcc;
  });
  /* === ACTUAL-LINE DENOMINATOR FIX (Option A): END === */
  /* === WEIGHT-FREEZE SNAPSHOT (read side): END === */
  return w>0 ? sum/w : null;
}
function weightedActualPctAtDate(tasks, date){
  /* === S-CURVE DATE SEQUENCING (backward-fill fix): START ===
     Kung wala pang snapshot BAGO sa hiniling na petsa, huwag mag-"backfill"
     gamit ang unang kilalang snapshot — magreresulta iyon sa maling flat na
     linya paatras hanggang sa simula ng project, na parang may accomplishment
     na kahit bago pa man magsimula ang pagsubaybay. Walang datos (null;
     puwang sa chart) bago ang unang totoong snapshot. Pasulong lang (mula
     huling kilalang snapshot papunta sa "today") ang flat extrapolation,
     dahil tama namang ipagpalagay na walang bagong progress kung walang
     bagong report. */
  const {before, after} = findSurroundingSnapshots(date);
  if(!before) return null;
  const beforeVal = weightedPctFromSnapshot(tasks, before);
  if(!after || before===after) return beforeVal;
  const afterVal = weightedPctFromSnapshot(tasks, after);
  if(afterVal==null) return beforeVal;
  const t0 = +new Date(before.at), t1 = +new Date(after.at), t = +date;
  if(t1<=t0) return beforeVal;
  const frac = clamp((t-t0)/(t1-t0), 0, 1);
  return beforeVal + (afterVal-beforeVal)*frac;
  /* === S-CURVE DATE SEQUENCING (backward-fill fix): END === */
}
/* === S-CURVE DATE SEQUENCING: END === */
function recordSnapshot(asOfDate){
  const today = asOfDate ? new Date(asOfDate) : new Date();
  const dayKey = today.toISOString().slice(0,10);
  const values = {};
  /* === WEIGHT-FREEZE SNAPSHOT: START ===
     Iniimbak na ang {acc, weight} object sa halip na plain number — ang
     weight na ginamit sa petsang ito ay permanenteng naka-lock sa snapshot
     mismo, kaya hindi na muling babaguhin ang kasaysayan ng S-curve kung
     babaguhin mo ang Weight % ng isang task sa hinaharap. */
  state.tasks.forEach(t=>{
    if(t.accToDatePct!=null){
      values[t.id] = { acc: t.accToDatePct, weight: t.weightPct!=null ? t.weightPct : null };
    }
  });
  /* === WEIGHT-FREEZE SNAPSHOT: END === */
  const existingIdx = state.snapshots.findIndex(s=>s.at.slice(0,10)===dayKey);
  const snap = { at: today.toISOString(), values };
  if(existingIdx>=0) state.snapshots[existingIdx] = snap;
  else state.snapshots.push(snap);
  state.snapshots.sort((a,b)=>new Date(a.at)-new Date(b.at));
  saveSnapshots();
}
/* === ACCOMPLISHMENT SNAPSHOT LOG: END === */

/* ---------------------------------------------------------------------
   FINANCE / COST ENGINE (Earned Value)
   costEntries: {id, building, trade, category, type:'budget'|'actual', amount, date, note, sourceFile}
   --------------------------------------------------------------------- */
function buildingList(){
  const set = new Set([
    ...state.tasks.map(t=>t.building),
    ...state.costEntries.map(e=>e.building),
    ...state.materialEntries.map(m=>m.building),
    ...state.quantityTakedowns.map(q=>q.building),
    ...state.violations.map(v=>v.building),
    ...state.forecastNotes.map(f=>f.building),
    ...state.variationOrders.map(v=>v.building),
    ...state.rfis.map(r=>r.building),
  ]);
  return [...set].filter(Boolean).sort();
}

/* === EAC SANITY BOUND: START ===
   Kung napakaliit ng CPI (malapit sa zero — nangyayari kapag maliit pa lang
   ang accomplishment pero may laki na ng na-book na actual cost), ang
   EAC = actual + (budget-EV)/CPI ay pwedeng mag-explode papuntang hindi
   makatotohanang numero. Dalawang threshold: kailangan may sapat nang
   schedule progress (>=5%) AT hindi masyadong maliit ang CPI (>=0.1) bago
   tiwalaan ang CPI-based na forecast. Kung hindi pa reliable, i-fallback sa
   budget mismo (ibig sabihin "assumed on-budget hanggang may sapat nang
   datos") at i-flag bilang 'low' confidence sa halip na maglabas ng maling
   confident na numero. */
const MIN_RELIABLE_ACTUAL_PCT = 0.05;
const MIN_RELIABLE_CPI = 0.1;
/* === EAC SANITY BOUND: END === */

function costSummaryForBuilding(b){
  const entries = state.costEntries.filter(e=>e.building===b);
  const budget = entries.filter(e=>e.type==='budget').reduce((s,e)=>s+(Number(e.amount)||0),0);
  const actual = entries.filter(e=>e.type==='actual').reduce((s,e)=>s+(Number(e.amount)||0),0);
  /* === VEX SCHEMA SYNC: START ===
     'committed' = PO/contract issued pero hindi pa binabayaran (Vex
     costEntries.type). Hindi ito kasama sa EV/CPI/EAC math (parehong
     convention gaya ng dati — actual lang ang binibilang doon), pero
     dapat visible bilang hiwalay na "committed exposure" figure sa halip
     na tahimik na mawala. */
  const committed = entries.filter(e=>e.type==='committed').reduce((s,e)=>s+(Number(e.amount)||0),0);
  /* === VEX SCHEMA SYNC: END === */
  const scheduleTasks = state.tasks.filter(t=>t.building===b);
  const actualPct = scheduleTasks.length ? weightedActualPct(scheduleTasks)/100 : 0;
  const ev = budget * actualPct;
  const cpi = actual>0 ? ev/actual : null;
  /* === EAC SANITY BOUND: START === */
  let eac, eacConfidence = 'normal';
  const cpiReliable = cpi!=null && cpi>=MIN_RELIABLE_CPI && actualPct>=MIN_RELIABLE_ACTUAL_PCT;
  if(cpiReliable){
    eac = actual + (budget-ev)/cpi;
  } else if(budget>0){
    eac = budget;
    eacConfidence = (actual>0 || actualPct>0) ? 'low' : 'normal';
  } else {
    eac = null;
  }
  /* === EAC SANITY BOUND: END === */
  const vac = (budget>0 && eac!=null) ? budget-eac : null;
  const contractValue = (state.projectMeta[b] && state.projectMeta[b].contractValue) || null;
  const projectedProfit = (contractValue!=null && eac!=null) ? contractValue-eac : null;
  const profitToDate = (contractValue!=null) ? (contractValue*actualPct) - actual : null;
  return {building:b, budget, actual, committed, ev, cpi, eac, eacConfidence, vac, contractValue, projectedProfit, profitToDate, actualPct};
}

function computeCostWarnings(){
  const warnings = [];
  buildingList().forEach(b=>{
    const s = costSummaryForBuilding(b);
    if(s.budget>0 && s.vac!=null && s.vac < 0){
      warnings.push({building:b, overage: Math.abs(s.vac), summary:s});
    }
  });
  return warnings.sort((a,b)=>b.overage-a.overage);
}

/* === WEIGHT% NORMALIZATION CHECK: START ===
   Walang dating check kung ang WT% ng lahat ng tasks per building ay
   sumasadsad sa ~100%. Tolerance na ±5% bago i-flag — mas mahigpit dito
   posibleng maraming false positive dahil sa rounding sa source files. */
function computeWeightWarnings(){
  const warnings = [];
  buildingList().forEach(b=>{
    const tasks = state.tasks.filter(t=>t.building===b && t.weightPct!=null);
    if(!tasks.length) return;
    const total = tasks.reduce((s,t)=>s+t.weightPct,0);
    if(Math.abs(total-100) > 5){
      warnings.push({building:b, total, taskCount: tasks.length});
    }
  });
  return warnings.sort((a,b)=>Math.abs(b.total-100)-Math.abs(a.total-100));
}
/* === WEIGHT% NORMALIZATION CHECK: END === */

/* ---------------------------------------------------------------------
   MATERIALS / SUPPLY ENGINE
   materialEntries: {id, building, item, unit, qtyOnHand, weeklyConsumption, leadTimeDays, sourceFile, updatedAt}
   --------------------------------------------------------------------- */
function materialsForBuilding(b){
  return state.materialEntries.filter(m=>m.building===b).map(m=>{
    const weeklyC = Number(m.weeklyConsumption)||0;
    const daysSupply = weeklyC>0 ? (Number(m.qtyOnHand)||0)/weeklyC*7 : null;
    const leadTime = Number(m.leadTimeDays)||0;
    const atRisk = daysSupply!=null && daysSupply < leadTime;
    const severity = !atRisk ? null : (daysSupply < leadTime*0.4 ? 'High' : daysSupply < leadTime*0.75 ? 'Medium' : 'Low');
    return Object.assign({}, m, {daysSupply, atRisk, severity});
  });
}
function computeMaterialWarnings(){
  const warnings = [];
  buildingList().forEach(b=>{
    materialsForBuilding(b).forEach(m=>{ if(m.atRisk) warnings.push(m); });
  });
  return warnings.sort((a,b)=>(a.daysSupply??0)-(b.daysSupply??0));
}

