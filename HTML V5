  bg.querySelector('#editSaveBtn').addEventListener('click', ()=>saveTaskEdit(id, bg));
}
window.openEditTaskModal = openEditTaskModal;

function saveTaskEdit(id, modalEl){
  const t = state.tasks.find(x=>x.id===id);
  if(!t) return;
  if(t.locked){ toast('This task is locked — unlock it first.', 'err'); return; }
  const val = sel => document.getElementById(sel).value;
  const parseDateInput = s => {
    if(!s) return null;
    const d = new Date(s+'T00:00:00');
    return isNaN(d.getTime()) ? null : d.toISOString();
  };
  const newPlannedStart = parseDateInput(val('editPlannedStart'));
  const newPlannedFinish = parseDateInput(val('editPlannedFinish'));
  if(newPlannedStart==null || newPlannedFinish==null){
    toast('Planned Start and Planned Finish are required.', 'err');
    return;
  }
  const newRevisedStart = parseDateInput(val('editRevisedStart'));
  const newRevisedFinish = parseDateInput(val('editRevisedFinish'));
  const wRaw = val('editWeightPct');
  const newWeightPct = wRaw===''? null : Number(wRaw);
  const aRaw = val('editAccToDatePct');
  const newAccToDatePct = aRaw==='' ? null : Number(aRaw);

  const datesChanged = t.plannedStart!==newPlannedStart || t.plannedFinish!==newPlannedFinish ||
                        t.revisedStart!==newRevisedStart || t.revisedFinish!==newRevisedFinish;
  if(datesChanged){
    t.revisionHistory = t.revisionHistory || [];
    t.revisionHistory.push({
      at: t.importedAt || new Date().toISOString(),
      plannedStart: t.plannedStart, plannedFinish: t.plannedFinish,
      revisedStart: t.revisedStart, revisedFinish: t.revisedFinish,
      manualEdit: true,
    });
  }

  t.category = val('editCategory').trim();
  t.subcategory = val('editSubcategory').trim();
  t.level = val('editLevel').trim() || null;
  t.plannedStart = newPlannedStart;
  t.plannedFinish = newPlannedFinish;
  t.revisedStart = newRevisedStart;
  t.revisedFinish = newRevisedFinish;
  t.weightPct = newWeightPct;
  t.accToDatePct = newAccToDatePct;
  t.manuallyEdited = true;
  t.editedAt = new Date().toISOString();
  /* === DATE LOGIC VALIDATION: START === */
  const staleLogicMsgs = ['Revised Finish is earlier than Revised Start', 'Revised Finish is earlier than the original Planned Start'];
  t.dataIssues = (t.dataIssues||[]).filter(m=>!staleLogicMsgs.some(p=>m.startsWith(p)));
  const editLogicIssues = checkDateLogicIssues(t.plannedStart, t.plannedFinish, t.revisedStart, t.revisedFinish);
  if(editLogicIssues.length){
    t.dataIssues.push(...editLogicIssues);
    t.confidence = 'low';
    toast('Saved, but flagged: '+editLogicIssues[0], 'err');
  }
  /* === DATE LOGIC VALIDATION: END === */

  saveDB();
  /* === S-CURVE DATE SEQUENCING: START ===
     Dati, ang direktang pag-edit ng Accomplishment % dito sa Database tab
     ay hindi nagre-record ng snapshot — kaya hindi ito nare-reflect sa
     S-curve "actual" line hanggang sa susunod na import/field update.
     Kinukuha ngayon ang isang snapshot kaagad pagkatapos i-save. */
  recordSnapshot();
  /* === S-CURVE DATE SEQUENCING: END === */
  modalEl.remove();
  toast('Task updated.', 'ok');
  render();
}
window.saveTaskEdit = saveTaskEdit;
