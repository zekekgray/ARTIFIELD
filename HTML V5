function verifyTask(id){
  state.verifications[id] = {verifiedAt: new Date().toISOString()};
  const t = state.tasks.find(x=>x.id===id);
  if(t){ t.status='Verified'; t.locked = true; }
  saveDB();
  toast('Revision verified and locked from further edits/imports.', 'ok');
  render();
}
window.verifyTask = verifyTask;

function unlockTask(id){
  const t = state.tasks.find(x=>x.id===id);
  if(!t) return;
  t.locked = false;
  saveDB();
  toast(`"${t.name}" unlocked — editable again until re-verified.`, 'ok');
  render();
}
window.unlockTask = unlockTask;

function applyLockedConflict(conflictId){
  const idx = state.lockedImportConflicts.findIndex(c=>c.id===conflictId);
  if(idx<0) return;
  const conf = state.lockedImportConflicts[idx];
  const t = state.tasks.find(x=>x.id===conf.taskId);
  if(t){
    t.revisionHistory = t.revisionHistory || [];
    t.revisionHistory.push({
      at: t.importedAt || new Date().toISOString(),
      plannedStart: t.plannedStart, plannedFinish: t.plannedFinish,
      revisedStart: t.revisedStart, revisedFinish: t.revisedFinish,
    });
    Object.assign(t, conf.incoming, { locked: false, status: 'Shifted', importedAt: new Date().toISOString() });
    delete state.verifications[t.id];
    saveDB();
    recordSnapshot();
    toast(`Applied incoming values to "${t.name}" — unlocked, pending re-verification.`, 'ok');
  }
  state.lockedImportConflicts.splice(idx,1);
  saveLockedConflicts();
  render();
}
window.applyLockedConflict = applyLockedConflict;

function dismissLockedConflict(conflictId){
  state.lockedImportConflicts = state.lockedImportConflicts.filter(c=>c.id!==conflictId);
  saveLockedConflicts();
  toast('Conflict dismissed — locked task keeps its current (verified) values.', 'ok');
  render();
}
window.dismissLockedConflict = dismissLockedConflict;

