function esc(s){ return (s==null?'':String(s)).replace(/[&<>"]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
/* === ONCLICK-SAFE ARGUMENT ESCAPING: START ===
   Ang esc() ay HTML-escape lang (&, <, >, ") — hindi hinahawakan ang single
   quote ('). Kapag ang building/trade/item name ay may apostrophe (hal.
   "Contractor's Mix", "D'Building" — karaniwan sa totoong construction
   data), nasisira ang JS string literal sa loob ng onclick="...('...')"
   attribute, kaya tahimik na hindi gumagana ang button (walang error,
   basta't walang epekto ang click). Ginagamit ito sa halip na esc() kapag
   ang value ay ipinapasok bilang JS string ARGUMENT sa loob ng onclick/
   onchange handler (hindi para sa text content — doon esc() pa rin). */
function escOnclickArg(s){
  return String(s==null?'':s)
    .replace(/\\/g,'\\\\')
    .replace(/'/g,"\\'")
    .replace(/"/g,'&quot;')
    .replace(/</g,'&lt;')
    .replace(/>/g,'&gt;')
    .replace(/\n/g,'\\n')
    .replace(/\r/g,'');
}
/* === ONCLICK-SAFE ARGUMENT ESCAPING: END === */
function peso(n){ if(n==null||isNaN(n)) return '—'; const sign = n<0?'-':''; return sign+'₱'+Math.round(Math.abs(n)).toLocaleString('en-PH'); }

const LEVEL_PATTERNS = [
  [/ground\s*floor|^gf\b/i,'Ground Floor'],
  [/(\d+)(st|nd|rd|th)\s*f\s*loor/i, m=>`${m[1]}${m[2]} Floor`],
  [/mezzanine/i,'Mezzanine'],
  [/podium/i,'Podium'],
  [/roof\s*deck|^roof/i,'Roof Deck'],
  [/basement|^b\d/i,'Basement'],
  [/penthouse/i,'Penthouse'],
];
function detectLevel(text){
  if(!text) return null;
  for(const [re, out] of LEVEL_PATTERNS){
    const m = text.match(re);
    if(m) return (typeof out==='function') ? out(m) : out;
  }
  return null;
}

/* ---------------------------------------------------------------------
   SCHEDULE PARSER — header/column auto-detection, generic across formats
   --------------------------------------------------------------------- */
function sheetToMatrix(ws){
  return XLSX.utils.sheet_to_json(ws, {header:1, raw:true, defval:null});
}

function findHeaderCols(matrix){
  const found = { desc:null, start:null, finish:null, start2:null, finish2:null, weight:null, acc:null, accConfidence:null, duration:null, actId:null };
  const maxScanRow = Math.min(25, matrix.length);
  let startCols = [], finishCols = [];
  /* === ACC COLUMN DETECTION HARDENING: START ===
     Dati: basta may "to-date" sa header text, kunin agad ang c+1 bilang value
     column — walang paraan malaman kung tama. Ngayon, nirarank ang mga
     candidate: "high" kung may %/pct/percent mismo sa parehong header cell,
     "medium" kung ang KASUNOD na header cell ang may %, "low" kung wala
     talagang %-indicator kahit saan (yung dating blind guess). Pinipili ang
     pinaka-mataas ang confidence; ang confidence ay ikina-carry sa task-level
     dataIssues kapag "low" para malaman ng user na dapat i-verify. */
  let accCandidates = [];
  /* === ACC COLUMN DETECTION HARDENING: END === */
  for(let r=0;r<maxScanRow;r++){
    const row = matrix[r] || [];
    for(let c=0;c<row.length;c++){
      const v = row[c];
      if(typeof v !== 'string') continue;
      const t = v.trim().toLowerCase();
      if(/^start$/.test(t)) startCols.push(c);
      if(/^(finish|end)$/.test(t)) finishCols.push(c);
      /* === P6 ACTIVITY ID DETECTION: START === */
      if(found.actId===null && /^(activity|act)\s*id$|^p6\s*id$|^task\s*id$/.test(t)) found.actId = c;
      /* === P6 ACTIVITY ID DETECTION: END === */
      if(found.desc===null && !/\bid$/.test(t) && /(work )?description|item.*desc|activity/.test(t)) found.desc = c;
      if(found.weight===null && (/\bwt\b|weight\s*%/.test(t))) found.weight = c;
      if(found.duration===null && /duration|^days$/.test(t)) found.duration = c;
      /* === ACC COLUMN DETECTION HARDENING: START === */
      if(/to\s*-?\s*date/.test(t)){
        if(/%|pct|percent/.test(t)){
          accCandidates.push({col:c, confidence:'high'});
        } else {
          const nextHeader = row[c+1];
          if(typeof nextHeader === 'string' && /%|pct|percent/.test(nextHeader.toLowerCase())){
            accCandidates.push({col:c+1, confidence:'medium'});
          } else {
            accCandidates.push({col:c+1, confidence:'low'});
          }
        }
      }
      /* === ACC COLUMN DETECTION HARDENING: END === */
    }
  }
  if(startCols.length){ found.start = startCols[0]; found.finish = (finishCols[0]!=null)?finishCols[0]:startCols[0]+1; }
  if(startCols.length>1){ found.start2 = startCols[1]; found.finish2 = (finishCols[1]!=null)?finishCols[1]:startCols[1]+1; }
  /* === ACC COLUMN DETECTION HARDENING: START === */
  if(accCandidates.length){
    const rank = {high:3, medium:2, low:1};
    accCandidates.sort((a,b)=>rank[b.confidence]-rank[a.confidence]);
    found.acc = accCandidates[0].col;
    found.accConfidence = accCandidates[0].confidence;
  }
  /* === ACC COLUMN DETECTION HARDENING: END === */
  return found;
}

function guessDescCol(matrix, headerCols){
  if(headerCols.desc!=null) return headerCols.desc;
  const colCount = {};
  for(const row of matrix){
    if(!row) continue;
    for(let c=0;c<Math.min(row.length,6);c++){
      if(typeof row[c]==='string' && row[c].trim().length>2 && isNaN(Date.parse(row[c]))){
        colCount[c] = (colCount[c]||0)+1;
      }
    }
  }
  let best=1, bestCt=-1;
  for(const c in colCount){ if(colCount[c]>bestCt){ bestCt=colCount[c]; best=+c; } }
  return best;
}

function extractProjectMeta(matrix){
  let building=null, trade=null;
  const maxScan = Math.min(10, matrix.length);
  for(let r=0;r<maxScan;r++){
    const row = matrix[r]||[];
    for(let c=0;c<row.length;c++){
      const v = row[c];
      if(typeof v!=='string') continue;
      const label = v.trim().toLowerCase().replace(/:$/,'').trim();
      if(label!=='scope' && label!=='subject' && label!=='project') continue;
      let val=null;
      for(let cc=c+1; cc<row.length; cc++){
        let cv = row[cc];
        if(cv==null) continue;
        if(typeof cv==='string'){ cv = cv.replace(/^:\s*/,'').trim(); if(cv==='') continue; }
        val = cv; break;
      }
      if(val==null) continue;
      if(label==='scope' && !trade) trade = String(val).trim();
      if(label==='subject'){
        const bm = String(val).match(/BUILDING\s+([A-Z0-9]+)/i);
        if(bm && !building) building = bm[1].toUpperCase();
      }
    }
  }
  return {building, trade};
}

const PROJECT_MIN_DATE = new Date('2018-01-01');
const PROJECT_MAX_DATE = new Date('2033-12-31');
function isSaneDate(d){ return d instanceof Date && !isNaN(d) && d>=PROJECT_MIN_DATE && d<=PROJECT_MAX_DATE; }

/* === DATE LOGIC VALIDATION: START ===
   Ang isSaneDate() lang (2018-2033 range check) ay hindi sapat — puwedeng
   "sane" ang isang petsa (nasa loob ng range) pero logically mali pa rin
   ang pagkakasunod-sunod nito. Ito ang CONFIRMED_ERROR-level na check na
   kulang: Revised Finish na mas maaga sa Revised Start (internal
   contradiction sa parehong row), o Revised Finish na mas maaga pa sa
   Planned Start (malamang mali ang column mapping o typo sa revision
   entry). Tinatawag ito sa LAHAT ng ingestion path — xlsx parser, Vex JSON
   import, at manual edit — para consistent ang validation kahit saan
   nanggaling ang data. */
function checkDateLogicIssues(plannedStart, plannedFinish, revisedStart, revisedFinish){
  const issues = [];
  const ps = plannedStart ? new Date(plannedStart) : null;
  const rs = revisedStart ? new Date(revisedStart) : null;
  const rf = revisedFinish ? new Date(revisedFinish) : null;
  if(rs && rf && rf < rs){
    issues.push('Revised Finish is earlier than Revised Start in the same row — internally contradictory dates.');
  }
  if(rf && ps && rf < ps){
    issues.push('Revised Finish is earlier than the original Planned Start — likely a column mix-up or bad revision entry.');
  }
  return issues;
}
/* === DATE LOGIC VALIDATION: END === */

function guessBuildingFromSheetName(name){
  const m = name.match(/BUILDING\s+([A-Z0-9]+)|BLDG\s+([A-Z0-9]+)/i);
  if(m) return (m[1]||m[2]).toUpperCase();
  return null;
}

function looksLikePrimarySheet(name){
  const n = name.toUpperCase();
  if(/_RAW|RAW$|CONSO|SUMMARY|DELIVERY|MANPOWER|^SHEET\d|TRIGGER|BATCH|\(2\)/.test(n)) return false;
  return /BUILDING|BLDG/.test(n) || true;
}

function parseSheet(wb, sheetName, fileLabel, overrides){
  const ws = wb.Sheets[sheetName];
  const matrix = sheetToMatrix(ws);
  const headerCols = findHeaderCols(matrix);
  const descCol = guessDescCol(matrix, headerCols);
  const meta = extractProjectMeta(matrix);
  const building = canonicalizeBuilding((overrides && overrides.building) || guessBuildingFromSheetName(sheetName) || meta.building || sheetName);

  const trade = (overrides && overrides.trade) || meta.trade || fileLabel;

  const tasks = [];
  let cat = null, subcat = null;
  const occurrence = {};
  const startCol = headerCols.start, finishCol = headerCols.finish;
  const start2Col = headerCols.start2, finish2Col = headerCols.finish2;
  const actIdCol = headerCols.actId;

  for(let r=0;r<matrix.length;r++){
    const row = matrix[r];
    if(!row) continue;
    const descRaw = row[descCol];
    if(descRaw==null || (typeof descRaw==='string' && descRaw.trim()==='')) continue;
    const desc = String(descRaw).trim();
    if(/^(building|bldg)\s/i.test(desc) && desc.length<20) continue;
    const actIdRaw = actIdCol!=null ? row[actIdCol] : null;
    const p6ActivityId = (actIdRaw!=null && String(actIdRaw).trim()!=='') ? String(actIdRaw).trim() : null;

    const sVal = startCol!=null ? row[startCol] : null;
    const fVal = finishCol!=null ? row[finishCol] : null;
    let start = excelDateToJS(sVal);
    let finish = excelDateToJS(fVal);

    if(!start || !finish){
      if(cat===null || subcat!==null){ cat = desc; subcat = null; }
      else { subcat = desc; }
      continue;
    }

    const issues = [];
    if(!isSaneDate(start) || !isSaneDate(finish)){
      issues.push('Planned Start/Finish landed outside the expected project window ('+fmtDate(start)+' – '+fmtDate(finish)+') — likely an uncalculated formula in the source file.');
    }

    let s2 = start2Col!=null ? excelDateToJS(row[start2Col]) : null;
    let f2 = finish2Col!=null ? excelDateToJS(row[finish2Col]) : null;
    if((s2 && !isSaneDate(s2)) || (f2 && !isSaneDate(f2))){
      issues.push('Revised Start/Finish landed outside the expected project window — likely an uncalculated formula in the source file.');
      s2 = null; f2 = null;
    }
    issues.push(...checkDateLogicIssues(start, null, s2, f2));
    const weight = headerCols.weight!=null ? Number(row[headerCols.weight])||0 : null;
    const accRaw = headerCols.acc!=null ? row[headerCols.acc] : null;
    let accWeighted = null, accPct = null;
    if(accRaw!=null){
      const n = Number(accRaw);
      if(!isNaN(n)){
        accWeighted = n>1 ? n/100 : n;
        accPct = (weight && weight>0) ? clamp(accWeighted/weight*100, 0, 100) : null;
      }
    }
    /* === ACC COLUMN DETECTION HARDENING: START === */
    if(accPct!=null && headerCols.accConfidence==='low'){
      issues.push('Accomplishment % column was guessed (header said "to-date" without a clear %/pct label nearby) — verify this value against the source file. Not excluded from charts.');
    }
    /* === ACC COLUMN DETECTION HARDENING: END === */
    const level = detectLevel(desc) || detectLevel(subcat) || detectLevel(cat);
    const occKey = [building, trade, cat, subcat, desc].map(slug).join('|');
    occurrence[occKey] = (occurrence[occKey]||0) + 1;

    /* === VEX SCHEMA SYNC: START ===
       sourceRowRef: parehong locator format na ginagamit ng Vex
       (`<file> · <sheet> · row N`) para direktang maitugma/ma-cross-reference
       ang xlsx-imported at Vex-imported na tasks sa parehong table.
       confidence: 'low' kung may dataIssues na (hal. out-of-range date),
       'medium' kung na-guess lang ang Accomplishment % column, 'high' kung
       walang kahit anong red flag sa row na ito.
       isMilestone: zero-duration na row (parehong Start at Finish) —
       hindi kailanman ini-infer mula sa maikling duration lang. */
    tasks.push({
      building: String(building).trim(),
      trade: String(trade).trim(),
      category: cat || '',
      subcategory: subcat || '',
      name: desc,
      p6ActivityId: p6ActivityId,
      level: level,
      isMilestone: (+start === +finish),
      occurrence: occurrence[occKey],
      plannedStart: start.toISOString(),
      plannedFinish: finish.toISOString(),
      revisedStart: s2 ? s2.toISOString() : null,
      revisedFinish: f2 ? f2.toISOString() : null,
      weightPct: weight,
      accToDatePct: accPct,
      sourceFile: fileLabel,
      sourceSheet: sheetName,
      sourceRowRef: fileLabel+' · '+sheetName+' · row '+(r+1),
      confidence: issues.length ? 'low' : (headerCols.accConfidence==='low' ? 'medium' : 'high'),
      rowIndex: r,
      dataIssues: issues,
    });
    /* === VEX SCHEMA SYNC: END === */
  }
  /* === WEIGHT SCALE NORMALIZATION: START ===
     Ilang source files ay nag-iimbak ng WT% bilang fraction ng 1 (0.029 = 2.9%)
     sa halip na buong percentage. Kung ang kabuuan ng weights sa sheet na ito
     ay malapit sa 1 (hindi sa 100), i-multiply ng 100 lahat para consistent
     sa 0-100 scale na inaasahan ng computeWeightWarnings at ng Database tab. */
  const weightedTasks = tasks.filter(t=>t.weightPct!=null);
  if(weightedTasks.length){
    const sumW = weightedTasks.reduce((s,t)=>s+t.weightPct,0);
    if(sumW>0 && sumW<3){
      weightedTasks.forEach(t=>{ t.weightPct = t.weightPct*100; });
    }
  }
  /* === WEIGHT SCALE NORMALIZATION: END === */
  return tasks;
}

function makeTaskId(t){
  /* === P6 LINK: START ===
     Kapag may Activity ID mula sa P6 export, iyon na ang unique key — mas stable
     ito kaysa sa name-based slug pag nagbago ang description sa susunod na
     re-import. Fallback sa dating slug key kapag walang Activity ID. */
  if(t.p6ActivityId){
    return 'p6-' + hashKey(t.building + '|' + slug(t.p6ActivityId));
  }
  /* === P6 LINK: END === */
  return hashKey([t.building, t.trade, t.category, t.subcategory, t.name, t.occurrence||1].map(slug).join('|'));
}

/* === P6 ID MIGRATION RECONCILIATION: START ===
   Ang legacy (name-based) id ng isang task — kailangan ito para makilala kung
   ang isang bagong task na may p6ActivityId ngayon ay yun din yung dating
   task na wala pang Activity ID noong una itong na-import. */
function makeLegacyTaskId(t){
  return hashKey([t.building, t.trade, t.category, t.subcategory, t.name, t.occurrence||1].map(slug).join('|'));
}
/* === P6 ID MIGRATION RECONCILIATION: END === */

/* ---------------------------------------------------------------------
   MERGE ENGINE — revision diffing against existing DB
   --------------------------------------------------------------------- */
function mergeIntoDB(newTasks){
  const now = new Date().toISOString();
  const existingById = {};
  state.tasks.forEach(t=>existingById[t.id]=t);
  let added=0, shifted=0, unchanged=0, migrated=0, lockedSkipped=0;

  newTasks.forEach(nt=>{
    const id = makeTaskId(nt);
    let prev = existingById[id];

    /* === P6 ID MIGRATION RECONCILIATION: START ===
       Kung may bagong p6ActivityId ang task pero wala pang entry sa ilalim
       ng bagong p6-based id, tignan muna kung may existing entry sa ilalim ng
       lumang legacy (name-based) id na wala pang p6ActivityId — kung meron,
       ituring itong parehong task (i-migrate ang id nito, i-carry over ang
       revisionHistory) sa halip na gumawa ng duplicate entry. Yung mga
       historical accomplishment snapshot na naka-key sa lumang id ay
       kino-carry over din papunta sa bagong id, para hindi maputol yung
       S-curve history ng task na ito. */
    if(!prev && nt.p6ActivityId){
      const legacyId = makeLegacyTaskId(nt);
      const legacyPrev = existingById[legacyId];
      if(legacyPrev && !legacyPrev.p6ActivityId){
        delete existingById[legacyId];
        const oldId = legacyPrev.id;
        legacyPrev.id = id;
        legacyPrev.p6ActivityId = nt.p6ActivityId;
        existingById[id] = legacyPrev;
        prev = legacyPrev;
        migrated++;
        state.snapshots.forEach(snap=>{
          if(snap.values[oldId]!=null && snap.values[id]==null){
            snap.values[id] = snap.values[oldId];
            delete snap.values[oldId];
          }
        });
      }
    }
    /* === P6 ID MIGRATION RECONCILIATION: END === */

    /* === FROZEN ORIGINAL BASELINE: START ===
       plannedStart/plannedFinish ay MUTABLE — kapag nagbago ang source file
       (kahit ang "Planned" column mismo, hindi lang Revised), tahimik itong
       ino-overwrite ng mergeIntoDB dati, at ang lumang value ay mapupunta
       lang sa revisionHistory (kailangan pang balikan nang manual). Ito ang
       hiwalay, HINDI kailanman babaguhin pagkatapos ng unang import,
       tunay na "Day-1" reference point. Migration line dito para sa mga
       existing task na na-import na bago dumating ang patch na ito — ang
       kasalukuyang plannedStart/Finish nila sa oras na ito ang pinaka-maaga
       na value na alam natin, kaya iyon na ang gagamitin bilang original. */
    if(prev && prev.originalPlannedStart==null){
      prev.originalPlannedStart = prev.plannedStart;
      prev.originalPlannedFinish = prev.plannedFinish;
    }
    /* === FROZEN ORIGINAL BASELINE: END === */

    if(!prev){
      const newRec = Object.assign({}, nt, {
        id, status:'New', importedAt: now, revisionHistory: [],
        originalPlannedStart: nt.plannedStart, originalPlannedFinish: nt.plannedFinish,
      });
      state.tasks.push(newRec);
      existingById[id] = newRec;
      added++;
    } else if(prev.locked){
      /* === TASK LOCKING: START ===
         Kahit may bagong dates/weight/accomplishment ang paparating na
         import, hindi ito basta ino-overwrite dito — ang task ay
         na-verify na ng tao. Sa halip, itala bilang pending conflict para
         ma-review at manual na i-apply o i-dismiss (Clash & Sequence Log). */
      const wouldChange = prev.plannedStart!==nt.plannedStart || prev.plannedFinish!==nt.plannedFinish ||
                           prev.revisedStart!==nt.revisedStart || prev.revisedFinish!==nt.revisedFinish ||
                           prev.weightPct!==nt.weightPct || prev.accToDatePct!==nt.accToDatePct;
      if(wouldChange){
        state.lockedImportConflicts.push({
          id: hashKey(['lockconf', prev.id, now, nt.sourceRowRef||''].join('|')),
          taskId: prev.id, taskName: prev.name, building: prev.building,
          current: { plannedStart: prev.plannedStart, plannedFinish: prev.plannedFinish,
                      revisedStart: prev.revisedStart, revisedFinish: prev.revisedFinish,
                      weightPct: prev.weightPct, accToDatePct: prev.accToDatePct },
          incoming: { plannedStart: nt.plannedStart, plannedFinish: nt.plannedFinish,
                      revisedStart: nt.revisedStart, revisedFinish: nt.revisedFinish,
                      weightPct: nt.weightPct, accToDatePct: nt.accToDatePct },
          sourceRowRef: nt.sourceRowRef || '', at: now,
        });
        lockedSkipped++;
      } else {
        unchanged++;
      }
      /* === TASK LOCKING: END === */
    } else {
      const changed = prev.plannedStart!==nt.plannedStart || prev.plannedFinish!==nt.plannedFinish ||
                       prev.revisedStart!==nt.revisedStart || prev.revisedFinish!==nt.revisedFinish;
      if(changed){
        prev.revisionHistory = prev.revisionHistory || [];
        prev.revisionHistory.push({
          at: prev.importedAt || now,
          plannedStart: prev.plannedStart, plannedFinish: prev.plannedFinish,
          revisedStart: prev.revisedStart, revisedFinish: prev.revisedFinish,
        });
        const shiftDays = daysBetween(prev.plannedFinish, nt.plannedFinish);
        Object.assign(prev, nt, { id: prev.id, status:'Shifted', importedAt: now, shiftDays });
        shifted++;
      } else {
        Object.assign(prev, nt, { id: prev.id, importedAt: prev.importedAt || now });
        unchanged++;
      }
    }
  });
  state.lastImport = now;
  if(lockedSkipped) saveLockedConflicts();
  return {added, shifted, unchanged, migrated, lockedSkipped};
}

/* ---------------------------------------------------------------------
   SCHEDULE ENGINES
   --------------------------------------------------------------------- */
function hasValidDates(t){
  const s = new Date(t.plannedStart), f = new Date(t.plannedFinish);
  return isSaneDate(s) && isSaneDate(f) && f>=s;
}
function activeRange(t){
  const s = t.revisedStart || t.plannedStart;
  const f = t.revisedFinish || t.plannedFinish;
  return [new Date(s), new Date(f)];
}
function overlapDays(aS,aF,bS,bF){
  const s = Math.max(+aS, +bS), f = Math.min(+aF, +bF);
  return f>s ? Math.round((f-s)/DAY) : 0;
}
function pairKey(a,b){ return [a,b].sort().join('|'); }

function computeSequenceViolations(){
  const violations = [];
  const groups = {};
  /* === CROSS-TRADE SEQUENCE CHECK: START ===
     Grouping by building+level lang (tinanggal ang category at ang same-file
     restriction) — kasi iba-iba ang category naming convention per trade file,
     kaya hindi rin naman gumagana yung dating grouping across files. Sort by
     actual start date (hindi na rowIndex, dahil walang meaning yun across
     magkaibang files). Same-trade adjacent pairs sina-skip dahil yun ay
     nase-cover na ng ordering sa loob mismo ng trade's own file/revisions —
     ang gap na hinahanap dito ay yung cross-trade predecessor/successor
     issues (hal. Plumbing rough-in dapat matapos bago CSA finishing). */
  state.tasks.filter(hasValidDates).forEach(t=>{
    const key = [t.building, t.level||''].join('||');
    (groups[key] = groups[key]||[]).push(t);
  });
  Object.values(groups).forEach(list=>{
    list.sort((a,b)=>{
      const [aS] = activeRange(a);
      const [bS] = activeRange(b);
      return aS - bS;
    });
    for(let i=1;i<list.length;i++){
      const prev = list[i-1], cur = list[i];
      if(prev.trade===cur.trade) continue;
      const [,prevF] = activeRange(prev);
      const [curS] = activeRange(cur);
      const gap = daysBetween(prevF.toISOString(), curS.toISOString());
      if(gap!==null && gap < 0){
        violations.push({
          type:'sequence', severity: Math.abs(gap)>14?'High': Math.abs(gap)>5?'Medium':'Low',
          taskA: prev, taskB: cur, overlapDays: Math.abs(gap),
          note: `"${cur.name}" (${cur.trade}) starts ${Math.abs(gap)}d before "${prev.name}" (${prev.trade}) finishes`,
        });
      }
    }
  });
  return violations;
  /* === CROSS-TRADE SEQUENCE CHECK: END === */
}

function computeSpaceTimeClashes(){
  const clashes = [];
  const groups = {};
  state.tasks.filter(hasValidDates).forEach(t=>{
    if(!t.level) return;
    const key = [t.building, t.level].join('||');
    (groups[key] = groups[key]||[]).push(t);
  });
  Object.values(groups).forEach(list=>{
    for(let i=0;i<list.length;i++){
      for(let j=i+1;j<list.length;j++){
        const a=list[i], b=list[j];
        if(a.trade===b.trade) continue;
        if(state.compatiblePairs[pairKey(a.trade,b.trade)]) continue;
        const [aS,aF] = activeRange(a), [bS,bF] = activeRange(b);
        const ov = overlapDays(aS,aF,bS,bF);
        if(ov >= 4){
          clashes.push({
            type:'space-time', severity: ov>21?'High': ov>10?'Medium':'Low',
            taskA:a, taskB:b, overlapDays: ov,
            note: `${a.trade} vs ${b.trade} both active in ${a.building} · ${a.level} for ${ov} overlapping days`,
          });
        }
      }
    }
  });
  return clashes.sort((x,y)=>y.overlapDays-x.overlapDays);
}

/* === UNLEVELED TASK VISIBILITY: START ===
   Mga tasks na may valid dates pero walang na-detect na floor/level (walang
   match sa LEVEL_PATTERNS) ay dati tahimik na sina-skip sa
   computeSpaceTimeClashes — walang paraan malaman ng user. Ito ang query
   para ma-expose sila sa UI. */
function computeUnleveledTasks(){
  return state.tasks.filter(t=>hasValidDates(t) && !t.level);
}
/* === UNLEVELED TASK VISIBILITY: END === */

/* === PROJECT CONTROL STATUS LAYER: START ===
   Nagbibigay ng "bakit" sa likod ng bawat bar sa Gantt — hindi lang
   kailan ginagawa ang task, kundi anong status niya (critical/delayed/
   at-risk/on-track/completed) at anong mga kasunod na task ang
   maaapektuhan kung maantala ito. */
const GANTT_STATUS_COLORS = {
  critical: '#FF5C5C',
  delayed:  '#FF8A65',
  atrisk:   '#FFB020',
  ontrack:  '#3DDC84',
  completed:'#8FA0B3',
};
const GANTT_STATUS_LABELS = {
  critical: 'Critical',
  delayed:  'Delayed',
  atrisk:   'At Risk',
  ontrack:  'On Track',
  completed:'Completed',
};
/* === STATUS AS SHAPE, NOT COLOR: START ===
   Ang glyph ang PANGUNAHING nagsasabi ng status — ang kulay (STATUS_COLORS)
   ay tumutulong lang, hindi na ito ang tanging paraan para makilala.
   Walang glyph ang 'ontrack' — sinasadya: tahimik = walang problema, kaya
   hindi na dagdag na icon ang bawat normal na task, glyph lang lumalabas
   sa mga kailangan ng atensyon. */
const GANTT_STATUS_GLYPH = {
  critical: '▲',
  delayed:  '●',
  atrisk:   '◆',
  ontrack:  '',
  completed:'✓',
};
/* === STATUS AS SHAPE, NOT COLOR: END === */
const GANTT_LEVEL_ORDER = ['Basement','Ground Floor','Mezzanine','Podium'];
function levelSortKey(level){
  if(!level) return 999;
  const idx = GANTT_LEVEL_ORDER.indexOf(level);
  if(idx>=0) return idx;
  const m = level.match(/^(\d+)(st|nd|rd|th)\s*Floor$/i);
  if(m) return 10 + Number(m[1]);
  if(/penthouse/i.test(level)) return 900;
  if(/roof/i.test(level)) return 950;
  return 999;
}

/* Mga kasunod na task na maaapektuhan kung maantala itong task:
   (1) parehong building + floor, ibang trade, magsisimula malapit sa/
       pagkatapos ng finish nito (sequence dependency)
   (2) parehong building + trade, mas mataas na floor (vertical
       progression ng parehong trade paakyat ng gusali) */
function computeDownstreamTasks(t, allTasks){
  const [,tFinish] = activeRange(t);
  const impacts = [];
  allTasks.forEach(o=>{
    if(o.id===t.id || !hasValidDates(o) || o.building!==t.building) return;
    const [oStart] = activeRange(o);
    const startsAfter = oStart >= tFinish && (oStart-tFinish)/DAY <= 21;
    if(!startsAfter) return;
    if(o.trade!==t.trade && o.level===t.level){
      impacts.push({task:o, note:`${o.trade} follows on the same floor`});
    } else if(o.trade===t.trade && o.level && t.level && levelSortKey(o.level)>levelSortKey(t.level)){
      impacts.push({task:o, note:`${o.trade} continues upward to ${o.level}`});
    }
  });
  return impacts.sort((a,b)=>+activeRange(a.task)[0]-+activeRange(b.task)[0]).slice(0,8);
}

/* === FOCUS MODE — UPSTREAM (PREDECESSOR) LOOKUP: START ===
   Kabaliktaran ng computeDownstreamTasks — mga task na dapat matapos MUNA
   bago magsimula itong task (parehong floor, ibang trade / parehong
   trade, mas mababang floor). Ginagamit ito ng "Focus on a task" mode para
   maipakita ang buong agarang konteksto (predecessor + successor) ng isang
   partikular na task sa halip na iisang isolated bar lang. */
function computeUpstreamTasks(t, allTasks){
  const [tStart] = activeRange(t);
  const impacts = [];
  allTasks.forEach(o=>{
    if(o.id===t.id || !hasValidDates(o) || o.building!==t.building) return;
    const [,oFinish] = activeRange(o);
    const endsBefore = tStart >= oFinish && (tStart-oFinish)/DAY <= 21;
    if(!endsBefore) return;
    if(o.trade!==t.trade && o.level===t.level){
      impacts.push({task:o, note:`${o.trade} precedes on the same floor`});
    } else if(o.trade===t.trade && o.level && t.level && levelSortKey(o.level)<levelSortKey(t.level)){
      impacts.push({task:o, note:`${o.trade} continues from ${o.level}`});
    }
  });
  return impacts.sort((a,b)=>+activeRange(b.task)[1]-+activeRange(a.task)[1]).slice(0,8);
}
/* === FOCUS MODE — UPSTREAM (PREDECESSOR) LOOKUP: END === */

function computeGanttControlStatus(allTasks, flaggedIds){
  const statusMap = {};
  const now = state.asOfDate;
  allTasks.forEach(t=>{
    if(!hasValidDates(t)){ statusMap[t.id]={status:'ontrack',reasons:[],impacts:[],forecastShiftDays:0}; return; }
    const isCompleted = t.accToDatePct!=null && t.accToDatePct>=99.5;
    const [s,f] = activeRange(t);
    const isDelayed = t.status==='Shifted' && t.shiftDays>0;
    const isFlagged = flaggedIds.has(t.id);
    const dur = Math.max(1,(f-s)/DAY);
    const elapsed = clamp((now-s)/DAY,0,dur);
    const plannedPct = (elapsed/dur)*100;
    const actualPct = t.accToDatePct!=null ? t.accToDatePct : 0;
    const gap = plannedPct - actualPct;
    let status, reasons=[];
    if(isCompleted){
      status = 'completed';
    } else if(isFlagged && (isDelayed || gap>15)){
      status = 'critical';
      if(isDelayed) reasons.push(`Shifted ${t.shiftDays}d from original schedule`);
      else reasons.push(`${gap.toFixed(0)} pts behind planned pace`);
      reasons.push('Part of an open clash/sequence conflict');
    } else if(isDelayed){
      status = 'delayed';
      reasons.push(`Finish date shifted ${t.shiftDays}d from original schedule`);
    } else if(gap>10 && now>=s){
      status = 'atrisk';
      reasons.push(`${gap.toFixed(0)} pts behind planned pace as of ${fmtDate(now)}`);
    } else {
      status = 'ontrack';
    }
    const impacts = (status==='critical'||status==='delayed'||status==='atrisk') ? computeDownstreamTasks(t, allTasks) : [];
    const forecastShiftDays = isDelayed ? t.shiftDays : (status==='atrisk' ? Math.round(gap/100*dur) : 0);
    statusMap[t.id] = {status, reasons, impacts, forecastShiftDays};
  });
  return statusMap;
}

