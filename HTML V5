function computeTradesWithoutProgressData(){
  const byKey = {};
  state.tasks.forEach(t=>{
    const key = t.building+'||'+t.trade;
    byKey[key] = byKey[key] || {building:t.building, trade:t.trade, total:0, weighted:0};
    byKey[key].total++;
    if(t.weightPct!=null) byKey[key].weighted++;
  });
  return Object.values(byKey).filter(x=>x.total>0 && x.weighted===0);
}
