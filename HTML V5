     Month gridlines fill in the empty stretches between year marks (Jan is
     skipped since the year line already covers it). Weekend shading is capped
     to ~2-year horizons so very long multi-year projects don't render
     hundreds of extra divs for no visual benefit at that zoom level. */
  let monthMarks='';
  {
    let cursor = new Date(minD.getFullYear(), minD.getMonth(), 1);
    while(cursor<=maxD){
