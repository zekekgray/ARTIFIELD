      if((zoomLevel==='1M'||zoomLevel==='3M') && gx>=0 && gx<=trackWidth){
        monthMarks += `<div style="position:absolute;left:${gx+LABEL_W+4}px;top:20px;font-family:var(--mono);font-size:9.5px;color:#546274;z-index:2;">${cursor.toLocaleDateString('en-US',{month:'short'})}</div>`;
