function baselineSnapshotById(id){
  // 'current' = live state.tasks (hindi naka-imbak, kinukuha real-time)
  if(id==='current'){
    const taskDates = {};
    state.tasks.forEach(t=>{
      taskDates[t.id] = {
        name: t.name, building: t.building, trade: t.trade,
        plannedStart: t.plannedStart, plannedFinish: t.plannedFinish,
        revisedStart: t.revisedStart, revisedFinish: t.revisedFinish,
        weightPct: t.weightPct, accToDatePct: t.accToDatePct,
      };
    });
    return { id:'current', name:'Current (live)', taskDates };
  }
  return state.baselines.find(b=>b.id===id) || null;
}
function compareBaselines(idA, idB){
  const a = baselineSnapshotById(idA), b = baselineSnapshotById(idB);
  if(!a || !b) return [];
  const ids = new Set([...Object.keys(a.taskDates), ...Object.keys(b.taskDates)]);
  const rows = [];
  ids.forEach(id=>{
    const da = a.taskDates[id], db = b.taskDates[id];
    const finA = da ? (da.revisedFinish||da.plannedFinish) : null;
    const finB = db ? (db.revisedFinish||db.plannedFinish) : null;
    const shiftDays = (finA && finB) ? daysBetween(finA, finB) : null;
    rows.push({
      taskId: id,
      name: (db||da).name, building: (db||da).building, trade: (db||da).trade,
      inA: !!da, inB: !!db,
      finishA: finA, finishB: finB, shiftDays,
      accA: da ? da.accToDatePct : null, accB: db ? db.accToDatePct : null,
    });
  });
  return rows.sort((x,y)=>Math.abs(y.shiftDays||0)-Math.abs(x.shiftDays||0));
}
