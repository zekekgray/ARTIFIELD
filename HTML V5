        const left = ((s-minD)/DAY)*pxPerDay;
        const width = Math.max(3, ((f-s)/DAY)*pxPerDay);
        rows += `<div class="gantt-row gantt-group-row" onclick="toggleGanttTrade('${escOnclickArg(b)}','${escOnclickArg(tr)}')">
          <div class="gantt-label" style="cursor:pointer;padding-left:28px;">
