 if(focus.type==='delayed') parts.push('Delayed Activities');
  if(focus.type==='atrisk') parts.push('At-Risk Activities');
  if(focus.type==='task') parts.push(selectedTask ? `"${selectedTask.name}" + connected tasks` : 'Selected task (not found)');
  if(f.building) parts.push('Building '+f.building);
  if(f.trade) parts.push(f.trade);
  const focusLabel = parts.length ? parts.join(' · ') : 'All Activities';

  /* === GANTT DEPENDENCY CHAIN: START ===
     Dependency lines are hidden by default across the whole Gantt (no
     spaghetti). Only when a task is focused do we show its immediate
     predecessor(s)/successor(s) as a simple vertical chain — clicking any
     node re-centers the chain on that task. */
  let chainHtml = '';
  if(focus.type==='task' && selectedTask){
    const up = computeUpstreamTasks(selectedTask, state.tasks);
    const down = computeDownstreamTasks(selectedTask, state.tasks);
    const chainNode = (label, t, isSelected) => `
      <div class="gantt-chain-node ${isSelected?'selected':''}" ${t?`onclick="setGanttFocusTask('${escOnclickArg(t.id)}')"`:''}>
        <span class="gantt-chain-role">${label}</span>
        <span class="gantt-chain-name">${esc(t?t.name:selectedTask.name)}</span>
      </div>`;
    const upNodes = up.slice(0,2).map(imp=>chainNode('PREDECESSOR', imp.task, false));
    const downNodes = down.slice(0,2).map(imp=>chainNode('SUCCESSOR', imp.task, false));
    chainHtml = `<div class="gantt-chain">
      ${upNodes.join('<div class="gantt-chain-arrow">↓</div>')}
      ${up.length ? '<div class="gantt-chain-arrow">↓</div>' : ''}
      ${chainNode('SELECTED', null, true)}
      ${down.length ? '<div class="gantt-chain-arrow">↓</div>' : ''}
      ${downNodes.join('<div class="gantt-chain-arrow">↓</div>')}
    </div>`;
  }
  /* === GANTT DEPENDENCY CHAIN: END === */

  return `
  <div class="chart-card" style="margin-bottom:14px;background:linear-gradient(150deg,#0D141C,#12181F);border-color:${focus.type?'var(--blue-dim)':'var(--line-soft)'};">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;flex-wrap:wrap;gap:8px;">
      <div style="font-family:var(--mono);font-size:12px;color:var(--blue);">🎯 Focus: <b style="color:var(--text);">${esc(focusLabel)}</b></div>
      ${focus.type ? `<button class="btn" onclick="clearGanttFocus()">Clear focus</button>` : ''}
    </div>
    <div class="compare-row">
      <button class="pill-btn ${focus.type==='week'?'active':''}" onclick="setGanttFocus('week')">📅 Current Week</button>
      <button class="pill-btn ${focus.type==='critical'?'active':''}" style="--pill-color:var(--red);" onclick="setGanttFocus('critical')">🔴 Critical Path</button>
       <button class="pill-btn ${focus.type==='delayed'?'active':''}" style="--pill-color:var(--amber);" onclick="setGanttFocus('delayed')">🟠 Delayed</button>
      <button class="pill-btn ${focus.type==='atrisk'?'active':''}" style="--pill-color:var(--amber);" onclick="setGanttFocus('atrisk')">🟡 At Risk</button>
      <input type="text" list="ganttTaskSearchList" placeholder="🔎 Focus on a task…" style="width:240px;" value="${selectedTask?esc(ganttTaskSearchLabel(selectedTask)):''}" onchange="ganttFocusTaskInputChange(this.value)">
      <datalist id="ganttTaskSearchList">${searchPool.map(t=>`<option value="${esc(ganttTaskSearchLabel(t))}">`).join('')}</datalist>
    </div>
    <div class="help" style="margin-top:6px;">Combine with the Building/Trade filters below for a tighter view — e.g. "Delayed Activities · Building B". Task focus shows that task plus its immediate predecessors and successors.</div>
    ${chainHtml}
  </div>`;
}
