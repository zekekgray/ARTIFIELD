/* === ARTIFIELD LICENSE PIN GATE: START ===
   Server-side verification via google.script.run → verifyArtifieldPin() sa
   Code.gs (PropertiesService, fail-closed). Ang PIN mismo ay HINDI kailanman
   dumadaan o naka-hardcode sa client-side JS — pinapadala lang bilang
   parameter papunta sa server, tapos boolean result lang ang bumabalik. */
(function setupArtifieldPinGate(){
  const boxes = Array.from(document.querySelectorAll('#pinRow .pin-box'));
  const errorEl = document.getElementById('pinError');
  const submitBtn = document.getElementById('btnEnterApp');
  const originalBtnHTML = submitBtn.innerHTML;

  function clearErrorState(){
    errorEl.textContent = '';
    boxes.forEach(b=>b.classList.remove('error'));
  }
  function showError(msg){
    errorEl.textContent = msg;
    boxes.forEach(b=>b.classList.add('error'));
  }
  function currentPin(){ return boxes.map(b=>b.value).join(''); }
  function focusBox(i){ if(boxes[i]) boxes[i].focus(); }
  function setBusy(isBusy){
    submitBtn.disabled = isBusy;
    boxes.forEach(b=>b.disabled = isBusy);
    submitBtn.innerHTML = isBusy ? 'Verifying…' : originalBtnHTML;
  }

  /* === ESCALATING LOCKOUT COUNTDOWN: START === */
  let lockCountdownInterval = null;

  function formatDuration(ms){
    const totalSec = Math.max(0, Math.ceil(ms/1000));
    if(totalSec < 60) return totalSec+' second'+(totalSec===1?'':'s');
    const totalMin = Math.ceil(totalSec/60);
    if(totalMin < 60) return totalMin+' minute'+(totalMin===1?'':'s');
    const totalHr = Math.ceil(totalMin/60);
    if(totalHr < 24) return totalHr+' hour'+(totalHr===1?'':'s');
    const totalDay = Math.ceil(totalHr/24);
    return totalDay+' day'+(totalDay===1?'':'s');
  }

  function showLockError(remainingMs, showTip){
    const tipHtml = showTip
      ? '<br><span style="display:block;margin-top:6px;color:var(--text-faint);font-size:11px;">Tip: check your internet connection, or contact your admin for licensing help.</span>'
      : '';
    errorEl.innerHTML = 'Too many attempts. Try again in '+formatDuration(remainingMs)+'.'+tipHtml;
    boxes.forEach(b=>b.classList.add('error'));
  }

  function startLockCountdown(retryAfterMs, showTip){
    clearInterval(lockCountdownInterval);
    let remaining = retryAfterMs;
    boxes.forEach(b=>{ b.value=''; b.disabled = true; });
    submitBtn.disabled = true;
    showLockError(remaining, showTip);
    lockCountdownInterval = setInterval(()=>{
      remaining -= 1000;
      if(remaining <= 0){
        clearInterval(lockCountdownInterval);
        boxes.forEach(b=>b.disabled = false);
        submitBtn.disabled = false;
        clearErrorState();
        focusBox(0);
      } else {
        showLockError(remaining, showTip);
      }
    }, 1000);
  }
  /* === ESCALATING LOCKOUT COUNTDOWN: END === */

  boxes.forEach((box, i)=>{
    box.addEventListener('input', ()=>{
      clearErrorState();
      box.value = box.value.replace(/[^0-9]/g,'').slice(0,1);
      if(box.value && i < boxes.length-1) focusBox(i+1);
      if(i===boxes.length-1 && currentPin().length===6) attemptUnlock();
    });
    box.addEventListener('keydown', e=>{
      if(e.key==='Backspace' && !box.value && i>0) focusBox(i-1);
      if(e.key==='Enter' && currentPin().length===6) attemptUnlock();
    });
    box.addEventListener('paste', e=>{
      e.preventDefault();
      const digits = (e.clipboardData.getData('text')||'').replace(/[^0-9]/g,'').slice(0,6).split('');
      digits.forEach((d,di)=>{ if(boxes[di]) boxes[di].value = d; });
      focusBox(Math.min(digits.length, boxes.length-1));
      if(digits.length===6) attemptUnlock();
    });
  });

  function attemptUnlock(){
    const pin = currentPin();
    if(pin.length!==6){ showError('Enter all 6 digits.'); return; }
    clearErrorState();
    setBusy(true);
    google.script.run
      .withSuccessHandler(res=>{
        setBusy(false);
        if(res && res.ok){
          const w = document.getElementById('welcome');
          w.classList.add('fade-out');
          setTimeout(()=>w.remove(), 380);
          setTimeout(showFieldWelcomeSplash, 450); // shows right after the PIN gate fades out
        } else {
          handleDenied(res);
        }
      })
      .withFailureHandler(()=>{
        // FAIL-CLOSED: error sa server call mismo — huwag payagang makapasok.
        setBusy(false);
        boxes.forEach(b=>b.value='');
        focusBox(0);
        showError('Could not verify PIN right now. Please try again.');
      })
      .verifyArtifieldPin(pin);
  }

  function handleDenied(res){
    if(!res){ boxes.forEach(b=>b.value=''); focusBox(0); showError('Could not verify PIN. Please try again.'); return; }
    /* === ESCALATING LOCKOUT COUNTDOWN: START === */
    if(res.reason==='locked'){
      startLockCountdown(res.retryAfterMs || 10000, !!res.showTip);
      return;
    }
    /* === ESCALATING LOCKOUT COUNTDOWN: END === */
    boxes.forEach(b=>b.value='');
    focusBox(0);
    if(res.reason==='not_configured'){
      showError('License PIN not yet configured for this deployment.');
    } else {
      const remaining = res.attemptsRemaining!=null ? ` (${res.attemptsRemaining} attempt(s) left)` : '';
      showError('Incorrect PIN.'+remaining);
    }
  }

  /* === ADMIN OVERRIDE — ROTATION UI HOOK: START ===
     Deliberately not a visible button — 5 quick clicks on the pin-hint
     label opens a browser prompt flow to rotate the override key. Kept
     minimal (window.prompt) on purpose: this is an admin-only maintenance
     action, not part of the normal unlock flow, so it doesn't need its
     own modal markup. */
  (function setupOverrideRotationHook(){
    const hintEl = document.getElementById('pinHintTrigger');
    if(!hintEl) return;
    let clickCount = 0, clickTimer = null;
    hintEl.addEventListener('click', ()=>{
      clickCount++;
      clearTimeout(clickTimer);
      clickTimer = setTimeout(()=>{ clickCount = 0; }, 1200);
      if(clickCount>=5){
        clickCount = 0;
        promptRotateOverrideKey();
      }
    });
  })();

  function promptRotateOverrideKey(){
    const current = window.prompt('Admin override — enter CURRENT override key (leave blank if none set yet):');
    if(current===null) return; // cancelled
    const next = window.prompt('Enter NEW override key (min 6 characters):');
    if(next===null) return;
    google.script.run
      .withSuccessHandler(res=>{
        if(res && res.ok){
          alert('Override key updated.');
        } else if(res && res.reason==='incorrect_current'){
          alert('Current override key is incorrect — no change made.');
        } else if(res && res.reason==='invalid_new'){
          alert('New key must be at least 6 characters.');
        } else if(res && res.reason==='same_as_user_pin'){
          alert('Override key cannot match the regular license PIN.');
        } else {
          alert('Could not update override key.');
        }
      })
      .withFailureHandler(()=>alert('Could not reach the server to update the override key.'))
      .changeArtifieldAdminOverrideKey(current, next);
  }
  /* === ADMIN OVERRIDE — ROTATION UI HOOK: END === */

  focusBox(0);
})();
/* === ARTIFIELD LICENSE PIN GATE: END === */

