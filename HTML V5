/* === SOURCE TRACEABILITY — STRUCTURED PARSE: START ===
   sourceRowRef is stored as a flat string ("<file> · <sheet> · row N" for
   schedule/Vex tasks, or "<file> · row N" for cost/material entries with no
   sheet). Splitting it back into labeled fields turns "trust me, here's a
   string" into an actual traceable citation the user can scan at a glance. */
function parseSourceRowRef(ref, fallbackFile, fallbackSheet){
  if(!ref) return { file: fallbackFile||null, sheet: fallbackSheet||null, row: null };
  const parts = String(ref).split('·').map(s=>s.trim()).filter(Boolean);
  let file = parts[0] || fallbackFile || null;
  let sheet = null, row = null;
  parts.slice(1).forEach(p=>{
    const m = p.match(/^row\s+(.+)$/i);
    if(m) row = m[1];
    else if(!sheet) sheet = p;
  });
  if(!sheet) sheet = fallbackSheet || null;
  return { file, sheet, row };
}
/* === SOURCE TRACEABILITY — STRUCTURED PARSE: END === */
