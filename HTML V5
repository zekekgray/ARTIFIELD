        const actualLeft = ((as_-minD)/DAY)*pxPerDay;
        const flagged = flaggedIds.has(t.id);
        const cs = controlStatus[t.id] || {status:'ontrack', reasons:[], impacts:[], forecastShiftDays:0};
        const statusColor = GANTT_STATUS_COLORS[cs.status];
        const variance = ganttVarianceDays(t);
        const varLabel = variance!==0 ? `${variance>0?'+':''}${variance}d` : '';
        const tip = `${t.p6ActivityId?esc(t.p6ActivityId)+' · ':''}${esc(t.trade)} · Planned ${fmtDate(ps)}–${fmtDate(pf)} · Actual ${fmtDate(as_)}–${fmtDate(af)}${t.accToDatePct!=null?' · '+t.accToDatePct.toFixed(0)+'% complete':''} · ${GANTT_STATUS_LABELS[cs.status]}${variance!==0?' · '+varLabel+(variance>0?' behind plan':' ahead of plan'):''}`;
        /* === GANTT BASELINE COMPARE: START === */
        let baselineHtml = '';
        if(compareActive){
          const be = baselineTaskEntry(state.ganttBaselineCompare, t.id);
          if(be){
