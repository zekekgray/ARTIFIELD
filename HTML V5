/* ---------- S-CURVE (hand-rolled SVG line chart, with hover + drill-down) ---------- */
let _scurveIdSeq = 0;
function resetScurveRegistry(){ window._scurveRegistry = {}; }

function buildScurveSVG(tasks, label, rangeOverride){
  const withDates = tasks.filter(hasValidDates);
  const skipped = tasks.length - withDates.length;
  if(withDates.length===0) return `<div class="help">No reliably dated tasks for ${esc(label)}.</div>`;
  let minD = new Date(Math.min(...withDates.map(t=>+new Date(t.plannedStart))));
  let maxD = new Date(Math.max(...withDates.map(t=>+new Date(t.revisedFinish||t.plannedFinish))));
  /* === HORIZON FIX: START === (see buildValueScurveSVG for full rationale) */
  maxD = new Date(+maxD + 14*DAY);
  /* === HORIZON FIX: END === */
  /* === SCURVE DATE-RANGE ZOOM: START ===
     Kung may ibinigay na rangeOverride (mula sa "Zoom to date range" filter),
     i-clamp ang minD/maxD papunta sa napiling window sa halip na buong
     project span. Optional lang ito — kapag walang range set (Dashboard,
     Trades tab, atbp.), tahimik itong walang epekto (backward compatible). */
  let isZoomed = false;
  if(rangeOverride && rangeOverride.start && isSaneDate(new Date(rangeOverride.start))){
    minD = new Date(rangeOverride.start);
    isZoomed = true;
  }
  if(rangeOverride && rangeOverride.end && isSaneDate(new Date(rangeOverride.end))){
    maxD = new Date(rangeOverride.end);
    isZoomed = true;
  }
  if(maxD <= minD) maxD = new Date(+minD + DAY);
  /* === SCURVE DATE-RANGE ZOOM: END === */

  const W=900, H=260, padL=46, padR=18, padT=16, padB=30;
  const totalW = W-padL-padR, totalH = H-padT-padB;
  const totalDays = Math.max(1,(maxD-minD)/DAY);
  const steps = 60;
  const rawPts = [];
  for(let i=0;i<=steps;i++){
    const d = new Date(+minD + (totalDays*i/steps)*DAY);
    /* === ACCOMPLISHMENT SNAPSHOT LOG: START ===
       Gamit na totoong historical snapshot (per import day) sa halip na yung
       live/latest accToDatePct — kaya totoong trajectory na ang "actual" line. */
    const actualVal = (d<=state.asOfDate) ? weightedActualPctAtDate(withDates, d) : null;
    /* === ACCOMPLISHMENT SNAPSHOT LOG: END === */
    rawPts.push({d, planned: weightedPlannedPct(withDates, d), actual: actualVal});
  }
  const x = d => padL + ((d-minD)/DAY)/totalDays*totalW;
  const y = p => padT + totalH - (clamp(p,0,100)/100)*totalH;

  const plannedPath = rawPts.map((p,i)=>`${i===0?'M':'L'}${x(p.d).toFixed(1)},${y(p.planned).toFixed(1)}`).join(' ');
  const actualPtsOnly = rawPts.filter(p=>p.actual!=null);
  const actualPath = actualPtsOnly.map((p,i)=>`${i===0?'M':'L'}${x(p.d).toFixed(1)},${y(p.actual).toFixed(1)}`).join(' ');
  const todayX = x(clamp(state.asOfDate, minD, maxD));

  let gridlines='', yearLabels='';
  for(let yr=minD.getFullYear(); yr<=maxD.getFullYear(); yr++){
    const gd = new Date(yr,0,1);
    if(gd<minD||gd>maxD) continue;
    const gx = x(gd);
    gridlines += `<line x1="${gx}" y1="${padT}" x2="${gx}" y2="${padT+totalH}" stroke="#1A222C" stroke-width="1"/>`;
    yearLabels += `<text x="${gx}" y="${H-8}" fill="#546274" font-size="10" font-family="var(--mono)">${yr}</text>`;
  }
  let hlines='';
  [0,25,50,75,100].forEach(p=>{
    hlines += `<line x1="${padL}" y1="${y(p)}" x2="${W-padR}" y2="${y(p)}" stroke="#161D26" stroke-width="1"/>`;
    hlines += `<text x="4" y="${y(p)+3}" fill="#546274" font-size="10" font-family="var(--mono)">${p}%</text>`;
  });

  /* === S-CURVE INTERACTIVITY: START === */
  const chartId = 'sc'+(_scurveIdSeq++);
  window._scurveRegistry = window._scurveRegistry || {};
  window._scurveRegistry[chartId] = {
    label, W, H,
    plannedVisible: true, actualVisible: true,
    tasks: withDates,
    points: rawPts.map(p=>({
      d: p.d, planned: p.planned, actual: p.actual,
      xPix: x(p.d), yPlannedPix: y(p.planned),
      yActualPix: p.actual!=null ? y(p.actual) : null,
    })),
  };
  /* === S-CURVE INTERACTIVITY: END === */

  return `
  <h4>${esc(label)} — Planned vs Actual</h4>
  <div class="sub">Horizon: ${fmtDate(minD)} → ${fmtDate(maxD)}${isZoomed?' · zoomed view':''} · today = ${fmtDate(state.asOfDate)}${skipped?` · ${skipped} task(s) excluded (data quality)`:''} · hover for values, click a point for the task breakdown</div>
  <div class="scurve-wrap" id="${chartId}-wrap">
    <div class="scurve-tooltip" id="${chartId}-tooltip"></div>
    <svg id="${chartId}-svg" viewBox="0 0 ${W} ${H}" style="width:100%;height:auto;display:block;cursor:crosshair;">
      ${hlines}${gridlines}
      <line x1="${todayX}" y1="${padT}" x2="${todayX}" y2="${padT+totalH}" stroke="#FFB020" stroke-width="1.3" stroke-dasharray="4 3"/>
      <path id="${chartId}-path-planned" d="${plannedPath}" fill="none" stroke="#4FC3F7" stroke-width="2.4"/>
      <path id="${chartId}-path-actual" d="${actualPath}" fill="none" stroke="#FFB020" stroke-width="2.4"/>
      <line id="${chartId}-crosshair" x1="0" y1="${padT}" x2="0" y2="${padT+totalH}" stroke="#EDF1F5" stroke-width="1" stroke-dasharray="2 2" style="opacity:0;pointer-events:none;"/>
      <circle id="${chartId}-marker-planned" r="4" fill="#4FC3F7" stroke="#0A0D12" stroke-width="1.5" style="opacity:0;pointer-events:none;"/>
      <circle id="${chartId}-marker-actual" r="4" fill="#FFB020" stroke="#0A0D12" stroke-width="1.5" style="opacity:0;pointer-events:none;"/>
      ${yearLabels}
    </svg>
  </div>
  <div class="legend">
    <button class="legend-btn" id="${chartId}-legend-planned" type="button"><i style="background:#4FC3F7"></i> Planned (time &amp; weight based)</button>
    <button class="legend-btn" id="${chartId}-legend-actual" type="button"><i style="background:#FFB020"></i> Actual (accomplishment to-date)</button>
    <span style="color:var(--text-faint)">Weighted by task WT% where available</span>
  </div>`;
}

/* === S-CURVE INTERACTIVITY: helpers START === */
function attachScurveInteractivity(chartId){
  const reg = (window._scurveRegistry||{})[chartId];
  if(!reg) return;
  const svg = document.getElementById(chartId+'-svg');
  const wrap = document.getElementById(chartId+'-wrap');
  const tooltip = document.getElementById(chartId+'-tooltip');
  const crosshair = document.getElementById(chartId+'-crosshair');
  const markerPlanned = document.getElementById(chartId+'-marker-planned');
  const markerActual = document.getElementById(chartId+'-marker-actual');
  if(!svg || !wrap || !tooltip || !crosshair) return;

  function nearestPoint(clientX){
    const rect = svg.getBoundingClientRect();
    if(!rect.width) return null;
    const relX = clamp((clientX-rect.left)/rect.width, 0, 1) * reg.W;
    let best = reg.points[0], bestDist = Infinity;
    reg.points.forEach(p=>{
      const dist = Math.abs(p.xPix - relX);
      if(dist<bestDist){ bestDist=dist; best=p; }
    });
    return best;
  }

  function showAt(clientX){
    const p = nearestPoint(clientX);
    if(!p) return;
    reg.lastPoint = p;
    crosshair.setAttribute('x1', p.xPix); crosshair.setAttribute('x2', p.xPix);
    crosshair.style.opacity = '1';
    if(reg.plannedVisible){
      markerPlanned.setAttribute('cx', p.xPix); markerPlanned.setAttribute('cy', p.yPlannedPix);
      markerPlanned.style.opacity = '1';
    } else { markerPlanned.style.opacity = '0'; }
    if(reg.actualVisible && p.actual!=null){
      markerActual.setAttribute('cx', p.xPix); markerActual.setAttribute('cy', p.yActualPix);
      markerActual.style.opacity = '1';
    } else { markerActual.style.opacity = '0'; }

    const wrapRect = wrap.getBoundingClientRect();
    const svgRect = svg.getBoundingClientRect();
    const leftPx = (svgRect.left - wrapRect.left) + (p.xPix/reg.W)*svgRect.width;
    let html = `<div class="stt-date">${fmtDate(p.d)}</div>`;
    if(reg.plannedVisible) html += `<div class="stt-row"><i style="background:#4FC3F7"></i>Planned: <b>${p.planned.toFixed(1)}%</b></div>`;
    if(reg.actualVisible){
      html += (p.actual!=null)
        ? `<div class="stt-row"><i style="background:#FFB020"></i>Actual: <b>${p.actual.toFixed(1)}%</b></div>`
        : `<div class="stt-row" style="color:var(--text-faint)">No accomplishment data yet</div>`;
    }
    html += `<div class="stt-hint">Click for task breakdown</div>`;
    tooltip.innerHTML = html;
    tooltip.style.opacity = '1';
    let left = leftPx + 14;
    if(left + 190 > wrapRect.width) left = leftPx - 190 - 14;
    tooltip.style.left = Math.max(4,left)+'px';
    tooltip.style.top = '8px';
  }

  function hide(){
    crosshair.style.opacity='0';
    markerPlanned.style.opacity='0';
    markerActual.style.opacity='0';
    tooltip.style.opacity='0';
  }

  svg.addEventListener('mousemove', e=>showAt(e.clientX));
  svg.addEventListener('mouseleave', hide);
  svg.addEventListener('click', ()=>{ if(reg.lastPoint) openScurvePointModal(chartId, reg.lastPoint); });
  svg.addEventListener('touchstart', e=>{ if(e.touches[0]) showAt(e.touches[0].clientX); }, {passive:true});
  svg.addEventListener('touchmove', e=>{ if(e.touches[0]) showAt(e.touches[0].clientX); }, {passive:true});

  const btnPlanned = document.getElementById(chartId+'-legend-planned');
  const btnActual = document.getElementById(chartId+'-legend-actual');
  const pathPlanned = document.getElementById(chartId+'-path-planned');
  const pathActual = document.getElementById(chartId+'-path-actual');
  if(btnPlanned) btnPlanned.addEventListener('click', ()=>{
    reg.plannedVisible = !reg.plannedVisible;
    btnPlanned.classList.toggle('series-off', !reg.plannedVisible);
