}
/* === CONSOLIDATED GANTT — SCOPE FILTERS: END === */

function renderGantt(c){
  const seqV = computeSequenceViolations();
  const clashV = computeSpaceTimeClashes();
const flaggedIds = new Set();
  [...seqV, ...clashV].forEach(v=>{ flaggedIds.add(v.taskA.id); flaggedIds.add(v.taskB.id); });
  const controlStatus = computeGanttControlStatus(state.tasks, flaggedIds);
  window._ganttControlStatus = controlStatus;
  /* === DELAY IMPACT CASCADE: START ===
     controlStatus[t.id].impacts ay computed na (via computeDownstreamTasks)
     para sa lahat ng critical/delayed/atrisk tasks — dito lang binabaligtad
     ang direksyon: mula "sino ang maaapektuhan ng task na ito" papunta sa
     "sino ang nag-aapekto sa task na ito" — para sa affected/downstream
     task mismo, may makikitang chain-glyph sa row nito na nagsasabing
     "may kasalukuyang paparating na delay na tatama dito". */
  const ganttAffectedByMap = {};
  state.tasks.forEach(src=>{
    const cs0 = controlStatus[src.id];
    if(cs0 && cs0.impacts && cs0.impacts.length){
      cs0.impacts.forEach(imp=>{
        (ganttAffectedByMap[imp.task.id] = ganttAffectedByMap[imp.task.id] || []).push({source:src, note:imp.note});
      });
    }
  });

  /* === CONTROL TOWER HEADER: START ===
     Project-wide status + attention alerts, computed against the FULL
     state.tasks (not the filtered/focused scope below) — this is the
     "zoom all the way out" summary that sits above the Gantt regardless
     of whatever Building/Trade/Focus the user has drilled into. */
  const ctOverallActual = weightedActualPct(state.tasks);
  const ctOverallPlanned = weightedPlannedPct(state.tasks, state.asOfDate);
  const ctVariance = ctOverallActual - ctOverallPlanned;
  const ctDelayedTasks = state.tasks.filter(t=>['critical','delayed'].includes((controlStatus[t.id]||{}).status));
  const ctAtRiskTasks = state.tasks.filter(t=>(controlStatus[t.id]||{}).status==='atrisk');
  const ctConflictsCount = seqV.length + clashV.length;
  const ctLowConfCount = state.tasks.filter(t=>t.confidence==='low').length;
  const ctDelayDaysList = ctDelayedTasks.map(t=>t.shiftDays).filter(d=>d>0);
  const ctAvgDelayDays = ctDelayDaysList.length ? Math.round(ctDelayDaysList.reduce((a,b)=>a+b,0)/ctDelayDaysList.length) : 0;

  const controlTowerHtml = `
  <div class="chart-card" style="margin-bottom:14px;">
