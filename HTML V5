function submitFieldUpdate(id, modalEl, force){
  const t = state.tasks.find(x=>x.id===id);
  if(!t) return;
  if(t.locked){ toast('This task is locked — unlock it first.', 'err'); return; }
  const dateVal = modalEl.querySelector('#fuDate').value;
  const pctVal = Number(modalEl.querySelector('#fuPct').value);
  if(!dateVal || isNaN(pctVal)){ toast('Date and % complete are required.', 'err'); return; }
  const dateISO = new Date(dateVal+'T00:00:00').toISOString();
  const dayKey = dateVal;
  const prevUpdateForDay = state.fieldUpdates.find(u=>u.taskId===id && u.date.slice(0,10)===dayKey);
  const flags = validateFieldUpdate(t, pctVal, dateISO, force?null:prevUpdateForDay);

  if(flags.length && !force){
    const flagsEl = modalEl.querySelector('#fuFlags');
    const hasError = flags.some(f=>f.level==='error');
    flagsEl.innerHTML = flags.map(f=>`<div class="warning-banner" style="margin-top:8px;">${f.level==='error'?'⛔':'⚠️'} <div>${esc(f.message)}</div></div>`).join('')
      + (hasError ? '' : `<button class="btn" style="margin-top:8px;" id="fuForceBtn">Save anyway</button>`);
    const forceBtn = modalEl.querySelector('#fuForceBtn');
    if(forceBtn) forceBtn.addEventListener('click', ()=>submitFieldUpdate(id, modalEl, true));
    return;
  }

  const prevPct = t.accToDatePct;
  const entry = {
    id: hashKey([id,dateISO,pctVal,Date.now()].join('|')),
    taskId: id, date: dateISO, prevPct, newPct: pctVal,
    note: modalEl.querySelector('#fuNote').value.trim(),
    loggedBy: modalEl.querySelector('#fuLoggedBy').value.trim(),
    flags, at: new Date().toISOString(),
  };
  state.fieldUpdates.push(entry);
  t.accToDatePct = pctVal;
  t.manuallyEdited = true;
  t.editedAt = new Date().toISOString();
  saveFieldUpdates();
  saveDB();
  /* === S-CURVE DATE SEQUENCING: START ===
     Gamitin ang petsang pinili ng user sa "Date" field ng modal na ito
     (dateISO) bilang snapshot timestamp — hindi ang "ngayon" — para tama
     ang alignment sa timeline kahit backdated ang na-log na update. */
  recordSnapshot(dateISO);
  /* === S-CURVE DATE SEQUENCING: END === */
  modalEl.remove();
  toast(flags.length? 'Update saved with '+flags.length+' flag(s) — visible in Clash & Sequence Log.' : 'Update saved.', flags.length?'err':'ok');
  render();
}
window.submitFieldUpdate = submitFieldUpdate;
