  if(withDates.length===0){
    c.innerHTML = controlTowerHtml + focusBarHtml + filterBarHtml + `<div class="empty"><h3>No tasks match this focus/filter combination</h3><p>Try widening your Building, Trade, Level, Status, Criticality, or date range selection above, or clear the active Focus.</p><div class="btn-row" style="justify-content:center;"><button class="btn primary" onclick="resetGanttFilters()">Reset all filters</button>${state.ganttFocus&&state.ganttFocus.type?`<button class="btn" onclick="clearGanttFocus()">Clear focus</button>`:''}</div></div>`;
