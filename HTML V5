  let rows = '';
  buildings.forEach(b=>{
    const bTasks = byBuildingGantt[b] || [];
    const bExpanded = !!state.ganttExpanded['B|'+b];
    const bPct = weightedActualPct(bTasks);
    const bFlagged = bTasks.some(t=>flaggedIds.has(t.id));
    const bChevron = bExpanded ? '▾' : '▸';

    if(!bExpanded){
