  const palette = ['#5B7A8C','#A68A5B','#7C6F94','#5B9179','#9C7566','#8C6572','#68708C','#5B8C82'];
  /* === STATUS AS SHAPE, NOT COLOR: END === */
  [...new Set(scopedTasks.map(t=>t.trade))].forEach((tr,i)=>tradeColors[tr]=palette[i%palette.length]);

