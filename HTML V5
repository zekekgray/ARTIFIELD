function excelDateToJS(v){
  if(v instanceof Date) return v;
  if(typeof v === 'number'){
    const utc_days = Math.floor(v - 25569);
    const utc_value = utc_days * 86400;
    const d = new Date(utc_value * 1000);
    return isNaN(d.getTime()) ? null : d;
  }
  if(typeof v === 'string'){
    const d = new Date(v);
    if(!isNaN(d.getTime())) return d;
  }
  return null;
}
function fmtDate(d){
  if(!d) return '—';
  const dt = (d instanceof Date) ? d : new Date(d);
  if(isNaN(dt.getTime())) return '—';
  return dt.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'2-digit'});
}
function daysBetween(a,b){ if(!a||!b) return null; return Math.round((new Date(b)-new Date(a))/DAY); }
function clamp(v,lo,hi){ return Math.max(lo,Math.min(hi,v)); }
function hashKey(s){ let h=0; for(let i=0;i<s.length;i++){ h=(h*31 + s.charCodeAt(i))|0; } return (h>>>0).toString(36); }
function slug(s){ return (s||'').toString().trim().toLowerCase().replace(/\s+/g,' '); }

/* === BUILDING NAME RESOLVER: START ===
   Ang building ay literal string key sa buong app (makeTaskId, buildingList,
   projectMeta, atbp). Walang fuzzy-merge na nangyayari kailanman nang
   automatic — laging need ng user confirmation via mergeBuildingNames().
   Ang canonicalizeBuilding() lang ang tanging pinto kung saan pumapasok ang
   isang "building" string papunta sa state — dapat dito laging dumaan ang
   bagong value bago ma-assign sa anumang record. */
function normBuildingKey(s){
  return String(s||'')
    .toUpperCase()
    .replace(/\bBUILDING\b|\bBLDG\.?\b|\bTOWER\b/g,'')
    .replace(/[^A-Z0-9]/g,'')
    .trim();
}
function canonicalizeBuilding(raw){
  const trimmed = String(raw||'').trim();
  if(!trimmed) return trimmed;
  const key = normBuildingKey(trimmed);
  return state.buildingAliases[key] || trimmed;
}
function levenshtein(a,b){
  const m=a.length, n=b.length;
  if(m===0) return n; if(n===0) return m;
  const dp = Array.from({length:m+1},(_,i)=>[i,...Array(n).fill(0)]);
  for(let j=0;j<=n;j++) dp[0][j]=j;
  for(let i=1;i<=m;i++){
    for(let j=1;j<=n;j++){
      dp[i][j] = a[i-1]===b[j-1] ? dp[i-1][j-1] : 1+Math.min(dp[i-1][j-1],dp[i-1][j],dp[i][j-1]);
    }
  }
  return dp[m][n];
}
function computeBuildingNameSuggestions(){
  const raws = buildingList();
  const groups = {};
  raws.forEach(b=>{ const k=normBuildingKey(b); (groups[k]=groups[k]||[]).push(b); });
  const pairs = [];
  const keys = Object.keys(groups);
  for(let i=0;i<keys.length;i++){
    for(let j=i+1;j<keys.length;j++){
      const ki=keys[i], kj=keys[j];
      if(!ki || !kj) continue;
      const dismissKey = [ki,kj].sort().join('|');
      if(state.buildingSuggestionsDismissed[dismissKey]) continue;
      const sameGroup = ki===kj;
      const closeTypo = !sameGroup && levenshtein(ki,kj) <= 1;
      if(sameGroup || closeTypo){
        pairs.push({ a: groups[ki][0], b: groups[kj][0], dismissKey, exact: sameGroup });
      }
    }
  }
  return pairs;
}
function dismissBuildingSuggestion(dismissKey){
  state.buildingSuggestionsDismissed[dismissKey] = true;
  saveBuildingDismissed();
  render();
}
window.dismissBuildingSuggestion = dismissBuildingSuggestion;
function mergeBuildingNames(fromRaw, toCanonical){
  if(fromRaw===toCanonical) return;
  const fromKey = normBuildingKey(fromRaw);
  state.buildingAliases[fromKey] = toCanonical;
  saveBuildingAliases();

  [state.costEntries, state.materialEntries, state.manpowerLogs,
   state.materialLogs, state.quantityTakedowns, state.violations,
   state.forecastNotes, state.variationOrders, state.rfis].forEach(arr=>{
    arr.forEach(x=>{ if(x.building===fromRaw) x.building = toCanonical; });
  });

  if(state.projectMeta[fromRaw]){
    state.projectMeta[toCanonical] = Object.assign({}, state.projectMeta[toCanonical], state.projectMeta[fromRaw]);
    delete state.projectMeta[fromRaw];
  }
  Object.keys(state.materialPlan).forEach(k=>{
    if(k.startsWith(fromRaw+'|')){
      const newKey = toCanonical + k.slice(fromRaw.length);
      state.materialPlan[newKey] = state.materialPlan[k];
      delete state.materialPlan[k];
    }
  });

  const byNewId = {};
  state.tasks.forEach(t=>{ if(t.building!==fromRaw) byNewId[t.id]=t; });
  state.tasks.forEach(t=>{
    if(t.building!==fromRaw) return;
    const oldId = t.id;
    t.building = toCanonical;
    const newId = makeTaskId(t);
    const collision = byNewId[newId];
    if(collision){
      // totoong duplicate matapos i-canonicalize — panatilihin ang mas
      // bagong-import, i-log sa revisionHistory ng nananatili, alisin ang isa
      collision.revisionHistory = collision.revisionHistory || [];
      collision.revisionHistory.push({at: t.importedAt||new Date().toISOString(), mergedFromDuplicate:true, taskName:t.name});
      t._removedByMerge = true;
    } else {
      t.id = newId;
      byNewId[newId] = t;
      state.snapshots.forEach(snap=>{
        if(snap.values[oldId]!=null && snap.values[newId]==null){
          snap.values[newId] = snap.values[oldId];
          delete snap.values[oldId];
        }
      });
      state.fieldUpdates.forEach(u=>{ if(u.taskId===oldId) u.taskId=newId; });
    }
  });
  state.tasks = state.tasks.filter(t=>!t._removedByMerge);

  if(state.compare.selected.includes(fromRaw)){
    state.compare.selected = state.compare.selected.map(id=>id===fromRaw?toCanonical:id);
  }
  if(state.dbFilters.building===fromRaw){
    state.dbFilters.building = toCanonical;
  }
  if(state.curveBuilding===fromRaw){
    state.curveBuilding = toCanonical;
  }

  saveDB(); saveCost(); saveMaterials(); saveProjectMeta();
  saveManpowerLogs(); saveMaterialLogs(); saveMaterialPlan();
  saveQuantityTakedowns(); saveViolations(); saveForecastNotes();
  saveVariationOrders(); saveRfis(); saveSnapshots(); saveFieldUpdates();
  toast(`Merged "${fromRaw}" into "${toCanonical}".`, 'ok');
  render();
}
