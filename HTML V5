  const ganttCenterDate = state.ganttZoom.centerDate ? new Date(state.ganttZoom.centerDate) : state.asOfDate;
  const centerLeftForScroll = clamp(((ganttCenterDate-minD)/DAY)*pxPerDay, 0, trackWidth);
  /* === GANTT ZOOM LEVEL: END === */  /* === GANTT AESTHETICS EDIT: START === */
  const LABEL_W = 260;
  const totalRowWidth = LABEL_W + trackWidth;
  /* === GANTT AESTHETICS EDIT: END === */
  const tradeColors = {};
  /* === STATUS AS SHAPE, NOT COLOR: START ===
     Desaturated/muted na palette — trade differentiation pa rin, pero
