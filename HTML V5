const affectedBy = ganttAffectedByMap[t.id];
        const chainGlyphHtml = affectedBy ? `<span class="gantt-chain-glyph" title="Affected by delay in: ${esc(affectedBy.slice(0,3).map(a=>a.source.name).join(' · '))}${affectedBy.length>3?' …':''}">⛓</span>` : '';
        /* === DELAY IMPACT CASCADE: END === */
        rows += `<div class="gantt-row">
