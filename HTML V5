function runImport(){
  let allNew = [];
  let errors = [];
  stagedWorkbooks.forEach(f=>{
    f.sheets.filter(s=>s.checked).forEach(s=>{
      try{
        const overrides = {};
        if(s.buildingOverride) overrides.building = s.buildingOverride;
        if(s.tradeOverride) overrides.trade = s.tradeOverride;
        const tasks = parseSheet(f.wb, s.name, f.fileLabel, overrides);
        allNew = allNew.concat(tasks);
      }catch(err){
        errors.push(`${f.fileLabel} / ${s.name}: ${err.message}`);
      }
    });
  });
  if(allNew.length===0){
    toast('No dated tasks found in the selected sheets. Try checking more sheets or verify the file has Start/Finish columns.', 'err');
    return;
  }
    const {added, shifted, unchanged, migrated, lockedSkipped} = mergeIntoDB(allNew);
  saveDB();
  /* === ACCOMPLISHMENT SNAPSHOT LOG: START === */
  const asOfInput = document.getElementById('importAsOfDate');
  const asOfVal = asOfInput && asOfInput.value ? new Date(asOfInput.value+'T00:00:00').toISOString() : null;
  recordSnapshot(asOfVal);
  /* === ACCOMPLISHMENT SNAPSHOT LOG: END === */

  /* === EXTRACTION REVIEW BRIDGE: START === */
  const sheetsProcessed = stagedWorkbooks.reduce((n,f)=>n+f.sheets.filter(s=>s.checked).length, 0);
  const filesAnalyzed = stagedWorkbooks.length;
  const confidence = tallyConfidence(allNew);
  const discrepancies = allNew.filter(t=>t.dataIssues && t.dataIssues.length).length;
  /* === EXTRACTION REVIEW BRIDGE: END === */

  stagedWorkbooks = []; window.stagedWorkbooks = stagedWorkbooks;
  toast(`Imported: ${added} new, ${shifted} shifted, ${unchanged} unchanged${migrated?`, ${migrated} linked to P6 ID`:''}${lockedSkipped?`, ${lockedSkipped} skipped (locked — review in Clash & Sequence Log)`:''}.${errors.length?' '+errors.length+' sheet(s) had errors.':''}`, lockedSkipped?'err':'ok');

  goToExtractionReview({
    source: 'Schedule (.xlsx)',
    filesAnalyzed, sheetsProcessed,
    costRecords: 0, materialRecords: 0, rfis: 0, variationOrders: 0,
    confidence,
    needsReview: { discrepancies, unusual: 0, skipped: errors.length },
  });
}

/* ----- cost & material import (json / generic xlsx rows) ----- */
function normKey(s){ return String(s||'').toLowerCase().replace(/[^a-z0-9]/g,''); }
function pickField(obj, aliases){
  for(const k of Object.keys(obj)){
    if(aliases.includes(normKey(k))) return obj[k];
  }
  return undefined;
}

/* === COST/MATERIALS HEADER AUTO-DETECTION: START ===
   Dati, `sheet_to_json` na lang diretso, na umaasang row 1 ang headers.
   Kapag may title/preamble rows bago ang totoong table (karaniwan sa
   construction report templates), tahimik na nawawala lahat ng rows nang
   walang error. Dito, scinascan ang unang 15 rows, tinitignan kung alin ang
   may pinaka-maraming header-like cell (tugma sa mga alias na ginagamit na
   ng pickField), tapos ginagamit yung row na yun bilang totoong header. */
const COST_MATERIAL_HEADER_ALIASES = new Set([
  'building','bldg','type','costtype','amount','value','cost','item','material','name',
  'qtyonhand','onhand','stock','quantity','weeklyconsumption','weekly','consumptionrate',
  'usageperweek','leadtimedays','leadtime','resourcecode','costcode','resource','materialcode',
  'itemcode','activityid','actid','p6id','p6activityid','loggedby','submittedby','enteredby',
  'preparedby','trade','discipline','scope','category','date','entrydate','note','notes',
  'description','unit','uom',
]);
function sheetToObjectsAutoHeader(ws){
  const matrix = XLSX.utils.sheet_to_json(ws, {header:1, raw:true, defval:null});
  const maxScan = Math.min(15, matrix.length);
  let bestRow = 0, bestScore = -1;
  for(let r=0;r<maxScan;r++){
    const row = matrix[r]||[];
    let score = 0;
    row.forEach(cell=>{
      if(typeof cell==='string' && COST_MATERIAL_HEADER_ALIASES.has(normKey(cell))) score++;
    });
    if(score>bestScore){ bestScore = score; bestRow = r; }
  }
  if(bestScore<=0){
    return { rows: XLSX.utils.sheet_to_json(ws, {defval:null}), headerRowIndex: 0, matched: false };
  }
  const headers = matrix[bestRow];
  const dataRows = matrix.slice(bestRow+1);
  const objs = dataRows
    .filter(row=>row && row.some(c=>c!=null && c!==''))
    .map(row=>{
      const o = {};
      headers.forEach((h,i)=>{ if(h!=null && h!=='') o[h] = row[i]; });
      return o;
    });
  return { rows: objs, headerRowIndex: bestRow, matched: true };
}
/* === COST/MATERIALS HEADER AUTO-DETECTION: END === */
function jsonDateToISO(v){
  if(v==null || v==='') return null;
  const d = excelDateToJS(v);
  return (d && isSaneDate(d)) ? d.toISOString() : null;
}

function rowsToCostEntries(rows, fileLabel){
  const entries = []; let skipped=0;
  rows.forEach((row,idx)=>{
    const buildingRaw = pickField(row,['building','bldg']);
    const building = canonicalizeBuilding(buildingRaw);
    let type = pickField(row,['type','costtype']);
    const amount = Number(pickField(row,['amount','value','cost']));
    if(!buildingRaw || !type || isNaN(amount)){ skipped++; return; }
    type = String(type).toLowerCase().includes('budget') ? 'budget' : 'actual';
    /* === P6 / AUDIT TRAIL FIELDS: START ===
       resourceCode = cost-code/resource key para tugma sa P6 resource assignments.
       p6ActivityId = optional link pabalik sa specific activity, kung nasa file.
       loggedBy + capturedAt = minimal audit trail bago pumasok sa master DB. */
    const resourceCode = pickField(row,['resourcecode','costcode','resource']) || '';
    const p6ActivityId = pickField(row,['activityid','actid','p6id','p6activityid']) || '';
    const loggedBy = pickField(row,['loggedby','submittedby','enteredby','preparedby']) || '';
    /* === P6 / AUDIT TRAIL FIELDS: END === */
    /* === VEX SCHEMA SYNC: START ===
       currency/confidence/sourceRowRef/dataIssues — parehong fields na
       nasa Vex costEntries[] schema, para consistent ang shape kahit saan
       galing ang entry (generic xlsx/json importer o Vex JSON). Ang
       generic importer na ito ay walang forensic verification pass gaya
       ng Vex, kaya 'medium' ang default confidence (hindi 'high'). */
    entries.push({
      id: hashKey([fileLabel,idx,building,type,amount].join('|')),
      building,
      trade: pickField(row,['trade','discipline','scope']) || '',
      category: pickField(row,['category']) || '',
      type, amount,
      currency: pickField(row,['currency']) || 'PHP',
      resourceCode: String(resourceCode).trim(),
      p6ActivityId: String(p6ActivityId).trim(),
      loggedBy: String(loggedBy).trim(),
      capturedAt: new Date().toISOString(),
      date: jsonDateToISO(pickField(row,['date','entrydate'])),
      note: pickField(row,['note','notes','description']) || '',
      sourceFile: fileLabel,
      sourceRowRef: fileLabel+' · row '+(idx+2),
      confidence: 'medium',
      dataIssues: [],
    });
    /* === VEX SCHEMA SYNC: END === */
  });
  return {entries, skipped};
}
function rowsToMaterialEntries(rows, fileLabel){
  const entries = []; let skipped=0;
  rows.forEach((row,idx)=>{
    const building = canonicalizeBuilding(pickField(row,['building','bldg']) || 'UNSPECIFIED');
    const item = pickField(row,['item','material','name']);
    const qtyOnHand = Number(pickField(row,['qtyonhand','onhand','stock','quantity']));
    const weeklyConsumption = Number(pickField(row,['weeklyconsumption','weekly','consumptionrate','usageperweek']));
    if(!item || isNaN(qtyOnHand)){ skipped++; return; }
    /* === P6 / AUDIT TRAIL FIELDS: START ===
       resourceCode = material/resource code para i-match sa Resource Name sa P6.
       linkedActivityId = anong Activity ID ang kumokonsumo nito (kung nasa file).
       loggedBy = foreman/site engineer na nag-submit — audit trail bago master DB. */
    const resourceCode = pickField(row,['resourcecode','materialcode','itemcode']) || '';
    const linkedActivityId = pickField(row,['activityid','actid','p6id','p6activityid']) || '';
    const loggedBy = pickField(row,['loggedby','submittedby','enteredby','preparedby']) || '';
    /* === P6 / AUDIT TRAIL FIELDS: END === */
    /* === VEX SCHEMA SYNC: START === */
    entries.push({
      id: hashKey([fileLabel,idx,building,item].join('|')),
      building,
      item: String(item).trim(),
      unit: pickField(row,['unit','uom']) || '',
      qtyOnHand,
      weeklyConsumption: isNaN(weeklyConsumption)?0:weeklyConsumption,
      leadTimeDays: Number(pickField(row,['leadtimedays','leadtime'])) || 0,
      resourceCode: String(resourceCode).trim(),
      linkedActivityId: String(linkedActivityId).trim(),
      loggedBy: String(loggedBy).trim(),
      sourceFile: fileLabel,
      sourceRowRef: fileLabel+' · row '+(idx+2),
      confidence: 'medium',
      dataIssues: [],
      updatedAt: new Date().toISOString(),
    });
    /* === VEX SCHEMA SYNC: END === */
  });
  return {entries, skipped};
}

function handleCostOrMaterialFiles(fileList, kind){
  [...fileList].forEach(file=>{
    const ext = (file.name.split('.').pop()||'').toLowerCase();
    const fileLabel = file.name.replace(/\.(json|xlsx|xls)$/i,'').replace(/_/g,' ').slice(0,60);

    const process = rows=>{
      if(kind==='cost'){
        const {entries, skipped} = rowsToCostEntries(rows, fileLabel);
        if(entries.length===0){ toast('No usable cost rows in '+file.name+' — check building/type/amount fields.', 'err'); return; }
        const existingIds = new Set(state.costEntries.map(e=>e.id));
        entries.forEach(e=>{ if(!existingIds.has(e.id)) state.costEntries.push(e); });
        saveCost();
        toast(`Imported ${entries.length} cost entr${entries.length===1?'y':'ies'} from ${file.name}.${skipped?` ${skipped} row(s) skipped.`:''}`, 'ok');
      } else {
        const {entries, skipped} = rowsToMaterialEntries(rows, fileLabel);
        if(entries.length===0){ toast('No usable material rows in '+file.name+' — check item/qtyOnHand fields.', 'err'); return; }
        const byKey = {}; state.materialEntries.forEach(m=>byKey[m.building+'|'+m.item]=m);
        entries.forEach(e=>{ byKey[e.building+'|'+e.item] = e; });
        state.materialEntries = Object.values(byKey);
        saveMaterials();
        toast(`Imported ${entries.length} material item(s) from ${file.name}.${skipped?` ${skipped} row(s) skipped.`:''}`, 'ok');
      }
      setTab(kind==='cost'?'finance':'materials');
    };

    if(ext==='json'){
      const reader = new FileReader();
      reader.onload = ev=>{
        try{
          const parsed = JSON.parse(ev.target.result);
          const rows = Array.isArray(parsed) ? parsed : (parsed.entries || parsed.materials || parsed.rows);
          if(!Array.isArray(rows)) throw new Error('Expected a JSON array, or {entries:[...]} / {materials:[...]}.');
          process(rows);
        }catch(err){ toast('Could not read '+file.name+': '+err.message, 'err'); }
      };
      reader.readAsText(file);
    } else if(ext==='xlsx' || ext==='xls'){
      const reader = new FileReader();
      reader.onload = ev=>{
        try{
          const data = new Uint8Array(ev.target.result);
          const wb = XLSX.read(data, {type:'array', cellDates:false});
          const ws = wb.Sheets[wb.SheetNames[0]];
          const { rows, headerRowIndex, matched } = sheetToObjectsAutoHeader(ws);
          if(!matched){
            toast(file.name+': could not confidently locate a header row in the first 15 rows — assumed row 1. Check the imported entries.', 'err');
          } else if(headerRowIndex>0){
            toast(file.name+': detected header row at row '+(headerRowIndex+1)+' (skipped '+headerRowIndex+' title/preamble row(s)).', 'ok');
          }
          process(rows);
        }catch(err){ toast('Could not read '+file.name+': '+err.message, 'err'); }
      };
      reader.readAsArrayBuffer(file);
    } else {
      toast(file.name+' — use .xlsx, .xls, or .json for cost/materials import.', 'err');
    }
  });
}

/* ===========================================================================
   VEX SCHEMA SYNC — JSON IMPORT
   Tumatanggap ng buong output ng Vex (Document Standardization Mode, schema
   v1.2) bilang isang JSON file, at ini-merge ang bawat array papunta sa
   tamang bahagi ng master DB. Hindi ito nagpapalit sa xlsx/json cost at
   materials importer sa itaas — dagdag na landas ito, dahil ang Vex JSON ay
   may fields (confidence, sourceRowRef, dataIssues, at ang limang bagong
   array) na wala sa generic column-alias importer.
   =========================================================================== */

function normalizeVexDate(v){
  // Ang mga petsa mula kay Vex ay laging ISO 8601 "YYYY-MM-DDT00:00:00.000Z"
  // o null — pass-through lang, walang re-parsing na kailangan.
  return (v && typeof v==='string') ? v : null;
}

function vexTaskToInternal(vt, fileLabel){
  const plannedStart = normalizeVexDate(vt.plannedStart);
  const plannedFinish = normalizeVexDate(vt.plannedFinish);
  const revisedStart = normalizeVexDate(vt.revisedStart);
  const revisedFinish = normalizeVexDate(vt.revisedFinish);
  const dataIssues = Array.isArray(vt.dataIssues) ? vt.dataIssues.slice() : [];
  const logicIssues = checkDateLogicIssues(plannedStart, plannedFinish, revisedStart, revisedFinish);
  dataIssues.push(...logicIssues);
  return {
    building: canonicalizeBuilding(vt.building),
    trade: String(vt.trade||'').trim(),
    category: vt.category||'',
    subcategory: vt.subcategory||'',
    name: vt.name||'(unnamed task)',
    p6ActivityId: vt.p6ActivityId||null,
    level: vt.level||null,
    isMilestone: !!vt.isMilestone,
    plannedStart, plannedFinish, revisedStart, revisedFinish,
    weightPct: vt.weightPct!=null ? Number(vt.weightPct) : null,
    accToDatePct: vt.accToDatePct!=null ? Number(vt.accToDatePct) : null,
    sourceFile: fileLabel,
    sourceSheet: vt.sourceRowRef || '',
    sourceRowRef: vt.sourceRowRef || '',
    confidence: logicIssues.length ? 'low' : (vt.confidence || 'medium'),
    rowIndex: null,
    dataIssues,
  };
}

function mergeVexTasks(vexTasks, fileLabel){
  // Hindi tinatanggal ang tasks na walang valid dates (di gaya ng xlsx
  // parser) — dapat manatiling traceable sa Database tab kahit incomplete,
  // sa halip na tahimik na mawala. Ang mga chart/engine ay gumagamit na rin
  // ng hasValidDates() filter, kaya awtomatiko silang excluded doon.
  const occurrence = {};
  const prepared = vexTasks
    .filter(vt=>vt && vt.name)
    .map(vt=>{
      const internal = vexTaskToInternal(vt, fileLabel);
      const occKey = [internal.building, internal.trade, internal.category, internal.subcategory, internal.name].map(slug).join('|');
      occurrence[occKey] = (occurrence[occKey]||0) + 1;
      internal.occurrence = occurrence[occKey];
      return internal;
    });
  return mergeIntoDB(prepared);
}

function mergeVexCostEntries(list, fileLabel){
  let added=0;
  const existingIds = new Set(state.costEntries.map(e=>e.id));
  list.forEach((ce,idx)=>{
    const id = hashKey(['vex',fileLabel,idx,ce.building,ce.type,ce.amount,ce.sourceRowRef].map(v=>String(v==null?'':v)).join('|'));
    if(existingIds.has(id)) return;
    state.costEntries.push({
      id,
      building: canonicalizeBuilding(ce.building),
      trade: ce.trade||'',
      category: ce.category||'',
      type: (ce.type==='budget'||ce.type==='committed') ? ce.type : 'actual',
      amount: Number(ce.amount)||0,
      currency: ce.currency||'PHP',
      resourceCode: ce.resourceCode||'',
      p6ActivityId: ce.p6ActivityId||'',
      loggedBy: ce.loggedBy||'',
      capturedAt: new Date().toISOString(),
      date: normalizeVexDate(ce.date),
      note: ce.note||'',
      sourceFile: fileLabel,
      sourceRowRef: ce.sourceRowRef||'',
      confidence: ce.confidence||'medium',
      dataIssues: Array.isArray(ce.dataIssues) ? ce.dataIssues.slice() : [],
    });
    added++;
  });
  return added;
}

function mergeVexMaterialEntries(list, fileLabel){
  // Parehong convention sa dating materials importer: ang materialEntries
  // ay CURRENT STOCK STATE, hindi log — kaya overwrite-by-key (building|item)
  // sa halip na push-only.
  let updated=0;
  const byKey = {}; state.materialEntries.forEach(m=>byKey[m.building+'|'+m.item]=m);
  list.forEach(me=>{
    const canonBuilding = canonicalizeBuilding(me.building);
    const key = canonBuilding+'|'+String(me.item||'').trim();
    byKey[key] = {
      id: hashKey(['vex-mat',key].join('|')),
      building: canonBuilding,
      item: String(me.item||'').trim(),
      unit: me.unit||'',
      qtyOnHand: Number(me.qtyOnHand)||0,
      weeklyConsumption: Number(me.weeklyConsumption)||0,
      leadTimeDays: Number(me.leadTimeDays)||0,
      resourceCode: me.resourceCode||'',
      linkedActivityId: me.linkedActivityId||'',
      loggedBy: me.loggedBy||'',
      sourceFile: fileLabel,
      sourceRowRef: me.sourceRowRef||'',
      confidence: me.confidence||'medium',
      dataIssues: Array.isArray(me.dataIssues) ? me.dataIssues.slice() : [],
      updatedAt: new Date().toISOString(),
    };
    updated++;
  });
  state.materialEntries = Object.values(byKey);
  return updated;
}

function mergeVexGenericArray(stateArrayName, list, fileLabel, keyFields){
  // Para sa quantityTakedowns / violations / forecastNotes / variationOrders
  // / rfis — walang existing na counterpart sa ARTIFIELD, kaya isa-isang
  // i-push nang buo ang bawat record (walang field na tinatanggal), may
  // dedup lang batay sa ilang key field + sourceRowRef para hindi
  // magduplicate kapag paulit-ulit na-import ang parehong file.
  const arr = state[stateArrayName];
  const existingIds = new Set(arr.map(x=>x.id));
  let added=0;
  list.forEach((item,idx)=>{
    const keyVals = keyFields.map(k=>String(item[k]==null?'':item[k]));
    const id = hashKey(['vex',stateArrayName,fileLabel,idx,...keyVals].join('|'));
    if(existingIds.has(id)) return;
    const patched = Object.assign({}, item, { id, sourceFile: fileLabel });
    if(patched.building!=null) patched.building = canonicalizeBuilding(patched.building);
    arr.push(patched);
    added++;
  });
  return added;
}

/* === VEX SCHEMA VERSION GUARD: START === */
const VEX_SUPPORTED_SCHEMA_VERSIONS = ['1.2'];
function mergeVexPayload(payload, fileLabel){
  const schemaVersion = payload.meta && payload.meta.schemaVersion;
  if(!VEX_SUPPORTED_SCHEMA_VERSIONS.includes(schemaVersion)){
    toast(`${fileLabel}: schema version "${schemaVersion||'unknown'}" is not supported (expects ${VEX_SUPPORTED_SCHEMA_VERSIONS.join('/')}). Import blocked to avoid silent mis-mapping — check the Vex prompt version used to generate this JSON.`, 'err');
    return null;
  }
  const result = { tasks:{added:0,shifted:0,unchanged:0,migrated:0}, cost:0, materials:0, takedowns:0, violations:0, forecasts:0, vos:0, rfis:0 };
/* === VEX SCHEMA VERSION GUARD: END === */
  if(Array.isArray(payload.tasks) && payload.tasks.length){
    result.tasks = mergeVexTasks(payload.tasks, fileLabel);
    saveDB();
  }
  if(Array.isArray(payload.costEntries) && payload.costEntries.length){
    result.cost = mergeVexCostEntries(payload.costEntries, fileLabel);
    saveCost();
  }
  if(Array.isArray(payload.materialEntries) && payload.materialEntries.length){
    result.materials = mergeVexMaterialEntries(payload.materialEntries, fileLabel);
    saveMaterials();
  }
  if(Array.isArray(payload.quantityTakedowns) && payload.quantityTakedowns.length){
    result.takedowns = mergeVexGenericArray('quantityTakedowns', payload.quantityTakedowns, fileLabel, ['building','item','sourceRowRef']);
    saveQuantityTakedowns();
  }
  if(Array.isArray(payload.violations) && payload.violations.length){
    result.violations = mergeVexGenericArray('violations', payload.violations, fileLabel, ['description','dateRaised','sourceRowRef']);
    saveViolations();
  }
  if(Array.isArray(payload.forecastNotes) && payload.forecastNotes.length){
    result.forecasts = mergeVexGenericArray('forecastNotes', payload.forecastNotes, fileLabel, ['narrative','asOfDate','sourceRowRef']);
    saveForecastNotes();
  }
  if(Array.isArray(payload.variationOrders) && payload.variationOrders.length){
    result.vos = mergeVexGenericArray('variationOrders', payload.variationOrders, fileLabel, ['voNumber','description','sourceRowRef']);
    saveVariationOrders();
  }
  if(Array.isArray(payload.rfis) && payload.rfis.length){
    result.rfis = mergeVexGenericArray('rfis', payload.rfis, fileLabel, ['rfiNumber','subject','sourceRowRef']);
    saveRfis();
  }
  if(payload.meta){
    state.vexMeta.push(Object.assign({}, payload.meta, { id: hashKey(['vexmeta',fileLabel,Date.now()].join('|')), fileLabel, importedAt: new Date().toISOString() }));
    saveVexMeta();
    if(payload.meta.projectName && !state.projectNameCustomized){
      setProjectName(payload.meta.projectName, false);
    }
    if(payload.meta.projectAddress && !state.projectAddressCustomized){
      setProjectAddress(payload.meta.projectAddress, false);
    }
  }
  return result;
}
/* === VEX JSON IMPORT — SHARED TEXT PROCESSOR: START === */
function processVexJsonText(jsonText, fileLabel){
  let payload;
  try{
    payload = JSON.parse(jsonText);
  }catch(err){
    toast('Could not parse "'+fileLabel+'" as JSON: '+err.message, 'err');
    return;
  }
  if(!payload || typeof payload!=='object'){
    toast(fileLabel+' does not look like a Vex JSON output (expected an object with tasks/costEntries/etc.).', 'err');
    return;
  }
  const r = mergeVexPayload(payload, fileLabel);
  if(r===null) return; // schema version guard already toasted the reason
  const parts = [];
  if(r.tasks && (r.tasks.added||r.tasks.shifted||r.tasks.unchanged)) parts.push(`${r.tasks.added} new task(s), ${r.tasks.shifted} shifted, ${r.tasks.unchanged} unchanged`);
  if(r.cost) parts.push(`${r.cost} cost entr${r.cost===1?'y':'ies'}`);
  if(r.materials) parts.push(`${r.materials} material item(s)`);
  if(r.takedowns) parts.push(`${r.takedowns} quantity takedown(s)`);
  if(r.violations) parts.push(`${r.violations} violation(s)`);
  if(r.forecasts) parts.push(`${r.forecasts} forecast note(s)`);
  if(r.vos) parts.push(`${r.vos} variation order(s)`);
  if(r.rfis) parts.push(`${r.rfis} RFI(s)`);
  toast(parts.length ? 'Vex import: '+parts.join(' · ') : fileLabel+' read, but no recognized arrays had data.', parts.length?'ok':'err');

  /* === EXTRACTION REVIEW BRIDGE: START === */
  if(parts.length){
    const findings = (payload.meta && payload.meta.structuralFindings) || [];
    const blindSpots = (payload.meta && payload.meta.blindSpots) || [];
    goToExtractionReview({
      source: (typeof ipdSource!=='undefined' && ipdSource) ? ipdSource : 'Vex JSON',
      filesAnalyzed: 1,
      sheetsProcessed: new Set((payload.tasks||[]).map(t=>t.sourceRowRef ? t.sourceRowRef.split(' · ')[0]+' · '+t.sourceRowRef.split(' · ')[1] : fileLabel)).size || 1,
      costRecords: (payload.costEntries||[]).length,
      materialRecords: (payload.materialEntries||[]).length,
      rfis: (payload.rfis||[]).length,
      variationOrders: (payload.variationOrders||[]).length,
      confidence: tallyConfidence(payload.tasks||[]),
      needsReview: {
        discrepancies: findings.filter(f=>f.category==='DISCREPANCY'||f.category==='CONFIRMED_ERROR').length,
        unusual: findings.filter(f=>f.category==='SUSPICIOUS'||f.category==='UNUSUAL').length,
        skipped: blindSpots.length,
      },
    });
  } else {
    render();
  }
  /* === EXTRACTION REVIEW BRIDGE: END === */
}

function handleVexJsonFile(fileList){
  [...fileList].forEach(file=>{
    const ext = (file.name.split('.').pop()||'').toLowerCase();
    if(ext!=='json'){ toast(file.name+' — Vex import expects a .json file (the Document Standardization Mode output).', 'err'); return; }
    const fileLabel = (ipdSource ? ipdSource+' — ' : '') + file.name.replace(/\.json$/i,'').replace(/_/g,' ').slice(0,60);
    const reader = new FileReader();
    reader.onload = ev=>{
      ipdPasteText = ev.target.result;
      const ta = document.getElementById('vexPasteText');
      if(ta) ta.value = ipdPasteText;
      updateIpdAdvancedPreview();
      processVexJsonText(ev.target.result, fileLabel);
    };
    reader.readAsText(file);
  });
}

