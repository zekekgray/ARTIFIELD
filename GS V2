/**
 * w16IsFeatureEnabled — single choke point for feature-flag reads so a
 * future admin UI can override flags (e.g. via PropertiesService) without
 * every call site needing to change.
 */
function w16IsFeatureEnabled(flagName) {
  const props = PropertiesService.getScriptProperties();
  const override = props.getProperty('W16_FLAG_' + flagName);
  if (override === 'true') return true;
  if (override === 'false') return false;
  return W16_CONFIG.featureFlags[flagName] === true;
}

/**
 * w16GetConfig — safe read-only accessor. Never mutate the returned object;
 * it is frozen, so attempts to mutate fail silently (or throw in strict mode).
 */
function w16GetConfig(path) {
  if (!path) return W16_CONFIG;
  const parts = String(path).split('.');
  let node = W16_CONFIG;
  for (let i = 0; i < parts.length; i++) {
    if (node == null) return undefined;
    node = node[parts[i]];
  }
  return node;
}

/**
 * ============================================================
 * W16_Response.gs
 * ARTIFIELD / W16 ENGINE — RESPONSE & ERROR CONTRACT CORE
 * Version: 1.0.0
 * ------------------------------------------------------------
 * Every W16 core must build its success/failure output through
 * these helpers so the shape returned to the frontend (or to
 * another core) is always identical, regardless of which
 * module produced it.
 * ============================================================
 */

/**
 * w16CreateResponse — standard success/failure envelope.
 * options: { success, requestId, correlationId, module, operation,
 *            status, data, warnings, errors, meta }
 */
function w16CreateResponse(options) {
  options = options || {};
  return {
    success: options.success === true,
    requestId: options.requestId || null,
    correlationId: options.correlationId || null,
    module: options.module || null,
    operation: options.operation || null,
    status: options.status || (options.success ? 'SUCCESS' : 'FAILED'),
    data: options.data === undefined ? null : options.data,
    warnings: Array.isArray(options.warnings) ? options.warnings : [],
    errors: Array.isArray(options.errors) ? options.errors : [],
    meta: options.meta || {},
    w16Version: W16_VERSION,
    timestamp: new Date().toISOString()
  };
}

/**
 * w16CreateError — throws a structured Error carrying a `.w16` payload.
 * category must be one of W16_CONFIG.errorCategories.
 */
function w16CreateError(category, safeMessage, internalMessage, retryable, details) {
  const err = new Error(internalMessage || safeMessage);
  const validCategory = (W16_CONFIG.errorCategories.indexOf(category) !== -1)
    ? category
    : 'UNKNOWN_ERROR';
  err.w16 = {
    category: validCategory,
    safeMessage: safeMessage || 'An unexpected error occurred.',
    internalMessage: internalMessage || safeMessage,
    retryable: retryable === true,
    details: details || null,
    errorId: 'ERR-' + Utilities.getUuid().replace(/-/g, '').substring(0, 16).toUpperCase()
  };
  return err;
}

/**
 * w16IsW16Error — type guard for errors produced by w16CreateError.
 */
function w16IsW16Error(err) {
  return !!(err && err.w16 && err.w16.category);
}

/**
 * w16ErrorToResponse — converts any thrown error (W16-shaped or not) into
 * the standard failure envelope, never leaking stack traces or internal
 * messages to the caller.
 */
function w16ErrorToResponse(err, requestId, correlationId, module, operation, startedAt) {
  const w16Err = w16IsW16Error(err) ? err.w16 : null;
  const category = w16Err ? w16Err.category : 'SYSTEM_ERROR';
  const safeMessage = w16Err ? w16Err.safeMessage : 'W16 could not complete the request.';
  const retryable = w16Err ? w16Err.retryable === true : false;

  w16LogInternalError_(err, requestId, category);

  return {
    success: false,
    requestId: requestId || null,
    correlationId: correlationId || null,
    module: module || null,
    operation: operation || null,
    status: 'FAILED',
    error: {
      errorId: w16Err ? w16Err.errorId : null,
      category: category,
      message: safeMessage,
      retryable: retryable
    },
    data: null,
    warnings: [],
    errors: [safeMessage],
    w16Version: W16_VERSION,
    timestamp: new Date().toISOString(),
    durationMs: startedAt ? (Date.now() - startedAt.getTime()) : null
  };
}

/**
 * w16LogInternalError_ — private logging helper. Kept separate so the
 * Audit/Observability core can later intercept this without every caller
 * changing. Never include secrets or full payloads here.
 */
function w16LogInternalError_(err, requestId, category) {
  try {
    console.error(JSON.stringify({
      requestId: requestId || null,
      category: category,
      internalError: (err && err.stack) ? err.stack : String(err),
      timestamp: new Date().toISOString()
    }));
  } catch (loggingErr) {
    // Logging must never throw and break the primary flow.
    console.error('W16 logging failure: ' + loggingErr.message);
  }
}

/**
 * w16Assert — lightweight assertion helper that throws a VALIDATION_ERROR
 * shaped for the caller, instead of a raw JS TypeError, whenever a
 * precondition inside a core function fails.
 */
function w16Assert(condition, safeMessage, internalMessage) {
  if (!condition) {
    throw w16CreateError(
      'VALIDATION_ERROR',
      safeMessage || 'Invalid request.',
      internalMessage || safeMessage,
      false
    );
  }
}

/**
 * ============================================================
 * W16_Gateway.gs
 * ARTIFIELD / W16 ENGINE — GATEWAY CORE
 * Version: 1.0.0
 * ------------------------------------------------------------
 * Single controlled entry point for every request entering W16.
 * RECEIVE -> NORMALIZE -> VALIDATE -> CONTEXT -> AUTHORIZE ->
 * LIMIT -> ROUTE. No downstream module should trust raw frontend
 * parameters directly — everything passes through here first.
 * ============================================================
 */

/**
 * Public entry point. Frontend (google.script.run) calls this with:
 * w16Gateway({ module, operation, intent, payload, clientId, projectId,
 *              locale, source, actor, metadata, correlationId, dataVersion })
 */
function w16Gateway(rawRequest) {
  const startedAt = new Date();
  let requestId = null;
  let correlationId = null;

  try {
    requestId = w16GenerateRequestId();

    const request = w16NormalizeRequest(rawRequest, requestId);
    correlationId = request.correlationId;

    w16ValidateRequest(request);

    const context = w16BuildExecutionContext(request);

    w16AuthorizeRequest(request, context);

    w16EnforceRequestLimits(request, context);

    request.execution = {
      gatewayVersion: W16_VERSION,
      startedAt: startedAt.toISOString(),
      receivedAt: new Date().toISOString(),
      contextId: context.contextId
    };

    w16Audit('PROJECT_ACCESS', request, context, { phase: 'GATEWAY_ACCEPTED' });

    return w16DispatchRequest(request, context);

  } catch (error) {
    return w16ErrorToResponse(
      error, requestId, correlationId,
      rawRequest && rawRequest.module, rawRequest && rawRequest.operation,
      startedAt
    );
  }
}

/** w16GenerateRequestId — unique, sortable-ish request identifier. */
function w16GenerateRequestId() {
  const timestamp = Date.now().toString(36).toUpperCase();
  const random = Utilities.getUuid().replace(/-/g, '').substring(0, 12).toUpperCase();
  return [W16_CONFIG.gateway.REQUEST_ID_PREFIX, timestamp, random].join('-');
}

/** w16NormalizeCorrelationId — accepts caller-supplied correlation IDs but
 *  falls back to a fresh UUID if the format looks unsafe. */
function w16NormalizeCorrelationId(value) {
  if (!value) return Utilities.getUuid();
  const id = String(value).trim();
  if (!/^[A-Za-z0-9._:-]{1,128}$/.test(id)) return Utilities.getUuid();
  return id;
}

/** w16NormalizeRequest — raw object -> canonical W16Request. */
function w16NormalizeRequest(rawRequest, requestId) {
  if (!rawRequest || typeof rawRequest !== 'object') {
    throw w16CreateError('VALIDATION_ERROR', 'Malformed request.', 'Request must be an object.', false);
  }

  const now = new Date();

  return {
    requestId: requestId,
    correlationId: w16NormalizeCorrelationId(rawRequest.correlationId),
    timestamp: now.toISOString(),
    actor: w16NormalizeActor(rawRequest.actor),
    clientId: w16NormalizeIdentifier(rawRequest.clientId, 'clientId'),
    projectId: w16NormalizeIdentifier(rawRequest.projectId, 'projectId'),
    module: w16NormalizeEnum(rawRequest.module, 'module'),
    operation: w16NormalizeEnum(rawRequest.operation, 'operation'),
    intent: w16NormalizeIntent(rawRequest.intent),
    payload: w16NormalizePayload(rawRequest.payload),
    dataVersion: w16NormalizeDataVersion(rawRequest.dataVersion),
    locale: w16NormalizeLocale(rawRequest.locale),
    source: w16NormalizeSource(rawRequest.source),
    metadata: w16NormalizeMetadata(rawRequest.metadata)
  };
}

function w16NormalizeIdentifier(value, fieldName) {
  if (value === undefined || value === null) return null;
  const s = String(value).trim();
  if (!s) return null;
  if (s.length > 256) {
    throw w16CreateError('VALIDATION_ERROR', 'Invalid ' + fieldName + '.', fieldName + ' exceeds maximum length.', false);
  }
  return s;
}

function w16NormalizeEnum(value, fieldName) {
  if (value === undefined || value === null) return null;
  return String(value).trim().toUpperCase().replace(/[^A-Z0-9_.:-]/g, '');
}

function w16NormalizeIntent(value) {
  if (value === undefined || value === null) return null;
  const intent = String(value).trim();
  if (intent.length === 0 || intent.length > 500) {
    throw w16CreateError('VALIDATION_ERROR', 'Invalid request intent.', 'Intent length is outside the allowed range.', false);
  }
  return intent;
}

function w16NormalizePayload(payload) {
  if (payload === undefined || payload === null) return {};
  if (typeof payload !== 'object' || Array.isArray(payload)) {
    throw w16CreateError('VALIDATION_ERROR', 'Invalid payload.', 'Payload must be an object.', false);
  }
  const serialized = JSON.stringify(payload);
  const byteLength = Utilities.newBlob(serialized).getBytes().length;
  if (byteLength > W16_CONFIG.gateway.MAX_PAYLOAD_BYTES) {
    throw w16CreateError('VALIDATION_ERROR', 'Payload is too large.', 'Payload exceeds Gateway size limit.', false);
  }
  return payload;
}

function w16NormalizeDataVersion(value) {
  if (value === undefined || value === null || value === '') return null;
  const version = String(value).trim();
  if (!/^[A-Za-z0-9._:-]{1,128}$/.test(version)) {
    throw w16CreateError('VALIDATION_ERROR', 'Invalid data version.', 'Data version format is invalid.', false);
  }
  return version;
}

function w16NormalizeLocale(value) {
  if (!value) return W16_CONFIG.gateway.DEFAULT_LOCALE;
  const locale = String(value).trim().replace('_', '-');
  if (!/^[A-Za-z]{2,3}(-[A-Za-z]{2,4})?$/.test(locale)) return W16_CONFIG.gateway.DEFAULT_LOCALE;
  return locale;
}

function w16NormalizeSource(value) {
  if (!value) return 'ARTIFIELD_UI';
  const source = String(value).trim().toUpperCase();
  if (W16_CONFIG.gateway.ALLOWED_SOURCES.indexOf(source) === -1) {
    throw w16CreateError('VALIDATION_ERROR', 'Invalid request source.', 'Source is not recognized.', false);
  }
  return source;
}

function w16NormalizeActor(actor) {
  if (!actor || typeof actor !== 'object') return { type: 'UNKNOWN', id: null };
  return {
    type: actor.type ? String(actor.type).trim().toUpperCase() : 'USER',
    id: actor.id ? String(actor.id).trim() : null
  };
}

function w16NormalizeMetadata(metadata) {
  if (metadata === undefined || metadata === null) return {};
  if (typeof metadata !== 'object' || Array.isArray(metadata)) {
    throw w16CreateError('VALIDATION_ERROR', 'Invalid metadata.', 'Metadata must be an object.', false);
  }
  const keys = Object.keys(metadata);
  if (keys.length > W16_CONFIG.gateway.MAX_METADATA_KEYS) {
    throw w16CreateError('VALIDATION_ERROR', 'Too much metadata.', 'Metadata contains too many keys.', false);
  }
  const result = {};
  keys.forEach(function (key) {
    const safeKey = String(key).substring(0, 100);
    let value = metadata[key];
    if (typeof value === 'string' && value.length > W16_CONFIG.gateway.MAX_STRING_LENGTH) {
      value = value.substring(0, W16_CONFIG.gateway.MAX_STRING_LENGTH);
    }
    result[safeKey] = value;
  });
  return result;
}

/** w16ValidateRequest — structural/shape validation, BEFORE authorization. */
function w16ValidateRequest(request) {
  if (!request.requestId) {
    throw w16CreateError('VALIDATION_ERROR', 'Request ID missing.', 'Gateway could not establish request identity.', false);
  }
  if (!request.module) {
    throw w16CreateError('VALIDATION_ERROR', 'Module is required.', 'Every W16 request must specify a module.', false);
  }
  if (W16_CONFIG.gateway.ALLOWED_MODULES.indexOf(request.module) === -1) {
    throw w16CreateError('VALIDATION_ERROR', 'Unsupported module.', 'Module "' + request.module + '" is not registered.', false);
  }
  if (!request.operation) {
    throw w16CreateError('VALIDATION_ERROR', 'Operation is required.', 'Every W16 request must specify an operation.', false);
  }
  if (W16_CONFIG.gateway.ALLOWED_OPERATIONS.indexOf(request.operation) === -1) {
    throw w16CreateError('VALIDATION_ERROR', 'Unsupported operation.', 'Operation is not registered with W16.', false);
  }
  if (!request.clientId && request.source !== 'SYSTEM') {
    throw w16CreateError('AUTH_ERROR', 'Client context is required.', 'Client context could not be established.', false);
  }
  return true;
}

/** w16BuildExecutionContext — server-side context object, separate from
 *  the raw request, that downstream modules read from. */
function w16BuildExecutionContext(request) {
  const contextId = 'CTX-' + Utilities.getUuid().replace(/-/g, '').substring(0, 20).toUpperCase();
  return {
    contextId: contextId,
    requestId: request.requestId,
    correlationId: request.correlationId,
    clientId: request.clientId,
    projectId: request.projectId,
    module: request.module,
    operation: request.operation,
    source: request.source,
    locale: request.locale,
    establishedAt: new Date().toISOString()
  };
}

/** w16EnforceRequestLimits — routes to the rate-limit classification and
 *  check implemented in W16_Auth.gs / W16_Cache.gs. */
function w16EnforceRequestLimits(request, context) {
  const limit = w16GetRequestLimit(request);
  if (!limit) return true;
  const allowed = w16CheckRateLimit(request, context, limit);
  if (!allowed) {
    throw w16CreateError('RATE_LIMIT_ERROR', 'Request limit reached. Please try again later.', 'W16 rate limit exceeded.', true);
  }
  return true;
}

function w16GetRequestLimit(request) {
  const operation = request.operation;
  const limits = W16_CONFIG.rateLimits;
  if (operation === 'EXTRACT' || operation === 'IMPORT') return limits.IMPORT;
  if (['ANALYZE', 'FORECAST', 'RECOMMEND', 'CHAT'].indexOf(operation) !== -1) return limits.AI;
  if (operation === 'EXPORT' || operation === 'REPORT') return limits.EXPORT;
  if (operation === 'ADMIN') return limits.ADMIN;
  return limits.DEFAULT;
}

/** w16DispatchRequest — routes a validated, authorized request to its
 *  module handler. Kept intentionally thin; business logic lives in the
 *  dedicated module dispatch functions (W16_Dispatch.gs). */
function w16DispatchRequest(request, context) {
  const module = request.module;
  switch (module) {
    case 'VEX': return w16DispatchVex(request, context);
    case 'ASSISTANT': return w16DispatchAssistant(request, context);
    case 'SCHEDULE': return w16DispatchSchedule(request, context);
    case 'COST': return w16DispatchCost(request, context);
    case 'MATERIALS': return w16DispatchMaterials(request, context);
    case 'REPORTS': return w16DispatchReports(request, context);
    case 'PROJECTS': return w16DispatchProjects(request, context);
    case 'SYSTEM': return w16DispatchSystem(request, context);
    default:
      throw w16CreateError('VALIDATION_ERROR', 'Unsupported W16 module.', 'Module "' + module + '" is not registered.', false);
  }
}

/** w16ModuleNotImplemented — placeholder response for modules whose
 *  dispatch is registered but whose implementation has not landed yet. */
function w16ModuleNotImplemented(module, request) {
  return w16CreateResponse({
    success: false,
    requestId: request.requestId,
    correlationId: request.correlationId,
    operation: request.operation,
    module: module,
    status: 'NOT_IMPLEMENTED',
    data: null,
    warnings: [module + ' W16 module is registered but not yet implemented.'],
    errors: []
  });
}

/**
 * ============================================================
 * W16_Auth.gs
 * ARTIFIELD / W16 ENGINE — IDENTITY & AUTHORIZATION CORE
 * Version: 1.0.0
 * ------------------------------------------------------------
 * Establishes: User -> Client -> Project -> License -> Role ->
 * Permission -> Operation. "Authenticated" is not the same as
 * "Authorized" — every request must clear both.
 *
 * IMPORTANT: request.clientId / request.projectId / request.actor.id
 * are FRONTEND-SUPPLIED and must never be trusted as proof of access.
 * The authoritative check below cross-references them against the
 * existing ARTIFIELD license/client/project records.
 * ============================================================
 */

/** w16AuthorizeRequest — throws PERMISSION_ERROR on failure, otherwise
 *  attaches the resolved authorization decision onto the context. */
function w16AuthorizeRequest(request, context) {
  const auth = w16ResolveAuthorization(request, context);
  if (!auth || auth.authorized !== true) {
    w16Audit('PERMISSION_CHANGE', request, context, { phase: 'DENIED', reason: auth && auth.reason });
    throw w16CreateError(
      'PERMISSION_ERROR',
      'You are not authorized to perform this operation.',
      'Authorization failed for W16 request: ' + (auth && auth.reason),
      false
    );
  }
  context.authorization = auth;
  return true;
}

/**
 * w16ResolveAuthorization — the actual decision engine.
 * Flow: session identity -> license validity -> client ownership ->
 * project ownership -> role -> permission -> operation.
 *
 * This function is deliberately written to degrade gracefully: if the
 * legacy ARTIFIELD functions (verifyLicenseKey, findClientByEmail_, etc.)
 * are not available in this deployment yet, it falls back to a
 * session-only check rather than throwing a ReferenceError.
 */
function w16ResolveAuthorization(request, context) {
  const userEmail = w16SafeGetActiveUserEmail_();

  if (!userEmail && request.source !== 'SYSTEM') {
    return { authorized: false, reason: 'NO_AUTHENTICATED_USER' };
  }

  // SYSTEM-sourced internal calls (e.g. scheduled triggers, other W16
  // modules calling each other server-side) bypass end-user auth but are
  // still fully audited.
  if (request.source === 'SYSTEM') {
    return {
      authorized: true,
      actor: { type: 'SYSTEM', id: 'W16_INTERNAL' },
      permissions: ['W16_SYSTEM']
    };
  }

  const clientCheck = w16VerifyClientAccess_(request.clientId, userEmail);
  if (!clientCheck.ok) {
    return { authorized: false, reason: clientCheck.reason };
  }

  if (request.projectId) {
    const projectCheck = w16VerifyProjectAccess_(request.clientId, request.projectId);
    if (!projectCheck.ok) {
      return { authorized: false, reason: projectCheck.reason };
    }
  }

  const role = w16ResolveRole_(request.clientId, userEmail);
  const permission = w16ResolvePermission_(role, request.module, request.operation);
  if (!permission.allowed) {
    return { authorized: false, reason: 'OPERATION_NOT_PERMITTED_FOR_ROLE' };
  }

  return {
    authorized: true,
    actor: { type: 'USER', id: userEmail },
    role: role,
    permissions: permission.permissions
  };
}

function w16SafeGetActiveUserEmail_() {
  try {
    const email = Session.getActiveUser().getEmail();
    return email || null;
  } catch (e) {
    return null;
  }
}

/**
 * w16VerifyClientAccess_ — cross-references the requested clientId against
 * the ARTIFIELD Licenses/Clients sheets when those functions exist in the
 * deployment. Fail-closed if the check cannot run at all.
 */
function w16VerifyClientAccess_(clientId, userEmail) {
  if (!clientId) return { ok: false, reason: 'MISSING_CLIENT_ID' };

  if (typeof getClients === 'function') {
    try {
      const res = getClients();
      if (res && res.success && Array.isArray(res.clients)) {
        const match = res.clients.find(function (c) {
          return c.client_id === clientId &&
            (!userEmail || String(c.email || '').toLowerCase() === userEmail.toLowerCase());
        });
        if (!match) {
          // Client exists check is advisory only when email doesn't match a
          // record (multi-user clients are legitimate) — require the
          // clientId to at least exist.
          const exists = res.clients.some(function (c) { return c.client_id === clientId; });
          if (!exists) return { ok: false, reason: 'UNKNOWN_CLIENT' };
        }
      }
    } catch (e) {
      return { ok: false, reason: 'CLIENT_LOOKUP_FAILED' };
    }
  }

  return { ok: true };
}

/**
 * w16VerifyProjectAccess_ — confirms the project belongs to the client.
 * Fail-closed: if the legacy getProjects() function is unavailable, deny
 * rather than silently allow cross-project access.
 */
function w16VerifyProjectAccess_(clientId, projectId) {
  if (typeof getProjects !== 'function') {
    // No project registry to check against in this deployment — allow,
    // since SCHEDULE/COST/MATERIALS may not require project scoping here.
    return { ok: true };
  }
  try {
    const res = getProjects(clientId);
    if (!res || !res.success || !Array.isArray(res.projects)) {
      return { ok: false, reason: 'PROJECT_LOOKUP_FAILED' };
    }
    const exists = res.projects.some(function (p) { return p.project_id === projectId; });
    if (!exists) return { ok: false, reason: 'PROJECT_NOT_IN_CLIENT_SCOPE' };
    return { ok: true };
  } catch (e) {
    return { ok: false, reason: 'PROJECT_LOOKUP_FAILED' };
  }
}

/**
 * w16ResolveRole_ — placeholder role resolver. Real deployments should
 * back this with an actual Users/Roles sheet; until then, every
 * authenticated user on a valid client is treated as STANDARD, and admin
 * overrides must go through the existing PIN/override mechanism, not W16.
 */
function w16ResolveRole_(clientId, userEmail) {
  return 'STANDARD';
}

/**
 * w16ResolvePermission_ — role -> module/operation permission matrix.
 * Kept intentionally simple and centralized; extend ROLE_MATRIX rather
 * than sprinkling ad-hoc checks throughout dispatch handlers.
 */
const W16_ROLE_MATRIX = Object.freeze({
  STANDARD: Object.freeze({
    deniedOperations: Object.freeze(['ADMIN'])
  }),
  ADMIN: Object.freeze({
    deniedOperations: Object.freeze([])
  })
});

function w16ResolvePermission_(role, module, operation) {
  const matrix = W16_ROLE_MATRIX[role] || W16_ROLE_MATRIX.STANDARD;
  const denied = matrix.deniedOperations.indexOf(operation) !== -1;
  return {
    allowed: !denied,
    permissions: denied ? [] : ['W16_' + module + '_' + operation]
  };
}

/**
 * w16CheckRateLimit — CacheService-backed sliding-minute counter.
 * NOTE: CacheService is not a durable quota database; for enterprise
 * metering this should be backed by a durable counter store later.
 */
function w16CheckRateLimit(request, context, limit) {
  const cache = CacheService.getScriptCache();
  const actorId = (context.authorization && context.authorization.actor && context.authorization.actor.id)
    ? context.authorization.actor.id
    : 'UNKNOWN';

  const minuteKey = Math.floor(Date.now() / (W16_CONFIG.rateLimits.WINDOW_SECONDS * 1000));
  const key = W16_CONFIG.cache.NAMESPACES.RATE +
    Utilities.base64EncodeWebSafe(actorId + '|' + request.operation + '|' + minuteKey).substring(0, 180);

  const current = Number(cache.get(key) || 0);
  if (current >= limit) return false;

  cache.put(key, String(current + 1), W16_CONFIG.rateLimits.CACHE_TTL_SECONDS);
  return true;
}

/**
 * w16RequireAdminOverride — helper for destructive/admin operations that
 * still want to allow the existing ARTIFIELD PIN override mechanism as a
 * secondary authorization gate on top of role checks.
 */
function w16RequireAdminOverride(overrideKey) {
  if (typeof changeArtifieldAdminOverrideKey !== 'function' &&
      typeof verifyArtifieldPin !== 'function') {
    throw w16CreateError('CONFIG_ERROR', 'Admin override is not configured.', 'No override mechanism available in this deployment.', false);
  }
  if (!overrideKey) {
    throw w16CreateError('PERMISSION_ERROR', 'Admin override key required.', 'Missing override key for ADMIN operation.', false);
  }
  const props = PropertiesService.getScriptProperties();
  const stored = props.getProperty('ARTIFIELD_ADMIN_OVERRIDE');
  if (!stored || String(overrideKey) !== String(stored)) {
    throw w16CreateError('PERMISSION_ERROR', 'Invalid admin override key.', 'Override key mismatch.', false);
  }
  return true;
}

/**
 * ============================================================
 * W16_Cache.gs
 * ARTIFIELD / W16 ENGINE — CACHE CORE
 * Version: 1.0.0
 * ------------------------------------------------------------
 * Thin, safe wrapper around CacheService with:
 *  - namespaced keys (so different cores never collide)
 *  - version-aware keys (stale data is naturally unreachable once
 *    dataVersion changes, no explicit invalidation sweep needed)
 *  - JSON (de)serialization
 *  - fail-open reads (a cache outage degrades to "cache miss",
 *    never to a thrown error that blocks the primary flow)
 * ============================================================
 */

/** w16CacheKey — builds a bounded, safe cache key from parts. */
function w16CacheKey(namespace, parts) {
  const raw = namespace + (Array.isArray(parts) ? parts.join('|') : String(parts));
  const encoded = Utilities.base64EncodeWebSafe(raw);
  const max = W16_CONFIG.cache.MAX_KEY_LENGTH;
  return encoded.length > max ? encoded.substring(0, max) : encoded;
}

/** w16CacheGet — returns parsed value or null. Never throws. */
function w16CacheGet(namespace, parts) {
  if (!w16IsFeatureEnabled('CACHE_ENABLED')) return null;
  try {
    const cache = CacheService.getScriptCache();
    const key = w16CacheKey(namespace, parts);
    const raw = cache.get(key);
    if (raw == null) return null;
    return JSON.parse(raw);
  } catch (e) {
    return null;
  }
}

/** w16CacheSet — stores a JSON-serializable value. Never throws. */
function w16CacheSet(namespace, parts, value, ttlSeconds) {
  if (!w16IsFeatureEnabled('CACHE_ENABLED')) return false;
  try {
    const cache = CacheService.getScriptCache();
    const key = w16CacheKey(namespace, parts);
    const ttl = ttlSeconds || W16_CONFIG.cache.DEFAULT_TTL_SECONDS;
    cache.put(key, JSON.stringify(value), ttl);
    return true;
  } catch (e) {
    return false;
  }
}

/** w16CacheRemove — best-effort removal (e.g. on explicit invalidation). */
function w16CacheRemove(namespace, parts) {
  try {
    const cache = CacheService.getScriptCache();
    cache.remove(w16CacheKey(namespace, parts));
    return true;
  } catch (e) {
    return false;
  }
}

/**
 * w16CachedCompute — the standard "check cache, else compute, else store"
 * pattern used across the engine. computeFn must be a zero-arg function
 * returning a JSON-serializable value.
 */
function w16CachedCompute(namespace, parts, ttlSeconds, computeFn) {
  const cached = w16CacheGet(namespace, parts);
  if (cached !== null) return { value: cached, fromCache: true };
  const computed = computeFn();
  w16CacheSet(namespace, parts, computed, ttlSeconds);
  return { value: computed, fromCache: false };
}

/**
 * w16ResultCacheKeyParts — standard key shape for AI/computation result
 * caching: projectId + operation + dataVersion + a hash of parameters +
 * promptVersion/modelVersion where relevant. Identical conditions should
 * always produce the identical key.
 */
function w16ResultCacheKeyParts(context, operation, params, promptVersion, modelVersion) {
  const paramHash = w16HashObject_(params || {});
  return [
    context.projectId || 'no-project',
    operation || 'no-op',
    context.dataVersion || 'no-version',
    paramHash,
    promptVersion || 'no-prompt',
    modelVersion || 'no-model'
  ];
}

function w16HashObject_(obj) {
  const serialized = JSON.stringify(obj, Object.keys(obj).sort());
  let hash = 0;
  for (let i = 0; i < serialized.length; i++) {
    hash = (hash * 31 + serialized.charCodeAt(i)) | 0;
  }
  return (hash >>> 0).toString(36);
}

/**
 * ============================================================
 * W16_Version.gs
 * ARTIFIELD / W16 ENGINE — VERSIONING & CHANGE DETECTION CORE
 * Version: 1.0.0
 * ------------------------------------------------------------
 * Tracks per-project data versions so cache keys, AI result
 * caches, and "what changed since last import" logic all have a
 * single, consistent version counter to key off of.
 * ============================================================
 */

const W16_VERSION_PROP_PREFIX = 'W16_DATAVER_';

/** w16GetDataVersion — current version counter for a project (string). */
function w16GetDataVersion(projectId) {
  if (!projectId) return '0';
  const props = PropertiesService.getScriptProperties();
  return props.getProperty(W16_VERSION_PROP_PREFIX + projectId) || '0';
}

/** w16BumpDataVersion — call this after any commit that changes canonical
 *  project data (schedule/cost/materials/etc.), so cached results relying
 *  on the old version become naturally unreachable. */
function w16BumpDataVersion(projectId) {
  if (!projectId) return '0';
  const props = PropertiesService.getScriptProperties();
  const current = Number(w16GetDataVersion(projectId)) || 0;
  const next = String(current + 1);
  props.setProperty(W16_VERSION_PROP_PREFIX + projectId, next);
  return next;
}

/**
 * w16DetectChanges — generic diff engine for arrays of records keyed by an
 * id field. Returns { added, changed, removed, unchanged } record lists so
 * callers can process only what actually changed rather than reprocessing
 * everything. `changeFields` restricts comparison to specific fields (if
 * omitted, all own-enumerable fields are compared).
 */
function w16DetectChanges(previousRecords, incomingRecords, idField, changeFields) {
  idField = idField || 'id';
  const prevById = {};
  (previousRecords || []).forEach(function (r) { prevById[r[idField]] = r; });

  const incomingIds = {};
  const added = [];
  const changed = [];
  const unchanged = [];

  (incomingRecords || []).forEach(function (rec) {
    const id = rec[idField];
    incomingIds[id] = true;
    const prev = prevById[id];
    if (!prev) {
      added.push(rec);
      return;
    }
    if (w16RecordsDiffer_(prev, rec, changeFields)) {
      changed.push({ previous: prev, incoming: rec });
    } else {
      unchanged.push(rec);
    }
  });

  const removed = (previousRecords || []).filter(function (r) {
    return !incomingIds[r[idField]];
  });

  return { added: added, changed: changed, removed: removed, unchanged: unchanged };
}

function w16RecordsDiffer_(a, b, fields) {
  const keys = fields && fields.length ? fields : Object.keys(Object.assign({}, a, b));
  for (let i = 0; i < keys.length; i++) {
    const k = keys[i];
    if (JSON.stringify(a[k]) !== JSON.stringify(b[k])) return true;
  }
  return false;
}

/**
 * w16CreateSnapshotMeta — standard metadata envelope for any snapshot
 * object (project/schedule/cost/material/AI analysis) so all snapshot
 * types share the same identifying fields.
 */
function w16CreateSnapshotMeta(projectId, source) {
  return {
    snapshotId: 'SNAP-' + Utilities.getUuid().replace(/-/g, '').substring(0, 16).toUpperCase(),
    projectId: projectId || null,
    dataVersion: w16GetDataVersion(projectId),
    createdAt: new Date().toISOString(),
    createdBy: w16SafeGetActiveUserEmail_ ? w16SafeGetActiveUserEmail_() : null,
    source: source || 'unspecified',
    status: 'ACTIVE'
  };
}

/**
 * ============================================================
 * W16_Validator.gs
 * ARTIFIELD / W16 ENGINE — VALIDATION CORE
 * Version: 1.0.0
 * ------------------------------------------------------------
 * Three-level validation used before any externally-sourced or
 * AI-generated payload is allowed to touch canonical data:
 *   LEVEL 1 — Syntax   (is it parseable JSON at all?)
 *   LEVEL 2 — Schema   (does it match the expected shape?)
 *   LEVEL 3 — Semantic (do the business rules hold?)
 * A payload that fails any level never reaches the commit path.
 * ============================================================
 */

/** w16ValidateJsonSyntax — Level 1. Returns { ok, value, error }. */
function w16ValidateJsonSyntax(text) {
  try {
    const cleaned = String(text).trim()
      .replace(/^```json\s*/i, '')
      .replace(/```\s*$/, '')
      .trim();
    const value = JSON.parse(cleaned);
    return { ok: true, value: value, error: null };
  } catch (e) {
    return { ok: false, value: null, error: e.message };
  }
}

/**
 * w16ValidateSchemaVersion — Level 2 gate. Blocks unsupported schema
 * versions outright rather than attempting a best-effort mapping, since a
 * silent mis-mapping is worse than a blocked import.
 */
function w16ValidateSchemaVersion(payload) {
  const supported = W16_CONFIG.validation.SCHEMA_VERSION_SUPPORTED;
  const version = payload && payload.meta && payload.meta.schemaVersion;
  if (supported.indexOf(version) === -1) {
    return {
      ok: false,
      reason: 'UNSUPPORTED_SCHEMA_VERSION',
      message: 'Schema version "' + (version || 'unknown') + '" is not supported (expects ' + supported.join('/') + ').'
    };
  }
  return { ok: true };
}

/**
 * w16ValidateRequiredFields — Level 2 shape check for a single record
 * against a list of required field names. Returns an array of missing
 * field names (empty = valid).
 */
function w16ValidateRequiredFields(record, requiredFields) {
  const missing = [];
  requiredFields.forEach(function (f) {
    if (record[f] === undefined || record[f] === null || record[f] === '') missing.push(f);
  });
  return missing;
}

/**
 * w16ValidateArrayBounds — Level 2 safety check: refuses to process
 * absurdly large arrays that likely indicate a malformed or malicious
 * payload rather than real project data.
 */
function w16ValidateArrayBounds(arr, label) {
  const max = W16_CONFIG.validation.MAX_ARRAY_RECORDS;
  if (Array.isArray(arr) && arr.length > max) {
    throw w16CreateError(
      'VALIDATION_ERROR',
      label + ' contains too many records to process safely.',
      label + ' length ' + arr.length + ' exceeds MAX_ARRAY_RECORDS (' + max + ').',
      false
    );
  }
  return true;
}

/**
 * w16ValidateDateLogic — Level 3 semantic check shared by schedule-shaped
 * records regardless of ingestion path (xlsx importer, Vex JSON, manual
 * edit). Mirrors the app's existing checkDateLogicIssues() so both W16 and
 * the frontend enforce the same rule.
 */
function w16ValidateDateLogic(plannedStart, plannedFinish, revisedStart, revisedFinish) {
  const issues = [];
  const ps = plannedStart ? new Date(plannedStart) : null;
  const rs = revisedStart ? new Date(revisedStart) : null;
  const rf = revisedFinish ? new Date(revisedFinish) : null;

  if (rs && rf && rf < rs) {
    issues.push('Revised Finish is earlier than Revised Start in the same row — internally contradictory dates.');
  }
  if (rf && ps && rf < ps) {
    issues.push('Revised Finish is earlier than the original Planned Start — likely a column mix-up or bad revision entry.');
  }
  return issues;
}

/**
 * w16ValidateNumberRange — Level 3 semantic bound check with a category
 * label so callers can decide whether an out-of-range value is a hard
 * CONFIRMED_ERROR or a soft UNUSUAL flag.
 */
function w16ValidateNumberRange(value, min, max) {
  const n = Number(value);
  if (isNaN(n)) return { valid: false, reason: 'NOT_A_NUMBER' };
  if (min !== null && n < min) return { valid: false, reason: 'BELOW_MIN' };
  if (max !== null && n > max) return { valid: false, reason: 'ABOVE_MAX' };
  return { valid: true };
}

/**
 * w16RunCrossRecordValidation — Level 3 checks that require seeing more
 * than one record at a time (duplicate IDs, orphaned references, etc.).
 * Returns a flat list of { category, message, ref } findings, matching the
 * structuralFindings shape used elsewhere in ARTIFIELD/Vex.
 */
function w16RunCrossRecordValidation(records, idField) {
  const findings = [];
  const seenIds = {};
  (records || []).forEach(function (rec, idx) {
    const id = rec[idField];
    if (id != null) {
      if (seenIds[id]) {
        findings.push({
          category: 'DISCREPANCY',
          message: 'Duplicate identifier "' + id + '" detected across records.',
          ref: 'record index ' + idx
        });
      }
      seenIds[id] = true;
    }
  });
  return findings;
}

/**
 * w16ValidatePayloadPipeline — orchestrates all three levels for a full
 * import-shaped payload (tasks/costEntries/materialEntries/etc.), and
 * returns a structured result the caller can inspect before committing.
 */
function w16ValidatePayloadPipeline(rawText) {
  const syntaxResult = w16ValidateJsonSyntax(rawText);
  if (!syntaxResult.ok) {
    return { ok: false, level: 'SYNTAX', reason: syntaxResult.error };
  }

  const payload = syntaxResult.value;
  if (!payload || typeof payload !== 'object') {
    return { ok: false, level: 'SCHEMA', reason: 'Payload is not an object.' };
  }

  const schemaCheck = w16ValidateSchemaVersion(payload);
  if (!schemaCheck.ok) {
    return { ok: false, level: 'SCHEMA', reason: schemaCheck.message };
  }

  const arraysToCheck = ['tasks', 'costEntries', 'materialEntries', 'quantityTakedowns',
    'violations', 'forecastNotes', 'variationOrders', 'rfis'];
  arraysToCheck.forEach(function (key) {
    if (Array.isArray(payload[key])) w16ValidateArrayBounds(payload[key], key);
  });

  return { ok: true, payload: payload };
}

/**
 * ============================================================
 * W16_Data.gs
 * ARTIFIELD / W16 ENGINE — DATA ACCESS CORE
 * Version: 1.0.0
 * ------------------------------------------------------------
 * Single controlled gateway between W16 modules and physical
 * storage (currently Google Sheets). No other core should call
 * SpreadsheetApp directly — everything routes through here so a
 * future migration to a real database only requires changing
 * this file's internals, not every caller.
 * ============================================================
 */

/** w16GetSpreadsheet_ — resolves the active project spreadsheet. */
function w16GetSpreadsheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss) {
    throw w16CreateError('STORAGE_ERROR', 'Could not access project storage.', 'getActiveSpreadsheet() returned null.', true);
  }
  return ss;
}

/** w16GetOrCreateSheet — idempotent sheet accessor with header enforcement. */
function w16GetOrCreateSheet(name, headers) {
  const ss = w16GetSpreadsheet_();
  let sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
    if (headers && headers.length) {
      sh.appendRow(headers);
      sh.setFrozenRows(1);
    }
  }
  return sh;
}

/** w16ReadSheetAsObjects — generic sheet -> array-of-objects reader. */
function w16ReadSheetAsObjects(sheetName) {
  const sh = w16GetSpreadsheet_().getSheetByName(sheetName);
  if (!sh) return [];
  const data = sh.getDataRange().getValues();
  if (data.length < 2) return [];
  const headers = data.shift();
  return data.map(function (row) {
    const obj = {};
    headers.forEach(function (h, i) { obj[h] = row[i]; });
    return obj;
  });
}

/** w16AppendRow — safe append with basic retry on transient failures. */
function w16AppendRow(sheetName, rowValues) {
  return w16WithRetry(function () {
    const sh = w16GetSpreadsheet_().getSheetByName(sheetName);
    if (!sh) {
      throw w16CreateError('STORAGE_ERROR', 'Storage table not found.', 'Sheet "' + sheetName + '" does not exist.', false);
    }
    sh.appendRow(rowValues);
    return true;
  }, W16_CONFIG.retry.MAX_ATTEMPTS);
}

/** w16NextId — collision-resistant sequential ID generator with a prefix,
 *  scanning the existing ID column for the current max suffix. */
function w16NextId(prefix, sheetName, idColIndex1Based) {
  const sh = w16GetSpreadsheet_().getSheetByName(sheetName);
  if (!sh) return prefix + '-0001';
  const last = sh.getLastRow();
  let max = 0;
  if (last > 1) {
    const vals = sh.getRange(2, idColIndex1Based, last - 1, 1).getValues().flat();
    vals.forEach(function (v) {
      const m = String(v).match(/-(\d+)$/);
      if (m) max = Math.max(max, parseInt(m[1], 10));
    });
  }
  return prefix + '-' + String(max + 1).padStart(4, '0');
}

/**
 * w16WithRetry — generic retry wrapper for transient storage/network
 * failures. Never retries operations flagged non-idempotent by the caller
 * (pass isIdempotent=false to disable retries entirely).
 */
function w16WithRetry(fn, maxAttempts, isIdempotent) {
  if (isIdempotent === false) return fn();
  const attempts = maxAttempts || W16_CONFIG.retry.MAX_ATTEMPTS;
  let lastError = null;
  for (let attempt = 1; attempt <= attempts; attempt++) {
    try {
      return fn();
    } catch (e) {
      lastError = e;
      const delay = Math.min(
        W16_CONFIG.retry.BASE_DELAY_MS * Math.pow(2, attempt - 1),
        W16_CONFIG.retry.MAX_DELAY_MS
      );
      if (attempt < attempts) Utilities.sleep(delay);
    }
  }
  throw w16CreateError('STORAGE_ERROR', 'Could not complete the storage operation.', 'All ' + attempts + ' retry attempts failed: ' + (lastError && lastError.message), true);
}

/**
 * w16ScopedQuery — filters an array of records to only those belonging to
 * the given clientId/projectId, enforcing multi-tenant isolation at the
 * data layer rather than trusting every caller to filter correctly.
 */
function w16ScopedQuery(records, clientId, projectId) {
  return (records || []).filter(function (r) {
    if (clientId && r.client_id && r.client_id !== clientId) return false;
    if (projectId && r.project_id && r.project_id !== projectId) return false;
    return true;
  });
}

/**
 * w16Transaction — staged commit helper. Runs `stageFn` to produce a
 * pending payload, `validateFn` to check it, and only if both succeed
 * calls `commitFn` to actually persist. Mirrors the INPUT -> PROCESS ->
 * VALIDATE -> PREVIEW -> APPROVE -> COMMIT pipeline for risky operations.
 */
function w16Transaction(stageFn, validateFn, commitFn) {
  const staged = stageFn();
  const validation = validateFn(staged);
  if (!validation || validation.ok !== true) {
    return { committed: false, staged: staged, validation: validation };
  }
  const commitResult = commitFn(staged);
  return { committed: true, staged: staged, validation: validation, result: commitResult };
}

/**
 * ============================================================
 * W16_Calculator.gs
 * ARTIFIELD / W16 ENGINE — DETERMINISTIC COMPUTATION CORE
 * Version: 1.0.0
 * ------------------------------------------------------------
 * Schedule / EVM (cost) / Material engines. These formulas must
 * NEVER be delegated to AI — they are deterministic math over
 * canonical project data. AI may narrate the result; it must not
 * produce the number.
 * ============================================================
 */

const W16_DAY_MS = 86400000;

function w16Clamp_(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

/* ---------------- SCHEDULE ENGINE ---------------- */

/** w16HasValidDates — mirrors the app's hasValidDates() sanity check. */
function w16HasValidDates(task, minDate, maxDate) {
  const s = new Date(task.plannedStart);
  const f = new Date(task.plannedFinish);
  const lo = minDate || new Date('2018-01-01');
  const hi = maxDate || new Date('2033-12-31');
  return s instanceof Date && !isNaN(s) && f instanceof Date && !isNaN(f) &&
    s >= lo && s <= hi && f >= lo && f <= hi && f >= s;
}

/** w16ActiveRange — revised dates take precedence over planned dates. */
function w16ActiveRange(task) {
  const s = task.revisedStart || task.plannedStart;
  const f = task.revisedFinish || task.plannedFinish;
  return [new Date(s), new Date(f)];
}

/** w16PlannedPctAt — time-phased planned completion fraction (0-1) for a
 *  single task at a given date. */
function w16PlannedPctAt(task, date) {
  const [s, f] = w16ActiveRange(task);
  const dur = Math.max(1, (f - s) / W16_DAY_MS);
  const elapsed = w16Clamp_((date - s) / W16_DAY_MS, 0, dur);
  return elapsed / dur;
}

/** w16WeightedPlannedPct — weighted planned % complete across a task list
 *  at a given date (0-100 scale). */
function w16WeightedPlannedPct(tasks, date) {
  let w = 0, sum = 0;
  (tasks || []).forEach(function (t) {
    if (!w16HasValidDates(t) || t.weightPct == null) return;
    w += t.weightPct;
    sum += t.weightPct * w16PlannedPctAt(t, date) * 100;
  });
  return w > 0 ? sum / w : 0;
}

/** w16WeightedActualPct — weighted actual % complete (0-100 scale).
 *  Tasks with no reported accToDatePct count as 0% in the denominator,
 *  matching the app's EVM convention (not excluded from the population). */
function w16WeightedActualPct(tasks) {
  let w = 0, sum = 0;
  (tasks || []).forEach(function (t) {
    if (!w16HasValidDates(t) || t.weightPct == null) return;
    w += t.weightPct;
    if (t.accToDatePct != null) sum += t.weightPct * t.accToDatePct;
  });
  return w > 0 ? sum / w : 0;
}

/**
 * w16ComputeSPI — Schedule Performance Index.
 * PV = time-phased weighted planned value; EV = weighted earned value.
 * Returns { pv, ev, bac, spi }. spi is null when pv is 0 (insufficient
 * schedule-progress data), never a divide-by-zero NaN.
 */
function w16ComputeSPI(tasks, asOfDate) {
  const now = asOfDate || new Date();
  let pv = 0, bac = 0, ev = 0;
  (tasks || []).forEach(function (t) {
    if (!w16HasValidDates(t) || t.weightPct == null) return;
    const [s, f] = w16ActiveRange(t);
    const dur = Math.max(1, (f - s) / W16_DAY_MS);
    const elapsed = w16Clamp_((now - s) / W16_DAY_MS, 0, dur);
    const timeFrac = elapsed / dur;
    bac += t.weightPct;
    pv += t.weightPct * timeFrac;
    if (t.accToDatePct != null) ev += t.weightPct * (t.accToDatePct / 100);
  });
  const spi = pv > 0 ? (ev / pv) : null;
  return { pv: pv, ev: ev, bac: bac, spi: spi };
}

/**
 * w16ComputeSequenceViolations — cross-trade predecessor/successor order
 * check, grouped by building+level, sorted by active start date.
 */
function w16ComputeSequenceViolations(tasks) {
  const violations = [];
  const groups = {};
  (tasks || []).filter(function (t) { return w16HasValidDates(t); }).forEach(function (t) {
    const key = [t.building, t.level || ''].join('||');
    (groups[key] = groups[key] || []).push(t);
  });
  Object.keys(groups).forEach(function (key) {
    const list = groups[key];
    list.sort(function (a, b) { return w16ActiveRange(a)[0] - w16ActiveRange(b)[0]; });
    for (let i = 1; i < list.length; i++) {
      const prev = list[i - 1], cur = list[i];
      if (prev.trade === cur.trade) continue;
      const prevFinish = w16ActiveRange(prev)[1];
      const curStart = w16ActiveRange(cur)[0];
      const gapDays = Math.round((curStart - prevFinish) / W16_DAY_MS);
      if (gapDays < 0) {
        violations.push({
          type: 'sequence',
          severity: Math.abs(gapDays) > 14 ? 'High' : Math.abs(gapDays) > 5 ? 'Medium' : 'Low',
          taskA: prev, taskB: cur, overlapDays: Math.abs(gapDays)
        });
      }
    }
  });
  return violations;
}

/* ---------------- COST / EVM ENGINE ---------------- */

const W16_MIN_RELIABLE_ACTUAL_PCT = 0.05;
const W16_MIN_RELIABLE_CPI = 0.1;

/**
 * w16CostSummary — EVM figures for a set of cost entries + matching
 * schedule tasks for one building/scope. EAC falls back to budget (with
 * eacConfidence:'low') rather than exploding to an unrealistic figure when
 * CPI is unreliable (near-zero CPI with very little schedule progress).
 */
function w16CostSummary(costEntries, scheduleTasks) {
  const budget = (costEntries || []).filter(function (e) { return e.type === 'budget'; })
    .reduce(function (s, e) { return s + (Number(e.amount) || 0); }, 0);
  const actual = (costEntries || []).filter(function (e) { return e.type === 'actual'; })
    .reduce(function (s, e) { return s + (Number(e.amount) || 0); }, 0);
  const committed = (costEntries || []).filter(function (e) { return e.type === 'committed'; })
    .reduce(function (s, e) { return s + (Number(e.amount) || 0); }, 0);

  const actualPct = (scheduleTasks && scheduleTasks.length)
    ? w16WeightedActualPct(scheduleTasks) / 100
    : 0;
  const ev = budget * actualPct;
  const cpi = actual > 0 ? ev / actual : null;

  let eac, eacConfidence = 'normal';
  const cpiReliable = cpi != null && cpi >= W16_MIN_RELIABLE_CPI && actualPct >= W16_MIN_RELIABLE_ACTUAL_PCT;
  if (cpiReliable) {
    eac = actual + (budget - ev) / cpi;
  } else if (budget > 0) {
    eac = budget;
    eacConfidence = (actual > 0 || actualPct > 0) ? 'low' : 'normal';
  } else {
    eac = null;
  }

  const vac = (budget > 0 && eac != null) ? budget - eac : null;

  return {
    budget: budget, actual: actual, committed: committed,
    ev: ev, cpi: cpi, eac: eac, eacConfidence: eacConfidence, vac: vac, actualPct: actualPct
  };
}

/* ---------------- MATERIAL ENGINE ---------------- */

/**
 * w16MaterialRisk — days-of-supply vs lead-time shortage classification.
 * Returns { daysSupply, atRisk, severity }.
 */
function w16MaterialRisk(entry) {
  const weeklyC = Number(entry.weeklyConsumption) || 0;
  const daysSupply = weeklyC > 0 ? (Number(entry.qtyOnHand) || 0) / weeklyC * 7 : null;
  const leadTime = Number(entry.leadTimeDays) || 0;
  const atRisk = daysSupply != null && daysSupply < leadTime;
  const severity = !atRisk ? null : (daysSupply < leadTime * 0.4 ? 'High' : daysSupply < leadTime * 0.75 ? 'Medium' : 'Low');
  return { daysSupply: daysSupply, atRisk: atRisk, severity: severity };
}

/** w16ComputeMaterialWarnings — flags every at-risk item across a full
 *  material entry list, sorted by most urgent first. */
function w16ComputeMaterialWarnings(materialEntries) {
  return (materialEntries || [])
    .map(function (m) { return Object.assign({}, m, w16MaterialRisk(m)); })
    .filter(function (m) { return m.atRisk; })
    .sort(function (a, b) { return (a.daysSupply || 0) - (b.daysSupply || 0); });
}

/**
 * w16ComputeWeightWarnings — flags buildings whose task weights don't sum
 * to ~100% (tolerance ±5), which usually means a weight-column mapping
 * error in the source file.
 */
function w16ComputeWeightWarnings(tasks) {
  const byBuilding = {};
  (tasks || []).forEach(function (t) {
    if (t.weightPct == null) return;
    (byBuilding[t.building] = byBuilding[t.building] || []).push(t);
  });
  const warnings = [];
  Object.keys(byBuilding).forEach(function (b) {
    const list = byBuilding[b];
    const total = list.reduce(function (s, t) { return s + t.weightPct; }, 0);
    if (Math.abs(total - 100) > 5) {
      warnings.push({ building: b, total: total, taskCount: list.length });
    }
  });
  return warnings.sort(function (a, b) { return Math.abs(b.total - 100) - Math.abs(a.total - 100); });
}

/**
 * ============================================================
 * W16_Conflict.gs
 * ARTIFIELD / W16 ENGINE — CONFLICT ENGINE
 * Version: 1.0.0
 * ------------------------------------------------------------
 * Detects duplicates, discrepancies, missing links, locked-task
 * import conflicts, and version conflicts. Severity is always
 * one of: INFO, LOW, MEDIUM, HIGH, CRITICAL.
 * ============================================================
 */

const W16_CONFLICT_SEVERITY = Object.freeze(['INFO', 'LOW', 'MEDIUM', 'HIGH', 'CRITICAL']);

/**
 * w16DetectLockedTaskConflict — mirrors the app's task-locking behavior:
 * if a verified/locked task's incoming import values differ from its
 * current (locked) values, this is logged as a conflict for manual
 * review rather than silently overwritten.
 */
function w16DetectLockedTaskConflict(currentTask, incomingTask) {
  if (!currentTask.locked) return null;
  const fieldsToCompare = ['plannedStart', 'plannedFinish', 'revisedStart', 'revisedFinish', 'weightPct', 'accToDatePct'];
  const wouldChange = fieldsToCompare.some(function (f) { return currentTask[f] !== incomingTask[f]; });
  if (!wouldChange) return null;
  return {
    id: 'LOCKCONF-' + Utilities.getUuid().replace(/-/g, '').substring(0, 12).toUpperCase(),
    taskId: currentTask.id,
    taskName: currentTask.name,
    building: currentTask.building,
    severity: 'MEDIUM',
    current: w16PickFields_(currentTask, fieldsToCompare),
    incoming: w16PickFields_(incomingTask, fieldsToCompare),
    sourceRowRef: incomingTask.sourceRowRef || '',
    detectedAt: new Date().toISOString()
  };
}

function w16PickFields_(obj, fields) {
  const out = {};
  fields.forEach(function (f) { out[f] = obj[f]; });
  return out;
}

/**
 * w16DetectVersionConflict — optimistic-locking check: if the caller's
 * dataVersion does not match the project's current version, the write is
 * rejected rather than silently overwriting a concurrent change.
 */
function w16DetectVersionConflict(projectId, callerDataVersion) {
  const currentVersion = w16GetDataVersion(projectId);
  if (callerDataVersion == null) return null; // caller opted out of version checking
  if (String(callerDataVersion) !== String(currentVersion)) {
    return {
      severity: 'HIGH',
      reason: 'VERSION_MISMATCH',
      callerVersion: callerDataVersion,
      currentVersion: currentVersion
    };
  }
  return null;
}

/**
 * w16DetectDiscrepancy — cross-source figure mismatch (e.g. a cover-sheet
 * total vs. sum of detail rows), matching the DISCREPANCY category used by
 * Vex's structural-integrity classification.
 */
function w16DetectDiscrepancy(statedTotal, computedTotal, tolerance, label) {
  const tol = tolerance != null ? tolerance : 0.01;
  if (statedTotal == null || computedTotal == null) return null;
  const diff = Math.abs(Number(statedTotal) - Number(computedTotal));
  if (diff > tol) {
    return {
      category: 'DISCREPANCY',
      severity: diff > (Number(statedTotal) * 0.1) ? 'HIGH' : 'MEDIUM',
      message: (label || 'Stated total') + ' (' + statedTotal + ') does not match computed sum (' + computedTotal + ').'
    };
  }
  return null;
}

/**
 * w16DetectOrphanReference — flags a record whose linked id (e.g.
 * linkedActivityId on a material entry) doesn't exist in the referenced
 * collection.
 */
function w16DetectOrphanReference(record, refField, validIdSet) {
  const refId = record[refField];
  if (!refId) return null;
  if (!validIdSet.has(refId)) {
    return {
      category: 'DISCREPANCY',
      severity: 'LOW',
      message: 'Reference "' + refField + '=' + refId + '" does not match any known record.'
    };
  }
  return null;
}

/**
 * w16RunConflictScan — orchestrates the common conflict checks over a full
 * task list + optional locked-task incoming batch. Returns a flat findings
 * array with consistent severity levels for the UI to render.
 */
function w16RunConflictScan(tasks) {
  const findings = [];
  w16ComputeSequenceViolations(tasks).forEach(function (v) {
    findings.push({
      category: 'SEQUENCE_VIOLATION',
      severity: v.severity === 'High' ? 'HIGH' : v.severity === 'Medium' ? 'MEDIUM' : 'LOW',
      message: '"' + v.taskB.name + '" starts before "' + v.taskA.name + '" finishes.',
      taskAId: v.taskA.id, taskBId: v.taskB.id
    });
  });
  w16ComputeWeightWarnings(tasks).forEach(function (w) {
    findings.push({
      category: 'WEIGHT_NORMALIZATION',
      severity: 'LOW',
      message: 'Building ' + w.building + ' task weights sum to ' + w.total.toFixed(1) + '% instead of ~100%.'
    });
  });
  return findings;
}

/**
 * ============================================================
 * W16_AI.gs
 * ARTIFIELD / W16 ENGINE — AI ORCHESTRATION & MODEL ROUTING CORE
 * Version: 1.0.0
 * ------------------------------------------------------------
 * Provider-agnostic AI interface. No module should ever call a
 * provider SDK/API directly — everything goes through
 * w16AIRequest(), which selects a model, calls the adapter, and
 * returns a NORMALIZED response regardless of provider.
 *
 * AI output is NEVER trusted as authoritative — every call site
 * must run the result through W16_Validator before using it.
 * ============================================================
 */

/** w16AI_IsRetryableError_ — only 5xx, 429, network/fetch failures, and
 *  empty responses are worth retrying with backoff. A missing API key or
 *  any other 4xx will fail identically on retry — skip straight to the
 *  next provider instead of burning attempts on a guaranteed repeat. */
const W16_AI_RETRYABLE_ERROR_PATTERN_ = /_HTTP_5\d\d|_HTTP_429|_FETCH_FAILED|_EMPTY_RESPONSE/;
function w16AI_IsRetryableError_(errorString) {
  return W16_AI_RETRYABLE_ERROR_PATTERN_.test(String(errorString || ''));
}

/**
 * w16AIRequest — main entry point for any AI call inside W16.
 * task: { intent, riskLevel, contextText, systemPrompt, promptVersion,
 *         preferredProvider, maxOutputTokens, allowStaleFallback }
 * Returns normalized: { ok, text, provider, model, promptVersion,
 *                       usage, error, stale }
 */
function w16AIRequest(task) {
  if (!w16IsFeatureEnabled('AI_ROUTING_ENABLED')) {
    return { ok: false, error: 'AI_ROUTING_DISABLED', text: null };
  }

  w16Assert(task && task.intent, 'AI task requires an intent.');

  const trimmedContext = w16TrimContextForBudget_(task.contextText || '');
  const providerOrder = w16ResolveProviderOrder_(task);
  const cacheParts = ['req', task.intent, w16HashObject_({ c: trimmedContext, sp: task.systemPrompt || '' })];

  let lastError = null;

  for (let i = 0; i < providerOrder.length; i++) {
    const provider = providerOrder[i];
    const maxAttempts = W16_CONFIG.retry.MAX_ATTEMPTS;

    for (let attempt = 1; attempt <= maxAttempts; attempt++) {
      let result;
      try {
        result = w16CallProviderAdapter_(provider, task, trimmedContext);
      } catch (e) {
        result = { ok: false, error: provider + '_THREW: ' + e.message };
      }

      if (result && result.ok) {
        w16Audit('AI_RESPONSE', null, null, {
          provider: provider, intent: task.intent, riskLevel: task.riskLevel, attempt: attempt
        });
        // Cache as last-known-good for THIS exact request shape, so a
        // future total outage has something explicit to fall back to.
        w16CacheSet(W16_CONFIG.cache.NAMESPACES.AI, cacheParts, result, W16_CONFIG.cache.RESULT_TTL_SECONDS * 4);
        return Object.assign({ stale: false }, result);
      }

      lastError = result && result.error;
      const retryable = w16AI_IsRetryableError_(lastError);
      if (!retryable || attempt >= maxAttempts) break; // move to next provider

      const delay = Math.min(
        W16_CONFIG.retry.BASE_DELAY_MS * Math.pow(2, attempt - 1),
        W16_CONFIG.retry.MAX_DELAY_MS
      );
      Utilities.sleep(delay);
    }
  }

  // Full AI fallback hierarchy exhausted. Never fabricate a plausible-
  // looking response here — only two outcomes are allowed:
  // (a) an explicitly-flagged stale result, ONLY if the caller opted in, or
  // (b) an explicit, structured failure.
  if (task.allowStaleFallback) {
    const stale = w16CacheGet(W16_CONFIG.cache.NAMESPACES.AI, cacheParts);
    if (stale) {
      w16Audit('AI_RESPONSE', null, null, {
        provider: stale.provider, intent: task.intent, riskLevel: task.riskLevel, stale: true
      });
      return Object.assign({}, stale, { stale: true, error: 'SERVED_STALE_AFTER_ALL_PROVIDERS_FAILED: ' + lastError });
    }
  }

  return { ok: false, error: 'ALL_PROVIDERS_FAILED: ' + lastError, text: null, stale: false };
}

/** w16ResolveProviderOrder_ — honors an explicit preference, else config default. */
function w16ResolveProviderOrder_(task) {
  const configured = W16_CONFIG.ai.DEFAULT_PROVIDER_ORDER;
  if (task.preferredProvider && configured.indexOf(task.preferredProvider) !== -1) {
    return [task.preferredProvider].concat(configured.filter(function (p) { return p !== task.preferredProvider; }));
  }
  return configured;
}

/**
 * w16TrimContextForBudget_ — hard cap on context size sent to any
 * provider. Prefer trimming least-relevant tail content over sending an
 * oversized context that inflates cost/latency for no accuracy gain.
 */
function w16TrimContextForBudget_(contextText) {
  const max = W16_CONFIG.ai.MAX_CONTEXT_CHARS;
  if (contextText.length <= max) return contextText;
  return contextText.substring(0, max) + '\n\n[...context truncated to fit budget...]';
}

/**
 * w16CallProviderAdapter_ — dispatches to the correct provider adapter.
 * Each adapter must return { ok, text, provider, model, usage, error }.
 * Implementations are stubs here — wire up actual API calls
 * (UrlFetchApp.fetch) per provider in production, keeping API keys in
 * PropertiesService, never in this file or the frontend.
 */
function w16CallProviderAdapter_(provider, task, contextText) {
  switch (provider) {
    case 'GEMINI': return w16AdapterGemini_(task, contextText);
    case 'CLAUDE': return w16AdapterClaude_(task, contextText);
    case 'OPENAI': return w16AdapterOpenAI_(task, contextText);
    default:
      return { ok: false, error: 'UNKNOWN_PROVIDER: ' + provider };
  }
}

function w16AdapterGemini_(task, contextText) {
  const apiKey = PropertiesService.getScriptProperties().getProperty('GEMINI_API_KEY');
  if (!apiKey) return { ok: false, error: 'GEMINI_API_KEY_NOT_CONFIGURED' };

  const model = task.model || 'gemini-2.0-flash';
  const url = 'https://generativelanguage.googleapis.com/v1beta/models/' + model + ':generateContent?key=' + apiKey;

  const body = {
    contents: [{ parts: [{ text: (task.systemPrompt || '') + '\n\n' + contextText }] }],
    generationConfig: { maxOutputTokens: task.maxOutputTokens || W16_CONFIG.ai.MAX_OUTPUT_TOKENS }
  };

  return w16FetchAndNormalize_(url, body, 'GEMINI', model, function (json) {
    const candidate = json.candidates && json.candidates[0];
    const text = candidate && candidate.content && candidate.content.parts && candidate.content.parts[0] && candidate.content.parts[0].text;
    return text || null;
  });
}

function w16AdapterClaude_(task, contextText) {
  const apiKey = PropertiesService.getScriptProperties().getProperty('CLAUDE_API_KEY');
  if (!apiKey) return { ok: false, error: 'CLAUDE_API_KEY_NOT_CONFIGURED' };

  const model = task.model || 'claude-sonnet-4-6';
  const url = 'https://api.anthropic.com/v1/messages';
  const body = {
    model: model,
    max_tokens: task.maxOutputTokens || W16_CONFIG.ai.MAX_OUTPUT_TOKENS,
    system: task.systemPrompt || '',
    messages: [{ role: 'user', content: contextText }]
  };

  return w16FetchAndNormalize_(url, body, 'CLAUDE', model, function (json) {
    const block = json.content && json.content.find(function (b) { return b.type === 'text'; });
    return block ? block.text : null;
  }, { 'x-api-key': apiKey, 'anthropic-version': '2023-06-01' });
}

function w16AdapterOpenAI_(task, contextText) {
  const apiKey = PropertiesService.getScriptProperties().getProperty('OPENAI_API_KEY');
  if (!apiKey) return { ok: false, error: 'OPENAI_API_KEY_NOT_CONFIGURED' };

  const model = task.model || 'gpt-4o-mini';
  const url = 'https://api.openai.com/v1/chat/completions';
  const body = {
    model: model,
    max_tokens: task.maxOutputTokens || W16_CONFIG.ai.MAX_OUTPUT_TOKENS,
    messages: [
      { role: 'system', content: task.systemPrompt || '' },
      { role: 'user', content: contextText }
    ]
  };

  return w16FetchAndNormalize_(url, body, 'OPENAI', model, function (json) {
    const choice = json.choices && json.choices[0];
    return choice && choice.message ? choice.message.content : null;
  }, { 'Authorization': 'Bearer ' + apiKey });
}

/**
 * w16FetchAndNormalize_ — shared UrlFetchApp wrapper: fail-closed on any
 * non-2xx response, never throws raw provider errors to the caller.
 */
function w16FetchAndNormalize_(url, body, provider, model, extractTextFn, extraHeaders) {
  const options = {
    method: 'post',
    contentType: 'application/json',
    payload: JSON.stringify(body),
    muteHttpExceptions: true,
    headers: extraHeaders || {}
  };
  try {
    const response = UrlFetchApp.fetch(url, options);
    const code = response.getResponseCode();
    if (code < 200 || code >= 300) {
      return { ok: false, error: provider + '_HTTP_' + code, provider: provider, model: model };
    }
    const json = JSON.parse(response.getContentText());
    const text = extractTextFn(json);
    if (!text) return { ok: false, error: provider + '_EMPTY_RESPONSE', provider: provider, model: model };
    return { ok: true, text: text, provider: provider, model: model, usage: json.usage || null, error: null };
  } catch (e) {
    return { ok: false, error: provider + '_FETCH_FAILED: ' + e.message, provider: provider, model: model };
  }
}

/**
 * w16ClassifyRisk — assigns a risk level to an AI task so routing/
 * validation can scale scrutiny accordingly. Higher risk => stronger
 * validation, better model, more traceability, and potentially a
 * human-review gate before the result is used.
 */
function w16ClassifyRisk(intent) {
  const highRiskIntents = ['FORECAST', 'FINANCIAL_RECOMMENDATION', 'DESTRUCTIVE_DECISION'];
  const mediumRiskIntents = ['DOCUMENT_EXTRACTION', 'ANALYSIS'];
  if (highRiskIntents.indexOf(intent) !== -1) return 'HIGH';
  if (mediumRiskIntents.indexOf(intent) !== -1) return 'MEDIUM';
  return 'LOW';
}

/**
 * ============================================================
 * W16_Vex.gs
 * ARTIFIELD / W16 ENGINE — VEX INTEGRATION CORE
 * Version: 1.0.0
 * ------------------------------------------------------------
 * Vex is a specialized document-standardization worker, not a
 * database authority. This core owns the pipeline around it:
 *   UPLOAD -> VALIDATE FILE -> AI CALL -> SCHEMA VALIDATE ->
 *   SEMANTIC VALIDATE -> CONFLICT DETECT -> PENDING STATE ->
 *   HUMAN REVIEW -> EXPLICIT COMMIT -> CANONICAL DATA
 * AI never writes directly to canonical data.
 * ============================================================
 */

const W16_VEX_MAX_FILE_BYTES = 20 * 1024 * 1024; // 20MB safety ceiling

/**
 * w16VexRunExtraction — orchestrates a single Vex extraction request.
 * Does NOT commit anything — returns a PENDING result for human review,
 * matching the app's existing confirmVexImport()/discardVexPending() flow.
 */
 function w16VexRunExtraction(base64Data, fileName, mimeType, sourceLabel, systemPrompt, projectId, clientId, onProgress) {
  w16Assert(base64Data, 'A file is required for Vex extraction.');

  const inputCheck = w16ValidateFileInputSecurity(base64Data, fileName, mimeType, W16_VEX_MAX_FILE_BYTES);
  if (!inputCheck.ok) {
    throw w16CreateError('VALIDATION_ERROR', inputCheck.safeMessage, 'Input security check failed: ' + inputCheck.reason, false);
  }

  // If we have a projectId, route through the file storage layer first —
  // this gives us checksum-based dedup (skip re-extraction entirely if
  // this exact file was already processed for this project) plus a
  // durable /raw copy before anything touches the AI provider. Without a
  // projectId (legacy callers), fall back to the old direct-to-AI path.
  w16Assert(projectId, 'projectId is required for Vex extraction — change detection (checksum dedup) cannot run without it, and skipping it silently would mean every upload triggers a full paid extraction.');

  let fileRecord = w16StoreRawFile(base64Data, fileName, mimeType, projectId, clientId);

  if (fileRecord.isDuplicate) {
    const cachedAnalysisId = fileRecord.existingRecord.processedAnalysisId;
    if (cachedAnalysisId) {
      const cached = getAnalysisJsonById(cachedAnalysisId);
      if (cached && cached.success) {
        w16RecordMetric('vex.extraction.skipped_unchanged', 1);
        w16Audit('VEX_RUN', null, { projectId: projectId, clientId: clientId }, {
          phase: 'CHANGE_DETECTION_HIT', fileId: fileRecord.fileId, checksum: fileRecord.checksum,
          reusedAnalysisId: cachedAnalysisId
        });
        return {
          pending: true,
          payload: JSON.parse(cached.json_result),
          fileLabel: sourceLabel + ' — ' + fileName + ' (reused — unchanged since last upload)',
          provider: 'CACHE',
          model: 'checksum-dedup',
          fileId: fileRecord.fileId,
          reused: true
        };
      }
    }
    // Checksum matched a prior file, but that prior file has no usable
    // cached analysis (e.g. it was never actually committed) — proceed
    // with a fresh extraction rather than blocking, keeping the same
    // fileId so the metadata trail stays linked to this upload.
  }

  w16RecordMetric('vex.extraction.ran_' + (fileRecord.isDuplicate ? 'no_cached_result' : 'new_file'), 1);
  if (!fileRecord.isDuplicate) {
    w16MarkFileProcessing(fileRecord.fileId);
  }

  const aiResult = w16AIRequest({
    intent: 'DOCUMENT_EXTRACTION',
    riskLevel: 'MEDIUM',
    systemPrompt: systemPrompt || w16GetVexSystemPrompt_(),
    contextText: w16WrapUntrustedContent(
      '[Attached file: ' + fileName + ', type: ' + mimeType + ', source: ' + sourceLabel + ']',
      sourceLabel
    ),
    preferredProvider: 'GEMINI',
    maxOutputTokens: 8000
  });

  if (!aiResult.ok) {
    if (fileRecord && !fileRecord.isDuplicate) {
      w16MoveFileToFailed(fileRecord.fileId, aiResult.error);
    }
    throw w16CreateError('AI_ERROR', 'Vex could not process this file.', aiResult.error, true);
  }

  if (typeof onProgress === 'function') {
    try { onProgress(W16_JOB_STATUS.VALIDATING); } catch (e) { /* progress reporting must never break extraction */ }
  }

  const validation = w16ValidatePayloadPipelineFull(aiResult.text);
  if (!validation.ok) {
    if (fileRecord && !fileRecord.isDuplicate) {
      w16MoveFileToFailed(fileRecord.fileId, 'Validation failed at level ' + validation.level + ': ' + validation.reason);
    }
    throw w16CreateError(
      'SCHEMA_ERROR',
      'Vex extraction did not produce a valid structured result.',
      'Validation failed at level ' + validation.level + ': ' + validation.reason,
      false
    );
  }

  // Second-order injection check: even after passing schema + semantic
  // validation, the AI OUTPUT itself might contain injection-shaped text
  // that a later Assistant call (reading this data back as context) could
  // be manipulated by. Block on high-severity findings only — advisory
  // findings (medium severity) surface via dataIssues-style review, not a
  // hard reject, since ordinary construction text can occasionally trip a
  // heuristic pattern.
  const securityScan = w16SecurityScanPayload(validation.payload);
  if (!securityScan.ok) {
    if (fileRecord && !fileRecord.isDuplicate) {
      w16MoveFileToFailed(fileRecord.fileId, 'Security scan blocked: ' + securityScan.recommendation);
    }
    throw w16CreateError(
      'VALIDATION_ERROR',
      'Extraction output was blocked by a security check.',
      'w16SecurityScanPayload: ' + JSON.stringify(securityScan.injectionFindings.concat(securityScan.secretFindings)),
      false
    );
  }
  const sensitiveIdFindings = w16ScanForUnredactedIdentifiers(validation.payload);

  // NOTE: fileRecord is moved to /processed only once an analysis_id
  // actually exists — that happens at commit time (w16VexCommitPayload /
  // saveProjectState), not here. This function only returns a PENDING
  // payload for human review; the caller is responsible for calling
  // w16MoveFileToProcessed(fileRecord.fileId, analysisId) after commit.

   return {
    pending: true,
    payload: validation.payload,
    fileLabel: sourceLabel + ' — ' + fileName,
    provider: aiResult.provider,
    model: aiResult.model,
    fileId: fileRecord ? fileRecord.fileId : null,
    securityAdvisory: securityScan.injectionFindings.concat(sensitiveIdFindings)
  };
}

