    REQUEST_ID_PREFIX: 'W16',
    DEFAULT_LOCALE: 'en',
    ALLOWED_SOURCES: Object.freeze([
      'ARTIFIELD_UI', 'ARTIFIELD_ASSISTANT', 'VEX', 'SYSTEM', 'INTERNAL'
    ]),
    ALLOWED_OPERATIONS: Object.freeze([
