  sh.appendRow([id, clientId, projectId||'', key, 'active', plan||'Standard', 1, 1, expiresAt||'', new Date().toISOString()]);
  return { success:true, license_id:id, license_key:key };
}

function changeArtifieldAdminOverrideKey(currentKey, newKey){
  const props = PropertiesService.getScriptProperties();
  const existing = props.getProperty('ARTIFIELD_ADMIN_OVERRIDE') || '';
  if(existing && existing !== currentKey) return { ok:false, reason:'incorrect_current' };
  if(!newKey || newKey.length < 6) return { ok:false, reason:'invalid_new' };
  if(newKey === props.getProperty('ARTIFIELD_PIN')) return { ok:false, reason:'same_as_user_pin' };
  props.setProperty('ARTIFIELD_ADMIN_OVERRIDE', newKey);
  return { ok:true };
}

