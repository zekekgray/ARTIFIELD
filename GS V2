function w16VexSchema_IsPlainObject_(v) {
  return v !== null && typeof v === 'object' && !Array.isArray(v);
}

/** w16VexSchema_ScanControlChars_ — flags stray control characters inside
 *  a string (excluding legitimate \n \t \r) that could indicate a
 *  truncated/corrupted string slipped past JSON.parse. Advisory, not
 *  blocking — JSON.parse already guarantees syntactic validity by the
 *  time this runs. */
function w16VexSchema_ScanControlChars_(str) {
  for (let i = 0; i < str.length; i++) {
    const code = str.charCodeAt(i);
    if (code < 32 && code !== 9 && code !== 10 && code !== 13) return true;
  }
  return false;
}

/**
 * w16VexSchema_ValidateRecord_ — checks one record against its array's
 * schema. Returns { blocking: [...], advisory: [...] }, each entry shaped
 * { field, message }.
 */
function w16VexSchema_ValidateRecord_(record, schema, arrayName, index) {
  const blocking = [];
  const advisory = [];
  const ref = (record && record.sourceRowRef) ? record.sourceRowRef : (arrayName + '[' + index + ']');

  if (!w16VexSchema_IsPlainObject_(record)) {
    blocking.push({ field: null, message: arrayName + '[' + index + '] is not an object.' });
    return { blocking: blocking, advisory: advisory };
  }

  // required fields
  schema.required.forEach(function (field) {
    const value = record[field];
    if (value === undefined || value === null) {
      blocking.push({ field: field, message: arrayName + ' record (' + ref + ') is missing required field "' + field + '".' });
      return;
    }
    if (field === 'sourceRowRef' && String(value).trim() === '') {
      blocking.push({ field: field, message: arrayName + ' record (' + ref + ') has an empty sourceRowRef.' });
    }
  });

  // confidence enum (also covered by enumFields below, kept explicit since
  // it's called out separately in the checklist and must never be absent)
  if (record.confidence !== undefined && record.confidence !== null &&
      W16_VEX_CONFIDENCE_ENUM_.indexOf(record.confidence) === -1) {
    blocking.push({ field: 'confidence', message: arrayName + ' record (' + ref + ') has invalid confidence "' + record.confidence + '".' });
  }

  // date fields
  (schema.dateFields || []).forEach(function (field) {
    const value = record[field];
    if (value === undefined || value === null || value === '') return; // nullable by schema
    if (typeof value !== 'string' || !W16_VEX_ISO_DATE_REGEX_.test(value)) {
      blocking.push({ field: field, message: arrayName + ' record (' + ref + ') has non-ISO-8601 date in "' + field + '": ' + value });
    }
  });

  // number fields
  Object.keys(schema.numberFields || {}).forEach(function (field) {
    const rule = schema.numberFields[field];
    const value = record[field];
    if (value === undefined || value === null) {
      if (!rule.nullable) {
        blocking.push({ field: field, message: arrayName + ' record (' + ref + ') is missing required numeric field "' + field + '".' });
      }
      return;
    }
    if (typeof value !== 'number' || isNaN(value)) {
      blocking.push({ field: field, message: arrayName + ' record (' + ref + ') has non-numeric value in "' + field + '": ' + JSON.stringify(value) });
      return;
    }
    if (rule.min !== null && rule.min !== undefined && value < rule.min) {
      blocking.push({ field: field, message: arrayName + ' record (' + ref + ') "' + field + '" (' + value + ') is below minimum ' + rule.min + '.' });
    }
    if (rule.max !== null && rule.max !== undefined && value > rule.max) {
      blocking.push({ field: field, message: arrayName + ' record (' + ref + ') "' + field + '" (' + value + ') is above maximum ' + rule.max + '.' });
    }
  });

  // enum fields (excluding confidence, already handled above)
  Object.keys(schema.enumFields || {}).forEach(function (field) {
    if (field === 'confidence') return;
    const value = record[field];
    if (value === undefined || value === null || value === '') return;
    const allowed = schema.enumFields[field];
    if (allowed.indexOf(value) === -1) {
      blocking.push({ field: field, message: arrayName + ' record (' + ref + ') has invalid "' + field + '": "' + value + '" (expected one of: ' + allowed.join('|') + ').' });
    }
  });

  // malformed-string scan (advisory only — syntactically valid strings
  // that nonetheless carry stray control characters, worth a human look
  // but not a hard reject)
  Object.keys(record).forEach(function (field) {
    const value = record[field];
    if (typeof value === 'string' && w16VexSchema_ScanControlChars_(value)) {
      advisory.push({ field: field, message: arrayName + ' record (' + ref + ') field "' + field + '" contains a stray control character.' });
    }
  });

  return { blocking: blocking, advisory: advisory };
}

/**
 * w16ValidateVexPayloadDeep — the main entry point. Runs AFTER the
 * shallow w16ValidatePayloadPipeline (syntax + schema version + array
 * bounds) has already passed. Checks everything the shallow pass does
 * not: root required fields, array-type correctness, per-record schema
 * conformance, and recordCounts consistency.
 *
 * Returns { ok, blockingFindings, advisoryFindings }. ok:false means at
 * least one blocking finding exists — the caller should reject the
 * payload rather than commit it.
 */
function w16ValidateVexPayloadDeep(payload) {
  const blocking = [];
  const advisory = [];

  if (!w16VexSchema_IsPlainObject_(payload)) {
    return { ok: false, blockingFindings: [{ field: null, message: 'Payload root is not an object.' }], advisoryFindings: [] };
  }
  if (!w16VexSchema_IsPlainObject_(payload.meta)) {
    blocking.push({ field: 'meta', message: '"meta" is missing or is not an object.' });
  } else {
    if (!payload.meta.documentType || W16_VEX_DOCUMENT_TYPES_.indexOf(payload.meta.documentType) === -1) {
      blocking.push({ field: 'meta.documentType', message: 'meta.documentType is missing or not a recognized value: "' + payload.meta.documentType + '".' });
    }
    if (!w16VexSchema_IsPlainObject_(payload.meta.recordCounts)) {
      blocking.push({ field: 'meta.recordCounts', message: 'meta.recordCounts is missing or is not an object.' });
    }
    if (!payload.meta.overallConfidence || W16_VEX_CONFIDENCE_ENUM_.indexOf(payload.meta.overallConfidence) === -1) {
      blocking.push({ field: 'meta.overallConfidence', message: 'meta.overallConfidence is missing or invalid: "' + payload.meta.overallConfidence + '".' });
    }
    ['blindSpots', 'structuralFindings', 'skippedSections', 'sheetsProcessed'].forEach(function (key) {
      if (payload.meta[key] !== undefined && !Array.isArray(payload.meta[key])) {
        blocking.push({ field: 'meta.' + key, message: 'meta.' + key + ' is present but is not an array.' });
      }
    });
    (payload.meta.structuralFindings || []).forEach(function (finding, idx) {
      if (!finding || !finding.sourceRowRef) {
        blocking.push({ field: 'meta.structuralFindings[' + idx + ']', message: 'structuralFindings entry is missing sourceRowRef.' });
      }
      if (finding && ['CONFIRMED_ERROR', 'DISCREPANCY', 'SUSPICIOUS', 'UNUSUAL'].indexOf(finding.category) === -1) {
        blocking.push({ field: 'meta.structuralFindings[' + idx + ']', message: 'structuralFindings entry has invalid category "' + (finding && finding.category) + '".' });
      }
    });
  }

  // unexpected top-level keys — advisory only, schema may evolve
  Object.keys(payload).forEach(function (key) {
    if (W16_VEX_KNOWN_TOP_LEVEL_KEYS_.indexOf(key) === -1) {
      advisory.push({ field: key, message: 'Unexpected top-level key "' + key + '" not part of the known schema.' });
    }
  });

  // per-array: type correctness, per-record validation, recordCounts match
  W16_VEX_ROOT_ARRAY_NAMES_.forEach(function (arrayName) {
    const arr = payload[arrayName];
    if (arr === undefined) return; // absent array is fine (treated as empty)

    if (!Array.isArray(arr)) {
      blocking.push({ field: arrayName, message: '"' + arrayName + '" is present but is not an array.' });
      return;
    }

    const schema = W16_VEX_ARRAY_SCHEMAS_[arrayName];
    arr.forEach(function (record, idx) {
      const result = w16VexSchema_ValidateRecord_(record, schema, arrayName, idx);
      blocking.push.apply(blocking, result.blocking);
      advisory.push.apply(advisory, result.advisory);
    });

    if (payload.meta && w16VexSchema_IsPlainObject_(payload.meta.recordCounts)) {
      const stated = payload.meta.recordCounts[arrayName];
      if (stated !== undefined && Number(stated) !== arr.length) {
        blocking.push({
          field: 'meta.recordCounts.' + arrayName,
          message: 'meta.recordCounts.' + arrayName + ' (' + stated + ') does not match actual array length (' + arr.length + ') — possible truncated output.'
        });
      }
    }
  });

  return { ok: blocking.length === 0, blockingFindings: blocking, advisoryFindings: advisory };
}

/**
 * w16ValidatePayloadPipelineDeep — drop-in replacement for
 * w16ValidatePayloadPipeline at call sites that need the full checklist,
 * not just the shallow syntax/version/bounds pass. Runs the existing
 * shallow pipeline first (unchanged), then layers the deep check on top.
 * Same return shape ({ok, level, reason, payload}) plus an extra
 * `advisoryFindings` field on success, so existing callers reading
 * .ok/.level/.reason/.payload keep working unmodified.
 */
function w16ValidatePayloadPipelineDeep(rawText) {
  const shallow = w16ValidatePayloadPipeline(rawText);
  if (!shallow.ok) return shallow;

  const deep = w16ValidateVexPayloadDeep(shallow.payload);
  if (!deep.ok) {
    return {
      ok: false,
      level: 'SEMANTIC',
      reason: deep.blockingFindings.slice(0, 5).map(function (f) { return f.message; }).join(' | ') +
        (deep.blockingFindings.length > 5 ? ' | (+' + (deep.blockingFindings.length - 5) + ' more)' : '')
    };
  }

  return { ok: true, payload: shallow.payload, advisoryFindings: deep.advisoryFindings };
}

/**
 * ============================================================
 * W16_VexSemanticValidator.gs
 * ARTIFIELD / W16 ENGINE — VEX SEMANTIC VALIDATOR
 * Version: 1.0.0
 * ------------------------------------------------------------
 * Schema validation (W16_VexSchemaValidator.gs) confirms the
 * SHAPE is correct — required fields, types, date format, enum
 * membership. It does NOT confirm the MEANING is correct: a
 * record can be perfectly well-formed and still be logically
 * impossible (finish before start, negative on-hand quantity, a
 * p6ActivityId that references nothing).
 *
 * This layer runs on the raw Vex payload — the same arrays the
 * schema validator saw — and checks cross-field and cross-record
 * logic BEFORE the payload is trusted enough to commit. It is
 * distinct from W16_Rules.gs, which evaluates CANONICAL records
 * (Tasks_Canonical, etc.) AFTER commit, against business policy
 * that can evolve independently of what Vex itself extracted.
 *
 * Findings use the same four-category vocabulary Vex's own
 * prompt uses (CONFIRMED_ERROR / DISCREPANCY / SUSPICIOUS /
 * UNUSUAL) so a human reviewer sees one consistent taxonomy
 * whether a finding came from Vex itself or from this layer.
 * ============================================================
 */

/**
 * w16Semantic_ParseDate_ — parses an ISO date string (already validated by
 * the schema layer) into a comparable timestamp, or null if absent.
 */
function w16Semantic_ParseDate_(value) {
  if (!value) return null;
  const t = new Date(value).getTime();
  return isNaN(t) ? null : t;
}

/**
 * w16Semantic_CheckDateOrder_ — finish >= start, for both the planned pair
 * and the revised pair independently. A record can legitimately have only
 * one pair filled in — only compares pairs where BOTH ends are present.
 */
function w16Semantic_CheckDateOrder_(record, ref) {
  const findings = [];
  const ps = w16Semantic_ParseDate_(record.plannedStart);
  const pf = w16Semantic_ParseDate_(record.plannedFinish);
  const rs = w16Semantic_ParseDate_(record.revisedStart);
  const rf = w16Semantic_ParseDate_(record.revisedFinish);

  if (ps !== null && pf !== null && pf < ps) {
    findings.push({
      category: 'CONFIRMED_ERROR', arrayName: 'tasks', sourceRowRef: ref,
      message: 'plannedFinish (' + record.plannedFinish + ') is earlier than plannedStart (' + record.plannedStart + ').'
    });
  }
  if (rs !== null && rf !== null && rf < rs) {
    findings.push({
      category: 'CONFIRMED_ERROR', arrayName: 'tasks', sourceRowRef: ref,
      message: 'revisedFinish (' + record.revisedFinish + ') is earlier than revisedStart (' + record.revisedStart + ').'
    });
  }
  // A revised finish earlier than the ORIGINAL planned start usually means
  // a column mix-up rather than a genuine schedule pull-in — worth a
  // CONFIRMED_ERROR too, matching what w16ValidateDateLogic already flags
  // for canonical tasks (kept consistent here at the pre-commit stage).
  if (ps !== null && rf !== null && rf < ps) {
    findings.push({
      category: 'CONFIRMED_ERROR', arrayName: 'tasks', sourceRowRef: ref,
      message: 'revisedFinish (' + record.revisedFinish + ') is earlier than the original plannedStart (' + record.plannedStart + ') — likely a column mix-up.'
    });
  }
  return findings;
}

/**
 * w16Semantic_CheckNonNegative_ — quantity/on-hand fields that must never
 * be negative (unlike cost amounts, which Vex's own schema explicitly
 * allows to be negative for deductions/credits — see Output Schema notes
 * on costEntries.amount).
 */
function w16Semantic_CheckNonNegative_(value, fieldName, arrayName, ref) {
  if (value === undefined || value === null || typeof value !== 'number') return null;
  if (value < 0) {
    return {
      category: 'CONFIRMED_ERROR', arrayName: arrayName, sourceRowRef: ref,
      message: '"' + fieldName + '" is negative (' + value + ') — this field should never be below zero.'
    };
  }
  return null;
}

/**
 * w16Semantic_CheckCostSign_ — costEntries.amount MAY legitimately be
 * negative (deductions/credits/reversals), but a negative amount without
 * any indication it's intentional is worth a soft flag, not a hard
 * reject — mirrors Vex's own UNUSUAL category philosophy.
 */
function w16Semantic_CheckCostSign_(record, ref) {
  if (typeof record.amount !== 'number' || record.amount >= 0) return null;
  const looksIntentional = /credit|deduction|refund|reversal|adjustment/i.test(
    (record.note || '') + ' ' + (record.category || '')
  );
  if (looksIntentional) return null;
  return {
    category: 'UNUSUAL', arrayName: 'costEntries', sourceRowRef: ref,
    message: 'Negative cost amount (' + record.amount + ') with no note/category indicating a credit or deduction — confirm this is intentional.'
  };
}

/**
 * w16Semantic_CheckDuplicateSourceRowRef_ — Vex's own Output Rule 5 says a
 * duplicate physical row should still be emitted, with a dataIssues note
 * on the second occurrence. This check verifies that note actually
 * exists whenever the same sourceRowRef appears more than once within an
 * array — if Vex flagged it, fine; if not, this layer flags it instead.
 */
function w16Semantic_CheckDuplicateSourceRowRefs_(records, arrayName) {
  const findings = [];
  const seen = {};
  records.forEach(function (record, idx) {
    const ref = record && record.sourceRowRef;
    if (!ref) return;
    if (!seen[ref]) { seen[ref] = []; }
    seen[ref].push(idx);
  });
  Object.keys(seen).forEach(function (ref) {
    const indices = seen[ref];
    if (indices.length < 2) return;
    const flaggedAlready = indices.some(function (idx) {
      const issues = records[idx].dataIssues;
      return Array.isArray(issues) && issues.some(function (i) { return /duplicate/i.test(String(i)); });
    });
    if (!flaggedAlready) {
      findings.push({
        category: 'DISCREPANCY', arrayName: arrayName, sourceRowRef: ref,
        message: 'sourceRowRef "' + ref + '" appears ' + indices.length + ' times in ' + arrayName + ' without a duplicate-row dataIssues note on any occurrence.'
      });
    }
  });
  return findings;
}

/**
 * w16Semantic_CheckActivityIdConsistency_ — any record outside `tasks`
 * that references a p6ActivityId should point to an id that actually
 * exists somewhere in the tasks array. An orphan reference usually means
 * a typo or a mis-linked row, not a real cross-reference.
 */
function w16Semantic_CheckActivityIdConsistency_(payload) {
  const findings = [];
  const knownTaskIds = {};
  (payload.tasks || []).forEach(function (t) {
    if (t && t.p6ActivityId) knownTaskIds[t.p6ActivityId] = true;
  });
  if (!Object.keys(knownTaskIds).length) return findings; // no tasks with ids at all — nothing to cross-check against

  ['costEntries', 'quantityTakedowns', 'violations', 'variationOrders', 'rfis'].forEach(function (arrayName) {
    (payload[arrayName] || []).forEach(function (record) {
      const refId = record && record.p6ActivityId;
      if (!refId) return;
      if (!knownTaskIds[refId]) {
        findings.push({
          category: 'DISCREPANCY', arrayName: arrayName, sourceRowRef: record.sourceRowRef || '',
          message: 'p6ActivityId "' + refId + '" does not match any task in this extraction — possible typo or orphaned reference.'
        });
      }
    });
  });
  return findings;
}

/**
 * w16Semantic_CheckUnitConsistency_ — flags when the SAME item (by name,
 * case-insensitive) is recorded with different units within materialEntries
 * or quantityTakedowns for the same building — a likely sign of a unit
 * mix-up (e.g. "Cement" tracked in both "bags" and "kg" in one building).
 */
function w16Semantic_CheckUnitConsistency_(records, arrayName, itemField) {
  const findings = [];
  const byBuildingItem = {};
  (records || []).forEach(function (r) {
    if (!r || !r[itemField] || !r.unit) return;
    const key = (r.building || '') + '||' + String(r[itemField]).trim().toLowerCase();
    (byBuildingItem[key] = byBuildingItem[key] || []).push(r);
  });
  Object.keys(byBuildingItem).forEach(function (key) {
    const group = byBuildingItem[key];
    const units = {};
    group.forEach(function (r) { units[r.unit] = true; });
    if (Object.keys(units).length > 1) {
      findings.push({
        category: 'UNUSUAL', arrayName: arrayName, sourceRowRef: group[0].sourceRowRef || '',
        message: 'Item "' + group[0][itemField] + '" (building ' + (group[0].building || '—') + ') appears with mixed units: ' + Object.keys(units).join(', ') + '.'
      });
    }
  });
  return findings;
}

/**
 * w16Semantic_CheckCurrencyConsistency_ — same idea as unit consistency,
 * but for costEntries.currency within one building. Not blocking — Vex's
 * own Output Rule 13 already permits mixed currencies when the source
 * genuinely states them, this just surfaces it for review.
 */
function w16Semantic_CheckCurrencyConsistency_(costEntries) {
  const findings = [];
  const byBuilding = {};
  (costEntries || []).forEach(function (e) {
    if (!e || !e.building) return;
    (byBuilding[e.building] = byBuilding[e.building] || []).push(e);
  });
  Object.keys(byBuilding).forEach(function (building) {
    const currencies = {};
    byBuilding[building].forEach(function (e) { currencies[e.currency || 'PHP'] = true; });
    if (Object.keys(currencies).length > 1) {
      findings.push({
        category: 'UNUSUAL', arrayName: 'costEntries', sourceRowRef: byBuilding[building][0].sourceRowRef || '',
        message: 'Building ' + building + ' has cost entries in mixed currencies: ' + Object.keys(currencies).join(', ') + '.'
      });
    }
  });
  return findings;
}

/**
 * w16ValidateVexPayloadSemantic — the main entry point. Assumes the
 * payload already PASSED schema validation (arrays exist, fields are the
 * right type) — this layer focuses purely on cross-field/cross-record
 * logic. Returns { ok, blockingFindings, advisoryFindings }, same shape
 * as the schema validator for a consistent call pattern.
 */
function w16ValidateVexPayloadSemantic(payload) {
  const blocking = [];
  const advisory = [];

  (payload.tasks || []).forEach(function (t) {
    const ref = t.sourceRowRef || '';
    w16Semantic_CheckDateOrder_(t, ref).forEach(function (f) { blocking.push(f); });
    const weightIssue = w16Semantic_CheckNonNegative_(t.weightPct, 'weightPct', 'tasks', ref);
    if (weightIssue) blocking.push(weightIssue);
    const accIssue = w16Semantic_CheckNonNegative_(t.accToDatePct, 'accToDatePct', 'tasks', ref);
    if (accIssue) blocking.push(accIssue);
  });

  (payload.costEntries || []).forEach(function (e) {
    const ref = e.sourceRowRef || '';
    const signIssue = w16Semantic_CheckCostSign_(e, ref);
    if (signIssue) advisory.push(signIssue);
  });

  (payload.materialEntries || []).forEach(function (m) {
    const ref = m.sourceRowRef || '';
    const qtyIssue = w16Semantic_CheckNonNegative_(m.qtyOnHand, 'qtyOnHand', 'materialEntries', ref);
    if (qtyIssue) blocking.push(qtyIssue);
    const consIssue = w16Semantic_CheckNonNegative_(m.weeklyConsumption, 'weeklyConsumption', 'materialEntries', ref);
    if (consIssue) blocking.push(consIssue);
  });

  (payload.quantityTakedowns || []).forEach(function (q) {
    const ref = q.sourceRowRef || '';
    const qtyIssue = w16Semantic_CheckNonNegative_(q.quantity, 'quantity', 'quantityTakedowns', ref);
    if (qtyIssue) blocking.push(qtyIssue);
  });

  (payload.variationOrders || []).forEach(function (v) {
    // amountDelta may be null (unstated) or negative (a deduction) by
    // design — only a non-numeric NaN-producing value would be wrong,
    // and that's already caught at the schema layer. Nothing to add here
    // beyond what schema validation covers.
  });

  W16_VEX_ROOT_ARRAY_NAMES_.forEach(function (arrayName) {
    if (Array.isArray(payload[arrayName])) {
      w16Semantic_CheckDuplicateSourceRowRefs_(payload[arrayName], arrayName).forEach(function (f) { advisory.push(f); });
    }
  });

  w16Semantic_CheckActivityIdConsistency_(payload).forEach(function (f) { advisory.push(f); });
  w16Semantic_CheckUnitConsistency_(payload.materialEntries, 'materialEntries', 'item').forEach(function (f) { advisory.push(f); });
  w16Semantic_CheckUnitConsistency_(payload.quantityTakedowns, 'quantityTakedowns', 'item').forEach(function (f) { advisory.push(f); });
  w16Semantic_CheckCurrencyConsistency_(payload.costEntries).forEach(function (f) { advisory.push(f); });

  return { ok: blocking.length === 0, blockingFindings: blocking, advisoryFindings: advisory };
}

/**
 * w16ValidatePayloadPipelineFull — chains ALL THREE layers: shallow
 * (syntax/version/bounds) -> deep schema (shape/types/enums/dates) ->
 * semantic (cross-field/cross-record logic). This is the pipeline
 * w16VexRunExtraction should call — it is the complete "AI output ≠
 * trusted output" gate before anything reaches human review or commit.
 */
function w16ValidatePayloadPipelineFull(rawText) {
  const schemaResult = w16ValidatePayloadPipelineDeep(rawText);
  if (!schemaResult.ok) return schemaResult;

  const semanticResult = w16ValidateVexPayloadSemantic(schemaResult.payload);
  if (!semanticResult.ok) {
    return {
      ok: false,
      level: 'SEMANTIC',
      reason: semanticResult.blockingFindings.slice(0, 5).map(function (f) { return f.message; }).join(' | ') +
        (semanticResult.blockingFindings.length > 5 ? ' | (+' + (semanticResult.blockingFindings.length - 5) + ' more)' : '')
    };
  }

  return {
    ok: true,
    payload: schemaResult.payload,
    advisoryFindings: (schemaResult.advisoryFindings || []).concat(semanticResult.advisoryFindings)
  };
}

/**
 * ============================================================
 * W16_VexInputSecurity.gs
 * ARTIFIELD / W16 ENGINE — VEX INPUT SECURITY CORE
 * Version: 1.0.0
 * ------------------------------------------------------------
 * Untrusted documents enter here. Bago pa man makarating sa
 * checksum/storage/AI, dumadaan muna dito ang bawat upload:
 *   size limit -> decodability -> extension allowlist ->
 *   MIME allowlist -> extension/MIME agreement ->
 *   magic-byte signature check (reject known executables even
 *   kung nagpapanggap ang extension/MIME).
 *
 * Ito ang unang harang. Hindi ito antivirus — walang Apps
 * Script primitive para doon — pero sinasara nito ang
 * pinaka-madaling paraan ng pag-abuso: maling laki, sirang
 * base64, hindi tugmang extension/MIME, at disguised na
 * executable file.
 * ============================================================
 */

/** Bawat extension -> tanggap na MIME types. Hindi nangangahulugang
 *  "ligtas" ang lahat ng dito — ito lang ang mga uri ng file na
 *  inaasahan talaga ng ARTIFIELD/Vex pipeline (construction docs). */
const W16_FILE_EXT_MIME_MAP_ = Object.freeze({
  '.xlsx': ['application/vnd.openxmlformats-officedocument.spreadsheetml.sheet', 'application/zip'],
  '.xls': ['application/vnd.ms-excel'],
  '.csv': ['text/csv', 'text/plain', 'application/vnd.ms-excel'],
  '.pdf': ['application/pdf'],
  '.docx': ['application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'application/zip'],
  '.doc': ['application/msword'],
  '.txt': ['text/plain'],
  '.png': ['image/png'],
  '.jpg': ['image/jpeg'],
  '.jpeg': ['image/jpeg']
});

/** Magic-byte signatures na kailanman hindi dapat pumasok bilang project
 *  document, kahit ano pa ang sinasabing extension/MIME nito. Ang
 *  pag-check dito ang tumatakip sa "disguised executable" na attack —
 *  hal. isang .exe na pinalitan lang ng pangalan bilang "Schedule.xlsx". */
const W16_FILE_BLOCKED_SIGNATURES_ = Object.freeze([
  { bytes: [0x4D, 0x5A], label: 'WINDOWS_EXECUTABLE (MZ header)' },
  { bytes: [0x7F, 0x45, 0x4C, 0x46], label: 'LINUX_ELF_EXECUTABLE' },
  { bytes: [0xCA, 0xFE, 0xBA, 0xBE], label: 'MACH_O_EXECUTABLE_OR_JAVA_CLASS' },
  { bytes: [0x25, 0x21, 0x50, 0x53], label: 'POSTSCRIPT_FILE' } // rarely legitimate in this pipeline
]);

function w16FileSecurity_MatchesSignature_(bytes, signature) {
  if (bytes.length < signature.length) return false;
  for (let i = 0; i < signature.length; i++) {
    const b = bytes[i] < 0 ? bytes[i] + 256 : bytes[i];
    if (b !== signature[i]) return false;
  }
  return true;
}

function w16FileSecurity_GetExtension_(fileName) {
  const match = String(fileName || '').match(/(\.[a-z0-9]+)$/i);
  return match ? match[1].toLowerCase() : '';
}

/**
 * w16ValidateFileInputSecurity — the main gate. Returns { ok: true } or
 * { ok: false, reason, safeMessage } — never throws directly, so callers
 * decide whether to wrap it in a w16CreateError with their own context.
 */
function w16ValidateFileInputSecurity(base64Data, fileName, mimeType, maxBytes) {
  if (!base64Data || typeof base64Data !== 'string') {
    return { ok: false, reason: 'EMPTY_FILE', safeMessage: 'No file content was received.' };
  }

  const approxBytes = Math.floor(base64Data.length * 0.75);
  const limit = maxBytes || W16_VEX_MAX_FILE_BYTES;
  if (approxBytes > limit) {
    return { ok: false, reason: 'FILE_TOO_LARGE', safeMessage: 'File exceeds the maximum allowed size.' };
  }

  // Malformed-file handling: base64 decode can throw on truncated/corrupt
  // input — never let that surface as a raw, unhandled exception.
  let bytes;
  try {
    bytes = Utilities.base64Decode(base64Data);
  } catch (e) {
    return { ok: false, reason: 'MALFORMED_BASE64', safeMessage: 'File content could not be decoded — it may be corrupted or truncated.' };
  }
  if (!bytes || bytes.length === 0) {
    return { ok: false, reason: 'EMPTY_DECODED_CONTENT', safeMessage: 'Decoded file content is empty.' };
  }

  const ext = w16FileSecurity_GetExtension_(fileName);
  if (!ext) {
    return { ok: false, reason: 'MISSING_EXTENSION', safeMessage: 'File name has no recognizable extension.' };
  }
  const allowedMimes = W16_FILE_EXT_MIME_MAP_[ext];
  if (!allowedMimes) {
    return { ok: false, reason: 'EXTENSION_NOT_ALLOWED', safeMessage: 'File type "' + ext + '" is not accepted by this pipeline.' };
  }
  if (mimeType && allowedMimes.indexOf(mimeType) === -1) {
    return { ok: false, reason: 'MIME_EXTENSION_MISMATCH', safeMessage: 'Declared file type does not match its extension "' + ext + '".' };
  }

  // Magic-byte check — runs regardless of what extension/MIME claimed,
  // since a disguised executable will lie about both.
  const header = bytes.slice(0, 8);
  const blockedMatch = W16_FILE_BLOCKED_SIGNATURES_.find(function (sig) {
    return w16FileSecurity_MatchesSignature_(header, sig.bytes);
  });
  if (blockedMatch) {
    return { ok: false, reason: 'BLOCKED_SIGNATURE_' + blockedMatch.label, safeMessage: 'File content does not match an accepted document type.' };
  }

  return { ok: true, sizeBytes: approxBytes, extension: ext };
}

/* ---------------- SENSITIVE-IDENTIFIER SAFETY NET ---------------- */

/**
 * Deterministic, PH-specific shapes for common government/financial
 * identifiers. This is NOT a general PII detector (names/addresses are
 * far too ambiguous for a reliable regex) — it exists as a safety net in
 * case Vex's own prompt-level redaction rule (Output Rule 14) misses an
 * identifier that slipped into a field. Findings here are ALWAYS
 * advisory — a human reviewer verifies, this layer never silently edits
 * extracted data.
 */
const W16_SENSITIVE_ID_PATTERNS_ = Object.freeze([
  { pattern: /\b\d{4}-\d{4}-\d{4}\b/, label: 'POSSIBLE_PHILSYS_OR_SSS_FORMAT_ID' },
  { pattern: /\b\d{3}-\d{3}-\d{3}-\d{3}\b/, label: 'POSSIBLE_TIN_FORMAT' },
  { pattern: /\b\d{2}-\d{7}-\d\b/, label: 'POSSIBLE_SSS_NUMBER_FORMAT' }
]);

/**
 * w16ScanForUnredactedIdentifiers — walks every string field in a
 * validated Vex payload and flags anything shaped like a government ID
 * that Vex's own redaction rule should have caught. Reuses the same
 * bounded object-walker pattern as W16_Security.gs.
 */
function w16ScanForUnredactedIdentifiers(payload) {
  const findings = [];
  w16Security_WalkStringsInObject_(payload, function (value, path) {
    if (/\[redacted\]/i.test(value)) return; // already handled correctly upstream
    W16_SENSITIVE_ID_PATTERNS_.forEach(function (entry) {
      if (entry.pattern.test(value)) {
        findings.push({
          category: 'SUSPICIOUS', arrayName: 'cross-file', sourceRowRef: path,
          message: 'Field "' + path + '" contains a value shaped like ' + entry.label + ' — verify this was not supposed to be redacted per extraction rule 14.'
        });
      }
    });
  });
  return findings;
}
