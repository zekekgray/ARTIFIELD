/** ---------- ANALYSES + JSON (the core: one JSON blob per saved state) ---------- */
function nextVersionForDocument_(documentId){
  const all = rowsToObjects_(SS.getSheetByName(SHEETS.analyses));
  const versions = all.filter(a=>a.document_id===documentId).map(a=>Number(a.version)||0);
  return versions.length ? Math.max(...versions)+1 : 1;
}

/** Main save entry point — ARTIFIELD calls this every time it needs to persist
 *  its full in-memory state (tasks, costEntries, materialEntries, etc.) as
 *  ONE JSON blob for a project. documentId is optional — pass '' if this
 *  save isn't tied to a specific uploaded file. */
function saveProjectState(projectId, jsonStateString, documentId, model, promptVersion, meta){
  ensureSheets_();
  meta = meta || {};
  const docId = documentId || '';
  const version = docId ? nextVersionForDocument_(docId) : nextVersionForDocument_(projectId);
  const analysisSh = SS.getSheetByName(SHEETS.analyses);
  const analysisId = nextId_('AN', SHEETS.analyses, 1);
  analysisSh.appendRow([analysisId, docId, projectId, version, 'completed', new Date().toISOString()]);

  const jsonSh = SS.getSheetByName(SHEETS.analysisJson);
  jsonSh.appendRow([
    analysisId, projectId, jsonStateString, model||'ARTIFIELD', promptVersion||'v1', new Date().toISOString(),
    meta.fileId || '', meta.checksum || '', meta.dataVersion || '', meta.schemaVersion || '',
    meta.requestId || '', meta.jobId || ''
  ]);

  logActivity('', projectId, 'save_state', Session.getActiveUser().getEmail()||'');
  return { success:true, analysis_id:analysisId, version:version };
}

/** Returns the MOST RECENT saved state for a project (what ARTIFIELD loads on open) */
function getProjectState(projectId){
  ensureSheets_();
  const analyses = rowsToObjects_(SS.getSheetByName(SHEETS.analyses)).filter(a=>a.project_id===projectId);
  if(!analyses.length) return { success:true, found:false };
  analyses.sort((a,b)=>new Date(b.created_at)-new Date(a.created_at));
  const latest = analyses[0];
  const jsonRows = rowsToObjects_(SS.getSheetByName(SHEETS.analysisJson));
  const match = jsonRows.find(j=>j.analysis_id===latest.analysis_id);
  if(!match) return { success:true, found:false };
  return {
    success:true, found:true, json_result: match.json_result, version: latest.version, created_at: latest.created_at,
    meta: {
      model: match.model || '', prompt_version: match.prompt_version || '',
      file_id: match.file_id || '', checksum: match.checksum || '',
      data_version: match.data_version || '', schema_version: match.schema_version || '',
      request_id: match.request_id || '', job_id: match.job_id || ''
    }
  };
}

/** Full history list (for "Data Snapshots" tab) — metadata only, not full JSON,
