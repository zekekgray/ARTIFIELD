/** ---------- LICENSE ACTIVATION GATE (fail-closed, PropertiesService for lockout) ---------- */
function normalizeLicenseKey_(key){
  return String(key||'').trim().toUpperCase();
}

function verifyLicenseKey(licenseKey){
  ensureSheets_();
  const props = PropertiesService.getScriptProperties();
  const lockUntil = Number(props.getProperty('LICENSE_LOCK_UNTIL')||0);
  if(Date.now() < lockUntil){
    return { ok:false, reason:'locked', retryAfterMs: lockUntil-Date.now(), showTip: true };
  }

  const key = normalizeLicenseKey_(licenseKey);
  if(!key){ return { ok:false, reason:'empty' }; }

  const licenses = rowsToObjects_(SS.getSheetByName(SHEETS.licenses));
  const match = licenses.find(l=>normalizeLicenseKey_(l.license_key)===key);

  // admin override key still works, for support/testing access
  const overrideKey = props.getProperty('ARTIFIELD_ADMIN_OVERRIDE');
  if(overrideKey && key === normalizeLicenseKey_(overrideKey)){
    props.deleteProperty('LICENSE_FAIL_COUNT');
    props.deleteProperty('LICENSE_LOCK_UNTIL');
    return { ok:true, client_id:'ADMIN', client_name:'Admin Override', license_status:'active' };
  }

  if(!match){
    return registerLicenseFail_();
  }
  if(String(match.status).toLowerCase() !== 'active'){
    return { ok:false, reason:'inactive' };
  }
  if(match.expires_at){
    const exp = new Date(match.expires_at);
    if(!isNaN(exp.getTime()) && exp.getTime() < Date.now()){
      return { ok:false, reason:'expired', expiredAt: match.expires_at };
    }
  }

  props.deleteProperty('LICENSE_FAIL_COUNT');
  props.deleteProperty('LICENSE_LOCK_UNTIL');

  const clients = rowsToObjects_(SS.getSheetByName(SHEETS.clients));
  const client = clients.find(c=>c.client_id===match.client_id);

  let projectId = '', projectName = '';
  if(match.project_id){
    const projects = rowsToObjects_(SS.getSheetByName(SHEETS.projects));
    const proj = projects.find(p=>p.project_id===match.project_id);
    if(proj){ projectId = proj.project_id; projectName = proj.project_name; }
  }

  logActivity(match.client_id, projectId, 'license_activated', Session.getActiveUser().getEmail()||'');
  return {
    ok:true,
    client_id: match.client_id,
    client_name: client ? client.client_name : match.client_id,
    client_email: client ? client.email : '',
    project_id: projectId,
    project_name: projectName,
    plan: match.plan || 'Standard',
    expires_at: match.expires_at || '',
    license_key: match.license_key || '',
    license_status: match.status || 'active',
    max_users: match.max_users || '',
    device_limit: match.device_limit || '',
  };
}

function registerLicenseFail_(){
  const props = PropertiesService.getScriptProperties();
  let fails = Number(props.getProperty('LICENSE_FAIL_COUNT')||0) + 1;
  props.setProperty('LICENSE_FAIL_COUNT', String(fails));
  if(fails >= 5){
    const lockMs = Math.min(fails*10000, 24*60*60*1000);
    props.setProperty('LICENSE_LOCK_UNTIL', String(Date.now()+lockMs));
    return { ok:false, reason:'locked', retryAfterMs: lockMs, showTip:true };
  }
  return { ok:false, reason:'not_found', attemptsRemaining: Math.max(0,5-fails) };
}

/** Admin helper: create a license for a client (call manually from the Apps Script editor,
