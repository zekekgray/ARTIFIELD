/**
 * runVexApiExtraction — frontend adapter/glue. Ito ang function na hinihintay
 * ng Index.html (runVexModalExtraction). HINDI ito bagong Vex engine — thin
 * wrapper lang ito sa ibabaw ng w16VexRunExtraction, na siyang may kompletong
 * validation/security pipeline. Diretso itong tumatawag kay w16VexRunExtraction
 * (hindi dumadaan sa w16Gateway/queue) para manatiling SYNCHRONOUS ang
 * google.script.run call na inaasahan ng frontend (single withSuccessHandler,
 * walang polling).
 *
 * Returns: raw JSON STRING (parehong shape na inaasahan ng processVexJsonText
 * sa frontend) — kahit na ang w16VexRunExtraction mismo ay nagbabalik ng
 * OBJECT na may parsed payload; dito na natin ito i-stringify pabalik.
 */
function runVexApiExtraction(base64, fileName, mimeType, sourceLabel, clientId, projectId){
  if(!projectId){
    throw new Error('No project selected — open or create a project before running Vex.');
  }
  try{
    const result = w16VexRunExtraction(
      base64, fileName, mimeType, sourceLabel,
      VEX_PROMPT_V1_2,   // ang totoong engineered prompt, hindi yung generic fallback
      projectId, clientId
    );
    return JSON.stringify(result.payload);
  }catch(err){
    // Huwag i-leak ang internal error message (stack, raw provider error) —
    // gamitin ang safeMessage kung galing ito sa w16CreateError.
    const safeMessage = (err && err.w16 && err.w16.safeMessage) ? err.w16.safeMessage : err.message;
    throw new Error(safeMessage);
  }
}

