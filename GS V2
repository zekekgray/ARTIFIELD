/** Simple installable-style trigger — Apps Script calls this automatically
 *  kapag may na-edit ang user sa spreadsheet (hindi kasama ang edits na
 *  ginawa mismo ng script, kaya safe ito laban sa infinite loop). */
function onEdit(e){
  try{
    if(!e || !e.range) return;
    const sh = e.range.getSheet();
    if(sh.getName() !== SHEETS.clientInput) return;
    const row = e.range.getRow();
    const col = e.range.getColumn();
    if(row===1) return;              // header row
    if(col !== CI_COL.action) return; // ibang column ang na-edit, hindi Action

    const actionVal = String(sh.getRange(row, CI_COL.action).getValue()||'').trim().toUpperCase();
    if(actionVal !== 'CREATE') return;

    processClientInputRow_(sh, row);
  }catch(err){
    // Huwag hayaang mag-crash ang onEdit — isulat na lang ang error sa row
    // kung kaya pa, para makita ng admin sa Sheet mismo.
    try{
      const sh = e.range.getSheet();
      const row = e.range.getRow();
      if(sh.getName()===SHEETS.clientInput && row>1){
        sh.getRange(row, CI_COL.resultStatus).setValue('⚠ Error: '+err.message);
      }
    }catch(e2){ /* wala nang magagawa */ }
  }
}

/** Manual fallback (menu button) — sinasala ang lahat ng rows na
 *  Action=CREATE pero walang Result Status pa, para sa kaso na na-disable
 *  ang onEdit trigger o gustong i-batch process ang maraming rows. */
function processAllPendingClientInputRows(){
  ensureSheets_();
  const sh = SS.getSheetByName(SHEETS.clientInput);
  const lastRow = sh.getLastRow();
  let processed = 0;
  for(let r=2; r<=lastRow; r++){
    const action = String(sh.getRange(r, CI_COL.action).getValue()||'').trim().toUpperCase();
    const result = String(sh.getRange(r, CI_COL.resultStatus).getValue()||'').trim();
    if(action==='CREATE' && !result){
      processClientInputRow_(sh, r);
      processed++;
    }
  }
  SpreadsheetApp.getUi().alert(processed+' row(s) processed.');
}

function normEmail_(s){ return String(s||'').trim().toLowerCase(); }
function normName_(s){ return String(s||'').trim().toLowerCase(); }

function findClientByEmail_(email){
  const clients = rowsToObjects_(SS.getSheetByName(SHEETS.clients));
  return clients.find(c=>normEmail_(c.email)===normEmail_(email)) || null;
}
function findProjectByNameForClient_(clientId, projectName){
  const projects = rowsToObjects_(SS.getSheetByName(SHEETS.projects));
  return projects.find(p=>p.client_id===clientId && normName_(p.project_name)===normName_(projectName)) || null;
}
function findActiveLicenseForClientProject_(clientId, projectId){
  const licenses = rowsToObjects_(SS.getSheetByName(SHEETS.licenses));
  return licenses.find(l=>
    l.client_id===clientId &&
    (l.project_id||'')===(projectId||'') &&
    String(l.status).toLowerCase()==='active'
  ) || null;
}
function computeExpiryDate_(durationMonths){
  const months = Number(durationMonths)||12;
  const d = new Date();
  d.setMonth(d.getMonth()+months);
  return d;
}

/** CORE "intelligence": validate -> dedupe -> create/reuse -> log.
 *  Ginagamit ito ng DALAWANG entry point: (1) sheet-row flow (Action=CREATE),
 *  at (2) modal form flow. Isang lugar lang ang totoong logic, iwas
 *  duplicate/inconsistent behavior sa pagitan ng dalawa. */
function createClientProjectLicense_(fields){
  const clientName = String(fields.clientName||'').trim();
  const email = String(fields.email||'').trim();
  const company = String(fields.company||'').trim();
  const projectName = String(fields.projectName||'').trim();
  const licenseType = String(fields.licenseType||'').trim() || 'Project';
  const durationMonths = fields.durationMonths || 12;

  // 1. Kumpleto ba ang required fields?
  if(!clientName || !email || !projectName){
    return { ok:false, status:'⚠ Missing required fields', notes:'Client Name, Email, at Project Name ay required.' };
  }

  ensureSheets_();

  // 2. Existing na ba ang client (match by email)?
  let client = findClientByEmail_(email);
  let clientId;
  if(client){
    clientId = client.client_id;
  } else {
    const res = createClient(clientName, email);
    clientId = res.client_id;
  }

  // 3. Existing na ba ang parehong project para sa client na ito?
  let project = findProjectByNameForClient_(clientId, projectName);
  let projectId;
  if(project){
    projectId = project.project_id;
  } else {
    const res = createProject(clientId, projectName, company);
    projectId = res.project_id;
  }

  // 4. May existing ACTIVE license na ba para sa client+project combo na ito?
  const existingLicense = findActiveLicenseForClientProject_(clientId, projectId);
  if(existingLicense){
    return {
      ok:false,
      status:'⚠ LICENSE NOT CREATED — active license already exists',
      client_id: clientId, project_id: projectId,
      license_id: existingLicense.license_id,
      license_key: existingLicense.license_key,
      notes: 'License ID: '+existingLicense.license_id+' · Status: ACTIVE · Expires: '+
        (existingLicense.expires_at ? Utilities.formatDate(new Date(existingLicense.expires_at), Session.getScriptTimeZone(), 'MMMM d, yyyy') : '—'),
    };
  }

  // 5-7. Wala pang active license — gumawa ng bago.
  const expiresAt = computeExpiryDate_(durationMonths);
  const licRes = createLicense(clientId, licenseType, expiresAt.toISOString(), projectId);
  const expiresLabel = Utilities.formatDate(expiresAt, Session.getScriptTimeZone(), 'MMMM d, yyyy');

  logActivity(clientId, projectId, 'license_created_via_admin_input', Session.getActiveUser().getEmail()||'admin');

  return {
    ok:true,
    status:'✅ ACTIVE',
    client_id: clientId, project_id: projectId,
    license_id: licRes.license_id, license_key: licRes.license_key,
    plan: licenseType, expires_at: expiresAt.toISOString(), expires_label: expiresLabel,
    notes: 'Client: '+clientId+' · Project: '+projectId+' · License: '+licRes.license_id+' · Expires: '+expiresLabel,
  };
}

/** Sheet-row wrapper — kinukuha ang fields mula sa cells, tapos itatawag ang
 *  core function, tapos isusulat pabalik ang resulta sa parehong row. */
function processClientInputRow_(sh, row){
  const fields = {
    clientName: sh.getRange(row, CI_COL.clientName).getValue(),
    email: sh.getRange(row, CI_COL.email).getValue(),
    company: sh.getRange(row, CI_COL.company).getValue(),
    projectName: sh.getRange(row, CI_COL.projectName).getValue(),
    licenseType: sh.getRange(row, CI_COL.licenseType).getValue(),
    durationMonths: sh.getRange(row, CI_COL.durationMonths).getValue(),
  };
  const result = createClientProjectLicense_(fields);

  sh.getRange(row, CI_COL.timestamp).setValue(new Date());
  sh.getRange(row, CI_COL.resultStatus).setValue(result.status);
  sh.getRange(row, CI_COL.licenseKey).setValue(result.license_key||'');
  sh.getRange(row, CI_COL.notes).setValue(result.notes||'');
  sh.getRange(row, CI_COL.action).setValue(''); // i-reset para hindi ma-reprocess nang paulit-ulit
}
