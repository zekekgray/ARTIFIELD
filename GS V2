function setVexProviderLink_(propKey, overrideKey, newLink) {
  var props = PropertiesService.getScriptProperties();
  var storedOverride = props.getProperty('ADMIN_OVERRIDE_KEY');
  if (!storedOverride || overrideKey !== storedOverride) {
    return { ok: false, reason: 'incorrect_current' };
  }
  if (!newLink || !/^https?:\/\//i.test(newLink)) {
    return { ok: false, reason: 'invalid_link' };
  }
  props.setProperty(propKey, newLink);
  return { ok: true };
}

/** ============================================================
 *  ARTIFIELD BACKEND — Apps Script + Google Sheets
 *  Schema: Clients -> Projects -> Documents -> Analyses -> Analysis_JSON
 *  ============================================================ */

const SS = SpreadsheetApp.getActiveSpreadsheet();
const SHEETS = {
  clients: 'Clients',
  projects: 'Projects',
  documents: 'Documents',
  analyses: 'Analyses',
  analysisJson: 'Analysis_JSON',
  activityLog: 'Activity_Log',
  licenses: 'Licenses',
  clientInput: 'Client_Input',
};

// 1-indexed columns ng Client_Input sheet — dito i-adjust kung magbabago ang layout
const CI_COL = {
  timestamp:1, clientName:2, email:3, company:4, projectName:5,
  licenseType:6, durationMonths:7, action:8, resultStatus:9, licenseKey:10, notes:11,
};

function getOrCreateSheet_(name, headers){
  let sh = SS.getSheetByName(name);
  if(!sh){
    sh = SS.insertSheet(name);
    sh.appendRow(headers);
    sh.setFrozenRows(1);
  }
  return sh;
}
function ensureSheets_(){
  getOrCreateSheet_(SHEETS.clients, ['client_id','client_name','email','status','created_at']);
  getOrCreateSheet_(SHEETS.projects, ['project_id','client_id','project_name','location','status','created_at']);
  getOrCreateSheet_(SHEETS.documents, ['document_id','project_id','filename','document_type','file_url','uploaded_at']);
  getOrCreateSheet_(SHEETS.analyses, ['analysis_id','document_id','project_id','version','status','created_at']);
  getOrCreateSheet_(SHEETS.analysisJson, ['analysis_id','project_id','json_result','model','prompt_version','created_at','file_id','checksum','data_version','schema_version','request_id','job_id']);
  getOrCreateSheet_(SHEETS.activityLog, ['log_id','client_id','project_id','action','user','timestamp']);
  getOrCreateSheet_(SHEETS.licenses, ['license_id','client_id','project_id','license_key','status','plan','max_users','device_limit','expires_at','created_at']);

  const ciHeaders = ['Timestamp','Client Name','Email','Company','Project Name','License Type','Duration (months)','Action','Result Status','License Key','Notes'];
  const ciSheet = getOrCreateSheet_(SHEETS.clientInput, ciHeaders);
  // Dropdown sa Action column (H) — "" o "CREATE" lang ang options, para hindi
  // mali-type ng admin. 1000 rows ang na-preset, dagdagan mo kung kailangan.
  const actionRule = SpreadsheetApp.newDataValidation()
    .requireValueInList(['', 'CREATE'], true)
    .setAllowInvalid(false)
    .build();
  ciSheet.getRange(2, CI_COL.action, 1000, 1).setDataValidation(actionRule);
  ciSheet.setColumnWidths(1,1,140);
  ciSheet.setColumnWidths(9,1,220);
  ciSheet.setColumnWidths(11,1,260);
}

function nextId_(prefix, sheetName, idCol){
  const sh = SS.getSheetByName(sheetName);
  const last = sh.getLastRow();
  let max = 0;
  if(last>1){
    const vals = sh.getRange(2, idCol, last-1, 1).getValues().flat();
    vals.forEach(v=>{
      const m = String(v).match(/-(\d+)$/);
      if(m) max = Math.max(max, parseInt(m[1],10));
    });
  }
  return prefix+'-'+String(max+1).padStart(4,'0');
}

function rowsToObjects_(sh){
  const data = sh.getDataRange().getValues();
  const headers = data.shift();
  return data.map(row=>{
    const o = {};
    headers.forEach((h,i)=>o[h]=row[i]);
    return o;
  });
}

