/**
 * ---------------- CANONICAL DATA LAYER ----------------
 * Ito na ang totoong "Database" — hindi na si Vex JSON ang binabasa ng
 * Gantt/S-Curve/EVM/Materials/Reports/Assistant, kundi ang mga sheet na
 * ito. Vex JSON -> W16 Validator -> DITO -> lahat ng consumer.
 */
const W16_TASKS_CANONICAL_HEADERS = ['id','client_id','project_id','building','trade','category','subcategory',
  'name','p6ActivityId','level','isMilestone','plannedStart','plannedFinish','revisedStart','revisedFinish',
  'weightPct','accToDatePct','locked','sourceRowRef','confidence','dataVersion','updatedAt'];

const W16_COST_ENTRIES_CANONICAL_HEADERS = ['id','client_id','project_id','building','trade','category',
  'type','amount','currency','date','resourceCode','p6ActivityId','loggedBy','note','sourceRowRef',
  'confidence','dataVersion','updatedAt'];

const W16_MATERIAL_ENTRIES_CANONICAL_HEADERS = ['id','client_id','project_id','building','item','unit',
  'qtyOnHand','weeklyConsumption','leadTimeDays','resourceCode','linkedActivityId','loggedBy',
  'sourceRowRef','confidence','dataVersion','updatedAt'];

/** w16EnsureCanonicalSheets_ — idempotent; safe to call on every commit. */
function w16EnsureCanonicalSheets_() {
  w16GetOrCreateSheet('Tasks_Canonical', W16_TASKS_CANONICAL_HEADERS);
  w16GetOrCreateSheet('Cost_Entries_Canonical', W16_COST_ENTRIES_CANONICAL_HEADERS);
  w16GetOrCreateSheet('Material_Entries_Canonical', W16_MATERIAL_ENTRIES_CANONICAL_HEADERS);
}

/**
 * w16DeriveRecordId_ — Vex records don't carry an "id" field (only
 * sourceRowRef). A stable id must be derivable from fields that DON'T
 * change between re-extractions of an updated file (never from amount/
 * qty/dates/progress) — otherwise every re-import creates duplicate rows
 * instead of updating the same one. sourceRowRef + building is the
 * natural stable key: it points at the same physical source location
 * across revisions.
 */
function w16DeriveRecordId_(arrayName, record, projectId) {
  if (record.id) return record.id;
  const keyBasis = { a: arrayName, p: projectId, s: record.sourceRowRef || '', b: record.building || '' };
  return arrayName + '-' + w16HashObject_(keyBasis);
}

/**
 * w16CanonicalUpsertRecords_ — generic upsert-by-id into a canonical
 * sheet. Reads existing ids once, then updates matching rows in place or
 * appends new ones. This is the single write path every canonical table
 * goes through, so Gantt/S-Curve/EVM/Materials/Reports/Assistant always
 * see one consistent, deduplicated table — never raw Vex output.
 */
function w16CanonicalUpsertRecords_(sheetName, headers, records) {
  const sh = w16GetOrCreateSheet(sheetName, headers);
  const last = sh.getLastRow();
  const idMap = {};
  if (last > 1) {
    const ids = sh.getRange(2, 1, last - 1, 1).getValues();
    for (let i = 0; i < ids.length; i++) {
      if (ids[i][0]) idMap[ids[i][0]] = i + 2;
    }
  }

  let added = 0, updated = 0;
  records.forEach(function (record) {
    const rowValues = headers.map(function (h) {
      const v = record[h];
      return (v === undefined || v === null) ? '' : v;
    });
    const existingRow = idMap[record.id];
    if (existingRow) {
      sh.getRange(existingRow, 1, 1, headers.length).setValues([rowValues]);
      updated++;
    } else {
      sh.appendRow(rowValues);
      idMap[record.id] = sh.getLastRow();
      added++;
    }
  });
  return { added: added, updated: updated };
}

/**
 * ---------------- RECOVERY / SAFE STATE ----------------
 * Bawat project may explicit state: LAST_VALID (derived straight from the
 * authoritative data-version counter — this is what every consumer reads
 * and it NEVER advances mid-commit), PENDING (a tentative version number
 * reserved while a commit is in flight, not yet trusted), and FAILED (the
 * last commit attempt that broke, with its version number and reason).
 *
 * The actual w16BumpDataVersion() call — the thing that makes a new
 * version "official" — happens LAST, only after every canonical write and
 * the Result Store write have succeeded. If anything throws before that
 * point, the counter never advances: w16GetDataVersion() keeps returning
 * the old, still-valid number, and Gantt/S-Curve/EVM/Materials/Reports/
 * Assistant keep reading whatever was last confirmed good.
 */
const W16_PROJECT_STATE_PROP_PREFIX = 'W16_PROJSTATE_';

/** w16PeekNextDataVersion — what the NEXT version number would be, without
 *  persisting it. Used to reserve a PENDING slot before any writes start. */
function w16PeekNextDataVersion(projectId) {
  return String((Number(w16GetDataVersion(projectId)) || 0) + 1);
}

/**
 * w16GetProjectState — the CURRENT / LAST_VALID / PENDING / FAILED picture
 * for a project. lastValid is always derived live from the authoritative
 * counter (never stored separately, so it can never drift out of sync);
 * pending/failed are the only parts actually persisted.
 */
function w16GetProjectState(projectId) {
  const lastValid = w16GetDataVersion(projectId);
  const base = { lastValid: lastValid, pending: null, failed: null, updatedAt: null };
  if (!projectId) return base;
  const raw = PropertiesService.getScriptProperties().getProperty(W16_PROJECT_STATE_PROP_PREFIX + projectId);
  if (!raw) return base;
  try {
    const stored = JSON.parse(raw);
    return Object.assign(base, { pending: stored.pending || null, failed: stored.failed || null, updatedAt: stored.updatedAt || null });
  } catch (e) {
    return base;
  }
}

/** w16SetProjectState_ — persists only the pending/failed fields; lastValid
 *  is never stored here, it's always re-derived from the version counter. */
function w16SetProjectState_(projectId, patch) {
  if (!projectId) return;
  const props = PropertiesService.getScriptProperties();
  const current = w16GetProjectState(projectId);
  const next = {
    pending: patch.pending !== undefined ? patch.pending : current.pending,
    failed: patch.failed !== undefined ? patch.failed : current.failed,
    updatedAt: new Date().toISOString()
  };
  props.setProperty(W16_PROJECT_STATE_PROP_PREFIX + projectId, JSON.stringify(next));
}

/**
 * w16VexCommitPayload — the ONLY function allowed to move a validated Vex
 * payload into canonical data. Requires the caller to have already shown
 * the payload to a human (pending review) and received explicit
 * confirmation — this function does not itself gate on that; the
 * dispatch layer must enforce it.
 *
 * commitMeta: { fileId, jobId, checksum, model, promptVersion, reused } —
 * carried through from the original extraction so the persisted result
 * stays fully reproducible: RAW file (fileId, already in
 * W16_Files_Canonical) + VALIDATED payload (this write) + the exact
 * model/prompt/schema/request that produced it.
 *
 * VERSIONING RULE: reused=true means the source file's checksum matched
 * an already-processed file — nothing was actually re-extracted, so this
 * commit must NOT write a duplicate analysis row, must NOT bump
 * DATA_VERSION, and must NOT re-touch the canonical tables (they already
 * reflect this content from the original commit). Same file hash => same
 * data version, same canonical rows, always.
 *
 * RECOVERY RULE: for a genuine (non-reused) commit, the version bump is
 * deferred until every write succeeds. On any failure mid-commit, the
 * attempted version is recorded under FAILED, LAST_VALID stays exactly
 * where it was, and the error is re-thrown so the caller/job queue still
 * sees this as a failure — existing project data is never left pointing
 * at a half-written version.
 */
function w16VexCommitPayload(payload, fileLabel, context, commitMeta) {
  commitMeta = commitMeta || {};
  const schemaCheck = w16ValidateSchemaVersion(payload);
  if (!schemaCheck.ok) {
    throw w16CreateError('SCHEMA_ERROR', schemaCheck.message, schemaCheck.message, false);
  }

  const results = {
    tasksAdded: 0, tasksChanged: 0, tasksUnchanged: 0,
    costEntries: 0, materialEntries: 0,
    quantityTakedowns: 0, violations: 0, forecastNotes: 0,
    variationOrders: 0, rfis: 0
  };

  if (Array.isArray(payload.quantityTakedowns)) results.quantityTakedowns = payload.quantityTakedowns.length;
  if (Array.isArray(payload.violations)) results.violations = payload.violations.length;
  if (Array.isArray(payload.forecastNotes)) results.forecastNotes = payload.forecastNotes.length;
  if (Array.isArray(payload.variationOrders)) results.variationOrders = payload.variationOrders.length;
  if (Array.isArray(payload.rfis)) results.rfis = payload.rfis.length;
  // NOTE: quantityTakedowns/violations/forecastNotes/variationOrders/rfis
  // are counted only, not yet persisted to a canonical table — no
  // dispatch handler reads them yet either. Same upsert pattern below
  // extends to these once their canonical sheets/consumers exist.

  let analysisId = null;
  const isReused = commitMeta.reused === true;

  if (context && context.projectId) {
    const projectId = context.projectId;
    const clientId = context.clientId || '';

    if (isReused) {
      // Checksum-unchanged file — canonical tables already reflect this
      // content from the original commit. No new Result Store entry, no
      // DATA_VERSION bump, no canonical writes, no state-machine change.
      const fileRecord = commitMeta.fileId ? w16GetFileRecord(commitMeta.fileId) : null;
      analysisId = (fileRecord && fileRecord.processedAnalysisId) || null;
      w16Audit('VEX_RUN', null, context, {
        fileLabel: fileLabel, results: results, analysisId: analysisId,
        commitMeta: commitMeta, phase: 'REUSED_NO_VERSION_BUMP'
      });
    } else {
      const tentativeVersion = w16PeekNextDataVersion(projectId);
      w16SetProjectState_(projectId, { pending: tentativeVersion, failed: null });

      try {
        w16EnsureCanonicalSheets_();
        const stampedAt = new Date().toISOString();

        // ---- Vex JSON -> Canonical Project Model: TASKS ----
        if (Array.isArray(payload.tasks) && payload.tasks.length) {
          const existingTasks = w16ReadSheetAsObjects('Tasks_Canonical');
          const canonicalTasks = payload.tasks.map(function (t) {
            return Object.assign({}, t, {
              id: w16DeriveRecordId_('tasks', t, projectId),
              client_id: clientId, project_id: projectId,
              locked: t.locked === true, dataVersion: tentativeVersion, updatedAt: stampedAt
            });
          });
          const diff = w16DetectChanges(existingTasks, canonicalTasks, 'id',
            ['plannedStart', 'plannedFinish', 'revisedStart', 'revisedFinish', 'weightPct', 'accToDatePct']);
          results.tasksAdded = diff.added.length;
          results.tasksChanged = diff.changed.length;
          results.tasksUnchanged = diff.unchanged.length;
          w16CanonicalUpsertRecords_('Tasks_Canonical', W16_TASKS_CANONICAL_HEADERS, canonicalTasks);
        }

        // ---- Vex JSON -> Canonical Project Model: COST ENTRIES ----
        if (Array.isArray(payload.costEntries) && payload.costEntries.length) {
          const canonicalCost = payload.costEntries.map(function (e) {
            return Object.assign({}, e, {
              id: w16DeriveRecordId_('costEntries', e, projectId),
              client_id: clientId, project_id: projectId,
              dataVersion: tentativeVersion, updatedAt: stampedAt
            });
          });
          const costResult = w16CanonicalUpsertRecords_('Cost_Entries_Canonical', W16_COST_ENTRIES_CANONICAL_HEADERS, canonicalCost);
          results.costEntries = costResult.added + costResult.updated;
        }

        // ---- Vex JSON -> Canonical Project Model: MATERIAL ENTRIES ----
        if (Array.isArray(payload.materialEntries) && payload.materialEntries.length) {
          const canonicalMaterial = payload.materialEntries.map(function (m) {
            return Object.assign({}, m, {
              id: w16DeriveRecordId_('materialEntries', m, projectId),
              client_id: clientId, project_id: projectId,
              dataVersion: tentativeVersion, updatedAt: stampedAt
            });
          });
          const matResult = w16CanonicalUpsertRecords_('Material_Entries_Canonical', W16_MATERIAL_ENTRIES_CANONICAL_HEADERS, canonicalMaterial);
          results.materialEntries = matResult.added + matResult.updated;
        }

        // Result Store — persists the VALIDATED result (full JSON blob) with
        // reproducibility metadata. RAW/SOURCE already lives in
        // W16_Files_Canonical (fileId/checksum); linked here, not duplicated.
        const saveResult = saveProjectState(
          projectId,
          JSON.stringify(payload),
          commitMeta.fileId || '',
          commitMeta.model || (payload.meta && payload.meta.model) || 'ARTIFIELD',
          commitMeta.promptVersion || '',
          {
            fileId: commitMeta.fileId || '',
            checksum: commitMeta.checksum || '',
            dataVersion: tentativeVersion,
            schemaVersion: (payload.meta && payload.meta.schemaVersion) || '',
            requestId: context.requestId || '',
            jobId: commitMeta.jobId || ''
          }
        );
        analysisId = saveResult && saveResult.analysis_id ? saveResult.analysis_id : null;

        // Every write succeeded — NOW it's safe to make this version
        // official. This is the single moment LAST_VALID actually moves.
        w16BumpDataVersion(projectId);
        w16SetProjectState_(projectId, { pending: null, failed: null });

        // Link raw file -> validated result, move it out of /processing.
        // Non-fatal if this fails — the validated result is already saved
        // and the version is already confirmed.
        if (commitMeta.fileId && analysisId) {
          try { w16MoveFileToProcessed(commitMeta.fileId, analysisId); } catch (e) { /* non-fatal */ }
        }

        w16Audit('VEX_RUN', null, context, { fileLabel: fileLabel, results: results, analysisId: analysisId, commitMeta: commitMeta });

      } catch (commitError) {
        // Commit broke partway through. LAST_VALID (the version counter)
        // was never bumped, so it still points at the last good version —
        // existing project data stays intact. Record what failed and why,
        // then let the caller/job queue see this as a real failure.
        w16SetProjectState_(projectId, {
          pending: null,
          failed: { version: tentativeVersion, error: commitError.message, at: new Date().toISOString() }
        });
        w16Audit('VEX_RUN', null, context, {
          fileLabel: fileLabel, phase: 'COMMIT_FAILED', attemptedVersion: tentativeVersion,
          error: commitError.message, commitMeta: commitMeta
        });
        throw commitError;
      }
    }
  }

  return Object.assign({}, results, { analysisId: analysisId, reused: isReused });
}

/**
 * w16VexExtractStructuralFindings — pulls meta.structuralFindings +
 * meta.blindSpots out of a validated Vex payload into the unified
 * conflict/finding shape used elsewhere in W16.
 */
function w16VexExtractStructuralFindings(payload) {
  const findings = (payload.meta && payload.meta.structuralFindings) || [];
  const blindSpots = (payload.meta && payload.meta.blindSpots) || [];
  return {
    findings: findings.map(function (f) {
      return {
        category: f.category, severity: f.category === 'CONFIRMED_ERROR' ? 'HIGH' : 'MEDIUM',
        message: f.message, ref: f.sourceRowRef, arrayName: f.arrayName
      };
    }),
    blindSpots: blindSpots
  };
}

/**
 * ============================================================
 * W16_Audit.gs
 * ARTIFIELD / W16 ENGINE — AUDIT & OBSERVABILITY CORE
 * Version: 1.0.0
 * ------------------------------------------------------------
 * Every important state change/event gets an audit record.
 * Audit writes must never block or fail the primary operation —
 * logging failures are swallowed (and separately logged to
 * console.error) rather than propagated.
 * ============================================================
 */

const W16_AUDIT_SHEET = 'W16_Audit_Log';
const W16_AUDIT_HEADERS = ['event_id', 'timestamp', 'event_type', 'actor', 'client_id',
  'project_id', 'operation', 'request_id', 'details_json'];

/**
 * w16Audit — fire-and-forget audit write. request/context may be null for
 * internal events not tied to a live W16 request.
 */
function w16Audit(eventType, request, context, details) {
  try {
    if (W16_CONFIG.auditEvents.indexOf(eventType) === -1) {
      eventType = 'UNKNOWN_EVENT:' + eventType;
    }
    const sh = w16GetOrCreateSheet(W16_AUDIT_SHEET, W16_AUDIT_HEADERS);
    const actor = (context && context.authorization && context.authorization.actor && context.authorization.actor.id) ||
      (request && request.actor && request.actor.id) || 'unknown';
    sh.appendRow([
      'AUD-' + Utilities.getUuid().replace(/-/g, '').substring(0, 14).toUpperCase(),
      new Date().toISOString(),
      eventType,
      actor,
      (context && context.clientId) || (request && request.clientId) || '',
      (context && context.projectId) || (request && request.projectId) || '',
      (request && request.operation) || '',
      (request && request.requestId) || '',
      w16SafeStringify_(details)
    ]);
    return true;
  } catch (e) {
    console.error('W16 audit write failed: ' + e.message);
    return false;
  }
}

function w16SafeStringify_(obj) {
  try {
    // Redact secret-shaped substrings BEFORE this ever lands in a
    // sheet-based audit row — the audit trail must never become a
    // secondary leak surface for a credential that ended up in a
    // user-supplied field by accident (e.g. a document that happened to
    // contain an API key string).
    const redacted = (typeof w16RedactSecretsDeep === 'function') ? w16RedactSecretsDeep(obj || {}) : (obj || {});
    const s = JSON.stringify(redacted);
    const max = W16_CONFIG.gateway.MAX_STRING_LENGTH;
    return s.length > max ? s.substring(0, max) + '...[truncated]' : s;
  } catch (e) {
    return '"[unserializable]"';
  }
}

/**
 * w16GetAuditTrail — scoped read of audit records for a project, most
 * recent first, capped to a reasonable page size.
 */
function w16GetAuditTrail(projectId, limit) {
  const records = w16ReadSheetAsObjects(W16_AUDIT_SHEET);
  const scoped = records.filter(function (r) { return !projectId || r.project_id === projectId; });
  scoped.sort(function (a, b) { return new Date(b.timestamp) - new Date(a.timestamp); });
  return scoped.slice(0, limit || 200);
}

/* ---------------- OBSERVABILITY METRICS ---------------- */

/**
 * w16RecordMetric — lightweight metric counter using CacheService for
 * short-lived aggregation (e.g. per-minute request counts). For durable
 * historical metrics, pair this with a periodic flush to a Metrics sheet.
 */
function w16RecordMetric(metricName, value) {
  try {
    const cache = CacheService.getScriptCache();
    const minuteKey = Math.floor(Date.now() / 60000);
    const key = 'W16_METRIC_' + metricName + '_' + minuteKey;
    const current = Number(cache.get(key) || 0);
    cache.put(key, String(current + (value || 1)), 120);
  } catch (e) {
    // Metrics must never break the primary flow.
  }
}

/**
 * w16Timer — simple duration-tracking helper for instrumenting any
 * function: const stop = w16Timer('vex.extract'); ...; stop();
 */
function w16Timer(label) {
  const start = Date.now();
  return function stop() {
    const durationMs = Date.now() - start;
    w16RecordMetric('duration.' + label, durationMs);
    return durationMs;
  };
}

/**
 * ============================================================
 * W16_Dispatch.gs
 * ARTIFIELD / W16 ENGINE — MODULE DISPATCH HANDLERS
 * Version: 1.0.0
 * ------------------------------------------------------------
 * Thin per-module routers called by w16DispatchRequest() in
 * W16_Gateway.gs. Each handler further routes on `operation`/
 * `intent` and calls the appropriate deterministic engine, data
 * accessor, or AI orchestration function — it does not contain
 * the actual business logic itself (that lives in the Calculator/
 * Data/Vex/AI cores).
 * ============================================================
 */

/* ---------------- SCHEDULE ---------------- */

function w16DispatchSchedule(request, context) {
  const op = request.operation;
  const payload = request.payload;

  if (op === 'READ') {
    const cacheParts = w16ResultCacheKeyParts(context, 'SCHEDULE_READ', payload);
    const cached = w16CachedCompute(W16_CONFIG.cache.NAMESPACES.RESULT, cacheParts,
      W16_CONFIG.cache.RESULT_TTL_SECONDS, function () {
        const tasks = w16ReadSheetAsObjects('Tasks_Canonical');
        const scoped = w16ScopedQuery(tasks, request.clientId, request.projectId);
        const spi = w16ComputeSPI(scoped, new Date());
        return { tasks: scoped, spi: spi };
      });
    return w16CreateResponse({
      success: true, requestId: request.requestId, correlationId: request.correlationId,
      module: 'SCHEDULE', operation: op, data: cached.value,
      meta: { fromCache: cached.fromCache }
    });
  }

  if (op === 'CALCULATE') {
    const tasks = w16ScopedQuery(w16ReadSheetAsObjects('Tasks_Canonical'), request.clientId, request.projectId);
    const spi = w16ComputeSPI(tasks, new Date());
    const violations = w16ComputeSequenceViolations(tasks);
    const weightWarnings = w16ComputeWeightWarnings(tasks);
    return w16CreateResponse({
      success: true, requestId: request.requestId, correlationId: request.correlationId,
      module: 'SCHEDULE', operation: op,
      data: { spi: spi, sequenceViolations: violations, weightWarnings: weightWarnings }
    });
  }

  if (op === 'VALIDATE') {
    const tasks = Array.isArray(payload.tasks) ? payload.tasks : [];
    const findings = w16RunConflictScan(tasks);
    return w16CreateResponse({
      success: true, requestId: request.requestId, correlationId: request.correlationId,
      module: 'SCHEDULE', operation: op, data: { findings: findings }
    });
  }

  return w16ModuleNotImplemented('SCHEDULE:' + op, request);
}

/* ---------------- COST ---------------- */

function w16DispatchCost(request, context) {
  const op = request.operation;
  const payload = request.payload;

  if (op === 'READ' || op === 'CALCULATE') {
    const costEntries = w16ScopedQuery(w16ReadSheetAsObjects('Cost_Entries_Canonical'), request.clientId, request.projectId);
    const tasks = w16ScopedQuery(w16ReadSheetAsObjects('Tasks_Canonical'), request.clientId, request.projectId);
    const summary = w16CostSummary(costEntries, tasks);
    return w16CreateResponse({
      success: true, requestId: request.requestId, correlationId: request.correlationId,
      module: 'COST', operation: op, data: summary
    });
  }

  if (op === 'CREATE') {
    w16Assert(payload && payload.building && payload.type && payload.amount != null,
      'building, type, and amount are required to create a cost entry.');
    const id = w16NextId('COST', 'Cost_Entries_Canonical', 1);
    w16AppendRow('Cost_Entries_Canonical', [
      id, request.clientId, request.projectId, payload.building, payload.trade || '',
      payload.category || '', payload.type, Number(payload.amount) || 0,
      payload.currency || 'PHP', payload.date || '', new Date().toISOString()
    ]);
    w16BumpDataVersion(request.projectId);
    w16Audit('UPDATE', request, context, { entity: 'Cost_Entries_Canonical', id: id });
    return w16CreateResponse({
      success: true, requestId: request.requestId, correlationId: request.correlationId,
      module: 'COST', operation: op, data: { id: id }
    });
  }

  return w16ModuleNotImplemented('COST:' + op, request);
}

/* ---------------- MATERIALS ---------------- */

function w16DispatchMaterials(request, context) {
  const op = request.operation;

  if (op === 'READ' || op === 'CALCULATE') {
    const materials = w16ScopedQuery(w16ReadSheetAsObjects('Material_Entries_Canonical'), request.clientId, request.projectId);
    const warnings = w16ComputeMaterialWarnings(materials);
    return w16CreateResponse({
      success: true, requestId: request.requestId, correlationId: request.correlationId,
      module: 'MATERIALS', operation: op, data: { materials: materials, warnings: warnings }
    });
  }

  return w16ModuleNotImplemented('MATERIALS:' + op, request);
}

/* ---------------- VEX ---------------- */

function w16DispatchVex(request, context) {
  const op = request.operation;
  const payload = request.payload;

  if (op === 'EXTRACT') {
    w16Assert(payload && payload.base64Data && payload.fileName, 'base64Data and fileName are required.');
    const jobId = w16EnqueueVexExtractionJob(
      payload.base64Data, payload.fileName, payload.mimeType || 'application/octet-stream',
      payload.sourceLabel || 'Unspecified', payload.systemPrompt,
      context
    );
    return w16CreateResponse({
      success: true, requestId: request.requestId, correlationId: request.correlationId,
      module: 'VEX', operation: op, status: 'QUEUED',
      data: { jobId: jobId, pending: true }
    });
  }

  if (op === 'READ' && request.intent === 'JOB_STATUS') {
    w16Assert(payload && payload.jobId, 'jobId is required to check extraction status.');
    const jobStatus = w16GetJobStatus(payload.jobId);
    return w16CreateResponse({
      success: true, requestId: request.requestId, correlationId: request.correlationId,
      module: 'VEX', operation: op, data: jobStatus
    });
  }

  if (op === 'IMPORT') {
    w16Assert(payload && payload.payload && payload.confirmed === true,
      'A confirmed=true flag is required to commit a Vex payload — pending payloads must be reviewed first.');
    const commitResult = w16VexCommitPayload(payload.payload, payload.fileLabel || '', context, {
      fileId: payload.fileId || '',
      jobId: payload.jobId || '',
      checksum: payload.checksum || '',
      model: payload.model || '',
      promptVersion: payload.promptVersion || ''
    });
    return w16CreateResponse({
      success: true, requestId: request.requestId, correlationId: request.correlationId,
      module: 'VEX', operation: op, data: commitResult
    });
  }

  return w16ModuleNotImplemented('VEX:' + op, request);
}

/* ---------------- ASSISTANT ---------------- */

function w16DispatchAssistant(request, context) {
  const op = request.operation;
  const payload = request.payload;

  if (op === 'CHAT') {
    w16Assert(payload && payload.message, 'A message is required.');
    const aiResult = w16AIRequest({
      intent: 'ASSISTANT_CHAT',
      riskLevel: 'LOW',
      systemPrompt: 'You are the ARTIFIELD Assistant. Answer only from the project context provided; never claim access to data you were not given.',
      contextText: payload.message,
      preferredProvider: payload.preferredProvider
    });
    if (!aiResult.ok) {
      throw w16CreateError('AI_ERROR', 'The assistant could not respond right now.', aiResult.error, true);
    }
    return w16CreateResponse({
      success: true, requestId: request.requestId, correlationId: request.correlationId,
      module: 'ASSISTANT', operation: op, data: { reply: aiResult.text, provider: aiResult.provider }
    });
  }

  return w16ModuleNotImplemented('ASSISTANT:' + op, request);
}

/* ---------------- REPORTS ---------------- */

function w16DispatchReports(request, context) {
  const op = request.operation;

  if (op === 'REPORT' || op === 'EXPORT') {
    const tasks = w16ScopedQuery(w16ReadSheetAsObjects('Tasks_Canonical'), request.clientId, request.projectId);
    const costEntries = w16ScopedQuery(w16ReadSheetAsObjects('Cost_Entries_Canonical'), request.clientId, request.projectId);
    const spi = w16ComputeSPI(tasks, new Date());
    const cost = w16CostSummary(costEntries, tasks);
    return w16CreateResponse({
      success: true, requestId: request.requestId, correlationId: request.correlationId,
      module: 'REPORTS', operation: op,
      data: { spi: spi, cost: cost, generatedAt: new Date().toISOString() }
    });
  }

  return w16ModuleNotImplemented('REPORTS:' + op, request);
}

/* ---------------- PROJECTS ---------------- */

function w16DispatchProjects(request, context) {
  const op = request.operation;

  if (op === 'READ') {
    if (typeof getProjects !== 'function') {
      return w16ModuleNotImplemented('PROJECTS:READ (getProjects not available)', request);
    }
    const res = getProjects(request.clientId);
    return w16CreateResponse({
      success: !!(res && res.success), requestId: request.requestId, correlationId: request.correlationId,
      module: 'PROJECTS', operation: op, data: res
    });
  }

  return w16ModuleNotImplemented('PROJECTS:' + op, request);
}

/* ---------------- SYSTEM ---------------- */

function w16DispatchSystem(request, context) {
  const op = request.operation;

  if (op === 'READ' && request.intent === 'HEALTH_CHECK') {
    return w16CreateResponse({
      success: true, requestId: request.requestId, correlationId: request.correlationId,
      module: 'SYSTEM', operation: op,
      data: { w16Version: W16_VERSION, env: W16_ACTIVE_ENV, timestamp: new Date().toISOString() }
    });
  }

  if (op === 'ADMIN') {
    w16RequireAdminOverride(request.payload && request.payload.overrideKey);
    return w16CreateResponse({
      success: true, requestId: request.requestId, correlationId: request.correlationId,
      module: 'SYSTEM', operation: op, data: { adminActionAcknowledged: true }
    });
  }

  return w16ModuleNotImplemented('SYSTEM:' + op, request);
}

