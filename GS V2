/* === ARTIFIELD LICENSE PIN GATE — ESCALATING LOCKOUT + ADMIN OVERRIDE: START ===
   Setup: Project Settings → Script Properties → key: ARTIFIELD_PIN, value: 6-digit string (hal. "482913").
   FAIL-CLOSED sa lahat ng edge case: walang naka-configure na PIN, o nasira
   ang lockout record — ang default ay TANGGIHAN, hindi open access. */
const PIN_PROP_KEY = 'ARTIFIELD_PIN';
const ADMIN_OVERRIDE_PROP_KEY = 'ARTIFIELD_ADMIN_OVERRIDE';
const FAIL_COUNT_KEY = 'ARTIFIELD_FAIL_COUNT';
const LOCK_LEVEL_KEY = 'ARTIFIELD_LOCK_LEVEL';
const LOCK_UNTIL_KEY = 'ARTIFIELD_LOCK_UNTIL';
const CYCLE_START_KEY = 'ARTIFIELD_CYCLE_START';

const MAX_ATTEMPTS_BEFORE_LOCK = 7;
const SHOW_REMAINING_FROM_ATTEMPT = 4; // first 3 wrong = no count shown
const TIP_FROM_LOCK_LEVEL = 3;         // tip starts at the 1-min tier
const FULL_RESET_AFTER_MS = 24 * 60 * 60 * 1000;

// escalation tiers — index 0 = level 1 (first lock)
const LOCK_DURATIONS_MS = [
  10 * 1000,           // level 1 — 10 sec
  30 * 1000,           // level 2 — 30 sec
  60 * 1000,           // level 3 — 1 min (tip starts)
  30 * 60 * 1000,      // level 4 — 30 min
  60 * 60 * 1000,      // level 5 — 1 hour
  24 * 60 * 60 * 1000  // level 6 — 1 day (caps here)
];

function verifyArtifieldPin(pin){
  const props = PropertiesService.getScriptProperties();
  const now = Date.now();

  const storedPin = props.getProperty(PIN_PROP_KEY);
  if(!storedPin) return { ok:false, reason:'not_configured' };

  /* === ADMIN OVERRIDE — UNIVERSAL VOID: START ===
     Checked BEFORE the lock check on purpose — this is the whole point of
     an override: it must work even while a user is currently locked out.
     A wrong override guess just falls through silently to the normal PIN
     flow below — it never reveals that an override key exists, and it
     never counts toward the fail counter (a wrong override attempt is not
     a wrong PIN attempt). */
  const overrideKey = props.getProperty(ADMIN_OVERRIDE_PROP_KEY);
  if(overrideKey && String(pin) === String(overrideKey)){
    props.deleteProperty(FAIL_COUNT_KEY);
    props.deleteProperty(LOCK_LEVEL_KEY);
    props.deleteProperty(LOCK_UNTIL_KEY);
    props.deleteProperty(CYCLE_START_KEY);
    return { ok:true };
  }
  /* === ADMIN OVERRIDE — UNIVERSAL VOID: END === */

  // 24-hour full reset — checked before anything else
  const cycleStart = Number(props.getProperty(CYCLE_START_KEY) || 0);
  if(cycleStart && (now - cycleStart) >= FULL_RESET_AFTER_MS){
    props.deleteProperty(FAIL_COUNT_KEY);
    props.deleteProperty(LOCK_LEVEL_KEY);
    props.deleteProperty(LOCK_UNTIL_KEY);
    props.deleteProperty(CYCLE_START_KEY);
  }

  // currently locked?
  const lockUntil = Number(props.getProperty(LOCK_UNTIL_KEY) || 0);
  if(lockUntil && now < lockUntil){
    const lockLevel = Number(props.getProperty(LOCK_LEVEL_KEY) || 0);
    return { ok:false, reason:'locked', retryAfterMs: lockUntil - now, showTip: lockLevel >= TIP_FROM_LOCK_LEVEL };
  }

  // correct PIN — full reset
  if(String(pin) === String(storedPin)){
    props.deleteProperty(FAIL_COUNT_KEY);
    props.deleteProperty(LOCK_LEVEL_KEY);
    props.deleteProperty(LOCK_UNTIL_KEY);
    props.deleteProperty(CYCLE_START_KEY);
    return { ok:true };
  }

  // wrong PIN
  const priorLockLevel = Number(props.getProperty(LOCK_LEVEL_KEY) || 0);

  if(priorLockLevel > 0){
    const nextLevel = Math.min(priorLockLevel + 1, LOCK_DURATIONS_MS.length);
    const duration = LOCK_DURATIONS_MS[nextLevel - 1];
    props.setProperty(LOCK_LEVEL_KEY, String(nextLevel));
    props.setProperty(LOCK_UNTIL_KEY, String(now + duration));
    props.setProperty(FAIL_COUNT_KEY, '0');
    return { ok:false, reason:'locked', retryAfterMs: duration, showTip: nextLevel >= TIP_FROM_LOCK_LEVEL };
  }

  const failCount = Number(props.getProperty(FAIL_COUNT_KEY) || 0) + 1;
  props.setProperty(FAIL_COUNT_KEY, String(failCount));

  if(failCount >= MAX_ATTEMPTS_BEFORE_LOCK){
    const duration = LOCK_DURATIONS_MS[0];
    props.setProperty(LOCK_LEVEL_KEY, '1');
    props.setProperty(LOCK_UNTIL_KEY, String(now + duration));
    props.setProperty(CYCLE_START_KEY, String(now));
    props.setProperty(FAIL_COUNT_KEY, '0');
    return { ok:false, reason:'locked', retryAfterMs: duration, showTip:false };
  }

  const attemptsRemaining = (failCount >= SHOW_REMAINING_FROM_ATTEMPT)
    ? (MAX_ATTEMPTS_BEFORE_LOCK - failCount) : null;

  return { ok:false, reason:'incorrect', attemptsRemaining };
}

/* === ADMIN OVERRIDE — ROTATION: START ===
   Lets the client rotate the override key themselves without touching the
   Apps Script editor. Requires the CURRENT override key to set a new one —
   so once they know a copy leaked, they change it and the old one stops
   working immediately (this function itself is the only door, and it's
   locked by the very key it replaces). First-time setup (no override key
   configured yet) does not require currentOverrideKey. */
function changeArtifieldAdminOverrideKey(currentOverrideKey, newOverrideKey){
  const props = PropertiesService.getScriptProperties();
  const existing = props.getProperty(ADMIN_OVERRIDE_PROP_KEY);

  if(existing && String(currentOverrideKey) !== String(existing)){
    return { ok:false, reason:'incorrect_current' };
  }
  if(!newOverrideKey || String(newOverrideKey).trim().length < 6){
    return { ok:false, reason:'invalid_new' };
  }
  if(String(newOverrideKey).trim() === props.getProperty(PIN_PROP_KEY)){
    return { ok:false, reason:'same_as_user_pin' };
  }

  props.setProperty(ADMIN_OVERRIDE_PROP_KEY, String(newOverrideKey).trim());
  return { ok:true };
}
/* === ADMIN OVERRIDE — ROTATION: END === */
