.next-arrow-btn{position:fixed;top:22px;right:22px;z-index:9500;width:48px;height:48px;border-radius:50%;background:#F7F3E9;border:none;display:flex;align-items:center;justify-content:center;color:#0A0D12;box-shadow:0 1px 2px rgba(0,0,0,.15),0 6px 16px rgba(0,0,0,.25),0 14px 32px rgba(0,0,0,.2);transition:transform .3s var(--ease-spring),box-shadow .35s var(--ease-settle),opacity .25s,visibility .25s;}
