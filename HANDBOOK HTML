function openNextStepsModal(anchorEl){
  const modal=document.getElementById('problem-modal');
  if(currentProblemCard===anchorEl && modal.classList.contains('open')){ closeProblemModal(); return; }
  haptic('medium'); currentProblemCard=anchorEl; resetModalExtras(); nextStepsModalOpen=true;
  document.getElementById('problem-modal-icon').innerHTML='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>';
  document.getElementById('problem-modal-title').textContent='What happens next';
  document.getElementById('problem-modal-sub').textContent='From first call to going live';
  document.getElementById('problem-modal-body').innerHTML =
    '<div class="problem-modal-steps">' +
    '<div class="problem-modal-step-row"><div class="problem-modal-step-num">01</div><div class="problem-modal-step-txt">A 20-minute call to understand your buildings, trades, and current tools.</div></div>' +
    '<div class="problem-modal-step-row"><div class="problem-modal-step-num">02</div><div class="problem-modal-step-txt">A live walkthrough of ARTIFIELD using your own schedule or cost file.</div></div>' +
    '<div class="problem-modal-step-row"><div class="problem-modal-step-num">03</div><div class="problem-modal-step-txt">Setup and onboarding — most projects are live within a week.</div></div>' +
    '</div>';
  modal.classList.add('open'); positionProblemModal(anchorEl);
  clearTimeout(window._nextStepsAutoCloseTimer);
  window._nextStepsAutoCloseTimer=setTimeout(()=>{ if(currentProblemCard===anchorEl && modal.classList.contains('open')) closeProblemModal(); },15000);
}
function positionProblemModal(cardEl){
  const modal=document.getElementById('problem-modal'), arrow=document.getElementById('problem-modal-arrow');
  arrow.style.display='';
  const iconRect=getIconAnchorRect(cardEl);
  const vw=window.innerWidth;
  const mw=modal.offsetWidth||320, mh=modal.offsetHeight||200, gap=16;
  const anchorX=iconRect.right, anchorY=iconRect.top;
  let left=anchorX-32; left=Math.max(12,Math.min(vw-mw-12,left));
  let top=anchorY-gap-mh; top=Math.max(12,top);
  modal.style.left=left+'px'; modal.style.top=top+'px'; modal.style.transformOrigin='bottom center';
  arrow.className='problem-modal-arrow side-bottom';
  let arrowLeft=anchorX-left-8; arrowLeft=Math.max(16,Math.min(mw-24,arrowLeft));
  arrow.style.left=arrowLeft+'px'; arrow.style.top='';
}
function closeProblemModal(){
  haptic('light'); document.getElementById('problem-modal').classList.remove('open'); currentProblemCard=null;
  if(nextStepsModalOpen){ nextStepsModalOpen=false; closingUnlocked=true; goTo(11); }
}
document.addEventListener('click', function(e){
  const modal=document.getElementById('problem-modal');
  if(!modal.classList.contains('open')) return;
  if(modal.contains(e.target)) return;
  if(e.target.closest('.problem-card')||e.target.closest('.product-card')||e.target.closest('.feat-item-modal')||e.target.closest('.vex-node')||e.target.closest('.privacy-badge-float')) return;
  closeProblemModal();
});
document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeProblemModal(); });
window.addEventListener('resize', function(){ const modal=document.getElementById('problem-modal'); if(modal.classList.contains('open') && currentProblemCard) positionProblemModal(currentProblemCard); });

/* ===== Pricing / chips ===== */
let selectedPlan='unsure';
function choosePlan(plan){
  showToast(`${plan} license selected — let's talk`);
  selectedPlan = plan==='Solo' ? 'small' : 'medium';
  setTimeout(()=>{ goTo(11); syncPlanChip(); },260);
}
function syncPlanChip(){
  document.querySelectorAll('.talk-chip-row .chip').forEach(c=>c.classList.remove('active'));
  const map={small:'chip-small',medium:'chip-medium',unsure:'chip-unsure'};
  const el=document.getElementById(map[selectedPlan]); if(el) el.classList.add('active');
}
function selectPlanChip(key,el){
  haptic('light');
  document.querySelectorAll('.talk-chip-row .chip').forEach(c=>c.classList.remove('active'));
  el.classList.add('active'); selectedPlan=key;
}

/* ===== Impact calculator ===== */
let impactDebounceTimer=null;
function updateImpact(){
  const revenue=parseInt(document.getElementById('s-revenue').value,10);
  const hours=parseInt(document.getElementById('s-hours').value,10);
  const idleDays=parseInt(document.getElementById('s-stockouts').value,10);
  document.getElementById('v-revenue').textContent=fmtPeso(revenue);
  document.getElementById('v-hours').textContent=hours;
  document.getElementById('v-stockouts').textContent=idleDays;
  clearTimeout(impactDebounceTimer);
  impactDebounceTimer=setTimeout(function(){
    const dailyWage=1200; // illustrative construction-crew day-rate basis
    const laborSavings = hours*4*dailyWage/8;
    const idleImpactRaw = idleDays * (revenue/30) * 0.5;
    const idleImpactCap = revenue*0.08;
    const idleSavings = Math.min(idleImpactRaw, idleImpactCap);
    const totalSavings = laborSavings + idleSavings;
    const planCost = selectedPlan==='small' ? 2999 : 6250; // 75000/12
    const planLabel = selectedPlan==='small' ? 'Solo license cost' : 'Project license cost';
    const paybackDays = totalSavings>0 ? Math.max(1, Math.round(planCost/(totalSavings/30))) : null;
    const paybackLabel = paybackDays ? (paybackDays+' day'+(paybackDays===1?'':'s')) : '—';
    const maxBar = Math.max(planCost, totalSavings, 1);
    document.getElementById('v-savings').textContent = fmtPeso(totalSavings);
    document.getElementById('v-hourssaved').textContent = Math.round(hours*4);
    document.getElementById('v-payback').textContent = paybackLabel;
    const planLabelEl=document.getElementById('impact-plan-label'); if(planLabelEl) planLabelEl.textContent=planLabel;
    document.getElementById('bar-cost').style.width = Math.min(100,(planCost/maxBar)*100)+'%';
    document.getElementById('bar-value').style.width = Math.min(100,(totalSavings/maxBar)*100)+'%';
  },220);
}

function toggleSliderInfo(btn){ haptic('light'); const info=btn.closest('.slider-block').querySelector('.slider-info-text'); info.classList.toggle('open'); }
let lastHapticStep=null;
['s-revenue','s-hours','s-stockouts'].forEach(id=>{
  const el=document.getElementById(id);
  if(el) el.addEventListener('input',()=>{ const step=Math.round(parseInt(el.value,10)/10); if(step!==lastHapticStep){ haptic('light'); lastHapticStep=step; } });
});
['talk-fullname','talk-bizname'].forEach(id=>{ const el=document.getElementById(id); if(el) el.addEventListener('input',()=>{ el.style.borderColor=''; }); });

/* ===== Let's talk ===== */
function submitTalk(btn){
  if(btn.classList.contains('loading')||btn.classList.contains('success')) return;
  const nameInput=document.getElementById('talk-fullname'), bizInput=document.getElementById('talk-bizname');
  const nameVal=nameInput?nameInput.value.trim():'', bizVal=bizInput?bizInput.value.trim():'';
  if(!nameVal||!bizVal){
    haptic('medium'); let firstEmpty=null;
    [nameInput,bizInput].forEach(inp=>{ if(inp && !inp.value.trim()){ inp.style.borderColor='#FF5C5C'; if(!firstEmpty) firstEmpty=inp; } });
    if(firstEmpty) firstEmpty.focus();
    showToast('Please fill in your name and company/project first.');
    return;
  }
  haptic('medium'); btn.classList.add('loading'); btn.disabled=true;
  setTimeout(()=>{
    btn.classList.remove('loading'); btn.classList.add('success'); haptic('success');
    setTimeout(()=>{ btn.classList.remove('success'); btn.disabled=false; openNextStepsModal(btn); },1400);
  },900);
}
function skipToClosing(){ haptic('light'); closingUnlocked=true; goTo(12); }
function restartPresentation(){
  entered.delete(0); realitySteps=0; realityClickEnabled=false;
  document.querySelectorAll('.slide[data-idx="0"] .reveal-item').forEach(item=>item.classList.remove('shown'));
  current=12; goTo(0);
}
function handleMessageTeamClick(btn){
  if(btn.classList.contains('loading')||btn.classList.contains('success')) return;
  haptic('medium'); btn.classList.add('loading');
  setTimeout(()=>{
    btn.classList.remove('loading'); btn.classList.add('success'); haptic('success');
    setTimeout(()=>{ btn.classList.remove('success'); openMessageOverlay(); },1100);
  },850);
}
function openMessageOverlay(){
  navLocked=true;
  const overlay=document.getElementById('message-overlay');
  overlay.classList.remove('hidden');
  setTimeout(()=>{
    overlay.classList.add('visible'); haptic('light');
    const wm=document.getElementById('overlay-wordmark-text'), sub=document.getElementById('overlay-sub-text');
    if(wm) revealChars(wm,'ARTIFIELD',{speed:26,dur:420});
    if(sub) setTimeout(()=>{ revealChars(sub,'Present differently.',{speed:22,dur:420}); },260);
  },350);
  overlay.onclick=closeMessageOverlay;
}
function closeMessageOverlay(){
  haptic('light'); navLocked=false;
  const overlay=document.getElementById('message-overlay');
  overlay.classList.remove('visible');
  setTimeout(()=>{ overlay.classList.add('hidden'); },200);
}

/* ===== Tips / notif panels ===== */
function toggleTips(){ haptic('light'); document.getElementById('tips-panel').classList.toggle('open'); }
document.addEventListener('click', function(e){ const panel=document.getElementById('tips-panel'); if(panel.classList.contains('open') && !panel.contains(e.target) && !e.target.closest('#tips-btn')) panel.classList.remove('open'); });
function toggleNotif(){ haptic('light'); document.getElementById('notif-panel').classList.toggle('open'); }
