function showPrivacyBadgeHint(){
  const badge=document.getElementById('privacy-badge-talk'); if(!badge) return;
  setTimeout(()=>{ badge.classList.add('visible'); },900);
  setTimeout(()=>{ badge.classList.remove('visible'); },6500);
}

/* ===== Next arrow ===== */
function syncNextArrow(){
  const btn=document.getElementById('next-arrow'); if(!btn) return;
  let stepsLeft=false;
  if(current===0) stepsLeft=realitySteps<9;
  else if(current===1) stepsLeft=devSteps<4;
  else if(current===7) stepsLeft=togetherSteps<TOGETHER_MAX;
  else { const cfg=GENERIC[current]; stepsLeft = cfg ? genericSteps[current]<cfg.max : false; }
  if(current===TOTAL-1 && !stepsLeft) btn.classList.add('hidden'); else btn.classList.remove('hidden');
}
function advance(){
  const hint=document.getElementById('nextarrow-hint'); if(hint) hint.classList.remove('visible');
  let stepsLeft=false;
  if(current===0) stepsLeft=realityClickEnabled && realitySteps<9;
  else if(current===1) stepsLeft=devClickEnabled && devSteps<4;
  else if(current===7) stepsLeft=togetherClickEnabled && togetherSteps<TOGETHER_MAX;
  else { const cfg=GENERIC[current]; stepsLeft = !!(cfg && genericClickEnabled[current] && genericSteps[current]<cfg.max); }
  if(stepsLeft) stepComponent(1); else if(current<TOTAL-1) nextSlide();
  syncNextArrow();
}
document.addEventListener('click', function(){ syncNextArrow(); });
document.addEventListener('keydown', function(e){ if(['ArrowRight','ArrowLeft','ArrowDown','ArrowUp','PageDown','PageUp','Home','End'].includes(e.key)) syncNextArrow(); });

