  setTimeout(()=>{ hint.classList.remove('visible'); },4200);
}
(function revealWelcomeWhenFontsReady(){
  const inner=document.querySelector('.welcome-inner'); if(!inner) return;
  let shown=false; function show(){ if(shown) return; shown=true; inner.classList.add('fonts-ready'); }
  if(document.fonts && document.fonts.ready){ document.fonts.ready.then(show).catch(show); }
  setTimeout(show,350);
})();

layout(); updateChrome(); syncNextArrow();
