<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>ArtiSlide — ARTIFIELD Presentation</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#0A0D12; --ink-2:#10151C;
  --cream:#EDF1F5; --paper:#151B24; --paper-line:rgba(237,241,245,.1);
  --gold:#4FC3F7; --gold-deep:#1F8FC7; --gold-line:rgba(79,195,247,.28);
  --rust:#FFB020; --green-pos:#3DDC84;
  --t1:#EDF1F5; --t2:rgba(237,241,245,.62); --t3:rgba(237,241,245,.42);
  --c1:#EDF1F5; --c2:rgba(237,241,245,.62); --c3:rgba(237,241,245,.4);
  --font-display:-apple-system,'SF Pro Display',Sora,Helvetica,Arial,sans-serif;
  --font-ui:-apple-system,'SF Pro Text',Inter,Helvetica,Arial,sans-serif;
  --font-mono:'JetBrains Mono',monospace;
  --ease-settle:cubic-bezier(.16,1,.3,1);
  --ease-spring:cubic-bezier(.34,1.56,.64,1);
  --ease-exit:cubic-bezier(.4,0,.2,1);
}
*{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
html,body{margin:0;padding:0;height:100%;}
body{font-family:var(--font-ui); color:var(--t1); background:var(--ink); overflow:hidden; position:relative;}
::selection{ background:var(--gold); color:var(--ink); }
button{ font-family:inherit; cursor:pointer; }
input,textarea{ font-family:inherit; }
#topline{position:fixed;top:0;left:0;right:0;height:2px;background:rgba(255,255,255,.06);z-index:61;}
#topline-fill{height:100%;width:9%;background:#FFFFFF;transition:width .7s var(--ease-settle);}
#track{position:absolute;top:0;left:0;width:100%;will-change:transform;transition:transform .82s var(--ease-settle);}
.slide{height:100vh;width:100%;display:flex;flex-direction:column;overflow:hidden;background:var(--ink);color:var(--c1);}
.slide-inner{flex:1;display:flex;flex-direction:column;justify-content:center;padding:32px 64px;max-width:1240px;width:100%;margin:0 auto;overflow-y:auto;min-height:0;}
.slide-eyebrow{font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.09em;color:var(--gold);display:flex;align-items:center;gap:9px;margin-bottom:16px;}
.slide-eyebrow .ln{width:18px;height:1px;background:var(--gold-line);}
.slide-num-huge{display:none;}
h1.h-display{font-family:var(--font-display);font-weight:800;letter-spacing:-.02em;line-height:1.03;margin:0 0 18px;font-size:clamp(34px,4.6vw,64px);}
h2.h-section{font-family:var(--font-display);font-weight:800;letter-spacing:-.015em;line-height:1.07;margin:0 0 14px;font-size:clamp(28px,3.4vw,44px);}
p.lede{font-size:17px;line-height:1.6;max-width:560px;margin:0 0 26px;color:var(--c2);}
.btn{border:0;border-radius:14px;padding:15px 26px;font-size:14.5px;font-weight:700;display:inline-flex;align-items:center;gap:9px;transition:transform .12s,opacity .12s,box-shadow .2s;}
.btn:active{transform:scale(.96);}
.btn-white-pill{background:#F7F3E9;color:#0A0D12;box-shadow:0 1px 2px rgba(0,0,0,.2),0 8px 20px rgba(0,0,0,.28);}
.btn-white-pill:hover{box-shadow:0 2px 4px rgba(0,0,0,.2),0 14px 28px rgba(0,0,0,.32);}
.btn-outline-dark{background:rgba(255,255,255,.05);color:var(--c1);border:1.5px solid rgba(255,255,255,.16);}
.btn-outline-dark:hover{background:rgba(255,255,255,.09);}
.btn-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:6px;}
.chip{padding:8px 15px;border-radius:20px;font-size:12.5px;font-weight:600;border:1.5px solid transparent;background:rgba(255,255,255,.06);color:var(--c1);border-color:rgba(255,255,255,.1);transition:transform .12s,background .15s,color .15s;}
.chip.active{background:linear-gradient(150deg,var(--gold),var(--gold-deep));color:#04121A;border-color:transparent;}
.chip:active{transform:scale(.94);}
.stat-row{display:flex;gap:12px;margin-top:30px;flex-wrap:wrap;}
.stat-pill{padding:14px 18px;border-radius:16px;min-width:150px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);}
.stat-pill .v{font-family:var(--font-mono);font-size:22px;font-weight:700;color:var(--gold);}
.stat-pill .l{font-size:11px;margin-top:2px;color:var(--c3);}
.card{border-radius:20px;padding:20px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);}
.icon-tile{width:38px;height:38px;border-radius:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:#F5F0E6;color:#0A0D12;}
.icon-tile svg{width:18px;height:18px;}
.split{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center;}
.product-card{display:flex;align-items:center;gap:14px;padding:16px 18px;border-radius:18px;margin-bottom:10px;transition:transform .16s var(--ease-spring);cursor:pointer;background:var(--paper);border:1px solid var(--paper-line);}
.product-card:hover{transform:translateX(4px);}
.problem-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:8px;width:100%;}
.problem-grid.cols-3{grid-template-columns:1fr 1fr 1fr;}
.problem-card{cursor:pointer;padding:13px 15px;border-radius:16px;box-sizing:border-box;width:100%;position:relative;}
.problem-card .pc-head{display:flex;align-items:center;gap:10px;}
.problem-card .icon-tile{width:32px;height:32px;border-radius:9px;}
.problem-card .icon-tile svg{width:16px;height:16px;}
.problem-card .pc-title{font-weight:600;font-size:13px;letter-spacing:-.005em;}
.problem-detail{max-height:0;overflow:hidden;transition:max-height .34s var(--ease-settle);}
.problem-card.open .problem-detail{max-height:120px;margin-top:12px;}
.problem-detail-inner{font-size:12.5px;color:var(--c2);line-height:1.55;border-top:1px solid rgba(255,255,255,.09);padding-top:12px;}
.feat-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-top:22px;}
.feat-item{display:flex;align-items:center;gap:12px;padding:13px 14px;border-radius:14px;background:rgba(255,255,255,.04);}
.feat-item .f-lbl{font-size:13px;font-weight:600;}
.feat-item-modal{cursor:pointer;transition:transform .16s var(--ease-spring);}
.feat-item-modal:active{transform:scale(.96);}
.reveal-item{opacity:0;transform:translateY(14px);pointer-events:none;transition:opacity .5s var(--ease-settle),transform .5s var(--ease-settle);}
.reveal-item.shown{opacity:1;transform:translateY(0);pointer-events:auto;}
[data-idx] .feat-grid .feat-item{opacity:0;transform:translateY(10px);transition:opacity .4s var(--ease-settle),transform .4s var(--ease-settle);}
[data-idx] .feat-grid.shown .feat-item{opacity:1;transform:translateY(0);}
[data-idx] .feat-grid .feat-item:nth-child(1){transition-delay:0ms;}
[data-idx] .feat-grid .feat-item:nth-child(2){transition-delay:110ms;}
[data-idx] .feat-grid .feat-item:nth-child(3){transition-delay:220ms;}
[data-idx] .feat-grid .feat-item:nth-child(4){transition-delay:330ms;}
[data-idx] .feat-grid .feat-item:nth-child(5){transition-delay:440ms;}
[data-idx] .feat-grid .feat-item:nth-child(6){transition-delay:550ms;}
.char-reveal .char{display:inline-block;opacity:0;transform:translateY(6px);transition-property:opacity,transform;transition-timing-function:var(--ease-settle);will-change:opacity,transform;}
.char-reveal.hiding .char{transition-delay:0s !important;transition-duration:.16s !important;}
.char-reveal.shown .char{opacity:1;transform:translateY(0);}
.vex-flow{display:flex;align-items:center;justify-content:center;gap:0;margin:26px 0 6px;flex-wrap:wrap;}
.vex-node{display:flex;flex-direction:column;align-items:center;gap:10px;cursor:pointer;flex-shrink:0;opacity:0;transform:translateY(16px) scale(.9);transition:transform .55s var(--ease-spring),opacity .45s var(--ease-settle);pointer-events:none;}
.vex-node.vn-show{opacity:1;transform:translateY(0) scale(1);pointer-events:auto;}
.vex-node:active{transform:scale(.97) !important;}
.vex-node .icon-tile{width:112px;height:112px;border-radius:30px;background:#0F161E;border:1px solid var(--paper-line);box-shadow:0 4px 14px rgba(0,0,0,.3);transition:background-color .5s var(--ease-settle),border-color .5s var(--ease-settle);}
.vex-node .icon-tile svg{width:48px;height:48px;color:#EDF1F5;transition:stroke .5s var(--ease-settle);}
.vex-node-label{font-family:var(--font-ui);font-weight:700;font-size:13.5px;color:var(--t1);text-align:center;max-width:130px;line-height:1.25;transition:color .5s var(--ease-settle);}
.vex-node-hub-icon-text{font-family:var(--font-mono);font-weight:700;font-size:20px;letter-spacing:.02em;color:#EDF1F5;text-align:center;line-height:1.15;}
.vex-node.vex-node-lit .icon-tile{background-color:var(--gold);border-color:var(--gold);}
.vex-node.vex-node-lit .icon-tile svg{stroke:#04121A;}
.vex-node.vex-node-lit .vex-node-hub-icon-text{color:#04121A;}
.vex-connector{flex:1;min-width:32px;max-width:72px;height:16px;position:relative;margin:0 2px;align-self:center;margin-top:-24px;}
.vex-connector svg{width:100%;height:16px;overflow:visible;display:block;}
.vex-connector-line{stroke:var(--gold-line);stroke-width:2;stroke-linecap:round;stroke-dasharray:120;stroke-dashoffset:120;transition:stroke-dashoffset .5s var(--ease-settle);}
.vex-connector.vn-show .vex-connector-line{stroke-dashoffset:0;}
.vex-connector-dot{position:absolute;top:50%;left:0;width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 8px 2px var(--gold-line);transform:translate(-3px,-50%);opacity:0;pointer-events:none;}
.vex-connector.pulsing .vex-connector-dot{animation:vexDotTravel 1.05s var(--ease-settle) forwards;}
@keyframes vexDotTravel{0%{left:0%;opacity:0;}8%{opacity:1;}92%{opacity:1;}100%{left:100%;opacity:0;}}
.vex-flow-hint{text-align:center;font-size:11.5px;color:var(--t3);margin-top:14px;}
.vex-together-layout{display:flex;align-items:center;gap:46px;flex-wrap:wrap;margin-top:6px;}
.vex-flow-col{flex:1 1 480px;min-width:0;}
.vex-together-layout .vex-flow{margin:20px 0 6px;}
.vex-result-panel{flex:0 0 240px;width:240px;background:#0F161E;border:1px solid var(--paper-line);border-radius:24px;padding:26px 22px;text-align:center;opacity:0;transform:scale(.92) translateY(6px);pointer-events:none;transition:opacity .5s var(--ease-settle),transform .5s var(--ease-spring);}
.vex-result-panel.shown{opacity:1;transform:scale(1) translateY(0);pointer-events:auto;}
.vex-connector-toresult{flex:0 0 44px;width:44px;margin:0 2px;align-self:center;margin-top:0;}
@media (max-width:900px){.vex-connector-toresult{display:none;}}
.vex-result-ring-wrap{position:relative;width:128px;height:128px;margin:0 auto 16px;}
.vex-result-ring{transition:stroke-dashoffset 1.1s cubic-bezier(.16,1,.3,1);}
.vex-result-ring-label{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
.vex-result-ring-num{font-family:var(--font-mono);font-weight:700;font-size:24px;color:#EDF1F5;}
.vex-result-ring-sub{font-size:11px;color:var(--t3);margin-top:2px;}
.vex-result-title{font-family:var(--font-display);font-weight:800;font-size:15px;color:#EDF1F5;margin-bottom:16px;line-height:1.3;}
.vex-result-stats{display:flex;flex-direction:column;gap:0;}
.vex-result-stat{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px 0;border-top:1px solid var(--paper-line);font-size:12px;}
.vex-result-stat:first-child{border-top:0;}
.vex-result-stat-label{color:var(--t3);text-align:left;}
.vex-result-stat-val{color:#EDF1F5;font-weight:700;text-align:right;}
@media (max-width:900px){.vex-together-layout{flex-direction:column;align-items:stretch;gap:22px;}.vex-result-panel{width:100%;flex:none;}}
.compare-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:10px;}
.compare-col{border-radius:20px;padding:22px;}
.compare-col.old{background:#12181F;border:1px solid rgba(237,241,245,.12);color:#EDF1F5;}
.compare-col.new{background:rgba(79,195,247,.06);border:1px solid var(--gold-line);}
.compare-head{font-weight:800;font-size:15px;margin-bottom:14px;display:flex;align-items:center;gap:8px;}
.compare-row{display:flex;align-items:flex-start;gap:10px;padding:9px 0;font-size:13px;line-height:1.5;border-top:1px solid rgba(255,255,255,.08);opacity:0;transform:translateY(8px);}
.compare-row:first-of-type{border-top:0;}
.compare-row.shown{animation:rowIn .5s var(--ease-settle) forwards;}
@keyframes rowIn{to{opacity:1;transform:translateY(0);}}
.compare-row .mk{flex-shrink:0;font-weight:700;margin-top:1px;}
.old .mk{color:#FF5C5C;}
.new .mk{color:#3DDC84;}
.price-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:8px;}
.price-card{border-radius:24px;padding:26px;position:relative;overflow:hidden;}
.price-card.medium{background:linear-gradient(160deg,#16202B,#0A0D12);color:var(--c1);border:1px solid rgba(237,241,245,.18);}
.price-card.small{background:var(--paper);border:1px solid var(--paper-line);}
.price-tag{font-family:var(--font-mono);font-size:10.5px;font-weight:700;letter-spacing:.06em;padding:4px 11px;border-radius:20px;display:inline-block;margin-bottom:14px;background:#F7F3E9;color:#0A0D12;}
.price-name{font-family:var(--font-ui);font-weight:800;font-size:22px;margin-bottom:4px;}
.price-setup{display:flex;align-items:baseline;gap:8px;margin:14px 0 2px;}
.price-setup .n{font-weight:700;font-size:34px;color:#EDF1F5;}
.price-setup .l{font-size:11.5px;color:var(--c3);}
.price-retention{font-size:12.5px;margin-bottom:18px;color:var(--c2);}
.price-retention b{font-family:var(--font-mono);}
.price-feats{display:flex;flex-direction:column;gap:9px;margin-bottom:20px;}
.price-feat{display:flex;align-items:center;gap:9px;font-size:13px;}
.price-feat .ck{color:#EDF1F5;}
.price-note{text-align:center;font-size:11.5px;margin-top:14px;color:var(--t3);}
.impact-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;}
.slider-block{margin-bottom:24px;}
.slider-head{display:flex;justify-content:space-between;margin-bottom:10px;font-size:13px;}
.slider-head .sv{color:var(--gold);font-weight:700;}
.slider-label-row{display:flex;align-items:center;gap:6px;}
.slider-info-btn{width:16px;height:16px;border-radius:50%;background:rgba(255,176,32,.16);border:1px solid rgba(255,176,32,.4);color:var(--rust);font-family:var(--font-mono);font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;padding:0;}
.slider-info-text{max-height:0;overflow:hidden;transition:max-height .28s var(--ease-settle);font-size:11.5px;color:var(--c2);line-height:1.5;}
.slider-info-text.open{max-height:60px;margin-bottom:10px;}
input[type=range]{-webkit-appearance:none;width:100%;height:4px;border-radius:3px;background:rgba(255,255,255,.14);outline:none;}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:50%;background:var(--gold);border:3px solid var(--ink);box-shadow:0 2px 8px rgba(0,0,0,.4);cursor:pointer;}
input[type=range]::-moz-range-thumb{width:18px;height:18px;border-radius:50%;background:var(--gold);border:3px solid var(--ink);cursor:pointer;}
.impact-result{border-radius:24px;padding:28px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);}
.impact-big{font-size:44px;font-weight:700;color:var(--gold);letter-spacing:-.01em;}
.impact-sub{font-size:12.5px;color:var(--c2);margin-top:2px;margin-bottom:20px;}
.impact-mini-row{display:flex;gap:12px;margin-bottom:18px;}
.impact-mini{flex:1;padding:12px 14px;border-radius:14px;background:rgba(255,255,255,.05);}
.impact-mini .v{font-size:18px;font-weight:700;color:var(--c1);}
.impact-mini .l{font-size:10.5px;color:var(--c3);margin-top:2px;}
.impact-bar-row{display:flex;align-items:center;gap:10px;margin-bottom:8px;}
.impact-bar-label{width:140px;font-size:11px;color:var(--c3);flex-shrink:0;}
.impact-bar-track{flex:1;height:8px;border-radius:5px;background:rgba(255,255,255,.08);overflow:hidden;}
.impact-bar-fill{height:100%;border-radius:5px;transition:width .5s var(--ease-settle);}
.impact-disclaimer{font-size:10.5px;color:var(--c3);margin-top:14px;line-height:1.5;}
.talk-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:flex-start;}
.field{margin-bottom:14px;}
.field label{display:block;font-size:11.5px;font-weight:600;color:var(--c2);margin-bottom:7px;}
.field input,.field textarea{width:100%;padding:13px 14px;border-radius:12px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);color:var(--c1);font-size:13.5px;outline:none;resize:none;transition:border-color .15s;}
.field input:focus,.field textarea:focus{border-color:var(--gold-line);}
.talk-chip-row{display:flex;gap:8px;margin-top:6px;}
.talk-submit{position:relative;overflow:hidden;width:100%;margin-top:6px;justify-content:center;}
.talk-submit .btn-content{display:flex;align-items:center;gap:8px;transition:opacity .16s var(--ease-exit);}
.talk-submit.loading .btn-content,.talk-submit.success .btn-content{opacity:0;}
.talk-submit .btn-status{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:8px;opacity:0;pointer-events:none;transition:opacity .16s var(--ease-exit);font-weight:700;}
.talk-submit.loading .status-loading{opacity:1;}
.talk-submit.success .status-success{opacity:1;}
.spinner{width:15px;height:15px;border-radius:50%;border:2px solid rgba(4,18,26,.25);border-top-color:#04121A;animation:spin .7s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
.talk-footer{margin-top:34px;display:flex;align-items:center;gap:10px;font-size:11.5px;color:var(--c3);flex-direction:column;text-align:center;gap:10px;}
.privacy-badge-float{position:absolute;top:8px;right:0;left:0;max-width:280px;margin:0 0 0 auto;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.09);border-radius:14px;padding:12px 15px;display:flex;align-items:center;gap:10px;cursor:pointer;opacity:0;visibility:hidden;pointer-events:none;transform:translateY(10px) scale(.96);transition:opacity .55s var(--ease-settle),transform .55s var(--ease-spring),visibility .55s;box-shadow:0 14px 32px rgba(0,0,0,.22);}
.privacy-badge-float.visible{opacity:1;visibility:visible;pointer-events:auto;transform:translateY(0) scale(1);}
@media (max-width:900px){.privacy-badge-float{position:static;max-width:100%;margin-top:14px;}}
.privacy-badge-icon{width:32px;height:32px;border-radius:9px;background:rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#EDF1F5;}
.privacy-badge-icon svg{width:16px;height:16px;}
.privacy-badge-text{font-size:12px;line-height:1.4;color:var(--c2);}
.privacy-badge-text b{color:var(--c1);font-weight:700;display:block;font-size:12.5px;margin-bottom:1px;}
.problem-modal{position:fixed;z-index:9700;width:320px;max-width:calc(100vw - 24px);background:#F5F0E6;border:1px solid rgba(20,19,16,.08);border-radius:22px;padding:22px 22px;box-shadow:0 28px 64px rgba(20,19,16,.2),0 4px 12px rgba(20,19,16,.1);opacity:0;visibility:hidden;pointer-events:none;transform:scale(.88) translateY(6px);transition:opacity .28s var(--ease-settle) .02s,transform .46s var(--ease-spring) .02s,visibility .28s;}
.problem-modal.open{opacity:1;visibility:visible;pointer-events:auto;transform:scale(1) translateY(0);}
.problem-modal-icon{width:42px;height:42px;border-radius:13px;display:flex;align-items:center;justify-content:center;background:rgba(20,19,16,.05);border:1px solid rgba(20,19,16,.08);margin-bottom:14px;color:#1C1C1E;}
.problem-modal-icon svg{width:20px;height:20px;}
.problem-modal-title{font-family:var(--font-display);font-weight:800;font-size:17px;color:#1C1C1E;margin-bottom:6px;}
.problem-modal-sub{font-size:12px;color:rgba(28,28,30,.5);margin-bottom:14px;}
.problem-modal-body{font-size:13px;line-height:1.6;color:rgba(28,28,30,.72);border-top:1px solid rgba(20,19,16,.08);padding-top:14px;}
.problem-modal-cost{display:none;align-items:center;padding:5px 12px;border-radius:14px;font-family:var(--font-mono);font-size:11px;font-weight:700;margin-bottom:12px;}
.problem-modal-cost.qualitative{background:rgba(20,19,16,.06);color:#1C1C1E;}
.problem-modal-solution{display:none;font-size:12.5px;line-height:1.6;color:rgba(28,28,30,.72);margin-top:12px;padding-top:12px;border-top:1px solid rgba(20,19,16,.08);}
