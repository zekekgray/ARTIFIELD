.nextarrow-hint{position:fixed;top:26px;right:82px;z-index:9499;background:rgba(16,21,28,.65);-webkit-backdrop-filter:blur(20px) saturate(180%);backdrop-filter:blur(20px) saturate(180%);color:#EDF1F5;font-size:12.5px;font-weight:600;letter-spacing:-.005em;padding:11px 18px;border-radius:16px;white-space:nowrap;border:1px solid rgba(255,255,255,.16);box-shadow:0 10px 30px rgba(0,0,0,.4);opacity:0;transform:translateX(10px) scale(.94);pointer-events:none;transition:opacity .55s var(--ease-settle),transform .55s var(--ease-spring);}
