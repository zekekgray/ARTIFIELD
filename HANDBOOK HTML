.notif-panel-body{font-size:12.5px;line-height:1.55;color:rgba(28,28,30,.72);}
.version-static{position:fixed;bottom:22px;right:18px;z-index:99999;font-family:var(--font-mono);font-size:10.5px;font-weight:600;color:rgba(237,241,245,.32);letter-spacing:.02em;cursor:pointer;user-select:none;padding:10px 12px;pointer-events:none;opacity:0;visibility:hidden;transition:color .2s,opacity .3s;}
