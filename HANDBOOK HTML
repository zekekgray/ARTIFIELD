.tips-btn,.notif-btn{position:fixed;top:22px;z-index:9500;width:48px;height:48px;background:transparent;border:none;box-shadow:none;display:flex;align-items:center;justify-content:center;color:#F5F0E6;transition:transform .3s var(--ease-spring),opacity .2s;}
