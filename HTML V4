/* === MULTI-SERIES COMPARE OVERLAY: START === */
.compare-panel{background:var(--panel);border:1px solid var(--line-soft);border-radius:var(--radius);padding:18px;margin-bottom:18px;}
.compare-panel h4{margin:0 0 2px;font-size:13px;font-weight:650;}
.compare-panel .sub{font-size:11px;color:var(--text-faint);margin-bottom:14px;font-family:var(--mono);}
.compare-controls{display:flex;flex-direction:column;gap:12px;margin-bottom:16px;}
.compare-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
.compare-label{font-size:11px;color:var(--text-faint);min-width:64px;}
.compare-mode-toggle{display:flex;gap:2px;background:var(--panel-2);border:1px solid var(--line);border-radius:8px;padding:2px;}
.compare-mode-toggle button{all:unset;cursor:pointer;font-size:11.5px;padding:6px 12px;border-radius:6px;color:var(--text-dim);}
.compare-mode-toggle button.active{background:var(--blue);color:#04121A;font-weight:600;}
.compare-chip{
  all:unset;cursor:pointer;display:inline-flex;align-items:center;gap:7px;font-size:11.5px;
  padding:6px 12px 6px 8px;border-radius:20px;border:1px solid var(--line);color:var(--text-dim);
  transition:all .12s;background:var(--panel-2);
}
.compare-chip:hover{border-color:#3A4759;color:var(--text);}
.compare-chip .swatch{width:9px;height:9px;border-radius:50%;background:#3A4759;flex:none;transition:background .12s;}
.compare-chip.selected{color:var(--text);border-color:var(--chip-color, var(--blue));background:color-mix(in srgb, var(--chip-color, var(--blue)) 14%, transparent);}
.compare-chip.selected .swatch{background:var(--chip-color, var(--blue));}
.compare-toolbtn{all:unset;cursor:pointer;font-size:11px;padding:5px 10px;border-radius:6px;color:var(--text-faint);border:1px solid transparent;}
.compare-toolbtn:hover{color:var(--text-dim);background:var(--panel-2);}
.compare-check{display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--text-dim);cursor:pointer;user-select:none;}
.compare-check input{accent-color:var(--blue);width:14px;height:14px;}
.compare-empty{border:1px dashed #2A3644;border-radius:10px;padding:26px;text-align:center;color:var(--text-faint);font-size:12px;}
.compare-legend-list{display:flex;flex-wrap:wrap;gap:10px 18px;margin-top:10px;}
.compare-legend-item{
  all:unset;cursor:pointer;display:inline-flex;align-items:center;gap:7px;font-size:11.5px;color:var(--text-dim);
  padding:3px 4px;border-radius:6px;
}
.compare-legend-item i{width:16px;height:3px;border-radius:2px;display:inline-block;flex:none;}
.compare-legend-item.off{opacity:.35;text-decoration:line-through;}
.compare-legend-item .cli-val{font-family:var(--mono);color:var(--text-faint);margin-left:2px;}
.compare-tooltip{
  position:absolute;top:8px;left:8px;z-index:10;background:#0D1319;border:1px solid var(--line);
  border-radius:8px;padding:10px 12px;font-size:11.5px;line-height:1.55;pointer-events:none;opacity:0;
