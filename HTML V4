.gantt-bldg-head{background:#0D141C;font-family:var(--mono);font-size:11px;color:var(--blue);padding:8px 12px;border-bottom:1px solid var(--line-soft);position:sticky;left:0;width:fit-content;}

/* ---------- Modal ---------- */
.modal-bg{position:fixed;inset:0;background:rgba(4,6,9,.7);backdrop-filter:blur(2px);display:flex;align-items:center;justify-content:center;z-index:100;}
.modal{background:var(--panel);border:1px solid var(--line);border-radius:14px;max-width:560px;width:92%;padding:22px 24px;max-height:82vh;overflow-y:auto;}
