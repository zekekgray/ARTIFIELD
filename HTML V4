function esc(s){ return (s==null?'':String(s)).replace(/[&<>"]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
/* === ONCLICK-SAFE ARGUMENT ESCAPING: START ===
   Ang esc() ay HTML-escape lang (&, <, >, ") — hindi hinahawakan ang single
   quote ('). Kapag ang building/trade/item name ay may apostrophe (hal.
   "Contractor's Mix", "D'Building" — karaniwan sa totoong construction
   data), nasisira ang JS string literal sa loob ng onclick="...('...')"
   attribute, kaya tahimik na hindi gumagana ang button (walang error,
   basta't walang epekto ang click). Ginagamit ito sa halip na esc() kapag
   ang value ay ipinapasok bilang JS string ARGUMENT sa loob ng onclick/
   onchange handler (hindi para sa text content — doon esc() pa rin). */
function escOnclickArg(s){
  return String(s==null?'':s)
    .replace(/\\/g,'\\\\')
    .replace(/'/g,"\\'")
    .replace(/"/g,'&quot;')
    .replace(/</g,'&lt;')
    .replace(/>/g,'&gt;')
    .replace(/\n/g,'\\n')
    .replace(/\r/g,'');
}
/* === ONCLICK-SAFE ARGUMENT ESCAPING: END === */
function peso(n){ if(n==null||isNaN(n)) return '—'; const sign = n<0?'-':''; return sign+'₱'+Math.round(Math.abs(n)).toLocaleString('en-PH'); }

const LEVEL_PATTERNS = [
  [/ground\s*floor|^gf\b/i,'Ground Floor'],
  [/(\d+)(st|nd|rd|th)\s*f\s*loor/i, m=>`${m[1]}${m[2]} Floor`],
  [/mezzanine/i,'Mezzanine'],
  [/podium/i,'Podium'],
  [/roof\s*deck|^roof/i,'Roof Deck'],
  [/basement|^b\d/i,'Basement'],
  [/penthouse/i,'Penthouse'],
];
function detectLevel(text){
  if(!text) return null;
  for(const [re, out] of LEVEL_PATTERNS){
    const m = text.match(re);
    if(m) return (typeof out==='function') ? out(m) : out;
  }
  return null;
}

/* ---------------------------------------------------------------------
   SCHEDULE PARSER — header/column auto-detection, generic across formats
   --------------------------------------------------------------------- */
function sheetToMatrix(ws){
  return XLSX.utils.sheet_to_json(ws, {header:1, raw:true, defval:null});
}

function findHeaderCols(matrix){
  const found = { desc:null, start:null, finish:null, start2:null, finish2:null, weight:null, acc:null, accConfidence:null, duration:null, actId:null };
  const maxScanRow = Math.min(25, matrix.length);
  let startCols = [], finishCols = [];
  /* === ACC COLUMN DETECTION HARDENING: START ===
     Dati: basta may "to-date" sa header text, kunin agad ang c+1 bilang value
     column — walang paraan malaman kung tama. Ngayon, nirarank ang mga
     candidate: "high" kung may %/pct/percent mismo sa parehong header cell,
     "medium" kung ang KASUNOD na header cell ang may %, "low" kung wala
     talagang %-indicator kahit saan (yung dating blind guess). Pinipili ang
     pinaka-mataas ang confidence; ang confidence ay ikina-carry sa task-level
     dataIssues kapag "low" para malaman ng user na dapat i-verify. */
  let accCandidates = [];
  /* === ACC COLUMN DETECTION HARDENING: END === */
  for(let r=0;r<maxScanRow;r++){
    const row = matrix[r] || [];
    for(let c=0;c<row.length;c++){
      const v = row[c];
      if(typeof v !== 'string') continue;
      const t = v.trim().toLowerCase();
      if(/^start$/.test(t)) startCols.push(c);
      if(/^(finish|end)$/.test(t)) finishCols.push(c);
      /* === P6 ACTIVITY ID DETECTION: START === */
      if(found.actId===null && /^(activity|act)\s*id$|^p6\s*id$|^task\s*id$/.test(t)) found.actId = c;
      /* === P6 ACTIVITY ID DETECTION: END === */
      if(found.desc===null && !/\bid$/.test(t) && /(work )?description|item.*desc|activity/.test(t)) found.desc = c;
      if(found.weight===null && (/\bwt\b|weight\s*%/.test(t))) found.weight = c;
      if(found.duration===null && /duration|^days$/.test(t)) found.duration = c;
      /* === ACC COLUMN DETECTION HARDENING: START === */
      if(/to\s*-?\s*date/.test(t)){
        if(/%|pct|percent/.test(t)){
          accCandidates.push({col:c, confidence:'high'});
        } else {
          const nextHeader = row[c+1];
          if(typeof nextHeader === 'string' && /%|pct|percent/.test(nextHeader.toLowerCase())){
            accCandidates.push({col:c+1, confidence:'medium'});
          } else {
            accCandidates.push({col:c+1, confidence:'low'});
          }
        }
      }
      /* === ACC COLUMN DETECTION HARDENING: END === */
    }
  }
  if(startCols.length){ found.start = startCols[0]; found.finish = (finishCols[0]!=null)?finishCols[0]:startCols[0]+1; }
  if(startCols.length>1){ found.start2 = startCols[1]; found.finish2 = (finishCols[1]!=null)?finishCols[1]:startCols[1]+1; }
  /* === ACC COLUMN DETECTION HARDENING: START === */
  if(accCandidates.length){
    const rank = {high:3, medium:2, low:1};
    accCandidates.sort((a,b)=>rank[b.confidence]-rank[a.confidence]);
    found.acc = accCandidates[0].col;
    found.accConfidence = accCandidates[0].confidence;
  }
  /* === ACC COLUMN DETECTION HARDENING: END === */
  return found;
}

function guessDescCol(matrix, headerCols){
  if(headerCols.desc!=null) return headerCols.desc;
  const colCount = {};
  for(const row of matrix){
    if(!row) continue;
    for(let c=0;c<Math.min(row.length,6);c++){
      if(typeof row[c]==='string' && row[c].trim().length>2 && isNaN(Date.parse(row[c]))){
        colCount[c] = (colCount[c]||0)+1;
      }
    }
  }
  let best=1, bestCt=-1;
  for(const c in colCount){ if(colCount[c]>bestCt){ bestCt=colCount[c]; best=+c; } }
  return best;
}

function extractProjectMeta(matrix){
  let building=null, trade=null;
  const maxScan = Math.min(10, matrix.length);
  for(let r=0;r<maxScan;r++){
    const row = matrix[r]||[];
    for(let c=0;c<row.length;c++){
      const v = row[c];
      if(typeof v!=='string') continue;
      const label = v.trim().toLowerCase().replace(/:$/,'').trim();
      if(label!=='scope' && label!=='subject' && label!=='project') continue;
      let val=null;
      for(let cc=c+1; cc<row.length; cc++){
        let cv = row[cc];
        if(cv==null) continue;
        if(typeof cv==='string'){ cv = cv.replace(/^:\s*/,'').trim(); if(cv==='') continue; }
        val = cv; break;
      }
      if(val==null) continue;
      if(label==='scope' && !trade) trade = String(val).trim();
      if(label==='subject'){
        const bm = String(val).match(/BUILDING\s+([A-Z0-9]+)/i);
        if(bm && !building) building = bm[1].toUpperCase();
      }
    }
  }
  return {building, trade};
}

const PROJECT_MIN_DATE = new Date('2018-01-01');
const PROJECT_MAX_DATE = new Date('2033-12-31');
function isSaneDate(d){ return d instanceof Date && !isNaN(d) && d>=PROJECT_MIN_DATE && d<=PROJECT_MAX_DATE; }

/* === DATE LOGIC VALIDATION: START ===
   Ang isSaneDate() lang (2018-2033 range check) ay hindi sapat — puwedeng
   "sane" ang isang petsa (nasa loob ng range) pero logically mali pa rin
   ang pagkakasunod-sunod nito. Ito ang CONFIRMED_ERROR-level na check na
   kulang: Revised Finish na mas maaga sa Revised Start (internal
   contradiction sa parehong row), o Revised Finish na mas maaga pa sa
   Planned Start (malamang mali ang column mapping o typo sa revision
   entry). Tinatawag ito sa LAHAT ng ingestion path — xlsx parser, Vex JSON
   import, at manual edit — para consistent ang validation kahit saan
   nanggaling ang data. */
function checkDateLogicIssues(plannedStart, plannedFinish, revisedStart, revisedFinish){
  const issues = [];
  const ps = plannedStart ? new Date(plannedStart) : null;
  const rs = revisedStart ? new Date(revisedStart) : null;
  const rf = revisedFinish ? new Date(revisedFinish) : null;
  if(rs && rf && rf < rs){
    issues.push('Revised Finish is earlier than Revised Start in the same row — internally contradictory dates.');
  }
  if(rf && ps && rf < ps){
    issues.push('Revised Finish is earlier than the original Planned Start — likely a column mix-up or bad revision entry.');
  }
  return issues;
}
/* === DATE LOGIC VALIDATION: END === */

function guessBuildingFromSheetName(name){
  const m = name.match(/BUILDING\s+([A-Z0-9]+)|BLDG\s+([A-Z0-9]+)/i);
  if(m) return (m[1]||m[2]).toUpperCase();
  return null;
}

function looksLikePrimarySheet(name){
  const n = name.toUpperCase();
  if(/_RAW|RAW$|CONSO|SUMMARY|DELIVERY|MANPOWER|^SHEET\d|TRIGGER|BATCH|\(2\)/.test(n)) return false;
  return /BUILDING|BLDG/.test(n) || true;
}

function parseSheet(wb, sheetName, fileLabel, overrides){
  const ws = wb.Sheets[sheetName];
  const matrix = sheetToMatrix(ws);
  const headerCols = findHeaderCols(matrix);
  const descCol = guessDescCol(matrix, headerCols);
  const meta = extractProjectMeta(matrix);
  const building = canonicalizeBuilding((overrides && overrides.building) || guessBuildingFromSheetName(sheetName) || meta.building || sheetName);

  const trade = (overrides && overrides.trade) || meta.trade || fileLabel;

  const tasks = [];
  let cat = null, subcat = null;
  const occurrence = {};
  const startCol = headerCols.start, finishCol = headerCols.finish;
  const start2Col = headerCols.start2, finish2Col = headerCols.finish2;
  const actIdCol = headerCols.actId;

  for(let r=0;r<matrix.length;r++){
    const row = matrix[r];
    if(!row) continue;
    const descRaw = row[descCol];
    if(descRaw==null || (typeof descRaw==='string' && descRaw.trim()==='')) continue;
    const desc = String(descRaw).trim();
    if(/^(building|bldg)\s/i.test(desc) && desc.length<20) continue;
    const actIdRaw = actIdCol!=null ? row[actIdCol] : null;
    const p6ActivityId = (actIdRaw!=null && String(actIdRaw).trim()!=='') ? String(actIdRaw).trim() : null;

    const sVal = startCol!=null ? row[startCol] : null;
    const fVal = finishCol!=null ? row[finishCol] : null;
    let start = excelDateToJS(sVal);
    let finish = excelDateToJS(fVal);

    if(!start || !finish){
      if(cat===null || subcat!==null){ cat = desc; subcat = null; }
      else { subcat = desc; }
      continue;
    }

    const issues = [];
    if(!isSaneDate(start) || !isSaneDate(finish)){
      issues.push('Planned Start/Finish landed outside the expected project window ('+fmtDate(start)+' – '+fmtDate(finish)+') — likely an uncalculated formula in the source file.');
    }

    let s2 = start2Col!=null ? excelDateToJS(row[start2Col]) : null;
    let f2 = finish2Col!=null ? excelDateToJS(row[finish2Col]) : null;
    if((s2 && !isSaneDate(s2)) || (f2 && !isSaneDate(f2))){
      issues.push('Revised Start/Finish landed outside the expected project window — likely an uncalculated formula in the source file.');
      s2 = null; f2 = null;
    }
    issues.push(...checkDateLogicIssues(start, null, s2, f2));
    const weight = headerCols.weight!=null ? Number(row[headerCols.weight])||0 : null;
    const accRaw = headerCols.acc!=null ? row[headerCols.acc] : null;
    let accWeighted = null, accPct = null;
    if(accRaw!=null){
      const n = Number(accRaw);
      if(!isNaN(n)){
        accWeighted = n>1 ? n/100 : n;
        accPct = (weight && weight>0) ? clamp(accWeighted/weight*100, 0, 100) : null;
      }
    }
    /* === ACC COLUMN DETECTION HARDENING: START === */
    if(accPct!=null && headerCols.accConfidence==='low'){
      issues.push('Accomplishment % column was guessed (header said "to-date" without a clear %/pct label nearby) — verify this value against the source file. Not excluded from charts.');
    }
    /* === ACC COLUMN DETECTION HARDENING: END === */
    const level = detectLevel(desc) || detectLevel(subcat) || detectLevel(cat);
    const occKey = [building, trade, cat, subcat, desc].map(slug).join('|');
    occurrence[occKey] = (occurrence[occKey]||0) + 1;

    /* === VEX SCHEMA SYNC: START ===
       sourceRowRef: parehong locator format na ginagamit ng Vex
       (`<file> · <sheet> · row N`) para direktang maitugma/ma-cross-reference
       ang xlsx-imported at Vex-imported na tasks sa parehong table.
       confidence: 'low' kung may dataIssues na (hal. out-of-range date),
       'medium' kung na-guess lang ang Accomplishment % column, 'high' kung
       walang kahit anong red flag sa row na ito.
       isMilestone: zero-duration na row (parehong Start at Finish) —
       hindi kailanman ini-infer mula sa maikling duration lang. */
    tasks.push({
      building: String(building).trim(),
      trade: String(trade).trim(),
      category: cat || '',
      subcategory: subcat || '',
      name: desc,
      p6ActivityId: p6ActivityId,
      level: level,
      isMilestone: (+start === +finish),
      occurrence: occurrence[occKey],
      plannedStart: start.toISOString(),
      plannedFinish: finish.toISOString(),
      revisedStart: s2 ? s2.toISOString() : null,
      revisedFinish: f2 ? f2.toISOString() : null,
      weightPct: weight,
      accToDatePct: accPct,
      sourceFile: fileLabel,
      sourceSheet: sheetName,
      sourceRowRef: fileLabel+' · '+sheetName+' · row '+(r+1),
      confidence: issues.length ? 'low' : (headerCols.accConfidence==='low' ? 'medium' : 'high'),
      rowIndex: r,
      dataIssues: issues,
    });
    /* === VEX SCHEMA SYNC: END === */
  }
  /* === WEIGHT SCALE NORMALIZATION: START ===
     Ilang source files ay nag-iimbak ng WT% bilang fraction ng 1 (0.029 = 2.9%)
     sa halip na buong percentage. Kung ang kabuuan ng weights sa sheet na ito
     ay malapit sa 1 (hindi sa 100), i-multiply ng 100 lahat para consistent
     sa 0-100 scale na inaasahan ng computeWeightWarnings at ng Database tab. */
  const weightedTasks = tasks.filter(t=>t.weightPct!=null);
  if(weightedTasks.length){
    const sumW = weightedTasks.reduce((s,t)=>s+t.weightPct,0);
    if(sumW>0 && sumW<3){
      weightedTasks.forEach(t=>{ t.weightPct = t.weightPct*100; });
    }
  }
  /* === WEIGHT SCALE NORMALIZATION: END === */
  return tasks;
}

function makeTaskId(t){
  /* === P6 LINK: START ===
     Kapag may Activity ID mula sa P6 export, iyon na ang unique key — mas stable
     ito kaysa sa name-based slug pag nagbago ang description sa susunod na
     re-import. Fallback sa dating slug key kapag walang Activity ID. */
  if(t.p6ActivityId){
    return 'p6-' + hashKey(t.building + '|' + slug(t.p6ActivityId));
  }
  /* === P6 LINK: END === */
  return hashKey([t.building, t.trade, t.category, t.subcategory, t.name, t.occurrence||1].map(slug).join('|'));
}

/* === P6 ID MIGRATION RECONCILIATION: START ===
   Ang legacy (name-based) id ng isang task — kailangan ito para makilala kung
   ang isang bagong task na may p6ActivityId ngayon ay yun din yung dating
   task na wala pang Activity ID noong una itong na-import. */
function makeLegacyTaskId(t){
  return hashKey([t.building, t.trade, t.category, t.subcategory, t.name, t.occurrence||1].map(slug).join('|'));
}
/* === P6 ID MIGRATION RECONCILIATION: END === */

/* ---------------------------------------------------------------------
   MERGE ENGINE — revision diffing against existing DB
   --------------------------------------------------------------------- */
function mergeIntoDB(newTasks){
  const now = new Date().toISOString();
  const existingById = {};
  state.tasks.forEach(t=>existingById[t.id]=t);
  let added=0, shifted=0, unchanged=0, migrated=0, lockedSkipped=0;

  newTasks.forEach(nt=>{
    const id = makeTaskId(nt);
    let prev = existingById[id];

    /* === P6 ID MIGRATION RECONCILIATION: START ===
       Kung may bagong p6ActivityId ang task pero wala pang entry sa ilalim
       ng bagong p6-based id, tignan muna kung may existing entry sa ilalim ng
       lumang legacy (name-based) id na wala pang p6ActivityId — kung meron,
       ituring itong parehong task (i-migrate ang id nito, i-carry over ang
       revisionHistory) sa halip na gumawa ng duplicate entry. Yung mga
       historical accomplishment snapshot na naka-key sa lumang id ay
       kino-carry over din papunta sa bagong id, para hindi maputol yung
       S-curve history ng task na ito. */
    if(!prev && nt.p6ActivityId){
      const legacyId = makeLegacyTaskId(nt);
      const legacyPrev = existingById[legacyId];
      if(legacyPrev && !legacyPrev.p6ActivityId){
        delete existingById[legacyId];
        const oldId = legacyPrev.id;
        legacyPrev.id = id;
        legacyPrev.p6ActivityId = nt.p6ActivityId;
        existingById[id] = legacyPrev;
        prev = legacyPrev;
        migrated++;
        state.snapshots.forEach(snap=>{
          if(snap.values[oldId]!=null && snap.values[id]==null){
            snap.values[id] = snap.values[oldId];
            delete snap.values[oldId];
          }
        });
      }
    }
    /* === P6 ID MIGRATION RECONCILIATION: END === */

    /* === FROZEN ORIGINAL BASELINE: START ===
       plannedStart/plannedFinish ay MUTABLE — kapag nagbago ang source file
       (kahit ang "Planned" column mismo, hindi lang Revised), tahimik itong
       ino-overwrite ng mergeIntoDB dati, at ang lumang value ay mapupunta
       lang sa revisionHistory (kailangan pang balikan nang manual). Ito ang
       hiwalay, HINDI kailanman babaguhin pagkatapos ng unang import,
       tunay na "Day-1" reference point. Migration line dito para sa mga
       existing task na na-import na bago dumating ang patch na ito — ang
       kasalukuyang plannedStart/Finish nila sa oras na ito ang pinaka-maaga
       na value na alam natin, kaya iyon na ang gagamitin bilang original. */
    if(prev && prev.originalPlannedStart==null){
      prev.originalPlannedStart = prev.plannedStart;
      prev.originalPlannedFinish = prev.plannedFinish;
    }
    /* === FROZEN ORIGINAL BASELINE: END === */

    if(!prev){
      const newRec = Object.assign({}, nt, {
        id, status:'New', importedAt: now, revisionHistory: [],
        originalPlannedStart: nt.plannedStart, originalPlannedFinish: nt.plannedFinish,
      });
      state.tasks.push(newRec);
      existingById[id] = newRec;
      added++;
    } else if(prev.locked){
      /* === TASK LOCKING: START ===
         Kahit may bagong dates/weight/accomplishment ang paparating na
         import, hindi ito basta ino-overwrite dito — ang task ay
         na-verify na ng tao. Sa halip, itala bilang pending conflict para
         ma-review at manual na i-apply o i-dismiss (Clash & Sequence Log). */
      const wouldChange = prev.plannedStart!==nt.plannedStart || prev.plannedFinish!==nt.plannedFinish ||
                           prev.revisedStart!==nt.revisedStart || prev.revisedFinish!==nt.revisedFinish ||
                           prev.weightPct!==nt.weightPct || prev.accToDatePct!==nt.accToDatePct;
      if(wouldChange){
        state.lockedImportConflicts.push({
          id: hashKey(['lockconf', prev.id, now, nt.sourceRowRef||''].join('|')),
          taskId: prev.id, taskName: prev.name, building: prev.building,
          current: { plannedStart: prev.plannedStart, plannedFinish: prev.plannedFinish,
                      revisedStart: prev.revisedStart, revisedFinish: prev.revisedFinish,
                      weightPct: prev.weightPct, accToDatePct: prev.accToDatePct },
          incoming: { plannedStart: nt.plannedStart, plannedFinish: nt.plannedFinish,
                      revisedStart: nt.revisedStart, revisedFinish: nt.revisedFinish,
                      weightPct: nt.weightPct, accToDatePct: nt.accToDatePct },
          sourceRowRef: nt.sourceRowRef || '', at: now,
        });
        lockedSkipped++;
      } else {
        unchanged++;
      }
      /* === TASK LOCKING: END === */
    } else {
      const changed = prev.plannedStart!==nt.plannedStart || prev.plannedFinish!==nt.plannedFinish ||
                       prev.revisedStart!==nt.revisedStart || prev.revisedFinish!==nt.revisedFinish;
      if(changed){
        prev.revisionHistory = prev.revisionHistory || [];
        prev.revisionHistory.push({
          at: prev.importedAt || now,
          plannedStart: prev.plannedStart, plannedFinish: prev.plannedFinish,
          revisedStart: prev.revisedStart, revisedFinish: prev.revisedFinish,
        });
        const shiftDays = daysBetween(prev.plannedFinish, nt.plannedFinish);
        Object.assign(prev, nt, { id: prev.id, status:'Shifted', importedAt: now, shiftDays });
        shifted++;
      } else {
        Object.assign(prev, nt, { id: prev.id, importedAt: prev.importedAt || now });
        unchanged++;
      }
    }
  });
  state.lastImport = now;
  if(lockedSkipped) saveLockedConflicts();
  return {added, shifted, unchanged, migrated, lockedSkipped};
}

/* ---------------------------------------------------------------------
   SCHEDULE ENGINES
   --------------------------------------------------------------------- */
function hasValidDates(t){
  const s = new Date(t.plannedStart), f = new Date(t.plannedFinish);
  return isSaneDate(s) && isSaneDate(f) && f>=s;
}
function activeRange(t){
  const s = t.revisedStart || t.plannedStart;
  const f = t.revisedFinish || t.plannedFinish;
  return [new Date(s), new Date(f)];
}
function overlapDays(aS,aF,bS,bF){
  const s = Math.max(+aS, +bS), f = Math.min(+aF, +bF);
  return f>s ? Math.round((f-s)/DAY) : 0;
}
function pairKey(a,b){ return [a,b].sort().join('|'); }

function computeSequenceViolations(){
  const violations = [];
  const groups = {};
  /* === CROSS-TRADE SEQUENCE CHECK: START ===
     Grouping by building+level lang (tinanggal ang category at ang same-file
     restriction) — kasi iba-iba ang category naming convention per trade file,
     kaya hindi rin naman gumagana yung dating grouping across files. Sort by
     actual start date (hindi na rowIndex, dahil walang meaning yun across
     magkaibang files). Same-trade adjacent pairs sina-skip dahil yun ay
     nase-cover na ng ordering sa loob mismo ng trade's own file/revisions —
     ang gap na hinahanap dito ay yung cross-trade predecessor/successor
     issues (hal. Plumbing rough-in dapat matapos bago CSA finishing). */
  state.tasks.filter(hasValidDates).forEach(t=>{
    const key = [t.building, t.level||''].join('||');
    (groups[key] = groups[key]||[]).push(t);
  });
  Object.values(groups).forEach(list=>{
    list.sort((a,b)=>{
      const [aS] = activeRange(a);
      const [bS] = activeRange(b);
      return aS - bS;
    });
    for(let i=1;i<list.length;i++){
      const prev = list[i-1], cur = list[i];
      if(prev.trade===cur.trade) continue;
      const [,prevF] = activeRange(prev);
      const [curS] = activeRange(cur);
      const gap = daysBetween(prevF.toISOString(), curS.toISOString());
      if(gap!==null && gap < 0){
        violations.push({
          type:'sequence', severity: Math.abs(gap)>14?'High': Math.abs(gap)>5?'Medium':'Low',
          taskA: prev, taskB: cur, overlapDays: Math.abs(gap),
          note: `"${cur.name}" (${cur.trade}) starts ${Math.abs(gap)}d before "${prev.name}" (${prev.trade}) finishes`,
        });
      }
    }
  });
  return violations;
  /* === CROSS-TRADE SEQUENCE CHECK: END === */
}

function computeSpaceTimeClashes(){
  const clashes = [];
  const groups = {};
  state.tasks.filter(hasValidDates).forEach(t=>{
    if(!t.level) return;
    const key = [t.building, t.level].join('||');
    (groups[key] = groups[key]||[]).push(t);
  });
  Object.values(groups).forEach(list=>{
    for(let i=0;i<list.length;i++){
      for(let j=i+1;j<list.length;j++){
        const a=list[i], b=list[j];
        if(a.trade===b.trade) continue;
        if(state.compatiblePairs[pairKey(a.trade,b.trade)]) continue;
        const [aS,aF] = activeRange(a), [bS,bF] = activeRange(b);
        const ov = overlapDays(aS,aF,bS,bF);
        if(ov >= 4){
          clashes.push({
            type:'space-time', severity: ov>21?'High': ov>10?'Medium':'Low',
            taskA:a, taskB:b, overlapDays: ov,
            note: `${a.trade} vs ${b.trade} both active in ${a.building} · ${a.level} for ${ov} overlapping days`,
          });
        }
      }
    }
  });
  return clashes.sort((x,y)=>y.overlapDays-x.overlapDays);
}

/* === UNLEVELED TASK VISIBILITY: START ===
   Mga tasks na may valid dates pero walang na-detect na floor/level (walang
   match sa LEVEL_PATTERNS) ay dati tahimik na sina-skip sa
   computeSpaceTimeClashes — walang paraan malaman ng user. Ito ang query
   para ma-expose sila sa UI. */
function computeUnleveledTasks(){
  return state.tasks.filter(t=>hasValidDates(t) && !t.level);
}
/* === UNLEVELED TASK VISIBILITY: END === */

function computeShiftedTasks(){
  return state.tasks.filter(t=>t.status==='Shifted' && !state.verifications[t.id]);
}

/* === FIELD UPDATE + SMART VALIDATION: START === */
function validateFieldUpdate(task, newPct, dateISO, prevUpdateForDay){
  const flags = [];
  const prevPct = task.accToDatePct;
  if(prevPct!=null && newPct < prevPct - 0.01){
    flags.push({level:'warn', message:`Progress decreased: ${prevPct.toFixed(1)}% → ${newPct.toFixed(1)}%. Confirm this isn't a typo or a rework/rejection.`});
  }
  if(newPct > 100){
    flags.push({level:'error', message:`Accomplishment cannot exceed 100% (entered ${newPct.toFixed(1)}%).`});
  }
  if(hasValidDates(task)){
    const [,f] = activeRange(task);
    const d = new Date(dateISO);
    if(d > f && newPct < 99.5){
      flags.push({level:'warn', message:`Update date (${fmtDate(d)}) is past the planned/revised finish (${fmtDate(f)}) but accomplishment is only ${newPct.toFixed(1)}% — finish date may need revision.`});
    }
  }
  if(prevUpdateForDay){
    flags.push({level:'warn', message:`Another update was already logged for this task on ${fmtDate(new Date(dateISO))} (${prevUpdateForDay.newPct.toFixed(1)}%) — this will overwrite/correct that entry, not add a duplicate day.`});
  }
  return flags;
}
function computeFlaggedFieldUpdates(){
  return state.fieldUpdates.filter(u=>u.flags && u.flags.length).sort((a,b)=>new Date(b.at)-new Date(a.at));
}
/* === FIELD UPDATE + SMART VALIDATION: END === */

/* === 7 S-CURVES: START ===
   Ang 7 kinikilalang S-Curve types sa construction planning practice (PSP/PMP/P6):
   Category A (Physical Progress %): (1) Master, (2) Per-Building/Zone,
   (3) Per-Trade — covered na ng buildScurveSVG (Dashboard/S-Curve/Trades tabs).
   Category B (Volume & Time-Based): (4) Cost/Cash Flow, (5) Manpower,
   (6) Banana Curve, (7) Material & Equipment — apat na dinagdag dito. */

function cumulativeLogValueAt(logs, valueField, date){
  const t = +date;
  let sum = 0;
  logs.forEach(l=>{ if(+new Date(l.date) <= t) sum += Number(l[valueField])||0; });
  return sum;
}

function buildValueScurveSVG(opts){
  // opts: {label, tasks, plannedTotal, actualLogs, valueField, unitLabel, formatValue}
  const withDates = opts.tasks.filter(hasValidDates);
  if(withDates.length===0 || !opts.plannedTotal){
    return `<div class="help">Not enough data yet — need dated schedule tasks and a planned total (set it above) to draw this curve.</div>`;
  }
  let minD = new Date(Math.min(...withDates.map(t=>+new Date(t.plannedStart))));
  let maxD = new Date(Math.max(...withDates.map(t=>+new Date(t.revisedFinish||t.plannedFinish))));
  /* === HORIZON FIX: START ===
     Dating naka-clamp ang maxD papuntang Dec 31, 2030 kahit matagal nang
     dapat matapos ang project — kaya artificially lumalaki ang buong date
     span, at ang bawat isa sa 60 sampling steps ng chart ay tumatalon ng
     mas malaking bilang ng araw kaysa dapat (hal. Aug 1 → Sep 9 → Oct 8
     sa halip na malinaw na pantay-pantay na agwat). Ngayon, ang aktwal na
     huling plannedFinish/revisedFinish sa dataset mismo ang dulo ng chart,
     may +14 days na maliit na padding lang para may espasyo ang huling
     datapoint. */
  maxD = new Date(+maxD + 14*DAY);
  /* === HORIZON FIX: END === */

  const W=900, H=260, padL=64, padR=18, padT=16, padB=30;
  const totalW = W-padL-padR, totalH = H-padT-padB;
  const totalDays = Math.max(1,(maxD-minD)/DAY);
  const steps = 60;
  const rawPts = [];
  for(let i=0;i<=steps;i++){
    const d = new Date(+minD + (totalDays*i/steps)*DAY);
    const planned = weightedPlannedPct(withDates, d)/100 * opts.plannedTotal;
    const actual = (d<=state.asOfDate) ? cumulativeLogValueAt(opts.actualLogs, opts.valueField, d) : null;
    rawPts.push({d, planned, actual});
  }
  const maxVal = Math.max(opts.plannedTotal, ...rawPts.filter(p=>p.actual!=null).map(p=>p.actual), 1) * 1.08;
  const x = d => padL + ((d-minD)/DAY)/totalDays*totalW;
  const y = v => padT + totalH - (clamp(v,0,maxVal)/maxVal)*totalH;

  const plannedPath = rawPts.map((p,i)=>`${i===0?'M':'L'}${x(p.d).toFixed(1)},${y(p.planned).toFixed(1)}`).join(' ');
  const actualPtsOnly = rawPts.filter(p=>p.actual!=null);
  const actualPath = actualPtsOnly.map((p,i)=>`${i===0?'M':'L'}${x(p.d).toFixed(1)},${y(p.actual).toFixed(1)}`).join(' ');
  const todayX = x(clamp(state.asOfDate, minD, maxD));

  let gridlines='', yearLabels='';
  for(let yr=minD.getFullYear(); yr<=maxD.getFullYear(); yr++){
    const gd = new Date(yr,0,1);
    if(gd<minD||gd>maxD) continue;
    const gx = x(gd);
    gridlines += `<line x1="${gx}" y1="${padT}" x2="${gx}" y2="${padT+totalH}" stroke="#1A222C" stroke-width="1"/>`;
    yearLabels += `<text x="${gx}" y="${H-8}" fill="#546274" font-size="10" font-family="var(--mono)">${yr}</text>`;
  }
  let hlines='';
  [0,0.25,0.5,0.75,1].forEach(f=>{
    const v = f*maxVal;
    hlines += `<line x1="${padL}" y1="${y(v)}" x2="${W-padR}" y2="${y(v)}" stroke="#161D26" stroke-width="1"/>`;
    hlines += `<text x="4" y="${y(v)+3}" fill="#546274" font-size="10" font-family="var(--mono)">${opts.formatValue(v)}</text>`;
  });

  const latestActual = [...actualPtsOnly].reverse()[0];
  const latestPlanned = rawPts.filter(p=>p.d<=state.asOfDate).slice(-1)[0];
  const variance = (latestActual && latestPlanned) ? latestActual.actual - latestPlanned.planned : null;

  return `
  <h4>${esc(opts.label)}</h4>
  <div class="sub">Horizon: ${fmtDate(minD)} → ${fmtDate(maxD)} · today = ${fmtDate(state.asOfDate)} · unit: ${esc(opts.unitLabel)}</div>
  <svg viewBox="0 0 ${W} ${H}" style="width:100%;height:auto;display:block;">
    ${hlines}${gridlines}
    <line x1="${todayX}" y1="${padT}" x2="${todayX}" y2="${padT+totalH}" stroke="#FFB020" stroke-width="1.3" stroke-dasharray="4 3"/>
    <path d="${plannedPath}" fill="none" stroke="#4FC3F7" stroke-width="2.4"/>
    <path d="${actualPath}" fill="none" stroke="#3DDC84" stroke-width="2.4"/>
    ${yearLabels}
  </svg>
  <div class="legend">
    <span><i style="background:#4FC3F7"></i> Planned (time-phased from schedule %)</span>
    <span><i style="background:#3DDC84"></i> Actual (from logged entries)</span>
  </div>
  <div class="legend" style="margin-top:4px;">
    <span>Planned to-date: <b>${latestPlanned?opts.formatValue(latestPlanned.planned):'—'}</b></span>
    <span>Actual to-date: <b>${latestActual?opts.formatValue(latestActual.actual):'—'}</b></span>
    <span>Variance: <b style="color:${variance==null?'var(--text-dim)':(variance<0?'var(--red)':'var(--green)')}">${variance==null?'—':opts.formatValue(variance)}</b></span>
  </div>`;
}

function buildBananaCurveSVG(tasks, label){
  const withDates = tasks.filter(hasValidDates);
  if(withDates.length===0) return `<div class="help">No dated tasks for ${esc(label)}.</div>`;
  let minD = new Date(Math.min(...withDates.map(t=>+new Date(t.plannedStart))));
  let maxD = new Date(Math.max(...withDates.map(t=>+new Date(t.revisedFinish||t.plannedFinish))));
  /* === HORIZON FIX: START === (see buildValueScurveSVG for full rationale) */
  maxD = new Date(+maxD + 14*DAY);
  /* === HORIZON FIX: END === */

  const W=900, H=280, padL=46, padR=18, padT=16, padB=30;
  const totalW = W-padL-padR, totalH = H-padT-padB;
  const totalDays = Math.max(1,(maxD-minD)/DAY);
  const steps = 60;
  const x = d => padL + ((d-minD)/DAY)/totalDays*totalW;
  const y = p => padT + totalH - (clamp(p,0,100)/100)*totalH;

  function plannedPctAtOriginal(date){
    let w=0, sum=0;
    withDates.forEach(t=>{
      if(t.weightPct==null) return;
      const s = new Date(t.plannedStart), f = new Date(t.plannedFinish);
      const dur = Math.max(1,(f-s)/DAY);
      const elapsed = clamp((date-s)/DAY,0,dur);
      w += t.weightPct;
      sum += t.weightPct*(elapsed/dur)*100;
    });
    return w>0 ? sum/w : 0;
  }

  const rawPts = [];
  for(let i=0;i<=steps;i++){
    const d = new Date(+minD + (totalDays*i/steps)*DAY);
    rawPts.push({
      d,
      early: plannedPctAtOriginal(d),
      late: weightedPlannedPct(withDates, d),
      actual: (d<=state.asOfDate) ? weightedActualPctAtDate(withDates, d) : null,
    });
  }

  const linePath = field => rawPts.map((p,i)=>`${i===0?'M':'L'}${x(p.d).toFixed(1)},${y(p[field]).toFixed(1)}`).join(' ');
  const earlyPath = linePath('early');
  const latePath = linePath('late');
  const bandPath = earlyPath + ' L' + [...rawPts].reverse().map(p=>`${x(p.d).toFixed(1)},${y(p.late).toFixed(1)}`).join(' L') + ' Z';
  const actualPtsOnly = rawPts.filter(p=>p.actual!=null);
  const actualPath = actualPtsOnly.map((p,i)=>`${i===0?'M':'L'}${x(p.d).toFixed(1)},${y(p.actual).toFixed(1)}`).join(' ');
  const todayX = x(clamp(state.asOfDate, minD, maxD));

  let gridlines='', yearLabels='';
  for(let yr=minD.getFullYear(); yr<=maxD.getFullYear(); yr++){
    const gd = new Date(yr,0,1);
    if(gd<minD||gd>maxD) continue;
    const gx = x(gd);
    gridlines += `<line x1="${gx}" y1="${padT}" x2="${gx}" y2="${padT+totalH}" stroke="#1A222C" stroke-width="1"/>`;
    yearLabels += `<text x="${gx}" y="${H-8}" fill="#546274" font-size="10" font-family="var(--mono)">${yr}</text>`;
  }
  let hlines='';
  [0,25,50,75,100].forEach(p=>{
    hlines += `<line x1="${padL}" y1="${y(p)}" x2="${W-padR}" y2="${y(p)}" stroke="#161D26" stroke-width="1"/>`;
    hlines += `<text x="4" y="${y(p)+3}" fill="#546274" font-size="10" font-family="var(--mono)">${p}%</text>`;
  });

  return `
  <h4>${esc(label)} — Banana Curve</h4>
  <div class="sub">Early = original baseline dates · Late = current/revised dates · band = allowable float zone · today = ${fmtDate(state.asOfDate)}</div>
  <svg viewBox="0 0 ${W} ${H}" style="width:100%;height:auto;display:block;">
    ${hlines}${gridlines}
    <path d="${bandPath}" fill="#4FC3F7" opacity="0.08" stroke="none"/>
    <line x1="${todayX}" y1="${padT}" x2="${todayX}" y2="${padT+totalH}" stroke="#FFB020" stroke-width="1.3" stroke-dasharray="4 3"/>
    <path d="${earlyPath}" fill="none" stroke="#4FC3F7" stroke-width="2" stroke-dasharray="5 3"/>
    <path d="${latePath}" fill="none" stroke="#A78BFA" stroke-width="2" stroke-dasharray="5 3"/>
    <path d="${actualPath}" fill="none" stroke="#3DDC84" stroke-width="2.6"/>
    ${yearLabels}
  </svg>
  <div class="legend">
    <span><i style="background:#4FC3F7"></i> Early / Original Baseline</span>
    <span><i style="background:#A78BFA"></i> Late / Current Program</span>
    <span><i style="background:#3DDC84"></i> Actual</span>
  </div>
  <div class="help" style="margin-top:6px;">Approximated from tracked Planned vs Revised dates (no full CPM logic-link network in this dataset) — the practical banana curve most contractors use without a fully linked P6 schedule.</div>`;
}
/* === 7 S-CURVES: END === */

 /* === SPI DENOMINATOR ALIGNMENT (Option A): START ===
   Dati, ang SPI ay gumagamit ng `pvTracked` — isang HIWALAY na denominator na
   restricted lang sa mga task na may naka-log na accToDatePct. Ibig sabihin
   magkaibang "population" ang ginagamit ng SPI number (Dashboard KPI) kumpara
   sa Planned/Actual lines mismo ng Master S-Curve (na gumagamit na ng buong
   population matapos ang Option A fix sa weightedActualPct/
   weightedPctFromSnapshot). Kaya posibleng magkaiba ang implied gap sa chart
   kumpara sa sinasabing SPI — nakalilito sa isang PM na titignan pareho.
   Ngayon, ang `pv` mismo (full-population time-phased planned value, kasama
   na ang lahat ng may weightPct) ang ginagamit bilang denominator — pareho na
   ito sa convention ng weightedPlannedPct(). Ang `ev` ay 0 pa rin ang
   kontribusyon kung walang accToDatePct (hindi tinatanggal sa dataset) —
   pareho sa convention ng weightedActualPct(). Kaya magkatugma na ngayon ang
   SPI at ang Planned/Actual lines ng Master S-Curve — parehong population,
   parehong "walang report = 0% progress" na pagpapalagay. */
function computeSPI(taskList){
  const now = state.asOfDate;
  let pv=0, bac=0, ev=0;
  taskList.filter(hasValidDates).forEach(t=>{
    if(t.weightPct==null) return;
    const [s,f] = activeRange(t);
    const dur = Math.max(1,(f-s)/DAY);
    const elapsed = clamp((now-s)/DAY, 0, dur);
    const timeFrac = elapsed/dur;
    bac += t.weightPct;
    pv += t.weightPct * timeFrac;
    if(t.accToDatePct!=null){
      ev += t.weightPct * (t.accToDatePct/100);
    }
  });
  const spi = pv>0 ? (ev/pv) : null;
  return {pv, ev, bac, spi};
}
/* === SPI DENOMINATOR ALIGNMENT (Option A): END === */

function plannedPctAt(t, date){
  const [s,f] = activeRange(t);
  const dur = Math.max(1,(f-s)/DAY);
  const elapsed = clamp((date-s)/DAY,0,dur);
  return elapsed/dur;
}
/* === ACTUAL-LINE DENOMINATOR FIX (Option A): START ===
   Dati, ang task na walang naka-log na accToDatePct ay basta tinatanggal sa
   DENOMINATOR (w) — kaya mas maliit ang population ng Actual kaysa sa
   Planned (na kumukuha ng buong weight ng lahat ng may weightPct). Ngayon,
   kasama sa denominator ang LAHAT ng may weightPct, pero ang task na walang
   accToDatePct ay itinuturing na 0% progress (standard EVM convention) sa
   halip na tanggalin — kaya magkapareho na ang population ng Planned at
   Actual lines. */
function weightedActualPct(tasks){
  let w=0, sum=0;
  tasks.filter(hasValidDates).forEach(t=>{
    if(t.weightPct==null) return;
    w+=t.weightPct;
    if(t.accToDatePct!=null) sum+=t.weightPct*t.accToDatePct;
  });
  return w>0 ? sum/w : 0;
}
/* === ACTUAL-LINE DENOMINATOR FIX (Option A): END === */
function weightedPlannedPct(tasks, date){
  let w=0, sum=0;
  tasks.filter(hasValidDates).forEach(t=>{ if(t.weightPct!=null){ w+=t.weightPct; sum += t.weightPct*plannedPctAt(t,date)*100; } });
  return w>0 ? sum/w : 0;
}

/* === ACCOMPLISHMENT SNAPSHOT LOG: START ===
   Isang snapshot ng accToDatePct per task, isang beses per araw (overwrite kung
   ilang import ang nangyari sa parehong araw). Dito hinuhugot ng S-curve ang
   totoong historical "actual" value sa halip na yung latest snapshot na lang. */
function findSnapshotAtOrBefore(date){
  const t = +date;
  let best = null;
  state.snapshots.forEach(s=>{
    const st = +new Date(s.at);
    if(st<=t && (!best || st>+new Date(best.at))) best = s;
  });
  return best;
}
/* === S-CURVE DATE SEQUENCING: START ===
   Dating step function ang actual line (naka-freeze sa huling snapshot
   hanggang sa susunod na import) — hindi tugma sa standard S-curve na dapat
   makinis at tuloy-tuloy araw-araw. Dito, hinahanap muna ang snapshot BAGO
   at PAGKATAPOS ng hiniling na petsa, tapos ginagawan ng linear
   interpolation ang weighted % sa pagitan ng dalawa — kaya kalendaryo-based
   at walang hagdan-hagdan kahit paisa-isang linggo/buwan lang ang aktwal
   na import. */
function findSurroundingSnapshots(date){
  const t = +date;
  let before = null, after = null;
  state.snapshots.forEach(s=>{
    const st = +new Date(s.at);
    if(st<=t && (!before || st>+new Date(before.at))) before = s;
    if(st>=t && (!after || st<+new Date(after.at))) after = s;
  });
  return {before, after};
}
function weightedPctFromSnapshot(tasks, snap){
  if(!snap) return null;
  let w=0, sum=0;
  /* === WEIGHT-FREEZE SNAPSHOT (read side): START ===
     Suportado pa rin ang lumang format ng snapshot (plain number, walang
     naka-freeze na weight) sa pamamagitan ng fallback sa CURRENT weight
     ng task. Para sa bagong format ({acc, weight}), ang naka-freeze na
     weight sa mismong petsang iyon ang laging gagamitin. */
  /* === ACTUAL-LINE DENOMINATOR FIX (Option A): START ===
     Dati, ang task na walang entry sa snap.values (raw==null — hindi pa
     na-track sa petsang iyon) ay basta sina-skip, kaya tinatanggal din sa
     DENOMINATOR — parehong isyu gaya ng weightedActualPct(). Ngayon, kasama
     pa rin sa denominator (w) ang buong weight nito (fallback sa
     kasalukuyang t.weightPct dahil wala pang na-freeze na historical weight
     para dito), pero 0 ang kontribusyon sa sum — itinuturing itong "0%
     progress noon" sa halip na "wala sa dataset". */
  tasks.forEach(t=>{
    if(t.weightPct==null) return;
    const raw = snap.values[t.id];
    let histAcc = null, histWeight = t.weightPct;
    if(raw!=null){
      if(typeof raw === 'number'){
        histAcc = raw;
        histWeight = t.weightPct;
      } else {
        histAcc = raw.acc;
        histWeight = raw.weight!=null ? raw.weight : t.weightPct;
      }
    }
    w += histWeight;
    if(histAcc!=null) sum += histWeight*histAcc;
  });
  /* === ACTUAL-LINE DENOMINATOR FIX (Option A): END === */
  /* === WEIGHT-FREEZE SNAPSHOT (read side): END === */
  return w>0 ? sum/w : null;
}
function weightedActualPctAtDate(tasks, date){
  /* === S-CURVE DATE SEQUENCING (backward-fill fix): START ===
     Kung wala pang snapshot BAGO sa hiniling na petsa, huwag mag-"backfill"
     gamit ang unang kilalang snapshot — magreresulta iyon sa maling flat na
     linya paatras hanggang sa simula ng project, na parang may accomplishment
     na kahit bago pa man magsimula ang pagsubaybay. Walang datos (null;
     puwang sa chart) bago ang unang totoong snapshot. Pasulong lang (mula
     huling kilalang snapshot papunta sa "today") ang flat extrapolation,
     dahil tama namang ipagpalagay na walang bagong progress kung walang
     bagong report. */
  const {before, after} = findSurroundingSnapshots(date);
  if(!before) return null;
  const beforeVal = weightedPctFromSnapshot(tasks, before);
  if(!after || before===after) return beforeVal;
  const afterVal = weightedPctFromSnapshot(tasks, after);
  if(afterVal==null) return beforeVal;
  const t0 = +new Date(before.at), t1 = +new Date(after.at), t = +date;
  if(t1<=t0) return beforeVal;
  const frac = clamp((t-t0)/(t1-t0), 0, 1);
  return beforeVal + (afterVal-beforeVal)*frac;
  /* === S-CURVE DATE SEQUENCING (backward-fill fix): END === */
}
/* === S-CURVE DATE SEQUENCING: END === */
function recordSnapshot(asOfDate){
  const today = asOfDate ? new Date(asOfDate) : new Date();
  const dayKey = today.toISOString().slice(0,10);
  const values = {};
  /* === WEIGHT-FREEZE SNAPSHOT: START ===
     Iniimbak na ang {acc, weight} object sa halip na plain number — ang
     weight na ginamit sa petsang ito ay permanenteng naka-lock sa snapshot
     mismo, kaya hindi na muling babaguhin ang kasaysayan ng S-curve kung
     babaguhin mo ang Weight % ng isang task sa hinaharap. */
  state.tasks.forEach(t=>{
    if(t.accToDatePct!=null){
      values[t.id] = { acc: t.accToDatePct, weight: t.weightPct!=null ? t.weightPct : null };
    }
  });
  /* === WEIGHT-FREEZE SNAPSHOT: END === */
  const existingIdx = state.snapshots.findIndex(s=>s.at.slice(0,10)===dayKey);
  const snap = { at: today.toISOString(), values };
  if(existingIdx>=0) state.snapshots[existingIdx] = snap;
  else state.snapshots.push(snap);
  state.snapshots.sort((a,b)=>new Date(a.at)-new Date(b.at));
  saveSnapshots();
}
/* === ACCOMPLISHMENT SNAPSHOT LOG: END === */

/* ---------------------------------------------------------------------
   FINANCE / COST ENGINE (Earned Value)
   costEntries: {id, building, trade, category, type:'budget'|'actual', amount, date, note, sourceFile}
   --------------------------------------------------------------------- */
function buildingList(){
  const set = new Set([
    ...state.tasks.map(t=>t.building),
    ...state.costEntries.map(e=>e.building),
    ...state.materialEntries.map(m=>m.building),
    ...state.quantityTakedowns.map(q=>q.building),
    ...state.violations.map(v=>v.building),
    ...state.forecastNotes.map(f=>f.building),
    ...state.variationOrders.map(v=>v.building),
    ...state.rfis.map(r=>r.building),
  ]);
  return [...set].filter(Boolean).sort();
}

/* === EAC SANITY BOUND: START ===
   Kung napakaliit ng CPI (malapit sa zero — nangyayari kapag maliit pa lang
   ang accomplishment pero may laki na ng na-book na actual cost), ang
   EAC = actual + (budget-EV)/CPI ay pwedeng mag-explode papuntang hindi
   makatotohanang numero. Dalawang threshold: kailangan may sapat nang
   schedule progress (>=5%) AT hindi masyadong maliit ang CPI (>=0.1) bago
   tiwalaan ang CPI-based na forecast. Kung hindi pa reliable, i-fallback sa
   budget mismo (ibig sabihin "assumed on-budget hanggang may sapat nang
   datos") at i-flag bilang 'low' confidence sa halip na maglabas ng maling
   confident na numero. */
const MIN_RELIABLE_ACTUAL_PCT = 0.05;
const MIN_RELIABLE_CPI = 0.1;
/* === EAC SANITY BOUND: END === */

function costSummaryForBuilding(b){
  const entries = state.costEntries.filter(e=>e.building===b);
  const budget = entries.filter(e=>e.type==='budget').reduce((s,e)=>s+(Number(e.amount)||0),0);
  const actual = entries.filter(e=>e.type==='actual').reduce((s,e)=>s+(Number(e.amount)||0),0);
  /* === VEX SCHEMA SYNC: START ===
     'committed' = PO/contract issued pero hindi pa binabayaran (Vex
     costEntries.type). Hindi ito kasama sa EV/CPI/EAC math (parehong
     convention gaya ng dati — actual lang ang binibilang doon), pero
     dapat visible bilang hiwalay na "committed exposure" figure sa halip
     na tahimik na mawala. */
  const committed = entries.filter(e=>e.type==='committed').reduce((s,e)=>s+(Number(e.amount)||0),0);
  /* === VEX SCHEMA SYNC: END === */
  const scheduleTasks = state.tasks.filter(t=>t.building===b);
  const actualPct = scheduleTasks.length ? weightedActualPct(scheduleTasks)/100 : 0;
  const ev = budget * actualPct;
  const cpi = actual>0 ? ev/actual : null;
  /* === EAC SANITY BOUND: START === */
  let eac, eacConfidence = 'normal';
  const cpiReliable = cpi!=null && cpi>=MIN_RELIABLE_CPI && actualPct>=MIN_RELIABLE_ACTUAL_PCT;
  if(cpiReliable){
    eac = actual + (budget-ev)/cpi;
  } else if(budget>0){
    eac = budget;
    eacConfidence = (actual>0 || actualPct>0) ? 'low' : 'normal';
  } else {
    eac = null;
  }
  /* === EAC SANITY BOUND: END === */
  const vac = (budget>0 && eac!=null) ? budget-eac : null;
  const contractValue = (state.projectMeta[b] && state.projectMeta[b].contractValue) || null;
  const projectedProfit = (contractValue!=null && eac!=null) ? contractValue-eac : null;
  const profitToDate = (contractValue!=null) ? (contractValue*actualPct) - actual : null;
  return {building:b, budget, actual, committed, ev, cpi, eac, eacConfidence, vac, contractValue, projectedProfit, profitToDate, actualPct};
}

function computeCostWarnings(){
  const warnings = [];
  buildingList().forEach(b=>{
    const s = costSummaryForBuilding(b);
    if(s.budget>0 && s.vac!=null && s.vac < 0){
      warnings.push({building:b, overage: Math.abs(s.vac), summary:s});
    }
  });
  return warnings.sort((a,b)=>b.overage-a.overage);
}

/* === WEIGHT% NORMALIZATION CHECK: START ===
   Walang dating check kung ang WT% ng lahat ng tasks per building ay
   sumasadsad sa ~100%. Tolerance na ±5% bago i-flag — mas mahigpit dito
   posibleng maraming false positive dahil sa rounding sa source files. */
function computeWeightWarnings(){
  const warnings = [];
  buildingList().forEach(b=>{
    const tasks = state.tasks.filter(t=>t.building===b && t.weightPct!=null);
    if(!tasks.length) return;
    const total = tasks.reduce((s,t)=>s+t.weightPct,0);
    if(Math.abs(total-100) > 5){
      warnings.push({building:b, total, taskCount: tasks.length});
    }
  });
  return warnings.sort((a,b)=>Math.abs(b.total-100)-Math.abs(a.total-100));
}
/* === WEIGHT% NORMALIZATION CHECK: END === */

/* ---------------------------------------------------------------------
   MATERIALS / SUPPLY ENGINE
   materialEntries: {id, building, item, unit, qtyOnHand, weeklyConsumption, leadTimeDays, sourceFile, updatedAt}
   --------------------------------------------------------------------- */
function materialsForBuilding(b){
  return state.materialEntries.filter(m=>m.building===b).map(m=>{
    const weeklyC = Number(m.weeklyConsumption)||0;
    const daysSupply = weeklyC>0 ? (Number(m.qtyOnHand)||0)/weeklyC*7 : null;
    const leadTime = Number(m.leadTimeDays)||0;
    const atRisk = daysSupply!=null && daysSupply < leadTime;
    const severity = !atRisk ? null : (daysSupply < leadTime*0.4 ? 'High' : daysSupply < leadTime*0.75 ? 'Medium' : 'Low');
    return Object.assign({}, m, {daysSupply, atRisk, severity});
  });
}
function computeMaterialWarnings(){
  const warnings = [];
  buildingList().forEach(b=>{
    materialsForBuilding(b).forEach(m=>{ if(m.atRisk) warnings.push(m); });
  });
  return warnings.sort((a,b)=>(a.daysSupply??0)-(b.daysSupply??0));
}

