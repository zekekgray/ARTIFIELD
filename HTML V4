.status-dot{width:11px;height:11px;border-radius:50%;display:inline-block;}
.status-dot.red{background:var(--red);box-shadow:0 0 0 3px var(--red-dim);}
.status-dot.amber{background:var(--amber);box-shadow:0 0 0 3px var(--amber-dim);}
