<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ARTIFIELD — Master Control Tower</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
:root{
  --bg:#0A0D12;
  --panel:#10151C;
  --panel-2:#151B24;
  --line:#212B38;
  --line-soft:#1A222C;
  --text:#EDF1F5;
  --text-dim:#8FA0B3;
  --text-faint:#546274;
  --blue:#4FC3F7;
  --blue-dim:#274A5C;
  --amber:#FFB020;
  --amber-dim:#5C4118;
  --red:#FF5C5C;
  --red-dim:#5C2323;
  --green:#3DDC84;
  --green-dim:#1E4030;
  --violet:#A78BFA;
  --violet-dim:#3B2F5C;
  --teal:#2DD4BF;
  --teal-dim:#123B37;
  --radius:10px;
  --mono: 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
  --sans: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, sans-serif;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:var(--sans);height:100%;}
body{-webkit-font-smoothing:antialiased;}
::selection{background:var(--blue-dim);color:#fff;}
::-webkit-scrollbar{width:10px;height:10px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:#28323F;border-radius:6px;}
::-webkit-scrollbar-thumb:hover{background:#354254;}
:focus-visible{outline:2px solid var(--blue);outline-offset:2px;border-radius:4px;}

#app{display:flex;height:100vh;overflow:hidden;}

/* ---------- Sidebar ---------- */
#sidebar{
  width:242px;flex:none;background:linear-gradient(180deg,#0C1016,#0A0D12);
  border-right:1px solid var(--line-soft);display:flex;flex-direction:column;
  padding:20px 14px;
  overflow-y:auto;overflow-x:hidden;
  scrollbar-gutter:stable;
}
.brand{padding:4px 8px 18px 8px;border-bottom:1px solid var(--line-soft);margin-bottom:16px;}
.brand .mark{font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;color:var(--blue);}
.mark-edit{
  all:unset;display:block;width:100%;box-sizing:border-box;
  font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;color:var(--blue);
  cursor:text;border-radius:4px;padding:2px 4px;margin:-2px -4px;
  transition:background .12s;
}
.mark-edit:hover{background:var(--panel-2);}
.mark-edit:focus{background:var(--panel-2);outline:1px solid var(--line);}
.brand h1{font-size:16px;margin:5px 0 2px;font-weight:650;letter-spacing:-.01em;}
.brand .sub{font-size:11px;color:var(--text-dim);}

.nav-section-label{font-size:11px;color:var(--text-faint);padding:14px 10px 6px;font-weight:500;}
.nav-section-label:first-of-type{padding-top:2px;}
nav.tabs{display:flex;flex-direction:column;gap:1px;}
nav.tabs button{
  all:unset;cursor:pointer;padding:9px 10px;border-radius:8px;font-size:13px;color:var(--text-dim);
  display:flex;align-items:center;gap:10px;transition:background .12s,color .12s;
}
nav.tabs button:hover{background:var(--panel-2);color:var(--text);}
nav.tabs button.active{background:var(--panel-2);color:var(--text);box-shadow:inset 2.5px 0 0 var(--accent, var(--blue));}
nav.tabs .ico{width:16px;height:16px;flex:none;opacity:.85;}
nav.tabs button .badge-dot{margin-left:auto;width:7px;height:7px;border-radius:50%;background:var(--red);flex:none;}
.side-foot{margin-top:auto;padding:12px 10px 4px;border-top:1px solid var(--line-soft);}
.side-foot .row{display:flex;justify-content:space-between;font-size:11px;color:var(--text-faint);padding:2.5px 0;font-family:var(--mono);}
.side-foot .row b{color:var(--text-dim);font-weight:500;}

/* ---------- Main ---------- */
#main{flex:1;overflow-y:auto;position:relative;}
#topbar{
  position:sticky;top:0;z-index:20;background:rgba(10,13,18,.86);backdrop-filter:blur(14px);
  border-bottom:1px solid var(--line-soft);padding:16px 28px;display:flex;align-items:center;justify-content:space-between;
}
.topbar-mark{
  position:absolute;left:50%;top:30%;transform:translate(-50%,-50%);
  font-size:10.5px;letter-spacing:.1em;color:var(--blue);text-align:center;
  width:auto;max-width:none;
}
#topbar{position:sticky;}
#topbar h2{font-size:18px;margin:0;font-weight:650;letter-spacing:-.01em;}
#topbar .meta{font-size:11.5px;color:var(--text-dim);margin-top:3px;font-family:var(--mono);width:auto;min-width:50ch;max-width:none;box-sizing:content-box;height:auto;white-space:nowrap;padding:2px 0;border-radius:0;background:none !important;border:none !important;outline:none !important;box-shadow:none !important;-webkit-appearance:none;appearance:none;}
#topbar .meta:hover,#topbar .meta:focus{background:none !important;border:none !important;outline:none !important;box-shadow:none !important;}
.btn{
  all:unset;cursor:pointer;padding:8px 14px;border-radius:8px;font-size:12.5px;font-weight:500;
  background:var(--panel-2);color:var(--text);border:1px solid var(--line);transition:all .12s;
}
.btn:hover{border-color:#3A4759;background:#1A222D;}
.btn.primary{background:var(--blue);color:#04121A;border-color:var(--blue);font-weight:600;}
.btn.primary:hover{background:#6FD1FF;}
.btn.danger{color:var(--red);}
.btn-row{display:flex;gap:8px;}
.content{padding:24px 28px 64px;max-width:1400px;}

/* ---------- Cards ---------- */
.grid{display:grid;gap:14px;}
.cards4{grid-template-columns:repeat(4,1fr);}
.cards3{grid-template-columns:repeat(3,1fr);}
.cards2{grid-template-columns:repeat(2,1fr);}
.card{
  background:var(--panel);border:1px solid var(--line-soft);border-radius:var(--radius);padding:17px 19px;
}
.kpi .label{font-size:11.5px;color:var(--text-dim);letter-spacing:.01em;}
.kpi .value{font-family:var(--mono);font-size:25px;margin-top:7px;font-weight:600;letter-spacing:-.02em;}
.kpi .delta{font-size:11.5px;margin-top:5px;color:var(--text-faint);}
.kpi.warn .value{color:var(--amber);}
.kpi.bad .value{color:var(--red);}
.kpi.good .value{color:var(--green);}
.kpi.info .value{color:var(--violet);}
.section-title{font-size:14px;font-weight:650;margin:28px 0 12px;color:var(--text);display:flex;align-items:center;justify-content:space-between;}
.section-title .hint{font-size:11px;color:var(--text-faint);font-weight:400;font-family:var(--mono);}

/* ---------- Empty state ---------- */
.empty{
  border:1px dashed #2A3644;border-radius:12px;padding:60px 30px;text-align:center;color:var(--text-dim);
  margin-top:10px;
}
.empty h3{color:var(--text);font-size:16px;margin-bottom:6px;}
.empty p{font-size:13px;max-width:440px;margin:0 auto 18px;line-height:1.55;}

/* ---------- Import dropzone ---------- */
.dropzone{
  border:1.5px dashed #2A3644;border-radius:12px;padding:30px;text-align:center;cursor:pointer;
  transition:border-color .15s, background .15s;background:var(--panel);
}
.dropzone:hover, .dropzone.drag{border-color:var(--blue);background:#0E1720;}
.dropzone h3{margin:8px 0 4px;font-size:14px;}
.dropzone p{margin:0;font-size:12px;color:var(--text-dim);}
input[type=file]{display:none;}

.filecard{border:1px solid var(--line-soft);border-radius:var(--radius);background:var(--panel);margin-top:14px;overflow:hidden;}
.filecard-h{padding:12px 16px;border-bottom:1px solid var(--line-soft);display:flex;justify-content:space-between;align-items:center;background:var(--panel-2);}
.filecard-h .fname{font-size:12.5px;font-weight:600;}
.filecard-h .fsize{font-size:11px;color:var(--text-faint);font-family:var(--mono);}
.sheetrow{padding:10px 16px;border-bottom:1px solid var(--line-soft);display:grid;grid-template-columns:22px 1.3fr .9fr .9fr 1fr;gap:10px;align-items:center;font-size:12px;}
.sheetrow:last-child{border-bottom:none;}
.sheetrow input[type=text]{
  background:#0D1319;border:1px solid var(--line);color:var(--text);border-radius:6px;padding:6px 8px;font-size:12px;font-family:var(--sans);width:100%;
}
.sheetrow .sname{font-family:var(--mono);color:var(--text-dim);font-size:11.5px;}
.sheetrow .det{font-size:10.5px;color:var(--text-faint);margin-top:2px;}
.chk{width:15px;height:15px;accent-color:var(--blue);}

/* ---------- Tables ---------- */
table.data{width:100%;border-collapse:collapse;font-size:12.5px;}
table.data th{
  text-align:left;font-weight:500;color:var(--text-dim);font-size:11px;padding:9px 10px;
  border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--panel);white-space:nowrap;
}
table.data td{padding:9px 10px;border-bottom:1px solid var(--line-soft);vertical-align:top;}
table.data tr:hover td{background:#121924;}
.tag{display:inline-block;padding:2px 8px;border-radius:20px;font-size:10.5px;font-weight:600;letter-spacing:.01em;}
.tag.blue{background:var(--blue-dim);color:var(--blue);}
.tag.red{background:var(--red-dim);color:var(--red);}
.tag.amber{background:var(--amber-dim);color:var(--amber);}
.tag.green{background:var(--green-dim);color:var(--green);}
.tag.violet{background:var(--violet-dim);color:var(--violet);}
.tag.teal{background:var(--teal-dim);color:var(--teal);}
.tag.gray{background:#1D2733;color:var(--text-dim);}
.mono{font-family:var(--mono);font-size:11.5px;color:var(--text-dim);}
.small-btn{all:unset;cursor:pointer;font-size:11px;padding:4px 9px;border-radius:6px;background:var(--panel-2);border:1px solid var(--line);color:var(--text-dim);}
.small-btn:hover{color:var(--text);border-color:#3A4759;}
.small-btn.go{color:var(--green);}
.pill-btn{all:unset;cursor:pointer;font-size:11.5px;padding:6px 13px;border-radius:20px;background:var(--panel-2);border:1px solid var(--line);color:var(--text-dim);transition:all .12s;}
.pill-btn:hover{border-color:#3A4759;color:var(--text);}
.pill-btn.active{background:color-mix(in srgb, var(--pill-color, var(--blue)) 22%, transparent);border-color:var(--pill-color, var(--blue));color:var(--pill-color, var(--blue));}
.toolbar{display:flex;gap:8px;align-items:center;margin-bottom:12px;flex-wrap:wrap;}
.toolbar select, .toolbar input[type=text], .toolbar input[type=number]{
  background:var(--panel);border:1px solid var(--line);color:var(--text);border-radius:7px;padding:7px 10px;font-size:12px;
}
.toolbar .spacer{flex:1;}
.count-pill{font-family:var(--mono);font-size:11px;color:var(--text-faint);padding:6px 4px;}
.inline-input{background:#0D1319;border:1px solid var(--line);color:var(--text);border-radius:6px;padding:5px 8px;font-size:12px;font-family:var(--mono);width:120px;}

/* ---------- Chart / panel cards ---------- */
.chart-card{background:var(--panel);border:1px solid var(--line-soft);border-radius:var(--radius);padding:18px;margin-bottom:18px;}
.chart-card h4{margin:0 0 2px;font-size:13px;font-weight:650;}
.chart-card .sub{font-size:11px;color:var(--text-faint);margin-bottom:10px;font-family:var(--mono);}
.legend{display:flex;gap:16px;font-size:11px;color:var(--text-dim);margin-top:8px;flex-wrap:wrap;}
.legend span{display:inline-flex;align-items:center;gap:6px;}
.legend i{width:10px;height:3px;border-radius:2px;display:inline-block;}

/* === S-CURVE INTERACTIVITY: START === */
.scurve-wrap{position:relative;}
.scurve-tooltip{
  position:absolute;top:8px;left:8px;z-index:10;background:#0D1319;border:1px solid var(--line);
  border-radius:8px;padding:9px 11px;font-size:11.5px;line-height:1.6;pointer-events:none;opacity:0;
  transition:opacity .08s;box-shadow:0 8px 24px rgba(0,0,0,.35);min-width:160px;max-width:220px;
}
.scurve-tooltip .stt-date{font-family:var(--mono);color:var(--text-dim);font-size:10.5px;margin-bottom:3px;}
.scurve-tooltip .stt-row{display:flex;align-items:center;gap:6px;}
.scurve-tooltip .stt-row i{width:8px;height:8px;border-radius:50%;display:inline-block;flex:none;}
.scurve-tooltip .stt-hint{margin-top:4px;color:var(--text-faint);font-size:10px;}
.legend-btn{
  all:unset;cursor:pointer;display:inline-flex;align-items:center;gap:6px;font-size:11px;color:var(--text-dim);
  padding:3px 8px;border-radius:20px;border:1px solid transparent;transition:all .12s;
}
.legend-btn:hover{background:var(--panel-2);border-color:var(--line);}
.legend-btn.series-off{opacity:.4;text-decoration:line-through;}
/* === S-CURVE INTERACTIVITY: END === */

