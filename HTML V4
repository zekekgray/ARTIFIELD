    <div class="field"><label>Planned Start</label><input type="date" id="editPlannedStart" value="${toInputDate(t.plannedStart)}"></div>
    <div class="field"><label>Planned Finish</label><input type="date" id="editPlannedFinish" value="${toInputDate(t.plannedFinish)}"></div>
    <div class="field"><label>Revised Start (optional)</label><input type="date" id="editRevisedStart" value="${toInputDate(t.revisedStart)}"></div>
    <div class="field"><label>Revised Finish (optional)</label><input type="date" id="editRevisedFinish" value="${toInputDate(t.revisedFinish)}"></div>
    <div class="field"><label>Weight %</label><input type="number" step="0.01" id="editWeightPct" value="${t.weightPct!=null?t.weightPct:''}"></div>
    <div class="field"><label>Accomplishment To-Date %</label><input type="number" step="0.1" id="editAccToDatePct" value="${t.accToDatePct!=null?t.accToDatePct:''}"></div>
    <div class="btn-row" style="margin-top:10px;">
      <button class="btn primary" id="editSaveBtn">Save changes</button>
      <button class="btn" onclick="this.closest('.modal-bg').remove();">Cancel</button>
