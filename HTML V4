      <div>
        <h2 id="topTitle">Dashboard</h2>
        <input type="text" class="mark-edit meta" id="topMetaInput" value="" placeholder="Project address" spellcheck="false" onchange="setProjectAddress(this.value)" oninput="this.style.width=((this.value.length||this.placeholder.length)+2)+'ch'">
