/* ---------- GANTT TAB ---------- */
function renderGantt(c){
  const seqV = computeSequenceViolations();
  const clashV = computeSpaceTimeClashes();
  const flaggedIds = new Set();
  [...seqV, ...clashV].forEach(v=>{ flaggedIds.add(v.taskA.id); flaggedIds.add(v.taskB.id); });

  const buildings = [...new Set(state.tasks.map(t=>t.building))].sort();
  const withDates = state.tasks.filter(hasValidDates);
  const skippedCount = state.tasks.length - withDates.length;
  let minD = new Date(Math.min(...withDates.map(t=>+new Date(t.plannedStart))));
  let maxD = new Date(Math.max(...withDates.map(t=>+new Date(t.revisedFinish||t.plannedFinish))));
  /* === HORIZON FIX: START === (see buildValueScurveSVG for full rationale) */
  maxD = new Date(+maxD + 14*DAY);
  /* === HORIZON FIX: END === */
  const totalDays = Math.max(1,(maxD-minD)/DAY);
  const pxPerDay = 2.2;
  const trackWidth = totalDays*pxPerDay;
  const tradeColors = {};
  const palette = ['#4FC3F7','#FFB020','#A78BFA','#3DDC84','#FF8A65','#F06292','#7986CB','#4DB6AC'];
  [...new Set(state.tasks.map(t=>t.trade))].forEach((tr,i)=>tradeColors[tr]=palette[i%palette.length]);

  let rows = '';
  buildings.forEach(b=>{
    rows += `<div class="gantt-bldg-head">BUILDING ${esc(b)}</div>`;
    const list = withDates.filter(t=>t.building===b).sort((a,b2)=>new Date(a.plannedStart)-new Date(b2.plannedStart));
    list.forEach(t=>{
      const [s,f] = activeRange(t);
      const left = ((s-minD)/DAY)*pxPerDay;
      const width = Math.max(3, ((f-s)/DAY)*pxPerDay);
      const flagged = flaggedIds.has(t.id);
      rows += `<div class="gantt-row">
        <div class="gantt-label" title="${esc(t.name)}">${flagged?'⚠ ':''}${esc(t.name)}</div>
        <div class="gantt-track" style="width:${trackWidth}px">
          <div class="gantt-bar ${flagged?'violation':''}" style="left:${left}px;width:${width}px;background:${tradeColors[t.trade]}" title="${t.p6ActivityId?esc(t.p6ActivityId)+' · ':''}${esc(t.trade)} · ${fmtDate(s)}–${fmtDate(f)}"></div>
        </div>
      </div>`;
    });
  });

  const todayLeft = ((state.asOfDate-minD)/DAY)*pxPerDay;
  let yearMarks='';
  for(let yr=minD.getFullYear(); yr<=maxD.getFullYear(); yr++){
    const gx = ((new Date(yr,0,1)-minD)/DAY)*pxPerDay;
    if(gx<0||gx>trackWidth) continue;
    yearMarks += `<div style="position:absolute;left:${gx+260}px;top:0;bottom:0;width:1px;background:#1A222C;"></div><div style="position:absolute;left:${gx+264}px;top:6px;font-family:var(--mono);font-size:10px;color:#546274;">${yr}</div>`;
  }

  c.innerHTML = `
  <div class="toolbar">
    <span class="count-pill">${withDates.length} tasks plotted · ${buildings.length} buildings · horizon to ${maxD.getFullYear()}${skippedCount?` · ${skippedCount} excluded (data quality)`:''}</span>
    <div class="spacer"></div>
    <div class="legend">${Object.entries(tradeColors).map(([tr,col])=>`<span><i style="background:${col}"></i>${esc(tr)}</span>`).join('')}</div>
  </div>
  <div class="gantt-wrap" style="position:relative;max-height:70vh;overflow:auto;">
    <div style="position:relative;">
      ${yearMarks}
      <div style="position:absolute;left:${todayLeft+260}px;top:0;bottom:0;width:1.5px;background:#FFB020;z-index:5;"></div>
      ${rows}
    </div>
  </div>
  <div class="help" style="margin-top:10px;">⚠ marks a task involved in an open clash or sequence violation. Bar color = trade. Amber vertical line = today.</div>
  `;
}

