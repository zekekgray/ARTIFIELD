/* ---------- Gantt ---------- */
.gantt-wrap{overflow-x:auto;border:1px solid var(--line-soft);border-radius:var(--radius);background:var(--panel);}
.gantt-row{display:flex;border-bottom:1px solid var(--line-soft);}
.gantt-row:hover{background:#111823;}
.gantt-label{
