/* ===========================================================================
   MULTI-SERIES COMPARE OVERLAY
   Overlay 2+ buildings OR 2+ trades sa iisang S-curve chart, para direktang
   makumpara ang pace nila. Toggle sa pagitan ng "compare by building" at
   "compare by trade", multi-select chips, planned-baseline toggle,
   per-series legend na naka-click para ma-isolate, shared hover crosshair
   na nagpapakita ng lahat ng values sa parehong petsa, at click-to-drill
   na modal na nagpapakita ng active tasks per series sa napiling araw.
   =========================================================================== */
function compareOptionsList(){
  if(state.compare.mode==='trade') return [...new Set(state.tasks.map(t=>t.trade))].filter(Boolean).sort();
  return buildingList().filter(b=>state.tasks.some(t=>t.building===b));
}

function compareColorFor(id, allIds){
  const idx = allIds.indexOf(id);
  return COMPARE_PALETTE[idx % COMPARE_PALETTE.length];
}

function setCompareMode(mode){
  if(state.compare.mode===mode) return;
  state.compare.mode = mode;
  state.compare.selected = [];
  render();
}
window.setCompareMode = setCompareMode;

function toggleCompareSelection(id){
  const sel = state.compare.selected;
  const i = sel.indexOf(id);
  if(i>=0) sel.splice(i,1); else sel.push(id);
  render();
}
window.toggleCompareSelection = toggleCompareSelection;

function setCompareAll(){
  state.compare.selected = compareOptionsList();
  render();
}
window.setCompareAll = setCompareAll;

function clearCompareSelection(){
  state.compare.selected = [];
  render();
}
window.clearCompareSelection = clearCompareSelection;

function toggleComparePlanned(){
  state.compare.showPlanned = !state.compare.showPlanned;
  render();
}
window.toggleComparePlanned = toggleComparePlanned;

function buildCompareSeriesDefs(){
  const ids = state.compare.selected;
  return ids.map(id=>{
    const tasks = state.compare.mode==='trade'
      ? state.tasks.filter(t=>t.trade===id)
      : state.tasks.filter(t=>t.building===id);
    return {
      id, label: (state.compare.mode==='trade'?id:'Building '+id),
      color: compareColorFor(id, ids), tasks: tasks.filter(hasValidDates),
    };
  });
}

let _compareIdSeq = 0;
function buildCompareScurveSVG(seriesDefs){
  if(seriesDefs.length===0){
    return `<div class="compare-empty">Select at least one ${esc(state.compare.mode)} above to overlay its S-curve.</div>`;
  }
  const withData = seriesDefs.filter(s=>s.tasks.length>0);
  if(withData.length===0){
    return `<div class="compare-empty">None of the selected ${esc(state.compare.mode)}s have dated tasks yet.</div>`;
  }

  const allTasks = withData.flatMap(s=>s.tasks);
  let minD = new Date(Math.min(...allTasks.map(t=>+new Date(t.plannedStart))));
  let maxD = new Date(Math.max(...allTasks.map(t=>+new Date(t.revisedFinish||t.plannedFinish))));
  /* === HORIZON FIX: START === (see buildValueScurveSVG for full rationale) */
  maxD = new Date(+maxD + 14*DAY);
  /* === HORIZON FIX: END === */

  const W=900, H=280, padL=46, padR=18, padT=16, padB=30;
  const totalW = W-padL-padR, totalH = H-padT-padB;
  const totalDays = Math.max(1,(maxD-minD)/DAY);
  const steps = 60;
  const x = d => padL + ((d-minD)/DAY)/totalDays*totalW;
  const y = p => padT + totalH - (clamp(p,0,100)/100)*totalH;

  const seriesPoints = withData.map(s=>{
    const pts = [];
    for(let i=0;i<=steps;i++){
      const d = new Date(+minD + (totalDays*i/steps)*DAY);
      const actualVal = (d<=state.asOfDate) ? weightedActualPctAtDate(s.tasks, d) : null;
      pts.push({ d, planned: weightedPlannedPct(s.tasks, d), actual: actualVal, xPix: x(d) });
    }
    return Object.assign({}, s, {points: pts});
  });

  let gridlines='', yearLabels='';
  for(let yr=minD.getFullYear(); yr<=maxD.getFullYear(); yr++){
    const gd = new Date(yr,0,1);
    if(gd<minD||gd>maxD) continue;
    const gx = x(gd);
    gridlines += `<line x1="${gx}" y1="${padT}" x2="${gx}" y2="${padT+totalH}" stroke="#1A222C" stroke-width="1"/>`;
    yearLabels += `<text x="${gx}" y="${H-8}" fill="#546274" font-size="10" font-family="var(--mono)">${yr}</text>`;
  }
  let hlines='';
  [0,25,50,75,100].forEach(p=>{
    hlines += `<line x1="${padL}" y1="${y(p)}" x2="${W-padR}" y2="${y(p)}" stroke="#161D26" stroke-width="1"/>`;
    hlines += `<text x="4" y="${y(p)+3}" fill="#546274" font-size="10" font-family="var(--mono)">${p}%</text>`;
  });
  const todayX = x(clamp(state.asOfDate, minD, maxD));

  const chartId = 'cmp'+(_compareIdSeq++);
  window._compareRegistry = window._compareRegistry || {};
  window._compareRegistry[chartId] = {
    W, H, mode: state.compare.mode, series: seriesPoints,
    visibility: Object.fromEntries(seriesPoints.map(s=>[s.id, true])),
    showPlanned: state.compare.showPlanned,
  };

  const paths = seriesPoints.map(s=>{
    const plannedPath = s.points.map((p,i)=>`${i===0?'M':'L'}${p.xPix.toFixed(1)},${y(p.planned).toFixed(1)}`).join(' ');
    const actualPtsOnly = s.points.filter(p=>p.actual!=null);
    const actualPath = actualPtsOnly.map((p,i)=>`${i===0?'M':'L'}${p.xPix.toFixed(1)},${y(p.actual).toFixed(1)}`).join(' ');
    return `
      <path id="${chartId}-planned-${s.id}" d="${plannedPath}" fill="none" stroke="${s.color}" stroke-width="1.6" stroke-dasharray="4 3" opacity="${state.compare.showPlanned?0.55:0}"/>
      <path id="${chartId}-actual-${s.id}" d="${actualPath}" fill="none" stroke="${s.color}" stroke-width="2.4"/>
    `;
  }).join('');

  const legend = seriesPoints.map(s=>{
    const lastActual = [...s.points].reverse().find(p=>p.actual!=null);
    return `<button class="compare-legend-item" id="${chartId}-legend-${s.id}" type="button">
      <i style="background:${s.color}"></i>${esc(s.label)}
      <span class="cli-val">${lastActual ? lastActual.actual.toFixed(1)+'%' : 'no data yet'}</span>
    </button>`;
  }).join('');

  return `
  <h4>Overlay — ${esc(state.compare.mode==='trade'?'Trades':'Buildings')} compared</h4>
  <div class="sub">Horizon: ${fmtDate(minD)} → ${fmtDate(maxD)} · today = ${fmtDate(state.asOfDate)} · solid = actual, dashed = planned · click a point for task breakdown</div>
  <div class="scurve-wrap" id="${chartId}-wrap">
    <div class="compare-tooltip" id="${chartId}-tooltip"></div>
    <svg id="${chartId}-svg" viewBox="0 0 ${W} ${H}" style="width:100%;height:auto;display:block;cursor:crosshair;">
      ${hlines}${gridlines}
      <line x1="${todayX}" y1="${padT}" x2="${todayX}" y2="${padT+totalH}" stroke="#FFB020" stroke-width="1.3" stroke-dasharray="4 3"/>
      ${paths}
      <line id="${chartId}-crosshair" x1="0" y1="${padT}" x2="0" y2="${padT+totalH}" stroke="#EDF1F5" stroke-width="1" stroke-dasharray="2 2" style="opacity:0;pointer-events:none;"/>
      ${yearLabels}
    </svg>
  </div>
  <div class="compare-legend-list">${legend}</div>
  `;
}

function attachCompareScurveInteractivity(chartId){
  const reg = (window._compareRegistry||{})[chartId];
  if(!reg) return;
  const svg = document.getElementById(chartId+'-svg');
  const wrap = document.getElementById(chartId+'-wrap');
  const tooltip = document.getElementById(chartId+'-tooltip');
  const crosshair = document.getElementById(chartId+'-crosshair');
  if(!svg || !wrap || !tooltip || !crosshair) return;

  function nearestIndex(clientX){
    const rect = svg.getBoundingClientRect();
    if(!rect.width || !reg.series[0]) return null;
    const relX = clamp((clientX-rect.left)/rect.width, 0, 1) * reg.W;
    let bestI = 0, bestDist = Infinity;
    reg.series[0].points.forEach((p,i)=>{
      const dist = Math.abs(p.xPix - relX);
      if(dist<bestDist){ bestDist=dist; bestI=i; }
    });
    return bestI;
  }

  function showAt(clientX){
    const i = nearestIndex(clientX);
    if(i==null) return;
    reg.lastIndex = i;
    const anyPoint = reg.series[0].points[i];
    crosshair.setAttribute('x1', anyPoint.xPix); crosshair.setAttribute('x2', anyPoint.xPix);
    crosshair.style.opacity = '1';

    const wrapRect = wrap.getBoundingClientRect();
    const svgRect = svg.getBoundingClientRect();
    const leftPx = (svgRect.left - wrapRect.left) + (anyPoint.xPix/reg.W)*svgRect.width;

    let rows = '';
    reg.series.forEach(s=>{
      if(reg.visibility[s.id]===false) return;
      const p = s.points[i];
      const val = p.actual!=null ? p.actual.toFixed(1)+'%' : (reg.showPlanned ? p.planned.toFixed(1)+'% (planned)' : '—');
      rows += `<div class="ctt-row"><span class="ctt-name"><i style="background:${s.color}"></i>${esc(s.label)}</span><b>${val}</b></div>`;
    });
    tooltip.innerHTML = `<div class="ctt-date">${fmtDate(anyPoint.d)}</div>${rows}<div class="ctt-hint">Click for task breakdown</div>`;
    tooltip.style.opacity = '1';
    let left = leftPx + 14;
    if(left + 240 > wrapRect.width) left = leftPx - 240 - 14;
    tooltip.style.left = Math.max(4,left)+'px';
    tooltip.style.top = '8px';
  }
  function hide(){ crosshair.style.opacity='0'; tooltip.style.opacity='0'; }

  svg.addEventListener('mousemove', e=>showAt(e.clientX));
  svg.addEventListener('mouseleave', hide);
  svg.addEventListener('click', ()=>{ if(reg.lastIndex!=null) openComparePointModal(chartId, reg.lastIndex); });
  svg.addEventListener('touchstart', e=>{ if(e.touches[0]) showAt(e.touches[0].clientX); }, {passive:true});
  svg.addEventListener('touchmove', e=>{ if(e.touches[0]) showAt(e.touches[0].clientX); }, {passive:true});

  reg.series.forEach(s=>{
    const btn = document.getElementById(chartId+'-legend-'+s.id);
    if(!btn) return;
    btn.addEventListener('click', ()=>{
      reg.visibility[s.id] = !reg.visibility[s.id];
      btn.classList.toggle('off', !reg.visibility[s.id]);
      const pa = document.getElementById(chartId+'-actual-'+s.id);
      const pp = document.getElementById(chartId+'-planned-'+s.id);
      if(pa) pa.style.opacity = reg.visibility[s.id] ? '1' : '0';
      if(pp) pp.style.opacity = reg.visibility[s.id] ? (reg.showPlanned?'0.55':'0') : '0';
    });
  });
}

function initAllCompareCharts(){
  Object.keys(window._compareRegistry||{}).forEach(id=>attachCompareScurveInteractivity(id));
}

function openComparePointModal(chartId, idx){
  const reg = window._compareRegistry[chartId];
  if(!reg || !reg.series[0]) return;
  const date = reg.series[0].points[idx].d;
  const sections = reg.series.filter(s=>reg.visibility[s.id]!==false).map(s=>{
    const active = s.tasks.filter(t=>{
      const [st,f] = activeRange(t);
      return st<=date && date<=f;
    }).sort((a,b)=>(b.weightPct||0)-(a.weightPct||0)).slice(0,15);
