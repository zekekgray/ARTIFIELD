<script>
/* =========================================================================
   TURF RESIDENCES — MASTER CONTROL TOWER
   Self-contained schedule + cost + supply intelligence app: xlsx/json import,
   normalization, clash/sequence/revision engines, cost EVM engine, materials
   shortage engine, S-curves, consolidated Gantt, executive dashboard.
   ========================================================================= */

const DAY = 86400000;
const state = {
  tasks: [],             // normalized schedule database
  costEntries: [],        // budget/actual cost line items
  materialEntries: [],    // materials on-hand / consumption
  projectMeta: {},        // building -> {contractValue}
  compatiblePairs: {},    // trade-pair overrides: "TradeA|TradeB" -> true (ignore clash)
  verifications: {},      // taskId -> {verifiedAt, note}
  /* === ACCOMPLISHMENT SNAPSHOT LOG: START === */
  snapshots: [],          // [{at: ISOString, values: {taskId: accToDatePct}}] — one per import day
  /* === ACCOMPLISHMENT SNAPSHOT LOG: END === */
  /* === FIELD UPDATE + SMART VALIDATION: START === */
  fieldUpdates: [],        // [{id, taskId, date, prevPct, newPct, note, flags:[], loggedBy, at}]
  /* === FIELD UPDATE + SMART VALIDATION: END === */
  /* === 7 S-CURVES: START === */
  manpowerLogs: [],        // [{id, building, trade, date, manHours, loggedBy}]
  materialLogs: [],        // [{id, building, item, date, qty, unit, loggedBy}]
  materialPlan: {},        // 'building|item' -> {plannedTotalQty, unit}
  curveBuilding: '',       // selected building for cost/manpower/banana/material curve tabs
  curveMaterialItem: '',   // selected item for material curve tab
  /* === 7 S-CURVES: END === */
  projectName: 'TURF RESIDENCES',
  projectNameCustomized: false,
  projectAddress: '',
  projectAddressCustomized: false,
  lastImport: null,
  pendingImport: null,
  tab: 'dashboard',
  /* === TASK LOCKING: START ===
     Ang verifyTask() ay nag-se-set ng task.locked=true. Habang locked, hindi
     puwedeng baguhin ang task via Edit modal o Log Update modal, AT hindi
     ito ino-overwrite ng susunod na import — sa halip, ang import ay
     nagta-tala ng "pending conflict" na kailangang manual na i-review. */
  lockedImportConflicts: [],  // [{id, taskId, taskName, building, incoming:{...}, sourceRowRef, at}]
  /* === TASK LOCKING: END === */
  asOfDate: new Date(),
  dbFilters: { building: '', trade: '' },
   /* === MULTI-SERIES COMPARE OVERLAY: START === */
  compare: { mode: 'building', selected: [], showPlanned: true },
  /* === MULTI-SERIES COMPARE OVERLAY: END === */
  /* === SCURVE DATE-RANGE ZOOM: START ===
     Para sa mahahabang project (5-10 years), ang fixed 60-step sampling sa
     buong horizon ay nagiging masyadong "coarse" — bawat step ay tumatalon
     ng ilang linggo/buwan. Sa halip na drag/pinch zoom (mas komplikado at
     hindi gaanong pamilyar sa maraming user), isang simpleng "from-to" date
     range filter — kapag na-set, ang minD/maxD ng chart mismo ang
     nagbabago papuntang mas maikling range, kaya awtomatikong mas
     magaganda (mas siksik) ang mga sample points sa loob ng napiling
     window. null = walang filter (buong project range, default). */
  scurveRange: { start: null, end: null },
  /* === SCURVE DATE-RANGE ZOOM: END === */
  /* === VEX SCHEMA SYNC: START ===
     Bagong arrays para tumugma 100% sa Vex Document Standardization Mode
     JSON output schema (v1.2) — mga array na wala pang katumbas sa dating
     ARTIFIELD data model: quantityTakedowns, violations, forecastNotes,
     variationOrders, rfis. Isa pang array (vexMeta) ang nag-iimbak ng meta
     block (schemaVersion, documentType, structuralFindings, blindSpots,
     overallConfidence) ng BAWAT Vex JSON import nang hiwalay-hiwalay —
     hindi pinagsasama-sama, dahil dapat manatiling traceable pabalik sa
     partikular na source file ang bawat structural finding. */
  quantityTakedowns: [],
  violations: [],
  forecastNotes: [],
  variationOrders: [],
  rfis: [],
  vexMeta: [],
  /* === VEX SCHEMA SYNC: END === */
  /* === BUILDING NAME RESOLVER: START === */
  buildingAliases: {},              // normBuildingKey(raw) -> canonical name (user-confirmed)
  buildingSuggestionsDismissed: {},  // "keyA|keyB" -> true (user said "not the same")
  /* === BUILDING NAME RESOLVER: END === */
  /* === NAMED BASELINES: START ===
     Hiwalay sa revisionHistory[] (na per-task, walang pangalan) — ito ay
     isang GLOBAL snapshot ng lahat ng task dates+progress sa sandaling
     ito, may user-given na pangalan (hal. "Rev 2 — Aug submission").
     Nagbibigay-daan itong pumili ng dalawang named point in time at
     ikumpara sa isang table, sa halip na basahin ang raw history array
     nang manual per-task. */
  baselines: [],  // [{id, name, createdAt, taskDates: {taskId:{plannedStart,plannedFinish,revisedStart,revisedFinish,weightPct,accToDatePct}}}]
  /* === NAMED BASELINES: END === */
};

const KEY_DB = 'turf-master-tasks-v1';
const KEY_RULES = 'turf-clash-rules-v1';
const KEY_LOCKED_CONFLICTS = 'turf-locked-import-conflicts-v1';
const KEY_COST = 'turf-cost-entries-v1';
const KEY_MATERIALS = 'turf-material-entries-v1';
 const KEY_PROJECTMETA = 'turf-project-meta-v1';
const KEY_PROJECTNAME = 'turf-project-name-v1';
const KEY_PROJECTADDRESS = 'turf-project-address-v1';
const KEY_PROJECTNAME_CUSTOMIZED = 'turf-project-name-customized-v1';
const KEY_PROJECTADDRESS_CUSTOMIZED = 'turf-project-address-customized-v1';
/* === ACCOMPLISHMENT SNAPSHOT LOG: START === */
const KEY_SNAPSHOTS = 'turf-accomplishment-snapshots-v1';
/* === ACCOMPLISHMENT SNAPSHOT LOG: END === */
/* === FIELD UPDATE + SMART VALIDATION: START === */
const KEY_FIELD_UPDATES = 'turf-field-updates-v1';
/* === FIELD UPDATE + SMART VALIDATION: END === */
/* === 7 S-CURVES: START === */
const KEY_MANPOWER_LOGS = 'turf-manpower-logs-v1';
const KEY_MATERIAL_LOGS = 'turf-material-logs-v1';
const KEY_MATERIAL_PLAN = 'turf-material-plan-v1';
/* === 7 S-CURVES: END === */
/* === VEX SCHEMA SYNC: START === */
const KEY_QTAKEDOWNS = 'turf-quantity-takedowns-v1';
const KEY_VIOLATIONS = 'turf-violations-v1';
const KEY_FORECASTNOTES = 'turf-forecast-notes-v1';
const KEY_VARIATIONORDERS = 'turf-variation-orders-v1';
const KEY_RFIS = 'turf-rfis-v1';
const KEY_VEXMETA = 'turf-vex-meta-v1';
/* === VEX SCHEMA SYNC: END === */
/* === BUILDING NAME RESOLVER: START === */
const KEY_BUILDING_ALIASES = 'turf-building-aliases-v1';
const KEY_BUILDING_DISMISSED = 'turf-building-dismissed-v1';
/* === BUILDING NAME RESOLVER: END === */
/* === NAMED BASELINES: START === */
const KEY_BASELINES = 'turf-named-baselines-v1';
/* === NAMED BASELINES: END === */

function toast(msg, type){
  const el = document.createElement('div');
  el.className = 'toastel' + (type ? ' '+type : '');
  el.textContent = msg;
  document.getElementById('toast').appendChild(el);
  setTimeout(()=>{ el.style.opacity='0'; el.style.transition='opacity .3s'; setTimeout(()=>el.remove(),300); }, 3600);
}

/* ---------------------------------------------------------------------
   PERSISTENCE
   --------------------------------------------------------------------- */
async function loadDB(){
  try{
    const r = await window.storage.get(KEY_DB, false);
    if(r && r.value){ const d = JSON.parse(r.value); state.tasks = d.tasks||[]; state.lastImport = d.lastImport||null; }
  }catch(e){ /* no data yet */ }
  try{
    const r2 = await window.storage.get(KEY_RULES, false);
    if(r2 && r2.value) state.compatiblePairs = JSON.parse(r2.value);
  }catch(e){}
